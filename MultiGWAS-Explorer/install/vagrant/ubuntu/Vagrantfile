Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("PIPELINE_VAGRANT_BOX", "bento/ubuntu-24.04")
  config.vm.hostname = "diffgwas-pipeline-ubuntu"

  repo_root = File.expand_path("../../..", __dir__)
  config.vm.synced_folder repo_root, "/repo"

  config.vm.provider "hyperv" do |h|
    h.vmname = "diffgwas-pipeline-ubuntu"
  end

  # Install into the VM's Linux filesystem.  Installing directly in /repo would
  # overwrite the host's .venv-pipeline with Linux binaries when /repo is a
  # Windows shared folder.
  config.vm.provision "shell", privileged: false, inline: <<-SHELL
    set -euo pipefail
    vm_root=/home/vagrant/MultiGWAS-Explorer
    mkdir -p "${vm_root}"
    tar \
      --exclude=.venv-pipeline \
      --exclude=local \
      --exclude=cache \
      --exclude=.oda_upload_aliases \
      -C /repo -cf - . | tar -C "${vm_root}" -xf -
    cd "${vm_root}"
    bash install/install_ubuntu.sh
  SHELL
end
