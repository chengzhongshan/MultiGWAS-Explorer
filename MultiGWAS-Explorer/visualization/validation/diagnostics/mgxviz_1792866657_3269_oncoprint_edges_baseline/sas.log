124        proc sql noprint;
125         select count(*) into :ns trimmed from work._mgxo_samples;
126         select count(*) into :ng trimmed from work._mgxo_genes;
127         select count(*)-count(distinct sample)+sum(missing(sample) or missing(cohort))
128          +count(*)-count(distinct sample_index)
129          +sum(sample_index ne int(sample_index) or sample_index<1 or sample_index>&ns)
130         into :bad_samples trimmed from work._mgxo_samples;
131         select count(*)-count(distinct gene)+sum(missing(gene))
