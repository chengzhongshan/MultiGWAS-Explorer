145          where missing(s.sample) or missing(g.gene) or missing(v.variant_id)
146          or v.mutation_class not in ('Missense','Truncating','Splice','Inframe');
147         create table work._mgxo_conflicts as select sample,gene,variant_id,
148          count(distinct mutation_class) as n_classes from work._mgxo_variants
149          group by sample,gene,variant_id having calculated n_classes>1;
150         select count(*) into :bad_event_classes trimmed from work._mgxo_conflicts;
151         select count(*) into :uncallable_events trimmed from work._mgxo_variants as v
152          left join work._mgxo_genes as g on v.gene=g.gene
153          left join work._mgxo_callability as c on v.sample=c.sample and g.gene_index=c.gene_index
