182         create table &outlib..&prefix._burden as select s.sample,s.cohort,s.sample_index as burden_x,
183          count(v.variant_id) as n_events,0 as burden_zero from work._mgxo_samples as s
184         left join work._mgxo_unique as v on s.sample=v.sample group by s.sample,s.sample_index,s.cohort;
185         select max(1,coalesce(max(n_events),0)) into :maxburden trimmed from &outlib..&prefix._burden;
