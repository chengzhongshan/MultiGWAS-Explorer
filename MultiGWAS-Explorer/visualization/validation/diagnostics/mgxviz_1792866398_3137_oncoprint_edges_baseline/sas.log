163         create table work._mgxo_counts as select sample,gene,count(*) as n_variants,
164          max(mutation_class='Truncating') as truncating,max(mutation_class='Splice') as splice,
165          max(mutation_class='Inframe') as inframe,max(mutation_class='Missense') as missense
166          from work._mgxo_unique group by sample,gene;
167         create table &outlib..&prefix._tiles as
168         select s.sample,s.sample_index,s.cohort,g.gene,g.gene_index,c.callable,
169          coalesce(m.n_variants,0) as n_variants,coalesce(m.truncating,0) as truncating,
170          coalesce(m.splice,0) as splice,coalesce(m.inframe,0) as inframe,coalesce(m.missense,0) as missense
171         from work._mgxo_samples as s cross join work._mgxo_genes as g
172         left join work._mgxo_callability as c on s.sample=c.sample and g.gene_index=c.gene_index
173         left join work._mgxo_counts as m on s.sample=m.sample and g.gene=m.gene;
174         create table &outlib..&prefix._frequency as select gene,gene_index,
175          sum(callable=1) as n_callable,sum(callable=1 and n_variants>0) as n_mutated,
176          case when calculated n_callable>0 then 100*calculated n_mutated/calculated n_callable else . end as pct_mutated
177         from &outlib..&prefix._tiles group by gene,gene_index;
178         create table work._mgxo_events as select v.*,s.sample_index,g.gene_index,t.n_variants
179         from work._mgxo_unique as v inner join work._mgxo_samples as s on v.sample=s.sample
180         inner join work._mgxo_genes as g on v.gene=g.gene
