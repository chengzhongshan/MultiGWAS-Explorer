161        proc sql;
162         create table work._mgxo_counts as select sample,gene,count(*) as n_variants,
163          max(mutation_class='Truncating') as truncating,max(mutation_class='Splice') as splice,
164          max(mutation_class='Inframe') as inframe,max(mutation_class='Missense') as missense
165          from work._mgxo_unique group by sample,gene;
166         create table &outlib..&prefix._tiles as
167         select s.sample,s.sample_index,s.cohort,g.gene,g.gene_index,c.callable,
168          coalesce(m.n_variants,0) as n_variants,coalesce(m.truncating,0) as truncating,
169          coalesce(m.splice,0) as splice,coalesce(m.inframe,0) as inframe,coalesce(m.missense,0) as missense
170         from work._mgxo_samples as s cross join work._mgxo_genes as g
171         left join work._mgxo_callability as c on s.sample=c.sample and g.gene_index=c.gene_index
172         left join work._mgxo_counts as m on s.sample=m.sample and g.gene=m.gene;
173         create table &outlib..&prefix._frequency as select gene,gene_index,
174          sum(callable=1) as n_callable,sum(callable=1 and n_variants>0) as n_mutated,
175          case when calculated n_callable>0 then 100*calculated n_mutated/calculated n_callable else . end as pct_mutated
176         from &outlib..&prefix._tiles group by gene,gene_index;
177         create table work._mgxo_events as select v.*,s.sample_index,g.gene_index,t.n_variants
178         from work._mgxo_unique as v inner join work._mgxo_samples as s on v.sample=s.sample
179         inner join work._mgxo_genes as g on v.gene=g.gene
180         inner join &outlib..&prefix._tiles as t on v.sample=t.sample and v.gene=t.gene;
181         create table &outlib..&prefix._burden as select s.sample,s.sample_index as burden_x,
182          count(v.variant_id) as n_events,0 as burden_zero from work._mgxo_samples as s
183         left join work._mgxo_unique as v on s.sample=v.sample group by s.sample,s.sample_index;
184         select max(1,coalesce(max(n_events),0)) into :maxburden trimmed from &outlib..&prefix._burden;
185         create table work._mgxo_cohorts as select distinct cohort from work._mgxo_samples order by cohort;
186         select sample_index into :sample_ticks separated by ' ' from work._mgxo_samples order by sample_index;
187         select gene_index into :gene_ticks separated by ' ' from work._mgxo_genes order by gene_index;
188        quit;
