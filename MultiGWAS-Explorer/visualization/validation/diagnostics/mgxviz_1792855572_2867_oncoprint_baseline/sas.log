123        proc sql noprint;
124         select count(*) into :ns trimmed from work._mgxo_samples;
125         select count(*) into :ng trimmed from work._mgxo_genes;
126         select count(*)-count(distinct sample)+sum(missing(sample) or missing(cohort))
127          +count(*)-count(distinct sample_index)
128          +sum(sample_index ne int(sample_index) or sample_index<1 or sample_index>&ns)
129         into :bad_samples trimmed from work._mgxo_samples;
130         select count(*)-count(distinct gene)+sum(missing(gene))
131          +count(*)-count(distinct gene_index)
132          +sum(gene_index ne int(gene_index) or gene_index<1 or gene_index>&ng)
133         into :bad_genes trimmed from work._mgxo_genes;
134         create table work._mgxo_bad_keys as select sample,gene_index,count(*) as n
135          from work._mgxo_callability group by sample,gene_index having calculated n>1;
136         select count(*) into :bad_call_keys trimmed from work._mgxo_bad_keys;
137         select count(*) into :bad_calls trimmed from work._mgxo_callability as c
138          left join work._mgxo_samples as s on c.sample=s.sample
139          left join work._mgxo_genes as g on c.gene_index=g.gene_index
140          where missing(s.sample) or missing(g.gene) or c.callable not in (0,1);
141         select count(*) into :bad_events trimmed from work._mgxo_variants as v
142          left join work._mgxo_samples as s on v.sample=s.sample
143          left join work._mgxo_genes as g on v.gene=g.gene
144          where missing(s.sample) or missing(g.gene) or missing(v.variant_id)
145          or v.mutation_class not in ('Missense','Truncating','Splice','Inframe');
146         create table work._mgxo_conflicts as select sample,gene,variant_id,
147          count(distinct mutation_class) as n_classes from work._mgxo_variants
148          group by sample,gene,variant_id having calculated n_classes>1;
149         select count(*) into :bad_event_classes trimmed from work._mgxo_conflicts;
150         select count(*) into :uncallable_events trimmed from work._mgxo_variants as v
151          left join work._mgxo_genes as g on v.gene=g.gene
152          left join work._mgxo_callability as c on v.sample=c.sample and g.gene_index=c.gene_index
153          where missing(c.callable) or c.callable ne 1;
154        quit;
