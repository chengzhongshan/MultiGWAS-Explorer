2533            /*
2534              _xtag_ contains only the requested label rows.  Update their adjusted
2535              x positions directly in FINAL with a hash lookup.  The former
2536              CREATE TABLE FINAL AS SELECT ... FROM FINAL required a second complete
2537              438-column table plus SQL utility space and could disconnect SAS ODA
2538              when WORK filled.
2539            */
2540            data final;
