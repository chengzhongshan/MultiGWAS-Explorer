5146       %macro QQplot(dsdin,P_var);
5147       proc sql noprint;
5148       select count(*) into: tot
5149       from &dsdin;
5150       
5151       data &dsdin;
5152       set &dsdin;
5153       where &P_var>0;
5154       
5155       *sort and exclude these missing P values;
5156       proc sort data=&dsdin;
5157       by &P_var;
5158       run;
5159       
5160       data dataout;
5161       set &dsdin;
5162       retain x_;
5163       gap=1/&tot;
5164       ini=gap/2;
5165       if _n_=1 then x_=ini;
5166       else x_=x_+gap;
5167       x=-log10(x_);
5168       y=-log10(&P_var);
5169       run;
5170       
5171       
5172       proc sql noprint;
5173       select ceil(max(y)) into: max_y
5174       from dataout;
5175       
5176       *Adjust the tick number when the &max_y>10;
5177       %let step=1;
5178       %if &max_y>=20 %then %do;
5179         %let step=5;
5180         *Update the max_y can be divided by 5;
5181         %let max_y=%sysevalf(%sysevalf(&max_y/5,ceil)*5);
5182       %end;
5183       
5184       /*make sure to put reset here*/
5185       /*otherwise symbol2 will not work*/
5186       goptions reset=global hsize=15cm vsize=15cm;
5187       symbol1 interpol=none value=dot color=maroon;
5188       symbol2 interpol=rl value=none color=black;
5189       %let fontsize=3;
5190       axis1 label=(f='arial' h=&fontsize 'Expected -log10(P)' justify=c)
5191             order=(0 to &max_y by &step) value=(f='arial' h=&fontsize);
5192       axis2 label=(a=90 f='arial' h=&fontsize 'Observed -log10(P)')
5193             order=(0 to &max_y by &step) value=(f='arial' h=&fontsize);
5194       proc gplot data=dataout;
5195       plot y*x x*x/overlay
5196                  haxis=axis1
5197                  vaxis=axis2
5198                  noframe;
5199       run;
5200       
5201       *Also make a QQ plot with x- and y-axis with the same scale and maximum value of 8;
5202       goptions reset=global hsize=15cm vsize=15cm;
5203       symbol1 interpol=none value=dot color=maroon;
5204       symbol2 interpol=rl value=none color=black;
5205       %let fontsize=3;
5206       axis1 label=(f='arial' h=&fontsize 'Expected -log10(P)' justify=c)
5207             order=(0 to 8 by 1) value=(f='arial' h=&fontsize);
5208       axis2 label=(a=90 f='arial' h=&fontsize 'Observed -log10(P)')
5209             order=(0 to 8 by 1) value=(f='arial' h=&fontsize);
5210       proc gplot data=dataout;
5211       plot y*x x*x/overlay
5212                  haxis=axis1
5213                  vaxis=axis2
5214                  noframe;
5215       run;
5216       
5217       %mend;
5218       
5219       
5220       %macro QueryLD_SNPs_at_Haploreg4(
5221         snp=rs2564978,
5222         LDpop=EUR,
5223         ldThresh=0.7,
5224         outdsd=LD_dsd
5225       );
5226       %local query_str _http_status _has_rsid _has_r2 _n_rows _out_lib _out_mem _response_bytes _response_records
5227              _cache_min _cache_action _cache_self_n;
5228       %global HAPLOREG_LD_HTTP_STATUS HAPLOREG_LD_QUERY_OK HAPLOREG_LD_QUERY_SOURCE
5229               HAPLOREG_LD_CACHE_DSD HAPLOREG_LD_CACHE_MIN_R2 HAPLOREG_LD_CACHE_MISS_ACTION;
5230       %let HAPLOREG_LD_HTTP_STATUS=;
5231       %let HAPLOREG_LD_QUERY_OK=0;
5232       %let HAPLOREG_LD_QUERY_SOURCE=NONE;
5233       %if %sysfunc(countw(%superq(outdsd),.))>1 %then %do;
5234         %let _out_lib=%scan(%superq(outdsd),1,.);
5235         %let _out_mem=%scan(%superq(outdsd),-1,.);
5236       %end;
5237       %else %do;
5238         %let _out_lib=WORK;
5239         %let _out_mem=&outdsd;
5240       %end;
5241       
5242       /*
5243       Optional local cache. The cache is a long table with QUERY_SNP, PROXY_SNP,
5244       LD_POPULATION, PROXY_R2, and CACHE_MIN_R2. It can be produced by
5245       extract_haploreg_ld_for_candidates.pl from the official downloadable archives.
5246       Archive data are available only from r2=0.2 upward; a cache is never used for a
5247       lower requested cutoff. A cache miss falls back to the web query by default.
5248       */
5249       %let _cache_action=%upcase(%sysfunc(strip(%superq(HAPLOREG_LD_CACHE_MISS_ACTION))));
5250       %if %sysevalf(%superq(_cache_action)=,boolean) %then %let _cache_action=WEB;
5251       %let _cache_min=%sysfunc(inputn(%superq(HAPLOREG_LD_CACHE_MIN_R2),best32.));
5252       %if %sysevalf(%superq(_cache_min)=,boolean) %then %let _cache_min=0.2;
5253       
5254       %if not %sysevalf(%superq(HAPLOREG_LD_CACHE_DSD)=,boolean)
5255           and %sysfunc(exist(%superq(HAPLOREG_LD_CACHE_DSD))) %then %do;
5256         %if %sysevalf(&ldThresh >= &_cache_min) %then %do;
5257           data &outdsd;
5258             length query_snp_rsid rsID $128 chr $16 pos_hg38 r2 8;
5259             set &HAPLOREG_LD_CACHE_DSD;
5260             where query_snp=upcase("&snp")
5261               and ld_population=upcase("&LDpop")
5262               and proxy_r2 >= &ldThresh;
5263             query_snp_rsid="&snp";
5264             rsID=strip(proxy_snp);
5265             r2=proxy_r2;
5266             chr='';
5267             pos_hg38=.;
5268             keep query_snp_rsid rsID chr pos_hg38 r2;
5269           run;
5270           proc sql noprint;
5271             select count(*) into :_cache_self_n trimmed
5272             from &outdsd
5273             where upcase(strip(rsID))=upcase("&snp");
5274           quit;
5275           %if %sysevalf(%superq(_cache_self_n)=,boolean) %then %let _cache_self_n=0;
5276           %if &_cache_self_n>0 %then %do;
5277             %let HAPLOREG_LD_HTTP_STATUS=LOCAL_CACHE;
5278             %let HAPLOREG_LD_QUERY_OK=1;
5279             %let HAPLOREG_LD_QUERY_SOURCE=LOCAL_CACHE;
5280             %put NOTE: HaploReg LD cache hit snp=&snp population=&LDpop threshold=&ldThresh cache=&HAPLOREG_LD_CACHE_DSD.;
5281             %return;
5282           %end;
5283           %put WARNING: HaploReg LD cache miss for &snp population=&LDpop.;
5284           %if &_cache_action ne WEB %then %do;
5285             %let HAPLOREG_LD_HTTP_STATUS=CACHE_MISS;
5286             %let HAPLOREG_LD_QUERY_SOURCE=LOCAL_CACHE_MISS;
5287             %return;
5288           %end;
5289         %end;
5290         %else %put WARNING: Ignoring HaploReg LD cache because requested r2=&ldThresh is below cache minimum r2=&_cache_min.;
5291       %end;
5292       
5293       %let query_str=%nrstr(&query=)&snp%nrstr(&ldThresh=)&ldThresh%nrstr(&ldPop=)&LDpop%nrstr(&output=text&submit=submit);
5294       %let HAPLOREG_LD_QUERY_SOURCE=WEB;
5295       
5296       filename hap temp lrecl=1000000000;
5297       proc http
5298         url="https://pubs.broadinstitute.org/mammals/haploreg/haploreg.php/post"
5299         method="POST"
5300         in="&query_str"
5301         out=hap
5302         ct='application/x-www-form-urlencoded';
5303       run;
5304       
5305       %let _http_status=&SYS_PROCHTTP_STATUS_CODE;
5306       %let HAPLOREG_LD_HTTP_STATUS=&_http_status;
5307       
5308       %if %sysevalf(%superq(_http_status)=,boolean)
5309           or %sysevalf(&_http_status < 200)
5310           or %sysevalf(&_http_status >= 400) %then %do;
5311         %put WARNING: HaploReg LD query failed for &snp population=&LDpop HTTP=&_http_status.;
5312         data &outdsd;
5313           length query_snp_rsid rsID $128 chr $16 pos_hg38 r2 8;
5314           stop;
5315         run;
5316         filename hap clear;
5317         %return;
5318       %end;
5319       
5320       %let _response_bytes=0;
5321       data _null_;
5322         length _size_text $64;
5323         _fid=fopen('hap');
5324         if _fid>0 then do;
5325           _size_text=finfo(_fid,'File Size (bytes)');
5326           call symputx('_response_bytes',input(compress(_size_text,,'kd'),best32.),'L');
5327           _rc=fclose(_fid);
5328         end;
5329       run;
5330       %if %sysevalf(%superq(_response_bytes)=,boolean) %then %let _response_bytes=0;
5331       %if %sysevalf(&_response_bytes <= 0) %then %do;
5332         %put WARNING: HaploReg returned an empty response for &snp population=&LDpop.;
5333         data &outdsd;
5334           length query_snp_rsid rsID $128 chr $16 pos_hg38 r2 8;
5335           stop;
5336         run;
5337         filename hap clear;
5338         %return;
5339       %end;
5340       
5341       /*
5342       PROC IMPORT writes a fatal-looking ERROR when HaploReg returns only a blank
5343       line or a header without data.  Count nonblank records first so an expected
5344       "no LD response" is represented by an empty data set and audit status instead
5345       of poisoning an otherwise successful SAS ODA job log.
5346       */
5347       %let _response_records=0;
5348       data _null_;
5349         infile hap lrecl=32767 truncover end=_eof;
5350         input;
5351         if not missing(_infile_) then _n_nonblank+1;
5352         if _eof then call symputx('_response_records',_n_nonblank,'L');
5353       run;
5354       %if %sysevalf(%superq(_response_records)=,boolean) %then %let _response_records=0;
5355       %if %sysevalf(&_response_records < 2) %then %do;
5356         %put WARNING: HaploReg returned no tabular LD rows for &snp population=&LDpop.;
5357         data &outdsd;
5358           length query_snp_rsid rsID $128 chr $16 pos_hg38 r2 8;
5359           stop;
5360         run;
5361         filename hap clear;
5362         %return;
5363       %end;
5364       
5365       proc import datafile=hap dbms=tab out=&outdsd replace;
5366         getnames=yes;
5367         guessingrows=max;
5368       run;
5369       filename hap clear;
5370       
5371       %if not %sysfunc(exist(&outdsd)) %then %do;
5372         %put WARNING: HaploReg returned no importable table for &snp population=&LDpop.;
5373         data &outdsd;
5374           length query_snp_rsid rsID $128 chr $16 pos_hg38 r2 8;
5375           stop;
5376         run;
5377         %return;
5378       %end;
5379       
5380       proc sql noprint;
5381         select sum(upcase(name)='RSID'),
5382                sum(upcase(name)='R2')
5383           into :_has_rsid trimmed,
5384                :_has_r2 trimmed
5385         from dictionary.columns
5386         where libname=upcase("&_out_lib")
5387           and memname=upcase("&_out_mem")
5388         ;
5389       quit;
5390       
5391       %if %sysevalf(%superq(_has_rsid)=,boolean) %then %let _has_rsid=0;
5392       %if %sysevalf(%superq(_has_r2)=,boolean) %then %let _has_r2=0;
5393       
5394       %if &_has_rsid=0 or &_has_r2=0 %then %do;
5395         %put WARNING: HaploReg response for &snp population=&LDpop lacks rsID or r2 columns.;
5396         data &outdsd;
5397           length query_snp_rsid rsID $128 chr $16 pos_hg38 r2 8;
5398           stop;
5399         run;
5400         %return;
5401       %end;
5402       
5403       data &outdsd;
5404         length query_snp_rsid $128;
5405         set &outdsd(drop=query_snp_rsid);
5406         query_snp_rsid="&snp";
5407       run;
5408       
5409       proc sql noprint;
5410         select count(*) into :_n_rows trimmed
5411         from &outdsd
5412         where upcase(strip(rsID))=upcase("&snp")
5413         ;
5414       quit;
5415       %if %sysevalf(%superq(_n_rows)=,boolean) %then %let _n_rows=0;
5416       %if %sysevalf(&_n_rows > 0) %then %let HAPLOREG_LD_QUERY_OK=1;
5417       
5418       %put NOTE: HaploReg LD query snp=&snp population=&LDpop threshold=&ldThresh HTTP=&_http_status
5418     ! query_ok=&HAPLOREG_LD_QUERY_OK.;
5419       %mend;
5420       
5421       
5422       %macro RandBetween(min, max);
5423       %local min max rnd _unif_num_ _rnd_;
5424       %let _unif_num_=%sysfunc(ranuni(0));
5425       %let _rnd_=%sysevalf((1+&max-&min)*&_unif_num_);
5426       %let rnd=%sysfunc(floor(&_rnd_));
5427       &rnd
5428       %mend;
5429       
