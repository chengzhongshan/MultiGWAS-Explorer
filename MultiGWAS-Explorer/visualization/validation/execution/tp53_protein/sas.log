5092       %macro OpenSVG_Printer(
5093       filename=mysvgfilename,
5094       svgfileref=out,
5095       other_paras4ods_graphics=%str( ),
5096       outdir=,/*output svg to the dir; if empty, it will save it
5097       into the dir %sysfunc(pathname(HOME));*/
5098       );
5099       
5100       *In Windows, due to sysfunc(pathname(HOME)) only works in Linux;
5101       *the SVG will be failed to be written into the SAS installation dir;
5102       *To address the issue, change the dir into working dir;
5103       %if &sysscp=WIN %then %do;
5104       data _null_;
5105       rx=dlgcdir("%sysfunc(getoption(work))");
5106       run;
5107       %end;
5108       %else %if %length(&outdir)=0 %then %do;
5109       data _null_;
5110       rx=dlgcdir("%sysfunc(pathname(HOME))");
5111       run;
5112       %end;
5113       
5114       *Check whether the svg exist;
5115       *add appendix to it to not overwrite previous svg;
5116       %let fi=1;
5117       %let oldname=&filename;
5118       %do %while (%FileOrDirExist(%sysfunc(pathname(HOME))/&filename..svg)=1);
5119         %put rename your svg output filename as:;
5120         %let filename=&oldname._&fi;
5121         %put &filename;
5122         %let fi=%eval(&fi+1);
5123       %end;
5124       
5125       options printerpath=(svg &svgfileref) nobyline;
5126       filename out "&filename..svg";
5127       ods listing close;
5128       ods printer;
5129       ods graphics on/outputfmt=svg
5130       &other_paras4ods_graphics;
5131       
5132       %if &sysscp=WIN %then %do;
5133       data _null_;
5134       rx=dlgcdir("%sysfunc(getoption(work))");
5135       run;
5136       %end;
5137       %else %do;
5138       data _null_;
5139       rx=dlgcdir("%sysfunc(pathname(HOME))");
5140       run;
5141       %end;
5142       
5143       %mend;
