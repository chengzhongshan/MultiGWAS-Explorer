1681       %end;
1682       %if &_max_pos_y>24 %then %do;
1683       		 %let mod_num2keep=6;
1684            %if &amplify_scatterheader_pos=1 %then %let adjval4header=%sysevalf(2*&adjval4header);
1685       %end;
1686       %put _max_pos_y is &_max_pos_y and the mod_num2keep is set as &mod_num2keep!;
