10633      /*
10634      / Program   : quotelst
10635      / Version   : 1.0
10636      / Author    : Roland Rashleigh-Berry
10637      / Date      : October 2002
10638      / Contact   : <REDACTED_EMAIL>
10639      / Purpose   : To quote the elements of a list
10640      / SubMacros : none
10641      / Notes     : This is useful to turn a list into a quoted list so that you can
10642      /             use the in() function on it in a data step. Also, if you search for
10643      /             a quoted string among a list of quoted strings then you can avoid
10644      /             matching on a subset of a single element. Note that you can change
10645      /             not only the quote mark but the delimiter as well so you can use
10646      /             this macro for other purposes like putting commas between variable
10647      /             names etc. It is assumed that the elements of the list are
10648      /             delimited by spaces.
10649      / Usage     : %if %index(%quotelst(varnames),"varname") %then...
10650      /
10651      /================================================================================
10652      / PARAMETERS:
10653      /-------name------- -------------------------description-------------------------
10654      / str               String to quote elements of (pos)
10655      / quote=%str(%")    Quote character to use (defaults to double quotation mark)
10656      / delim=%str( )     Delimiter character to use (defaults to a space)
10657      /================================================================================
10658      / AMENDMENT HISTORY:
10659      / init --date-- mod-id ----------------------description-------------------------
10660      /
10661      /================================================================================
10662      / This is public domain software. No guarantee as to suitability or accuracy is
10663      / given or implied. User uses this code entirely at their own risk.
10664      /===============================================================================*/
10665      
10666      %macro quotelst(str,quote=%str(%"),delim=%str( ));
10667      %local i quotelst;
10668      %let i=1;
10669      %do %while(%length(%scan(&str,&i,%str( ))) GT 0);
10670        %if %length(&quotelst) EQ 0 %then %let quotelst=&quote.%scan(&str,&i,%str( ))&quote;
10671        %else %let quotelst=&quotelst.&quote.%scan(&str,&i,%str( ))&quote;
10672        %let i=%eval(&i + 1);
10673        %if %length(%scan(&str,&i,%str( ))) GT 0 %then %let quotelst=&quotelst.&delim;
10674      %end;
10675      %unquote(&quotelst)
10676      %mend;
10677      
10678      /* Drop only existing transpose-generated coordinate columns. */
10679      %macro BookGDCDropCoordinates(data=,chr=,pos=);
10680       %local _id _n _i _name _drop _rc;
10681       %let _drop=;
10682       %let _id=%sysfunc(open(&data,i));
10683       %if &_id=0 %then %do;
10684        %put ERROR: BookGDCDropCoordinates cannot open &data.;
10685        %return;
10686       %end;
10687       %let _n=%sysfunc(attrn(&_id,nvars));
10688       %do _i=1 %to &_n;
10689        %let _name=%sysfunc(varname(&_id,&_i));
10690        %if %index(%upcase(%superq(_name)),%upcase(&chr._))=1 or
10691            %index(%upcase(%superq(_name)),%upcase(&pos._))=1 %then
10692         %let _drop=&_drop %sysfunc(nliteral(%superq(_name)));
10693       %end;
10694       %let _rc=%sysfunc(close(&_id));
10695       %if %length(%superq(_drop)) %then %do;
10696        data &data;set &data;drop &_drop;run;
10697       %end;
10698      %mend;
10699      
