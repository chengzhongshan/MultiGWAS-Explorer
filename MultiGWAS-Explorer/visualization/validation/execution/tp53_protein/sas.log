2106       select &grp_var into: grpnames separated by " "
2107       from
2108       (select unique(&grp_var)
2109       from x1
2110       where &yval_var>=0);
2111       %let onegrpname=%scan(&grpnames,1,%str( ));
2112       %put selected grpname for missing value of non-gene group is &onegrpname;
2113       /* %abort 255; */
2114       data final;
