3474       %macro Manhattan4DiffGWASs(
3475       dsdin=,/*Input GWAS dataset with multiple GWAS p variables put in columns; it is ideal to have sorted GWAS by numeric chr
3475     !  and position*/
3476       pos_var=,/*Position variable for markers, such as SNPs*/
3477       chr_var=,/*Chromosome variable for markers, such as SNPs; it is better to have numberic chr var as input*/
3478       P_var=,/*The P var for the 1st GWAS that is put at the bottom of the final manhattan plot; can be the only GWAS input*/
3479       Other_P_vars=, /*Leave it empty for a single-GWAS plot, or provide other GWAS P vars in order for making manhattan plots
3479     ! from botton to up*/
3480       logP=1,/*Provide value 1 to indicate the need of performing -log10 caculation for input P_var; Make sure the P_var and
3480     ! Other_P_vars are in the same format!*/
3481       gwas_thrsd=7.3,/*Use it to draw significance reference line in each GWAS track*/
3482       thrsd_line_color=gray,
3483       dotsize=2,/*The dot size for scatter plots*/
3484       _logP_topval=10, /*Top -log10P value to truncate GWAS signals and also restrict the max yaxis value of each GWAS track;
3485       Make sure to input EVEN number for the macro, as the macro separate ticks by step 2!*/
3486       y_axix_step=2,/*Customize the step for all y-axis tikets*/
3487       fig_width=1200,
3488       fig_height=500,
3489       fontsize=3,
3490       y_axis_label_size=, /*Optional y-axis label font size; default uses fontsize*/
3491       y_axis_value_size=, /*Optional y-axis tick-value font size; default uses fontsize*/
3492       gwas_label_names=, /*Optional pipe-delimited labels matching P_var followed by Other_P_vars*/
3493       gwas_label_x_pct=50, /*Graph-percent x position for GWAS track labels*/
3494       gwas_label_y_frac=0.89, /*Within-track y position as fraction of _logP_topval*/
3495       gwas_label_size=1.0, /*Black foreground label size in percent units*/
3496       gwas_label_halo_size=1.0, /*White underlay label size in percent units, ensure it is the same as the gwas_label_size!*/
3497       gwas_label_angle=0, /*Angle for GWAS track labels*/
3498       flip1stGWAS_signal=1, /*When providing value 1, which will draw the 1st GWAS at the bottom in reverse order for the
3498     ! yaxis,
3499       which means the most significant association will be put close to bottom;
3500       provide value 0 to draw the 1st GWAS in vertical mode!*/
3501       refline_color_4zero=gray, /*Color the manhattan bottom line*/
3502       rm_signals_with_logP_lt=0.5, /*To make the manhattan plot have reference line at association signal of zero,
3503       it is better to remove associaiton signal logP for all GWASs less than the cutoff*/
3504       use_uniq_colors=1, /*Draw scatter plots with different colors for chromosomes;
3505       provide value 0 to use SAS default color scheme;*/
3506       uniq_colors=,/*Provide customized uniq colors, such as cx0072bd and others with the prefix cx;
3507       If left empty, the default unique colors included in the macro will be used!*/
3508       gwas_sortedby_numchrpos=0, /*Ideally the input GWAS dsdin should be sorted by numchr and pos;
3509       if the GWAS dsdin is not, the macro will sort it accordingly but will require more memory and disk space*/
3510       outputfigname=Manhattan, /*a prefix used to label the output figure*/
3511       plot_title=, /*Optional visible title for the plotted statistic and color encoding.*/
3512       angle4xaxis_label=40, /*Adjust the angle of xaxis group labels*/
3513       Use_scaled_pos=1, /*Default is to draw manhattan plot with fake positions by group in even distance;
3514       Provide value 1 to draw the plot in scaled and uneven distance relative to its real position values!
3515       This will be helpful when draw top hits local manhattan plots!
3516       */
3517       sep_chr_grp=0, /*Default is not to add lines to separate x-axis chromosomal groups;
3518       Provide value 1 to add lines to separate each chromosomal group*/
3519       xgrp_y_pos=-1, /*Asign the y-axis value for all x-axis group labels;
3520       It is necessary to adjust the value if the default value is out of range;
3521       Try to use -1 to replace -1.5 if the above issue occurred!*/
3522       yoffset_setting=%str(offset=(0.5,0.5)), /*This macro var is used to extend the bottom and upper y-axis;
3523       which is especially helpful when the position of x-axis group labels assigned by xgrp_y_pos is
3524       out of the default offset of y-axis */
3525       
3526       /*Important parameters for drawing local Manhattan pltos*/
3527       draw_local_Manhattan=0,/*Default is to draw genome-wide Manhattan plot; if supplying value 1, the macro will draw local
3528       Manhattano around target SNPs when the macro var target_SNPs is provided or top hits if the macro var target_SNPs
3529       is empty and the macro var top_hit_thresd is supplied with specific association p threshold, such as p < 1e-6*/
3530       snp_var=rsid,/*It is necessary to have snp_var supplied when drawing local Manhattan plot*/
3531       snp_gene_splitter=:,/*In case the gene name for the snp is also supplied to the snp_var, the macro
3532       will split the snp_var into two string, with the first is snp and the 2nd is genename for it, which will
3533       be plotted at the bottom of the figure as x-axis labels for different snp mahattan plot*/
3534       target_SNPs=,/*Default is empty; please provide rsid that can be matched with the snp macro variable*/
3535       Keep_order_of_target_SNPs=0, /*Draw local Manhattan plot according to the order of target SNPs
3536       Note: need to set this macro with value 1 if drawing local Manhattan plots for target SNPs or top hits,
3537       which means if either target_SNPs or top_hit_thresd is not empty, please assign value 1 to this macro var!
3538       When draw genome-wide Manhattan plots, it is required to assign value 1 to this macro var.*/
3539       top_hit_thresd=,/*provide a p value threshold to only draw local Manhattan plot for the smallest
3540       top hit around a specific genomic window,such as p < 1e-6 within a window of 1e7 bp*/
3541       dist4get_smallest_top_hit=1e7, /*Select the smallest top SNP around a genomic window of the supplied distance in bp*/
3542       only_get_top_hit4n_th_gwas=0, /*The parameter enables the macro to focus on top hits from specific gwas represented by
3543       its order starting from 1 to n for the 1st gwas and other gwass inferred by their supplied P variables; the default value
3543     !  0 means
3544       to query all gwas top hits; if only want to query top hits from the 1 gwas, please supply value 1, and this applicable to
3545       other gwass if the correct numeric order for the gwas is supplied here!*/
3546       LD_SNPs2mark_scatterplot_dots=, /*Space-delimited high-LD rsIDs overlaid on every GWAS track.*/
3547       LD_marker_symbol=*,
3548       LD_marker_color=black,
3549       LD_display_mode=none,
3550       LD_r2_values=,
3551       LD_heatmap_colormodel=CXF7FBFF CX6BAED6 CX54278F,
3552       LD_heatmap_legend_title=%str(LD r2)
3553       );
3554       
3555       %local n_other_pvars n_gwas_pvars;
3556       %let n_other_pvars=%sysfunc(countw(%superq(Other_P_vars),%str( )));
3557       %let n_gwas_pvars=%eval(&n_other_pvars+1);
