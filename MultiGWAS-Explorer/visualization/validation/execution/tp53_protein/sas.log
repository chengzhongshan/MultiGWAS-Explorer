3866       *find maximum value for the x-axis, store in a macro variable;
3867       proc sql noprint;
3868       select 1.005*ceil(max(Fake_position)) into :maxbp
3869       from manhattan;
3870       quit;
3871       
3872       *
3873       find mean of BP within each chromosome (C)
3874       used later to position x-axis labels
3875       ;
3876       
3877       *A potential bug here especially when there are a lot of SNPs with missing p values;
3878       *were removed from the data set before calculating the mean of these positions;
3879       *Try to generate a temporary data set;
3880       proc sort data=manhattan(keep=&chr_var Fake_position) out=_manhattan_ nodupkeys;
3881       by &chr_var Fake_position;
3882       run;
3883       proc sql;
3884       create table _manhattan_ as
3885       select *
3886       from _manhattan_
3887       group by &chr_var
3888       having Fake_position=min(Fake_position) or Fake_position=max(Fake_position);
3889       *If the above invite some bugs, it is feasible to use the data set manhattan to replace _manhattan_;
3890       proc summary data=_manhattan_ nway;
3891       %if &Keep_order_of_target_SNPs=1 %then %do;
3892       *Draw local Manhattan plots by keeping the original order of target SNPs;
3893       /*class &chr_var tag_snp;*/
3894       *No need to add tag_snp as &chr_var is updated as tag_snp;
3895       class &chr_var;
3896       %end;
3897       %else %do;
3898       class &chr_var;
3899       %end;
3900       var Fake_position;
3901       /*output out=mbp mean=;*/
3902       /*output out=mbp mean= min=min max=max;*/
3903       output out=mbp mean=;
3904       run;
3905       
3906       %if &Keep_order_of_target_SNPs=1 %then %do;
3907       proc sql;
3908       create table mbp as
3909       select a.*, b.&ordered_target_label_var
3910       from mbp as a
3911       left join _chr_map_ as b
3912         on a.&chr_var=b._chr_
3913       ;
3914       quit;
3915       %end;
3916       
3917       *The _mid_ is the same as the mean position;
3918       /*data mbp;*/
3919       /*set mbp;*/
3920       /*_mid_=(max-min)/2 + min;*/
3921       /*run;*/
3922       
3923       
3924       * annotate data set used to add x-axis labels
3925       "manually" add the frame around the graph
3926       possibly add a horizontal reference line
3927       ;
3928       data anno ;
3929       length color $10. text $64. style $20.;
3930       *Note: the position will decide where to put the text;
3931       *position '1': put text under the position and left adjusted;
3932       *position '2': put text at the middle of the position and left adjusted;
3933       *position '3': put text above the position and left adjusted;
3934       *position '4': put text under the position and center adjusted;
3935       *see other useful positions, such as A, B, C, D, E, F;
3936       *and <,+, and >, and 7,8,9;
3937       *at: https://documentation.sas.com/doc/es/pgmsascdc/v_053/graphref/annotate_position.htm;
3938       %if "&var_type"="2" or &Keep_order_of_target_SNPs=1 %then %do;
3939       retain position '4' xsys ysys '2' y &xgrp_y_pos function 'label' text 'xx'  angle &angle4xaxis_label;
3940       %end;
3941       %else %do;
3942       *Key part to put the genomewide xgroup labels, such as 1,2,3,...,20 at the center of the position on the x-axis;
3943       %*put the xgroup labels at the center but one cell lower than the position;
3944       /* retain position '8' xsys ysys '2' y 0 function 'label' text 'xx' ; */
3945       %*Put the xgroup labels at the center of the position;
3946       /* retain position '+' xsys ysys '2' y 0 function 'label' text 'xx' ; */
3947       %*Text baseline half cell below location;
3948       /* retain position '5' xsys ysys '2' y 0 function 'label' text 'xx' ; */
3949       %*Half cell below location;
3950       retain position 'E' xsys ysys '2' y 0 function 'label' text 'xx';
3951       %end;
3952       do until (last1);
3953         %if &Keep_order_of_target_SNPs=1 %then %do;
3954         *Draw local Manhattan plots by keeping the original order of target SNPs;
3955       /*   set mbp (keep = Fake_position &chr_var  tag_snp) end=last1;*/
3956          *No need to add tag_snp as &chr_var is tag_snp when keep_order_of_target_SNPs is true;
3957            set mbp (keep = Fake_position &chr_var &ordered_target_label_var) end=last1;
3958         %end;
3959         %else %do;
3960          set mbp (keep = Fake_position &chr_var) end=last1;
3961         %end;
3962          x = round(Fake_position) ;
3963          *This step can be modified to remove the x-axis group labels by asigning empty str to text;
3964          %if &Keep_order_of_target_SNPs=1 %then %do;
3965            *For ordered local grouped Manhattan plots, keep numeric ordering in _chr_
3966             while restoring the original SNP:gene label for the bottom box.;
3967            text = strip(&ordered_target_label_var);
3968          %end;
3969          %else %if "&var_type"="2" %then %do;
3970          *text="";
3971           text=put(&chr_var,Xaxis_var_label.);
3972       /*       text=cat(&chr_var);*/
3973          %end;
3974          %else %do;
3975             text = cat(&chr_var);
3976             if text="20" or text="22"  then text=" ";
3977          %end;
3978          output;
3979       end;
3980       
3981       * top of frame;
3982       %if &n_gwas_pvars > 1 %then %do;
3983       xsys = '1'; ysys = '1'; function = 'move'; x = 0; y=100; output;
3984       xsys = '2'; function = 'draw'; x = &maxbp ; output;
3985       %end;
3986       * bottom of frame;
3987       xsys = '1'; ysys = '1'; function = 'move'; x = 0; y=0; output;
3988       xsys = '2'; function = 'draw'; x = &maxbp ; output;
3989       
3990       * horizontal reference line (if needed for 5x10-08);
3991       %if &n_gwas_pvars > 1 %then %do;
3992       xsys = '1'; ysys = '2'; function = 'move'; x = 0; y=&_logP_topval; output;
3993       xsys = '2'; function = 'draw'; x = &maxbp ; line=1; size=3; color="&refline_color_4zero";output;
3994       %end;
3995       
3996       * Explicit zero-reference line for the first/bottom GWAS track.
3997       * This is separate from the frame border because axis offsets used for SNP/gene
3998       * labels can move the visible plotting region away from the graph edge.
3999       %if &draw_local_Manhattan=1 %then %do;
4000       * When drawing local Manhattan plot, it is better to have the reference line for zero association signals;
4001       %if (&flip1stGWAS_signal=0) %then %do;
4002       xsys = '1'; ysys = '2'; function = 'move'; x = 0; y=0; output;
4003       xsys = '2'; function = 'draw'; x = &maxbp ; line=1; size=3; color="&refline_color_4zero";output;
4004       %end;
4005       %else %do;
4006       xsys = '1'; ysys = '2'; function = 'move'; x = 0; y=&_logP_topval; output;
4007       xsys = '2'; function = 'draw'; x = &maxbp ; line=1; size=3; color="&refline_color_4zero";output;
4008       %end;
4009       %end;
4010       
4011       *Note: only when &_logP_topval>&gwas_thrsd, the macro can draw these gwas threshold reference line;
4012       %if (&flip1stGWAS_signal=0) %then %do;
4013       %if %sysevalf(&_logP_topval>&gwas_thrsd) %then %do;
4014       xsys = '1'; ysys = '2'; function = 'move'; x = 0; y=&gwas_thrsd; output;
4015       xsys = '2'; function = 'draw'; x = &maxbp ; line=2; size=1; color="&thrsd_line_color";output;
4016       %end;
4017       %end;
4018       %else %do;
4019       %if %sysevalf(&_logP_topval>&gwas_thrsd) %then %do;
4020       xsys = '1'; ysys = '2'; function = 'move'; x = 0; y=&_logP_topval-&gwas_thrsd; output;
4021       xsys = '2'; function = 'draw'; x = &maxbp ; line=2; size=1; color="&thrsd_line_color";output;
4022       %end;
4023       %end;
4024       
4025       %do ri=1 %to &n_other_pvars;
4026       
4027       *For lines in the middle separating different scatter plots, use large line size to draw lines;
4028       %if &ri < &n_other_pvars %then %do;
4029       xsys = '1'; ysys = '2'; function = 'move'; x = 0; y=&_logP_topval+&_logP_topval*&ri; output;
4030       xsys = '2'; function = 'draw'; x = &maxbp ;  line=1; size=3; color="&refline_color_4zero";output;
4031       %end;
4032       
4033       %if %sysevalf(&_logP_topval>&gwas_thrsd) %then %do;
4034       *For lines at the top and bottom, use lighter line size to draw lines;
4035       xsys = '1'; ysys = '2'; function = 'move'; x = 0; y=&gwas_thrsd+&_logP_topval*&ri; output;
4036       xsys = '2'; function = 'draw'; x = &maxbp ; line=2; size=1; color="&thrsd_line_color";output;
4037       %end;
4038       
4039       %end;
4040       
4041       * Add GWAS variable names in the middle of each stacked GWAS track;
4042       %do _gwas_label_i_=1 %to &n_gwas_pvars;
4043         label_x = &maxbp / 2;
4044         label_y = (&_gwas_label_i_ - 1) * &_logP_topval +
4045                   min(&_logP_topval - 0.8, max(0.8, &_logP_topval * &gwas_label_y_frac));
4046         %if %superq(gwas_label_names) ne %then %do;
4047           text = "%qscan(%superq(gwas_label_names),&_gwas_label_i_,|)";
4048         %end;
4049         %else %do;
4050           text = "%scan(&P_var &Other_P_vars,&_gwas_label_i_,%str( ))";
4051         %end;
4052       
4053         * A white label underlay gives a readable halo over dense point clouds;
4054         * when 'a' is used for when, the label will be drawn after all the points are drawn, which can make sure the label is
4054     ! not covered by any points;
4055         xsys = '2';
4056         ysys = '2';
4057         hsys = '3';
4058         when='a';
4059         function = 'label';
4060         x = label_x;
4061         y = label_y;
4062         color = 'white';
4063         style = 'Albany AMT';
4064         size = &gwas_label_halo_size;
4065         position = '5';
4066         angle = &gwas_label_angle;
4067         output;
4068       
4069         * Dark label centered over the white underlay;
4070         function = 'label';
4071         x = label_x;
4072         y = label_y;
4073         color = 'black';
4074         style = 'Albany AMT';
4075         size = &gwas_label_size;
4076         position = '5';
4077         angle = &gwas_label_angle;
4078         when='a';
4079         output;
4080       %end;
4081       drop label_x label_y;
4082       
4083       run;
4084       
4085       *Further split text annotation if it contains the split char ":";
4086       *https://communities.sas.com/t5/Graphics-Programming/Splitting-text-in-two-lines-using-annotion-dataset/td-p/246199;
4087       *https://documentation.sas.com/doc/en/pgmsascdc/9.4_3.5/graphref/annotate_position.htm;
4088       data anno;
4089       retain str_len_diff 0;
4090       set anno;
4091       text0=trim(left(text));
4092       if prxmatch("/[^&snp_gene_splitter]+:[^&snp_gene_splitter]+/",text) and function='label' then do;
4093       	  do ti=1 to min(3,countw(text0,"&snp_gene_splitter"));
4094       		 text=scan(text0,ti,"&snp_gene_splitter");
4095       		 str_len_diff=length(scan(text0,1,"&snp_gene_splitter"));
4096       
4097       		 *half cell above location right aligned;
4098       		 %if &angle4xaxis_label=90 %then %do;
4099       		 if ti=1 then do;
4100                   position='B';
4101                   y=&xgrp_y_pos;
4102                   hsys='3';
4103                   size=max(1,&fontsize*0.80);
4104                   style='Albany AMT';
4105                end;
4106       		 %end;
4107       		 %else %do;
4108       		 if ti=1  then position='2';
4109       		 *one cell below location centeral aligned;
4110       		 %end;
4111       
4112       		 else if ti=2 then do;
4113                   %if &angle4xaxis_label=90 %then %do;
4114                    position='E';
4115                    y=&xgrp_y_pos;
4116                    hsys='3';
4117                    size=max(1,&fontsize*0.72);
4118       			*Use annotate relative-position placement for the second rotated line,
4119                    which matches the behavior of the original macro better than
4120                    forcing explicit x/y offsets.;
4121       			 %end;
4122       			 %else %do;
4123       		     position='+';*original location central alignment;
4124       			 %end;
4125       			 *See availabel SAS font style:
4125     ! https://documentation.sas.com/doc/en/vwbgraphref/v_001/n0c8945h7o2kmrn1h0uehmio2i6j.htm;
4126       			 style='ITALIC';
4127       			str_len_diff=str_len_diff-length(scan(text0,2,"&snp_gene_splitter"))+1;
4128       			*str_len_diff=round(str_len_diff/2);
4129       			if str_len_diff>0 then do;
4130       			  *text=resolve('%AddSpaces4str(str='||text||',add2end=1,nspaces='|| str_len_diff ||',char4space=-)');
4131       			end;
4132       		 end;
4133       		 else do;
4134                   *Third component, when supplied, is the chromosome name.
4135                    Place it to the right of the vertical gene symbol.;
4136       			%if &angle4xaxis_label=90 %then %do;
4137                   position='E';
4138                   y=&xgrp_y_pos;
4139                   hsys='3';
4140                   size=max(1,&fontsize*0.66);
4141                   *Convert the gene-label font height to fake-position units so
4142                    the chromosome label has its own column to the right.;
4143                   x=x+1.3*&maxbp*max(1,&fontsize*0.72)*&fig_height/(100*&fig_width);
4144       			%end;
4145       			%else %do;
4146                   position='+';
4147       			%end;
4148                   style='Albany AMT';
4149       		 end;
4150       		 output;
4151       	  end;
4152       end;
4153       else output;
4154       drop text0 ti;
4155       run;
4156       
4157       
4158       * reset all then set some graphics options;
4159       %let max_yaxis_val=%sysevalf(&n_other_pvars*&_logP_topval + &_logP_topval);
4160       *If put reset=all inside the command of goptions, the title will be removed;
4161       *It is necessary to reset all here, otherwise, the figure may be distorted;
4162       *Albany AMT is equivalent to Arial in SAS;
4163       * destination for the plot;
4164       filename gout "~/&outputfigname..png";
4165       
4166       goptions reset=all ftext="Albany AMT" htext=&fontsize gunit=pct
4167                dev=png xpixels=&fig_width ypixels=&fig_height gsfname=gout gsfmode=replace;
4168       
4169       
4170       /* Clear inherited titles and draw a requested title with a compact font. */
4171       %if %length(%superq(plot_title))>0 %then %do;
4172         title1 h=1.3 "&plot_title";
4173       %end;
4174       %else %do;
4175         title1;
4176       %end;
4177       title2;
4178       title3;
4179       footnote1;
4180       
4181       * let SAS choose the colors;
4182       * use h=5 to set dot size for the plot;
4183       %if &use_uniq_colors=0 %then %do;
4184       symbol1 v=dot r=46 h=&dotsize;
4185       %end;
4186       %else %do;
4187        %if %length(&uniq_colors)=0 %then %do;
4188             *Use default unique colors;
4189             %uniqcolors;
4190         %end;
4191          %else %do;
4192            *Use customized unique colors;
4193            %uniqcolors(inputcolors=&uniq_colors);
4194           %end;
4195       %end;
4196       
4197       * two alternating colors;
4198       * gray-scale;
4199       *%twocolors(gray33,graycc);
4200       * blue and blue-green;
4201       *%twocolors(cx2C7FB8,cx7FCDBB);
4202       
4203       *If the y_axix_step is larger than the top _logp_topval;
4204       *Use step value 2 instead;
4205       %if %sysevalf(2*&y_axix_step)>=&_logp_topval %then %do;
4206       					 %put Your assigned y-axis step value &y_axix_step is too large and even larger than half of the top association
4206     ! value;
4207                  %put The macro will reset the y-axis step value as 2!;
4208                  %let y_axix_step=2;
4209       %end;
4210       
4211       %if %length(&y_axis_label_size)=0 %then %let y_axis_label_size=&fontsize;
4212       %if %length(&y_axis_value_size)=0 %then %let y_axis_value_size=&fontsize;
4213       
4214       * suppress drawing of any x-axis feature;
4215       axis1 value=none major=none minor=none label=none style=0;
4216       * rotate y-axis label and asign font as f='Albany AMT';
4217       axis2 label=(angle=90 "-Log10(p)" f=Arial h=&y_axis_label_size)
4218            order=(0 to  &max_yaxis_val by &y_axix_step)	 &yoffset_setting
4219             value=(f=Arial h=&y_axis_value_size
4220                    %do _pi_=0 %to &n_other_pvars;
4221                       %if (&flip1stGWAS_signal=1 and &_pi_=0) %then %do;
4222                         %do _ti_=&_logp_topval %to &y_axix_step %by -&y_axix_step;
4223                             "&_ti_"
4224                          %end;
4225                        %end;
4226                        %else %do;
4227                         %do _ti_=0 %to %sysevalf(&_logp_topval-&y_axix_step) %by &y_axix_step;
4228                             "&_ti_"
4229                          %end;
4230                         %end;
4231                      %end;
4232                       ' '
4233                         );
4234       
4235       * use PROC GPLOT to create the plot;
4236       *Add format for customized &chr_var labels;
4237       *Make sure to remove nolegend;
4238       
4239       data manhattan;
4240       set manhattan;
4241       length _LD_SNP_MARK_ $8 _LD_COLOR_ $16;
4242       _LD_SNP_MARK_='';
4243       _LD_R2_=.;
4244       %if %length(&LD_SNPs2mark_scatterplot_dots)>0 and %upcase(&LD_display_mode) ne NONE %then %do;
4245       if findw(upcase("&LD_SNPs2mark_scatterplot_dots"),upcase(strip(&snp_var)),' ')>0
4246         then _LD_SNP_MARK_="&LD_marker_symbol";
4247       %end;
4248       %if %length(&LD_r2_values)>0 and
4249           (%upcase(&LD_display_mode)=HEATMAP or %upcase(&LD_display_mode)=BOTH) %then %do;
4250       %do _li_=1 %to %ntokens(&LD_r2_values);
4251         %let _ld_pair_=%scan(&LD_r2_values,&_li_,%str( ));
4252         if upcase(strip(&snp_var))=upcase("%scan(&_ld_pair_,1,%str(:))") then
4253           _LD_R2_=input("%scan(&_ld_pair_,2,%str(:))",best32.);
4254       %end;
4255       if not missing(_LD_R2_) then do;
4256         if _LD_R2_<0.5 then _LD_COLOR_="%scan(&LD_heatmap_colormodel,1,%str( ))";
4257         else if _LD_R2_<0.8 then _LD_COLOR_="%scan(&LD_heatmap_colormodel,2,%str( ))";
4258         else _LD_COLOR_="%scan(&LD_heatmap_colormodel,-1,%str( ))";
4259       end;
4260       %end;
4261       *Further remove signals with logP<1.3, which will save space and prevent the reference lines covered by these signals
4261     ! with logP<1.3;
4262       if logP<&rm_signals_with_logP_lt then logP=.;
4263       if logp>&_logP_topval then logp=&_logP_topval;
4264       
4265       %if (&flip1stGWAS_signal=1) %then %do;
4266       logp=&_logP_topval-logp;
4267       %end;
4268       
4269       
4270       %do _mi_=1 %to &n_other_pvars;
4271        logp&_mi_=-log10(%scan(&Other_P_vars,&_mi_,' '));
4272       if logP&_mi_<&rm_signals_with_logP_lt then logP&_mi_=.;
4273        if logp&_mi_>&_logP_topval then logp&_mi_=&_logP_topval ;
4274       if logp&_mi_^=. then logp&_mi_=logp&_mi_+&_logP_topval*&_mi_;
4275       %end;
4276       
4277       run;
4278       
4279       %if %length(&LD_SNPs2mark_scatterplot_dots)>0 and
4280           (%upcase(&LD_display_mode)=MARKERS or %upcase(&LD_display_mode)=BOTH) %then %do;
4281       data _ld_snp_anno;
4282         set manhattan(where=(not missing(_LD_SNP_MARK_)));
4283         length function $8 text $40 color $16 position $1 style $12;
4284         retain xsys '2' ysys '2' function 'label' text "&LD_marker_symbol" color "&LD_marker_color"
4285                position '5' style 'Arial' size 1.6;
4286         x=Fake_position;
4287         array _ld_logp_[*] logp logp1-logp%ntokens(&Other_P_vars);
4288         do _ld_i_=1 to dim(_ld_logp_);
4289           y=_ld_logp_[_ld_i_];
4290           if not missing(y) then output;
4291         end;
4292         keep x y xsys ysys function text color position style size;
4293       run;
4294       proc append base=anno data=_ld_snp_anno force;
4295       run;
4296       data _ld_snp_legend;
4297         length function $8 text $40 color $16 position $1 style $12;
4298         xsys='1'; ysys='1'; x=1; y=98; function='label'; position='6';
4299         text=cats("&LD_marker_symbol",' High-LD SNP'); color="&LD_marker_color"; style='Arial'; size=1.2;
4300       run;
4301       proc append base=anno data=_ld_snp_legend force;
4302       run;
4303       %end;
4304       
4305       %if %length(&LD_r2_values)>0 and
4306           (%upcase(&LD_display_mode)=HEATMAP or %upcase(&LD_display_mode)=BOTH) %then %do;
4307       data _ld_r2_anno;
4308         set manhattan(where=(not missing(_LD_R2_)));
4309         length function $8 text $40 color $16 position $1 style $12;
4310         xsys='2'; ysys='2'; function='label'; text='o'; color=_LD_COLOR_;
4311         position='5'; style='Arial'; size=1.8; x=Fake_position;
4312         array _ld_logp_[*] logp logp1-logp%ntokens(&Other_P_vars);
4313         do _ld_i_=1 to dim(_ld_logp_);
4314           y=_ld_logp_[_ld_i_]; if not missing(y) then output;
4315         end;
4316         keep x y xsys ysys function text color position style size;
4317       run;
4318       proc append base=anno data=_ld_r2_anno force; run;
4319       data _ld_r2_legend;
4320         length function $8 text $80 color $16 position $1 style $12;
4321         xsys='1'; ysys='1'; function='label'; position='6'; style='Arial'; size=1.0;
4322         x=68; y=98; text="&LD_heatmap_legend_title"; color='black'; output;
4323         x=78; text='o 0-0.5'; color="%scan(&LD_heatmap_colormodel,1,%str( ))"; output;
4324         x=86; text='o 0.5-0.8'; color="%scan(&LD_heatmap_colormodel,2,%str( ))"; output;
4325         x=95; text='o 0.8-1'; color="%scan(&LD_heatmap_colormodel,-1,%str( ))"; output;
4326       run;
4327       proc append base=anno data=_ld_r2_legend force; run;
4328       %end;
