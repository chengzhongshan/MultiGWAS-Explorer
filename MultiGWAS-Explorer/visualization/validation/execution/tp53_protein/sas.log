11013      %let SNP_long_dsd=tgt;
11014      
11015      /* Book-only addition: an explicit GRCh38 window needs no rsID or web lookup. */
11016      %if %sysfunc(prxmatch(/^\d+:\d+:\d+$/,%superq(query_rsid_or_genesymbol))) %then %do;
11017       %let chrnum=%scan(&query_rsid_or_genesymbol,1,:);
11018       %let stpos=%scan(&query_rsid_or_genesymbol,2,:);
11019       %let endpos=%scan(&query_rsid_or_genesymbol,3,:);
11020       %if &stpos>&endpos %then %do;
11021        %put ERROR: GDC genomic window start exceeds end.;%return;
11022       %end;
11023       data tgt;set &longformat_muts;
11024       where &gwas_chr_var=&chrnum and &gwas_pos_var between &stpos and &endpos;
11025       run;
11026      %end;
11027      %else %if %sysfunc(prxmatch(/^rs\d+/,&query_rsid_or_genesymbol)) %then %do;
11028        %put We are going to get the genomic position and chromosome for the input query SNP &query_rsid_or_genesymbol;
11029        proc sql noprint;
11030        select &gwas_chr_var,&gwas_pos_var into: tgt_chr, : tgt_pos
11031        from
11032        &longformat_muts
11033        where &gwas_snp_var="&query_rsid_or_genesymbol";
11034      
11035      	data tgt;
11036        set &longformat_muts;
11037        keep &gwas_snp_var &gwas_pos_var &gwas_chr_var &gwas_dsd_var
11038                 &gwas_beta_var &gwas_se_var &gwas_p_var &var4label_scatterplot_dots;
11039      	 *This will remove libname or HGI_GWAS from the gwas_dsd_var;
11040        &gwas_dsd_var=prxchange('s/(work.|HGI_GWAS|^[^\.]+\.)//',-1,&gwas_dsd_var);
11041        where &gwas_snp_var^="" and &gwas_chr_var=&tgt_chr and
11042        (&gwas_pos_var between &tgt_pos-&dist2snp_or_gene and &tgt_pos+&dist2snp_or_gene);
11043        run;
11044      
11045      	%if %length(&tgt_chr)=0 %then %do;
11046      	   %put No records related to the query SNP &query_rsid_or_genesymbol in the input GWAS &longformat_muts;
11047      		 %abort 255;
11048      	 %end;
11049        %put target chr and position for the snp are &tgt_chr and &tgt_pos;
11050      
11051      
11052      
11053      
11054      
11055      %end;
11056      %else %if (%length(&query_rsid_or_genesymbol)>0) %then %do;
11057        %put We are going to get the genomic position and chromosome for the input query gene &query_rsid_or_genesymbol;
11058      	%QueryGTEx4GeneID(
11059         geneids=&query_rsid_or_genesymbol,
11060         genomeBuild=hg38,
11061         outdsd=gene_info
11062         );
11063        proc sql noprint;
11064        select start - &dist2snp_or_gene,end + &dist2snp_or_gene, prxchange("s/^chr//",-1,chromosome)
11065        into: stpos, : endpos, :chrnum
11066        from gene_info;
11067        data tgt;
11068        set &longformat_muts;
11069        where &gwas_chr_var=&chrnum and
11070                   &gwas_pos_var between &stpos and &endpos;
11071      	 *This will remove libname or HGI_GWAS from the gwas_dsd_var;
11072        &gwas_dsd_var=prxchange('s/(work.|HGI_GWAS|^[^\.]+\.)//',-1,&gwas_dsd_var);
11073        run;
11074      %end;
11075      %else %do;
11076      	%put We will work on the whole input GWAS dataset, which will take longer than that of only focusing on a specific
11076    ! region!;
11077      	 %let SNP_long_dsd=&longformat_muts;
11078      	 *The following will prevent the macro to change the original GWAS dataset;
11079      	  %if %length(&filter4gwas_dsd)>0 %then %do;
11080      	  data tgt;
11081          set &SNP_long_dsd;
11082       	 *This will remove libname or HGI_GWAS from the gwas_dsd_var;
11083        &gwas_dsd_var=prxchange('s/(work.|HGI_GWAS|^[^\.]+\.)//',-1,&gwas_dsd_var);
11084          *filter GWAS dsd;
11085          /*if prxmatch('/DF/',dsd);*/
11086          %unquote(&filter4gwas_dsd);
11087          run;
11088      		%let SNP_long_dsd=tgt;
11089      		%put 	Due to the filtering by GWAS dsd, the input GWAS dataset is temporarily filtered and created a smaller dataset
11089    ! tgt for further analysis;
11090      		%end;
11091      %end;
