3795       Fake_position=1;
3796       Fake_position + _n_ /2 ;/*This part will affect the Xaxis dramatically*/;
3797       /*where &chr_var between 1 and 24;*/
3798       /*where &chr_var >=1;*/
3799       run;
3800       %end;
3801       /*For local EWAS or GWAS;*/
3802       %else %if &nrows le 4000 %then %do;
3803       data manhattan ;
