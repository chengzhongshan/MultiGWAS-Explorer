7640       %put They are sorted by snps and saved into a global macro variable, _chr_colors_;
7641       
7642       %if %totobsindsd(mydata=&dsdout)=0 %then %do;
7643       		%put No hits after filtering with the p value threshold &p_thrsd;
7644       /*    %abort 255;*/
7645       %end;
7646       
7647       %mend;
7648       
7649       
7650       %macro get_top_signal_with_ld(
7651         dsdin=,
7652         snp_var=SNP,
7653         grp_var=CHR,
7654         signal_var=P,
7655         select_smallest_signal=1,
7656         pos_var=BP,
7657         signal_thrshd=1,
7658         ld_pops=EUR,
7659         ld_r2_threshold=0.1,
7660         ld_population_rule=ANY,
7661         query_failure_action=DISTANCE,
7662         fallback_dist_bp=1e6,
7663         max_leads=0,
7664         dsdout=top_ind,
7665         audit_out=top_hit_ld_audit
7666       );
7667       %local _candidate_n _iter _remaining_n _lead_id _lead_snp _lead_chr
7668              _lead_query_snp _lead_bp _lead_signal _lead_is_rs _pop_n _pi _pop _valid_pop_n
7669              _requested_pop_n _response_valid _response_self_n _selected_n
7670              _rule _failure_action _max_leads_num _has_rsid _has_r2 _cache_pop_n
7671              _lead_query_status;
7672       %global TOP_HIT_LD_SELECTION_STATUS TOP_HIT_LD_SELECTED_N TOP_HIT_LD_PRUNED_N;
7673       
7674       %let TOP_HIT_LD_SELECTION_STATUS=RUNNING;
7675       %let TOP_HIT_LD_SELECTED_N=0;
7676       %let TOP_HIT_LD_PRUNED_N=0;
7677       %let _rule=%upcase(%sysfunc(strip(%superq(ld_population_rule))));
7678       %let _failure_action=%upcase(%sysfunc(strip(%superq(query_failure_action))));
7679       %let _requested_pop_n=%sysfunc(countw(%superq(ld_pops),%str( )));
7680       %let _max_leads_num=%sysfunc(inputn(%superq(max_leads),best32.));
7681       %if %sysevalf(%superq(_max_leads_num)=,boolean) %then %let _max_leads_num=0;
7682       
7683       %if &_requested_pop_n=0 %then %do;
7684         %put ERROR: get_top_signal_with_ld requires at least one HaploReg population in ld_pops=.;
7685         %let TOP_HIT_LD_SELECTION_STATUS=INVALID_LD_POPULATIONS;
7686         %return;
7687       %end;
7688       %if &_rule ne ANY and &_rule ne ALL %then %do;
7689         %put ERROR: ld_population_rule must be ANY or ALL, not &ld_population_rule.;
7690         %let TOP_HIT_LD_SELECTION_STATUS=INVALID_POPULATION_RULE;
7691         %return;
7692       %end;
7693       
7694       data _ld_candidates_unsorted;
7695         set &dsdin;
7696         length _ld_snp_key $128 _ld_chr_key $32;
7697         length _ld_signal _ld_bp_num 8;
7698         _ld_snp_key=upcase(strip(vvalue(&snp_var)));
7699         _ld_chr_key=upcase(compress(strip(vvalue(&grp_var)),' '));
7700         _ld_chr_key=prxchange('s/^CHR//i',1,_ld_chr_key);
7701         _ld_bp_num=input(strip(vvalue(&pos_var)),best32.);
7702         _ld_signal=input(strip(vvalue(&signal_var)),best32.);
7703         if missing(_ld_snp_key) or missing(_ld_chr_key) or missing(_ld_bp_num) then delete;
7704         if missing(_ld_signal) or _ld_signal <= 0 or _ld_signal > &signal_thrshd then delete;
7705       run;
7706       
7707       proc sort data=_ld_candidates_unsorted out=_ld_candidates_ranked;
7708       %if &select_smallest_signal=1 %then %do;
7709         by _ld_signal _ld_chr_key _ld_bp_num _ld_snp_key;
7710       %end;
7711       %else %do;
7712         by descending _ld_signal _ld_chr_key _ld_bp_num _ld_snp_key;
7713       %end;
7714       run;
7715       
7716       data _ld_candidates;
7717         if _n_=1 then do;
7718           declare hash _seen();
7719           _seen.defineKey('_ld_snp_key');
7720           _seen.defineDone();
7721         end;
7722         set _ld_candidates_ranked;
7723         if _seen.check()=0 then delete;
7724         _seen.add();
7725         length _ld_pruned_by $128 _ld_prune_population $32
7726                _ld_query_status $24 _ld_independence_method $24;
7727         retain _ld_candidate_id 0;
7728         _ld_candidate_id+1;
7729         _ld_selected=0;
7730         _ld_pruned=0;
7731         _ld_lead_rank=.;
7732         _ld_pruned_lead_rank=.;
7733         _ld_prune_r2=.;
7734       run;
7735       
7736       proc sql noprint;
7737         select count(*) into :_candidate_n trimmed from _ld_candidates;
7738       quit;
7739       %if %sysevalf(%superq(_candidate_n)=,boolean) %then %let _candidate_n=0;
7740       
7741       %if &_candidate_n=0 %then %do;
7742         data &dsdout; set _ld_candidates; run;
7743         data &audit_out;
7744           length candidate_snp lead_snp $128 selection_action $24;
7745           stop;
7746         run;
7747         %let TOP_HIT_LD_SELECTION_STATUS=NO_CANDIDATES;
7748         %goto _ld_cleanup;
7749       %end;
7750       
7751       %do _iter=1 %to &_candidate_n;
7752         %let _remaining_n=0;
7753         %let _lead_id=;
7754         %let _lead_snp=;
7755         %let _lead_query_snp=;
7756         %let _lead_chr=;
7757         %let _lead_bp=;
7758         %let _lead_signal=;
7759         proc sql noprint;
7760           select count(*) into :_remaining_n trimmed
7761           from _ld_candidates
7762           where _ld_selected=0 and _ld_pruned=0;
7763       
7764           select _ld_candidate_id, _ld_snp_key, _ld_chr_key, _ld_bp_num, _ld_signal
7765             into :_lead_id trimmed, :_lead_snp trimmed, :_lead_chr trimmed,
7766                  :_lead_bp trimmed, :_lead_signal trimmed
7767           from _ld_candidates
7768           where _ld_selected=0 and _ld_pruned=0
7769           having _ld_candidate_id=min(_ld_candidate_id);
7770         quit;
7771       
7772         %if %sysevalf(%superq(_remaining_n)=,boolean) %then %let _remaining_n=0;
7773         %if &_remaining_n=0 or %sysevalf(%superq(_lead_id)=,boolean) %then %goto _ld_finished;
7774       
7775         proc sql noprint;
7776           select count(*) into :_selected_n trimmed
7777           from _ld_candidates where _ld_selected=1;
7778         quit;
7779         %if %sysevalf(%superq(_selected_n)=,boolean) %then %let _selected_n=0;
7780         %if %sysevalf(&_max_leads_num > 0) and %sysevalf(&_selected_n >= &_max_leads_num) %then %goto _ld_finished;
7781       
7782         proc sql;
7783           update _ld_candidates
7784           set _ld_selected=1,
7785               _ld_lead_rank=&_selected_n+1
7786           where _ld_candidate_id=&_lead_id;
7787         quit;
7788       
7789         data _null_;
7790           call symputx('_lead_is_rs',prxmatch('/^RS[0-9]+$/i',symget('_lead_snp'))>0,'L');
7791         run;
7792       
7793         data _ld_lead_edges;
7794           length query_snp proxy_snp $128 ld_population $16 proxy_r2 8;
7795           stop;
7796         run;
7797         %let _valid_pop_n=0;
7798         %let _cache_pop_n=0;
7799       
7800         %if &_lead_is_rs %then %do;
7801           %let _lead_query_snp=%sysfunc(lowcase(%superq(_lead_snp)));
7802           %let _pop_n=%sysfunc(countw(%superq(ld_pops),%str( )));
7803           %do _pi=1 %to &_pop_n;
7804             %let _pop=%scan(%superq(ld_pops),&_pi,%str( ));
7805             %QueryLD_SNPs_at_Haploreg4(
7806               snp=&_lead_query_snp,
7807               LDpop=&_pop,
7808               ldThresh=&ld_r2_threshold,
7809               outdsd=_ld_raw_response
7810             );
7811       
7812             %let _has_rsid=0;
7813             %let _has_r2=0;
7814             %if %sysfunc(exist(work._ld_raw_response)) %then %do;
7815               proc sql noprint;
7816                 select sum(upcase(name)='RSID'), sum(upcase(name)='R2')
7817                   into :_has_rsid trimmed, :_has_r2 trimmed
7818                 from dictionary.columns
7819                 where libname='WORK' and memname='_LD_RAW_RESPONSE';
7820               quit;
7821             %end;
7822             %if %sysevalf(%superq(_has_rsid)=,boolean) %then %let _has_rsid=0;
7823             %if %sysevalf(%superq(_has_r2)=,boolean) %then %let _has_r2=0;
7824       
7825             %if &_has_rsid>0 and &_has_r2>0 %then %do;
7826               data _ld_response_norm;
7827                 length query_snp proxy_snp $128 ld_population $16 proxy_r2 8;
7828                 set _ld_raw_response;
7829                 query_snp="&_lead_snp";
7830                 proxy_snp=upcase(strip(vvaluex('rsID')));
7831                 ld_population="%upcase(&_pop)";
7832                 proxy_r2=input(strip(vvaluex('r2')),best32.);
7833                 if not missing(proxy_snp) and not missing(proxy_r2);
7834                 keep query_snp proxy_snp ld_population proxy_r2;
7835               run;
7836               proc sql noprint;
7837                 select count(*) into :_response_self_n trimmed
7838                 from _ld_response_norm
7839                 where proxy_snp="&_lead_snp";
7840               quit;
7841               %if %sysevalf(%superq(_response_self_n)=,boolean) %then %let _response_self_n=0;
7842               %if &_response_self_n>0 %then %do;
7843                 %let _valid_pop_n=%eval(&_valid_pop_n+1);
7844                 %if %upcase(%superq(HAPLOREG_LD_QUERY_SOURCE))=LOCAL_CACHE %then
7845                   %let _cache_pop_n=%eval(&_cache_pop_n+1);
7846                 proc append base=_ld_lead_edges data=_ld_response_norm force; run;
7847               %end;
7848             %end;
7849             proc datasets library=work nolist;
7850               delete _ld_raw_response _ld_response_norm;
7851             quit;
7852           %end;
7853         %end;
7854       
7855         %if &_valid_pop_n>0 %then %do;
7856           %if &_valid_pop_n=&_requested_pop_n %then %let _lead_query_status=OK;
7857           %else %let _lead_query_status=PARTIAL;
7858           %if &_cache_pop_n=&_valid_pop_n %then %let _lead_query_status=&_lead_query_status._LOCAL_CACHE;
7859           %else %if &_cache_pop_n>0 %then %let _lead_query_status=&_lead_query_status._MIXED;
7860       
7861           proc sql;
7862             create table _ld_prune_keys as
7863             select proxy_snp as _ld_snp_key length=128,
7864                    max(proxy_r2) as _edge_r2,
7865                    case
7866                      when count(distinct ld_population)>1 then 'MULTI'
7867                      else min(ld_population)
7868                    end as _edge_population length=32
7869             from _ld_lead_edges
7870             where proxy_snp ne "&_lead_snp"
7871               and proxy_r2 >= &ld_r2_threshold
7872             group by proxy_snp
7873             %if &_rule=ALL %then %do;
7874             having count(distinct ld_population) >= &_requested_pop_n
7875             %end;
7876             ;
7877           quit;
7878       
7879           proc sort data=_ld_candidates; by _ld_snp_key; run;
7880           proc sort data=_ld_prune_keys; by _ld_snp_key; run;
7881           data _ld_candidates;
7882             merge _ld_candidates(in=_candidate) _ld_prune_keys;
7883             by _ld_snp_key;
7884             if _candidate;
7885             if _ld_selected=0 and _ld_pruned=0 and not missing(_edge_r2) then do;
7886               _ld_pruned=1;
7887               _ld_pruned_by="&_lead_snp";
7888               _ld_pruned_lead_rank=&_selected_n+1;
7889               _ld_prune_r2=_edge_r2;
7890               _ld_prune_population=_edge_population;
7891               _ld_independence_method='LD';
7892             end;
7893             drop _edge_r2 _edge_population;
7894           run;
7895           proc sort data=_ld_candidates; by _ld_candidate_id; run;
7896       
7897           proc sql;
7898             update _ld_candidates
7899             set _ld_query_status="&_lead_query_status",
7900                 _ld_independence_method='LD'
7901             where _ld_candidate_id=&_lead_id;
7902           quit;
7903         %end;
7904         %else %do;
7905           %if &_failure_action=DISTANCE and %sysevalf(&fallback_dist_bp > 0) %then %do;
7906             data _ld_candidates;
7907               set _ld_candidates;
7908               if _ld_selected=0 and _ld_pruned=0
7909                  and _ld_chr_key="&_lead_chr"
7910                  and _ld_bp_num >= (&_lead_bp-0.5*&fallback_dist_bp)
7911                  and _ld_bp_num <= (&_lead_bp+0.5*&fallback_dist_bp) then do;
7912                 _ld_pruned=1;
7913                 _ld_pruned_by="&_lead_snp";
7914                 _ld_pruned_lead_rank=&_selected_n+1;
7915                 _ld_prune_population='NA';
7916                 _ld_independence_method='DISTANCE_FALLBACK';
7917               end;
7918               if _ld_candidate_id=&_lead_id then do;
7919                 _ld_query_status='NO_LD_RESPONSE';
7920                 _ld_independence_method='DISTANCE_FALLBACK';
7921               end;
7922             run;
7923           %end;
7924           %else %do;
7925             proc sql;
7926               update _ld_candidates
7927               set _ld_query_status='NO_LD_RESPONSE',
7928                   _ld_independence_method='UNRESOLVED_NO_LD'
7929               where _ld_candidate_id=&_lead_id;
7930             quit;
7931           %end;
7932         %end;
7933       
7934         proc datasets library=work nolist;
7935           delete _ld_lead_edges _ld_prune_keys;
7936         quit;
7937       %end;
7938       
7939       %_ld_finished:
7940       data &dsdout;
7941         set _ld_candidates;
7942         where _ld_selected=1;
7943         length INDEPENDENCE_METHOD $24 LD_POPULATIONS $64 LD_POPULATION_RULE $8
7944                LD_QUERY_STATUS $24;
7945         LD_LEAD_RANK=_ld_lead_rank;
7946         INDEPENDENCE_METHOD=_ld_independence_method;
7947         LD_R2_THRESHOLD=&ld_r2_threshold;
7948         LD_POPULATIONS="%upcase(&ld_pops)";
7949         LD_POPULATION_RULE="&_rule";
7950         LD_QUERY_STATUS=_ld_query_status;
7951         LD_FALLBACK_BP=&fallback_dist_bp;
7952         drop _ld_:;
7953       run;
7954       proc sort data=&dsdout; by LD_LEAD_RANK; run;
7955       
7956       data &audit_out;
7957         set _ld_candidates;
7958         length candidate_snp lead_snp $128 selection_action $24
7959                independence_method $24 query_status $24 ld_population $32;
7960         candidate_rank=_ld_candidate_id;
7961         candidate_snp=_ld_snp_key;
7962         chr=_ld_chr_key;
7963         bp=_ld_bp_num;
7964         signal=_ld_signal;
7965         if _ld_selected then do;
7966           selection_action='SELECTED_LEAD';
7967           lead_rank=_ld_lead_rank;
7968           lead_snp=_ld_snp_key;
7969         end;
7970         else if _ld_pruned then do;
7971           selection_action=ifc(_ld_independence_method='LD','PRUNED_LD','PRUNED_DISTANCE_FALLBACK');
7972           lead_rank=_ld_pruned_lead_rank;
7973           lead_snp=_ld_pruned_by;
7974         end;
7975         else selection_action='NOT_REACHED';
7976         prune_r2=_ld_prune_r2;
7977         ld_population=_ld_prune_population;
7978         query_status=_ld_query_status;
7979         independence_method=_ld_independence_method;
7980         keep candidate_rank candidate_snp chr bp signal selection_action lead_rank
7981              lead_snp prune_r2 ld_population query_status independence_method;
7982       run;
7983       proc sort data=&audit_out; by candidate_rank; run;
7984       
7985       proc sql noprint;
7986         select count(*) into :TOP_HIT_LD_SELECTED_N trimmed
7987         from _ld_candidates where _ld_selected=1;
7988         select count(*) into :TOP_HIT_LD_PRUNED_N trimmed
7989         from _ld_candidates where _ld_pruned=1;
7990       quit;
7991       %let TOP_HIT_LD_SELECTION_STATUS=COMPLETE;
7992       %put NOTE: LD top-hit selection complete: candidates=&_candidate_n selected=&TOP_HIT_LD_SELECTED_N
7992     ! pruned=&TOP_HIT_LD_PRUNED_N r2=&ld_r2_threshold populations=&ld_pops rule=&_rule.;
7993       
7994       %_ld_cleanup:
7995       proc datasets library=work nolist;
7996         delete _ld_candidates_unsorted _ld_candidates_ranked _ld_candidates
7997                _ld_lead_edges _ld_prune_keys _ld_raw_response _ld_response_norm;
7998       quit;
7999       %mend;
8000       
8001       
8002       %macro get_top_signal_within_dist(
8003       dsdin=,
8004       grp_var=,
8005       signal_var=,
8006       select_smallest_signal=1,
8007       pos_var=,
8008       pos_dist_thrshd=, /*Total exclusion span in bp; the macro keeps one lead signal within +/- 0.5*pos_dist_thrshd*/
8009       dsdout=,
8010       signal_thrshd=1 /*filter the input dsdin by association P, i.e, &signal_var <= &signal_thrshd*/
8011       );
8012       
8013       /*
8014       Greedy in-group top-signal selection with a distance exclusion window.
8015       
8016       Compared with the older self-join / SQL approach, this version is much faster
8017       when many loci pass the threshold because it:
8018       
8019       1. filters candidates first
8020       2. sorts once by group and signal strength
8021       3. keeps selected intervals for the current group only
8022       4. greedily accepts the next best non-overlapping signal
8023       
8024       The exclusion window matches the earlier behavior:
8025         dis_st = pos - pos_dist_thrshd * 0.5
8026         dis_end = pos + pos_dist_thrshd * 0.5
8027       
8028       So a value such as 1e6 means "keep one lead signal per 1 Mb span"
8029       rather than "use a 1 Mb half-window on each side".
8030       */
8031       
8032       data _top_signal_candidates;
8033       length Key $200.;
8034       set &dsdin;
8035       where not missing(&signal_var) and &signal_var > 0 and &signal_var <= &signal_thrshd;
8036       dis_st=&pos_var-&pos_dist_thrshd*0.5;
8037       dis_end=&pos_var+&pos_dist_thrshd*0.5;
8038       Key=catx(':',&grp_var,&pos_var);
8039       run;
8040       
8041       %put Warning: duplicate records by Key and &signal_var will be kept for only one record.;
8042       proc sort data=_top_signal_candidates dupout=_dup_records_ out=_top_signal_candidates nodupkeys;
8043       %if &select_smallest_signal=1 %then %do;
8044         by &grp_var &pos_var &signal_var;
8045       %end;
8046       %else %do;
8047         by &grp_var &pos_var descending &signal_var;
8048       %end;
8049       run;
8050       %put Warning: duplicate records by Key and &signal_var are saved into the data set _dup_records_.;
8051       
8052       proc sort data=_top_signal_candidates;
8053       %if &select_smallest_signal=1 %then %do;
8054         by &grp_var &signal_var &pos_var;
8055       %end;
8056       %else %do;
8057         by &grp_var descending &signal_var &pos_var;
8058       %end;
8059       run;
8060       
8061       data &dsdout;
8062         array _sel_dis_st[50000] _temporary_;
8063         array _sel_dis_end[50000] _temporary_;
8064         retain _sel_n 0;
8065         length _keep 8 _i 8;
8066       
8067         set _top_signal_candidates;
8068         by &grp_var;
8069       
8070         if first.&grp_var then _sel_n = 0;
8071       
8072         _keep = 1;
8073         do _i = 1 to _sel_n;
8074           if (&pos_var >= _sel_dis_st[_i]) and (&pos_var <= _sel_dis_end[_i]) then do;
8075             _keep = 0;
8076             leave;
8077           end;
8078         end;
8079       
8080         if _keep then do;
8081           output;
8082           _sel_n + 1;
8083           if _sel_n > dim(_sel_dis_st) then do;
8084             put "ERROR: get_top_signal_within_dist exceeded the temporary selection buffer size of 50000.";
8085             stop;
8086           end;
8087           _sel_dis_st[_sel_n] = dis_st;
8088           _sel_dis_end[_sel_n] = dis_end;
8089         end;
8090       
8091         drop _sel_n _keep _i;
8092       run;
8093       
8094       %if &select_smallest_signal=1 %then %do;
8095       proc sort data=&dsdout;
8096         by &grp_var &signal_var &pos_var;
8097       run;
8098       %end;
8099       %else %do;
8100       proc sort data=&dsdout;
8101         by &grp_var descending &signal_var &pos_var;
8102       run;
8103       %end;
8104       
8105       proc datasets library=work nolist;
8106         delete _top_signal_candidates;
8107       quit;
8108       
8109       %mend;
8110       
8111       
8112       %macro iscolallmissing(dsd,colvar,outmacrovar);
8113       %global &outmacrovar;
8114       proc sql noprint;
8115       select nmiss(&colvar)/count(&colvar)
8116       into: allmissing
8117       from &dsd;
8118       quit;
8119       
8120       %if %sysevalf(&allmissing=1,boolean) %then %do;
8121          %let &outmacrovar=1;
8122       %end;
8123       %else %do;
8124          %let &outmacrovar=0;
8125       %end;
8126       
8127       *This rescues the situation when all data of the column &colvar are missing;
8128       %if &allmissing=. %then %do;
8129          %let &outmacrovar=1;
8130        %end;
8131       
8132       %mend;
8133       
8134       
8135       %macro make_fake_axis4NegPosVal_by_grps(/*The macro will scale up or down positive or negative values and generate
8136       yaxis macro labels with the original postive values; To keep using the original positive value but also to scale the
8136     ! ratio
8137       between these positve and negative values, the macro variable NotChangePosVals is set to 1.
8138       The other global macro variable called fake_refline_values, can be used by other procedures to
8139       draw reference lines to separate each group into the final figure if required!
8140       Note: if NotChangePosVals=1, the final negative tick values are scaled values and the macro is updated
8141       to adjust the axis labels for negative values; since the negative values
8142       are used to draw gene track at the bottom, they will be replaced as " " in the final figure
8143       Note: the output put dsdout contain modified values based on the input scale;
8144       However, the macro variable yaxis_macro_labels is updated to use the original values
8145       to label axis, although the negative positive values may use different steps in the final axis labels!
8146       */
8147       dsdin,
8148       axis_var,/*Both negative and positive values of axis var are allowed to use this macro,
8149                  but in each group, only positve (>0) or negative (<0) values are allowed,
8150                  and all 0 axis var values will be excluded from the dsdin,
8151                  the above of which are the limitations of the macro!*/
8152       axis_grp,
8153       new_fake_axis_var,
8154       dsdout,
8155       yaxis_macro_labels=ylabelsmacro_var,
8156       fc2scale_pos_vals=1, /*Use this fc to enlarge the proportion of positive values in the plots
8157                      It seems that fc=2 is the best for the final ticks of different tracks;*/
8158       NotChangePosVals=1, /*For making manhattan plot, it is better to fix the positive y values,
8159       as scale down the positive values will lead to the y tick labels containing decimals, and
8160       the SAS macro to making local Manhattan plot is set in default to only show integer ticks;
8161       When fc2scale_pos_vals is < 1, the original positive values will be
8162       scaled down to generate fake values; sometimes it is necessary to keep the original values
8163       but also achieve the goal of scale down these positve values. The workaround method is
8164       to scale up the negative value with the fold change 1/&fcscale_pos_vals;
8165       Reason for keep the positive values but scale up the negative values:
8166       The coveat for squeezing the positive values by amplifying the value for negative values is that;
8167       the final figure ticks for the positive values will be with very few ticks in the y-axis;
8168       To rescue this, it is better to multiple both negative and positive values by the same scale value &yscale again;*/
8169       mod_num2keep= /*For the final yaxis_macro_labels, default value for the current var  is empty for not filtering these
8169     ! elements by mod; when values,
8170       such as 2 or 3 are provided, only keep numbers that fulfil the mod(element,num)=0;
8171       Note that this will only be applied on numbers that are positve!*/
8172       );
8173       
8174       *This para is important for making correct fake axis;
8175       %let axis_step=1;
8176       ************************************************************************;
8177       *Get records with negative values in &dsdin;
8178       data &dsdin._neg;
8179       set &dsdin (where=(&axis_var<0));
8180       *temporarily make all negative axis_var as positve ones;
8181       &axis_var=&axis_var*-1;
8182       %if &NotChangePosVals=1 %then %do;
8183       &axis_var=&axis_var/&fc2scale_pos_vals;
8184       %end;
8185       run;
8186       
8187       %if %totobsindsd(&dsdin._neg)=0 %then %do;
8188         %put Warning: there are NO negative values in the dsd &dsdin._neg;
8189         %abort 255;
8190       %end;
8191       
8192       *Make fake_axis for the dsd &dsdin._pos;
8193       %add_fake_pos_by_grp4nonnegvars(
8194       dsdin=&dsdin._neg,
8195       axis_var=&axis_var,
8196       axis_grp=&axis_grp,
8197       new_fake_axis_var=&new_fake_axis_var,
8198       dsdout=&dsdin._neg_fk,
8199       axis_step=&axis_step
8200       );
8201       /*
8202       data &dsdin._neg_fk;
8203       set &dsdin._neg_fk;
8204       %if &NotChangePosVals=1 %then %do;
8205       %end;
8206       %else %do;
8207       &new_fake_axis_var=&new_fake_axis_var*&fc2scale_pos_vals;
8208       %end;
8209       run;
8210       */
8211       
8212       *change back all newly created vars into negative ones;
8213       *including mid_val, tpos, &axis_var, fake&axis_grp, and grp_n;
8214       data &dsdin._neg_fk;set &dsdin._neg_fk;
8215       mid_val=mid_val*-1;grp_n=-1*grp_n;
8216       tpos=tpos*-1;&axis_var=&axis_var*-1;
8217       &new_fake_axis_var=&new_fake_axis_var*-1;
8218       n=n*-1;grpnum=-1*grpnum;
8219       run;
8220       
8221       ************************************************************************;
8222       *Get records with postive values in &dsdin;
8223       data &dsdin._pos;
8224       *Here would be a potential bug if 0 is the top value in a group with all negative values;
8225       *However, for gene track and scatterplot, this is unlikely happen, as the scatterplot;
8226       *usually has all positive values, including 0;
8227       set &dsdin (where=(&axis_var>=0));
8228       *set &dsdin (where=(&axis_var>0));
8229       *Scale position value and make it larger by fold change;
8230       %if &NotChangePosVals=0 %then %do;
8231       &axis_var=&axis_var*&fc2scale_pos_vals;
8232       %end;
8233       run;
8234       
8235       %if %totobsindsd(&dsdin._pos)=0 %then %do;
8236         %put There are NO positive values in the dsd &dsdin._pos;
8237         %abort 255;
8238       %end;
8239       
8240       *Make fake_axis for the dsd &dsdin._pos;
8241       %add_fake_pos_by_grp4nonnegvars(
8242       dsdin=&dsdin._pos,
8243       axis_var=&axis_var,
8244       axis_grp=&axis_grp,
8245       new_fake_axis_var=&new_fake_axis_var,
8246       dsdout=&dsdin._pos_fk,
8247       axis_step=&axis_step
8248       );
8249       
8250       ******************Combine fake negative and positve dsds****************;
8251       data &dsdout;
8252       *Note: put the neg dsd first;
8253       set &dsdin._neg_fk &dsdin._pos_fk;
8254       grp_end_tag=tag;
8255       run;
8256       
8257       ************************************************************************;
8258       *Generate real y axis labels;
8259       %global &yaxis_macro_labels fake_max_y fake_min_y fake_refline_values;
8260       
8261       *focus on negative axis values first;
8262       data &dsdin._neg_fk;
8263       set &dsdin._neg_fk;
8264       max_neg=0;
8265       run;
8266       proc sql noprint;
8267       select floor(&axis_var),max_neg
8268       into: min_neg_y4grps separated by " ",
8269           : max_neg_y4grps separated by " "
8270       from &dsdin._neg_fk
8271       where tag=1
8272       order by n;
8273       proc sql noprint;
8274       select tpos into: fake_refline_values_neg separated by " "
8275       from &dsdin._neg_fk
8276       where tag=1
8277       order by n;
8278       *All max_neg_fale_axis_var will be 0;
8279       *Need to remove the 1st num in fake_refline_values;
8280       %let fake_refline_values_neg=%sysfunc(prxchange(s/^[\-\d\.]+\s*//,-1,&fake_refline_values_neg));
8281       
8282       *focus on positive axis values now;
8283       data &dsdin._pos_fk;
8284       set &dsdin._pos_fk;
8285       min_pos=0;
8286       run;
8287       proc sql noprint;
8288       select ceil(&axis_var),tpos,min_pos
8289       into: max_pos_y4grps separated by " ",
8290           : fake_refline_values_pos separated by " ",
8291           : min_pos_y4grps separated by " "
8292       from &dsdin._pos_fk
8293       where tag=1
8294       order by n;
8295       *All min_pos_false_axis_var will be 0;
8296       *Need to remove the last num in fake_refline_values;
8297       %let fake_refline_values_pos=%sysfunc(prxchange(s/ [\d\.]+$//,-1,&fake_refline_values_pos));
8298       
8299       %let fake_refline_values=&fake_refline_values_neg &fake_refline_values_pos;
8300       %let max_y4grps=&max_neg_y4grps &max_pos_y4grps;
8301       %let min_y4grps=&min_neg_y4grps &min_pos_y4grps;
8302       
8303       %put max_y4grps: &max_y4grps;
8304       %put min_y4grps: &min_y4grps;
8305       
8306       *Also get the min_val when ll=1;
8307       *Get the macro var fake_max_y value;
8308       data _null_;
8309       set &dsdout end=eof;
8310       if eof then call symputx('fake_max_y',ceil(&new_fake_axis_var));
8311       run;
8312       
8313       %let fake_min_y=%scan(&min_y4grps,1,%str( ));
8314       %let fake_min_y=%sysfunc(floor(&fake_min_y));
8315       
8316       %let nums=;
8317       *The macro &axis_step will affect the following codes;
8318       *The default step is equal to 1, so there is no adjustment;
8319       *If the step=2, then all _min_y and _end_ need to be minused by 1;
8320       
8321       %do xi=1 %to %sysfunc(countw(&max_y4grps));
8322         *use %str( ) to prevent from lossing of negative nums;
8323       
8324       	  	%let _min_y=%scan(&min_y4grps,&xi,%str( ));
8325                       %if %sysevalf(&_min_y < 0) %then %do;
8326                         %let _end_=0;
8327                       %end;
8328                       %else %do;
8329                         %let _min_y=%sysevalf(&_min_y+&axis_step,floor);
8330                         %let _end_=%sysevalf(%scan(&max_y4grps,&xi,%str( ))+&axis_step,ceil);
8331                       %end;
8332       
8333       
8334                      /*
8335       		%if %eval(&_min_y > -1) and %eval(&_min_y < 0)  %then %do;
8336                         *for negative axis, there is no offset of 1;
8337                         %let _min_y=%eval(&_min_y-1);
8338                         %let _end_=%eval(&_end_-1);
8339       		%end;
8340       	      */
8341       		
8342       		%put _min_y is &_min_y;
8343       			
8344       		%if %eval(&xi=1) %then %do;
8345              %if &NotChangePosVals=0 %then %do;
8346                         %nums_in_range_adj_scale(st=&_min_y,end=&_end_,by=1,outmacrovar=nums&xi,
8347                          filter4scaledvals=%str(>0),scale=&fc2scale_pos_vals,quote=1,mod_num2keep=&mod_num2keep);
8348               %end;
8349              %else  %do;/*Scale back the nums when NotChangePosVals is true;*/
8350                         %nums_in_range_adj_scale(st=&_min_y,end=&_end_,by=1,outmacrovar=nums&xi,
8351                          filter4scaledvals=%str(>0),scale=1,quote=1,mod_num2keep=&mod_num2keep);
8352                         *Need to scale the negative values back to its original values for the axis ticks;
8353                         %if %sysfunc(prxmatch(/\-/,&&nums&xi)) %then %let
8353     ! nums&xi=%scale_nums_in_list(list=&&nums&xi,factor=%sysevalf(&fc2scale_pos_vals),contain_double_quote=1);
8354                         *Note: use . to represent single double quote, as SAS will crash if using single quote in prxchange;
8355                         %let nums&xi=%sysfunc(prxchange(s/[^\-][\-\d]+\.\d+./" "/,-1,&&nums&xi));
8356                         %put nums&xi are: &&nums&xi;
8357       
8358              %end;
8359       		 %let nums=&&nums&xi;
8360            %put &nums;
8361            %let nums=%sysfunc(prxchange(s/\.\d+//,-1,&nums));
8362            %put &nums;
8363       		 *Need to replace the last value as empty;
8364            *Note: the rgx will remove the last tick label that is overlapped with reference line;
8365            *Let the rgx not match -\d+, such as -1, -2, ..., and other negative numbers;
8366            *Otherwise, this bug would lead to unmatched quotes in the macro;
8367             %let nums=%sysfunc(prxchange(s/[^\-](\d+).$/" "/,-1,&nums));
8368       /*      %let nums=%trim(%left(&nums));*/
8369       		%end;
8370       		
8371           %else %do;
8372              %if &NotChangePosVals=0 %then %do;
8373       		              %nums_in_range_adj_scale(st=&_min_y,end=&_end_,by=1,outmacrovar=nums&xi,
8374                          filter4scaledvals=%str(>0),scale=&fc2scale_pos_vals,quote=1,mod_num2keep=&mod_num2keep);
8375              %end;
8376              %else %do;/*Scale back the negative nums when NotChangePosVals is true;*/
8377       		              %nums_in_range_adj_scale(st=&_min_y,end=&_end_,by=1,outmacrovar=nums&xi,
8378                          filter4scaledvals=%str(>0),scale=1,quote=1,mod_num2keep=&mod_num2keep);
8379              %end;
8380       
8381       		 *Need to replace the last value as empty;
8382       
8383            %let nums&xi=%sysfunc(prxchange(s/\.0//,-1,&&nums&xi));
8384            %put Unmodified num&xi are:;
8385            %put &&nums&xi;
8386            *Note: the rgx will remove the last element as empty;
8387            *Note: the rgx will remove the last tick label that is overlapped with reference line;
8388       		 %let new_nums=%qsysfunc(prxchange(s/[^\-](\d+).$/" "/,-1,&&nums&xi));
8389       		 %put modified new_nums are:;
8390            %put &new_nums;
8391       		 %let nums=&nums &new_nums;
8392            *If the value of &nums is too long to be truncated to contain an unmatched quote;
8393       
8394       		%end;
8395       		
8396          %end;
8397       
8398          *Need to remove fake_refline_values in the list of yaxis_macro_labels;
8399          %do ni=1 %to %ntokens(&fake_refline_values);
8400                  %if &ni=1 %then %do;
8401                      %let _refnum_=%scan(&fake_refline_values,1,%str( ));
8402                  %end;
8403                  %else %do;
8404                      *Note: the fake refline values need to be substracted with the fake refline value before it;
8405       						   %let _refnum_=%sysevalf(%scan(&fake_refline_values,&ni,%str( )) - %scan(&fake_refline_values,&ni-1,%str( )));
8406                   %end;
8407                   %let nums=%sysfunc(prxchange(s/[^\-]&_refnum_\D/" "/,1,&nums));
8408           %end;
8409            *Also need to remove the last fake refline value as the top value;
8410            *Note: the rgx will remove the last tick label that is overlapped with reference line;
8411            %let nums=%sysfunc(prxchange(s/[^\-](\d+).$/" "/,1,&nums));
8412       
8413       	%let &yaxis_macro_labels=&nums;
8414       	%put generated the global macro var &&yaxis_macro_labels for labeling y axis, which are: &&&yaxis_macro_labels;
8415       		%put generated the global macro var fake_min_y, the value of which are all 0s;
8416       	 %put generated the global macro var fake_max_y, the value of which is &fake_max_y;
8417       		%put generated the global macro var fake_refline_values, the value of which can be used to make reflines to separate
8417     ! grps:;
8418       		%put &fake_refline_values;
8419       /*    %abort 255;*/
8420       
8421       %mend;
