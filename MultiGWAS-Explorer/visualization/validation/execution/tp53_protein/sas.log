11097       &gwas_dsd_var=prxchange('s/(work.|HGI_GWAS|^[^\.]+\.)//',-1,&gwas_dsd_var);
11098      %if %length(&filter4gwas_dsd)>0 %then %do;
11099       *filter GWAS dsd;
