9694       %macro Long_format_muts2ProteinTrack(
9695       /*See the demo code at the end of this macro for how to generate fake gtf and inptu data set based on ncbi gpff file;
9696       Note: several important parameters can adjust the label on the top:
9697       yoffset4max_drawmarkersontop and Yoffset4textlabels can be used to enlarge the top regions covering the labels;
9698       pct2adj4dencluster is able to increase the distance among these labels.
9699       text_rotate_angle and  pct2adj4dencluster control the rotation of these labels.
9700       */
9701       longformat_muts=,/*Long format HGI GWAS with association signals in a union by same columns and different gwas dsd names;
9702       Note: the input GWAS data should be in hg38 build if querying by genesymbol!*/
9703       gwas_dsd_var=gwas,/*The gwas variable in the longformat_muts*/
9704       filter4gwas_dsd=,/*Add full sas conditional filter for filtering snps by GWAS dsd, such as the following without adding ;
9704     ! :
