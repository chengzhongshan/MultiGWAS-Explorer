11337      %macro adj_grpnum4close_gene_bed_regs(
11338      /*Note: the macro can only separate most of the bed regions
11339      for better labeling bed regions, and usually the 1st track will be
11340      good, with genes included in other tracks may not be well separated!*/
11341      gene_bed_dsd=a,
11342      st_var=st,
11343      end_var=end,
11344      reg_type=type,/*if empty, it will use the longest region as gene and
11345                     other shorter region from the same group as exons*/
11346      focused_reg_type4grouping=gene,
11347      gene_grp=grp,
11348      gene_dist_thrhd=0.1,/*(1) give 0 or negative value to incluce all genes into a single group;
11349                            (2) given value in bp > 1 to separate genes by absolute distance in bp;
11350                            (3) if given value ranging from 0 to 1, it will use the pct of the whole region
11351                                to separate genes into different groups!
11352                                This option would be most useful to enable enough space for adding text on each
11353                                gene, as it will consider the length of gene as well as the distance between genes*/
11354      dsdout=_gene_regions_,/*dsdout can be the same as gene_bed_dsd*/
11355      outnumgrp=numgrp /*the var name for outnumgrp can not be same as other vars in gene_bed_dsd*/
11356      );
11357      %local _book_gdc_sql;
11358      %let _book_gdc_sql=_bg%substr(%sysfunc(compress(%sysfunc(uuidgen()),-)),1,24);
11359      
11360      %if "&gene_bed_dsd"="&dsdout" %then %do;
11361          %put Your input dsd name is the same as the output dsd name;
11362          %put we will temporarily change the &dsdout as: &dsdout._;
11363          %let old_dsdout=&dsdout;
11364          %let dsdout=&dsdout._;
11365      %end;
11366      %else %do;
11367          %let old_dsdout=&dsdout;
11368      %end;
11369      
11370      %if &reg_type ne %then %do;
11371        proc sort
11372        data=&gene_bed_dsd(where=(&reg_type="&focused_reg_type4grouping"))
11373        out=&dsdout
11374        nodupkeys;
11375        by &st_var &end_var &gene_grp;
11376        run;
11377      %end;
11378      %else %do;
11379       data &dsdout;
11380       set &gene_bed_dsd;
11381       dist=&end_var - &st_var;
11382       run;
11383       proc sql;
11384       create table work.&_book_gdc_sql(drop=dist) as
11385       select &st_var,&end_var, &gene_grp, dist
11386       from &dsdout
11387       group by &gene_grp
11388       having dist=max(dist);
11389      quit;
11390      data &dsdout;set work.&_book_gdc_sql;run;
11391      proc datasets library=work nolist;delete &_book_gdc_sql;quit;
11392      proc sql;
11393      %end;
11394      
11395      *It is important to sort the start position again!;
11396      *otherwise, the _grp_ number would not be the best!;
11397      proc sort data=&dsdout;by &st_var;run;
11398      
11399      proc sql noprint;
11400      select left(put(count(&gene_grp),3.)) into: ngenes
11401      from &dsdout;
11402      run;
11403      
11404      %if &gene_dist_thrhd > 0 %then %do;
11405      
11406       %if &gene_dist_thrhd<1 %then %do;
11407           proc sql noprint;
11408           select min(st),max(end) into: st_min,:end_max
11409           from &dsdout;
11410           %put Now we will use the relative distance based on the percent &gene_dist_thrhd of whole region;
11411           %put from &st_min to &end_max to separate genes into different groups!;
11412           %let gene_dist_thrhd=%sysevalf((&end_max-&st_min)*&gene_dist_thrhd);
11413       %end;
11414      /*  data &dsdout(drop=_lag_end:);*/
11415       data &dsdout;
11416        retain _grp_ 1;
11417        set &dsdout;
11418        _lag_end_1=(lag(end) ^=.) and (abs(st-lag(end))<&gene_dist_thrhd or st-lag(end)<0);
11419        _lag_end_1= _lag_end_1 >0 or ((lag(st) ^=.) and (abs(st-lag(st))<&gene_dist_thrhd or st-lag(st)<0))>0;
11420        /*
11421        lag_end1=lag(end);
11422        */
11423        %do ni=2 %to &ngenes;
11424          /*
11425          lag_end2=lag2(end);
11426          lag_end3=lag3(end);
11427          */
11428          _lag_end_&ni=(lag&ni.(end) ^=.) and ((abs(st-lag&ni.(end))<&gene_dist_thrhd) or st-lag&ni.(end)<0);
11429          _lag_end_&ni=_lag_end_&ni>0 or ((lag&ni.(st) ^=.) and (abs(st-lag&ni.(st))<&gene_dist_thrhd or st-lag&ni.(st)<0))>0;
11430        %end;
11431        %if &ngenes>1 %then %do;
11432         *Add one to make it start from 1 for the 1st group;
11433          _grp_=sum(of _lag_end_1-_lag_end_&ngenes)+1;
11434        %end;
11435        run;
11436       %end;
11437      
11438      %else %do;
11439       *Include all genes into one group;
11440       data &dsdout;
11441       set &dsdout;
11442       _grp_=1;
11443       run;
11444      %end;
11445      /*%abort 255;*/
11446      
11447      
11448      *exclude records with the same consecutive _grp_;
11449      data &dsdout(drop=_consect_grp_tag)
11450           &dsdout._bad(drop=_consect_grp_tag);
11451      set &dsdout;
11452      _consect_grp_tag=lag(_grp_);
11453      if (_consect_grp_tag=_grp_ and _grp_>1) then output &dsdout._bad;
11454      else output &dsdout;
11455      run;
11456      /*for debugging*/
11457      /* %abort 255; */
11458      
11459      *make consective numeric groups for _grp_;
11460      *The limitation of this part is that only element in the _grp_=1 can be separated well;
11461      proc sort data=&dsdout;by _grp_ st end;
11462      data &dsdout;
11463      retain _cgrp_ 0;
11464      set &dsdout;
11465      if first._grp_ then _cgrp_=_cgrp_+1;
11466      by _grp_;
11467      run;
11468      
11469      *Combine the grps, such as n+1 and n+3, with n=0,1,2,3;
11470      *An easy way to combine them would be as follows:;
11471      *Make these grps with reverse order;
11472      *Note: use _grp_ to get max;
11473      proc sql noprint;
11474      select max(_grp_) into: mgrp
11475      from &dsdout;
11476      
11477      *Add back these bad groups and assign _cgrp_=&mgrp+_n_;
11478      data &dsdout._bad;
11479      retain init_num 1;
11480      set &dsdout._bad;
11481      _cgrp_=&mgrp+_n_;
11482      
11483      /*Assume it is better but it is not!;
11484      *Better to group regions with different _cgrp_ together;
11485      *which will aggregate these regions in a single track;
11486      if first._grp_ then do;
11487        _cgrp_=&mgrp+1;
11488        init_num=1;
11489      end;
11490      else do;
11491        init_num=init_num+1;
11492        _cgrp_=init_num+&mgrp;
11493      end;
11494      by _grp_;
11495      */
11496      run;
11497      
11498      
11499      data &dsdout;
11500      set &dsdout &dsdout._bad;
11501      run;
11502      
11503      *Note: use _cgrp_ but not _grp_ to get max;
11504      proc sql noprint;
11505      select max(_cgrp_) into: newmgrp
11506      from &dsdout;
11507      /*%abort 255;*/
11508      %if %superq(newmgrp)= %then %let newmgrp=0;
11509      
11510      data &dsdout;
11511      set &dsdout;
11512      *Important to adjust group number by not allowing the new _cgrp_ close to original _grp_;
11513      /* if &mgrp-_cgrp_+3 <= _grp_ then _cgrp_=&newmgrp-_cgrp_+1; */
11514      /* if &mgrp-_cgrp_+2 <= _grp_ then _cgrp_=&newmgrp-_cgrp_+1; */
11515      *Put half of these _cgrp_ with larger numbers started from 1;
11516      *This part is a bug if all grps are indeed not mergable, which means there are the same number of orginal and newly
11516    ! generated groups;
11517      %if %sysevalf(&newmgrp>=10) %then %do;
11518        %put WARNING: the macro adj_grpnum4close_gene_bed_regs will modify the newly created numeric group since it is the same
11518    !  number of groups as the original group;
11519        if _cgrp_>ceil(0.5*&newmgrp) then _cgrp_=_cgrp_-ceil(0.5*&newmgrp);
11520      %end;
11521      run;
11522      
11523      /*
11524      proc sql noprint;
11525      select max(_cgrp_) into: mgrp
11526      from &dsdout;
11527      *Add back these bad groups and assign _cgrp_=&mgrp+1;
11528      data &dsdout._bad;
11529      set &dsdout._bad;
11530      _cgrp_=&mgrp+1;
11531      data &dsdout;
11532      set &dsdout &dsdout._bad;
11533      run;
11534      */
11535      
11536      proc sort data=&dsdout;by _grp_ st end;
11537      *Note that the macro var &old_dsdout is used here to avoid of potential errors when the gene_bed_dsd is the same as
11537    ! &dsdout;
11538      proc sql;
11539      create table work.&_book_gdc_sql as
11540      select a.*,b._cgrp_ as &outnumgrp
11541      from &gene_bed_dsd as a
11542      left join
11543      &dsdout as b
11544      on a.&gene_grp=b.&gene_grp;
11545      quit;
11546      data &old_dsdout;set work.&_book_gdc_sql;run;
11547      proc datasets library=work nolist;delete &_book_gdc_sql;quit;
11548      proc sql;
11549      
11550      data &dsdout;
11551      set &old_dsdout;
11552      run;
11553      *When the two vars &dsdout and &old_dsdout have the same name, the original dataset will be overwritten;
11554      *Need to keep a copy for it.;
11555      data &old_dsdout.0;
11556      set &old_dsdout;
11557      run;
11558      /*%abort 255;*/
11559      ***It is necessary to further optimize these regions by merging the largest group number with the smallest group numer;
11560      ***when any regions in the largest group number are not within the distance threshold;
11561      
11562        *This part might invite issues for separating a gene and its corresponding exons into different groups;
11563        *To resovle the issue, it is necessary use minmum st and max end for each gene_grp as input;
11564        *First keep a copy for the above &dsdout, and then later update the &outnumgrp with newly calculated group numbers;
11565        proc sql;
11566        create table work.&_book_gdc_sql as
11567        select distinct &gene_grp,min(&st_var) as &st_var,max(&end_var) as &end_var,&outnumgrp
11568        from &dsdout
11569        group by &gene_grp;
11570      quit;
11571      data &dsdout;set work.&_book_gdc_sql;run;
11572      proc datasets library=work nolist;delete &_book_gdc_sql;quit;
11573      proc sql;
11574      /*  %abort 255;*/
11575      
11576      %let nmgrp_0=0;
11577      %let nmgrp_1=1;
11578      *For debugging the loop;
11579      %let nloop=0;
11580      *Restrict the loop only run maximum of 300 iterations;
11581      %do %while (&nmgrp_0 ne &nmgrp_1 and &nloop<300);
11582         %let nloop=%eval(&nloop+1);
11583        *Need to create a new numgrp var and reorder the numgrp based on new &outdsd in the loop;
11584        proc sql;
11585        create table _tmp_ as
11586        select unique(&outnumgrp) as _tmpnumgrp_
11587        from &dsdout
11588        order by &outnumgrp;
11589      /*  %abort 255;*/
11590        data _tmp_;set _tmp_;&outnumgrp=_n_;
11591        proc sql;
11592        create table work.&_book_gdc_sql as
11593        select a.*,b.&outnumgrp as new&outnumgrp
11594        from &dsdout as a
11595        left join
11596        _tmp_ as b
11597        on a.&outnumgrp=b._tmpnumgrp_;
11598      quit;
11599      data &dsdout;set work.&_book_gdc_sql;run;
11600      proc datasets library=work nolist;delete &_book_gdc_sql;quit;
11601      proc sql;
11602      /*  %abort 255;*/
11603        *Put the newnumgrp into the macro var &nmgrps;
11604        *This will update the macro var nmgrps in each interation;
11605        proc sql noprint;
11606        select put(new&outnumgrp,best12.) into: nmgrps separated by ' '
11607        from (
11608          select distinct new&outnumgrp from &dsdout
11609        );
11610      /*  %abort 255;*/
11611        *Use the newnumgrp to replace older numgrp;
11612        data &dsdout(rename=(new&outnumgrp=&outnumgrp));
11613        set &dsdout(drop=&outnumgrp);
11614        run;
11615      
11616       %if %ntokens(&nmgrps)>=3 %then %do;
11617      
11618         proc sql noprint;
11619         select put(&outnumgrp,best12.) into: nmgrp_0 separated by ':'
11620         from &dsdout
11621         order by &gene_grp, &st_var, &end_var;
11622         *Important to only consider the comparision between regions from i and i+2 groups;
11623         *since the consecutive groups, i and i+1 do not have potential non-overlapped regions based on the distance threshold;
11624      
11625         %do nmg_i=%ntokens(&nmgrps) %to 3 %by -1;
11626               *%let start_num=%eval(1+%ntokens(&nmgrps)-&nmg_i);
11627                %let start_num=1;
11628      		 *Note: only compare 3 pairs, and the following can not be uncommented as SAS will fail to parse the macro contents due
11628    !  to it is use of pcts;
11629      		 %let end_num=%sysfunc(ifc(%eval(&nmg_i-2)>%eval(&start_num+6),%eval(&start_num+6),%eval(&nmg_i-2)));
11630      /*		  %let end_num=%eval(&nmg_i-2);*/
11631      		 %put Your start and end number for the loop is &start_num and &end_num;
11632      	     %do nmg_ii= &start_num %to &end_num %by 2;
11633      /*		      %let nloop=%eval(&nloop+1);*/
11634      		       %put Running the n=&nloop loop: comparison for the group &nmg_i with group &nmg_ii;
11635      			 data p1;set &dsdout;where &outnumgrp=&nmg_ii;
11636      			 data p2;set &dsdout;where &outnumgrp=&nmg_i;
11637      			 run;
11638      /*			 %if %totobsindsd(work.p2)=0 %then %do;*/
11639      /*						%put No obs in the dataset p2 for the numgrp &nmg_i;*/
11640      /*						%abort 255;*/
11641      /*			 %end;*/
11642      			%if %totobsindsd(work.p2)>0 %then %do;
11643      
11644      			 %if %ntokens(&nmgrps)>=3 %then %do;
11645      				 data left;set &dsdout;where &outnumgrp^=&nmg_ii and &outnumgrp^=&nmg_i;
11646      			 %end;
11647      			  run;
11648      /*			  %abort 255;*/
11649      			  *It is important to use distinct to remove duplicate records due to the where condition leads to potential multiple
11649    ! matches;
11650      			  proc sql;
11651      			  create table p1_p2 as
11652      			  select distinct b.*
11653      			  from p1 as a,
11654      			           p2 as b
11655      			  where (b.&st_var between  (a.&st_var-&gene_dist_thrhd) and (a.&end_var+&gene_dist_thrhd)) or
11656                               (b.&end_var between  (a.&st_var-&gene_dist_thrhd) and (a.&end_var+&gene_dist_thrhd));
11657      /*			   proc print;run;*/
11658      			   %if %totobsindsd(work.p1_p2)>0 %then %do;;			
11659      					 proc sql;
11660      					 create table p1p2_except as
11661      					 select * from p2
11662      					 except
11663      					 select * from p1_p2;
11664      					   data p1p2_except;set p1p2_except;&outnumgrp=&nmg_ii;
11665      					   *Update data set p2, which have different outnumgrp for p1_p2 and p1p2_except;
11666      					   data p2;set p1_p2 p1p2_except;run;
11667      			   %end;
11668      			   %else %do;
11669      			   	  *Merge all records with the largest group &nmg_i as that of &nmg_ii;
11670      			      data p2;set p2;&outnumgrp=&nmg_ii;
11671      			   %end;
11672      			    data &dsdout;
11673      				set p1 p2
11674                      %if %ntokens(&nmgrps)>=3 %then %do;
11675      				  left
11676      				%end;
11677                      ;
11678      				run;
11679      
11680      				proc sql;
11681      				drop table left;
11682      				drop table p1;
11683      				drop table p2;
11684      				drop table p1_p2;
11685      				drop  table p1p2_except;
11686      /*				%abort 255;*/
11687      	      %end;
11688               %end;
11689         %end;
11690        *Capture these new group numbers and order them by positions;
11691        *The macro var will be used to compare with previous numbers &nmgrp_0;
11692         proc sql noprint;
11693         select put(&outnumgrp,best12.) into: nmgrp_1 separated by ':'
11694         from &dsdout
11695         order by &gene_grp, &st_var, &end_var;
11696      %end;
11697       %else %do;
11698      	 %let nmgrp_0=1;
11699           %let nmgrp_1=1;
11700       %end;
11701      
11702      %end;
11703      
11704        *It is necessary to rename the &dsdout as &old_dsdout;
11705      *&old_dsdout contains the target output data set name, in case that it is the same as input data set name;
11706      *Update the newly generated grp number to the &old_dsdout;
11707      /*%put old_dsdout is &old_dsdout and dsdout is &dsdout;*/
11708      proc sql;
11709      create table work.&_book_gdc_sql as
11710      select a.*,b.&outnumgrp
11711      from &old_dsdout.0(drop=&outnumgrp) as a
11712      left join
11713      &dsdout as b
11714      on a.&gene_grp=b.&gene_grp;
11715      quit;
11716      data &old_dsdout;set work.&_book_gdc_sql;run;
11717      proc datasets library=work nolist;delete &_book_gdc_sql;quit;
11718      proc sql;
11719      /*%abort 255;*/
11720      /* proc print;run; */
11721      %mend;
11722      
11723      
11724      %macro Lattice_gscatter_over_bed_track(
11725      /*
11726      Note: when makedotheatmap=1, in default, the scatterplot will use lattice_subgrp_var to color dots
11727      across different scatter groups; User can supply an independent variable represented by the macro variable
11728      color_resp_var to color scatter plot dots but different scattergroups will be applied in a union style!
11729      This macro can also draw mixed CNV and scatter plots upper the gene tracks;
11730      */
11731      bed_dsd,/*at least contains 7 variables, including chr_var, st_var, end_var, grp_var, and yval_var;
11732      Too many bed regions (>1000) for the gene track will slow down the macro dramatically;
11733      Note: the macro will change the input bed_dsd when supplying xaxis_viewmin and xaxis_viewmax*/
11734      chr_var,/*chromosome name for bed regions*/
