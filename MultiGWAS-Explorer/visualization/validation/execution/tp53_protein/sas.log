2542                declare hash _label_positions(
2543                  dataset:"_xtag_(keep=&var4label_scatterplot_dots pos newpos)",
2544                  duplicate:"r"
2545                );
2546                _label_positions.defineKey("&var4label_scatterplot_dots", "pos");
2547                _label_positions.defineData("newpos");
2548                _label_positions.defineDone();
2549              end;
2550              modify final;
2551              if &var4label_scatterplot_dots^="" and pos^=. then do;
2552                if _label_positions.find()=0 then &lattice_subgrp_var=0;
2553              end;
2554              label top_y4label="&yaxis_label";
