10368      %macro long2wide4multigrpsSameTypeVars(
10369      /*Note: this macro is handy when there are multiple target numeric or characteric variables needs to be transposed to
10369    ! rowwide;
10370      *Tranditional transpose procedure usually handle one type of variable to rowwide by other group variables;
10371      *But this macro can abtain wide format table for multiple variables at rowwide at the same time by other group variables;
10372      *The key macro parameter to represent these multiple variables is "SameTypeVars";
10373      
10374      Note: if the maximum length of grp_vars >32, it is suggested to set ShortenColnames=1
10375      In case of tranposing a table by swtiching rows into columns, please first transpose the table
10376      into long format dataset, and then run this macro to change it into a wide table!
10377      */
10378      long_dsd,
10379      outwide_dsd,
10380      grp_vars=,/*If grp_vars and SameTypeVars are overlapped,
10381      the macro will automatically only keep it in the grp_vars;
10382      grp_vars can be multi vars separated by space, which
10383      can be numeric and character*/
10384      subgrpvar4wideheader=,/*This subgrpvar will be used to tag all transposed SameTypeVars
10385      in the wide table, and the max length of this var can not be >32!*/
10386      dlm4subgrpvar=.,/*string used to split the subgrpvar using the SCAN function if it is too long;
10387      because SCAN will treat any of these supplied characters as delemeters to separate the string,
10388      it is thus important to use a special char that will not be matched with any character in the
10389      string, such as #, to keep the string unchanged by supplying value 1 to the following macro var*/
10390      ithelement4subgrpvar=1,/*Keep the nth splitted element of subgrpvar and use it for tag
10391      in the final wide table*/
10392      SameTypeVars=_numeric_, /*These same type of vars will be added with subgrp tag in the
10393      final wide table; Make sure they are either numberic or character vars and not
10394      overlapped with grp_vars and subgrpvar!*/
10395      ShortenColnames=0,/*Replace long headers for these transposed variables in the final rowwide table with numberic names,
10395    ! such as V1, V2, V3, ..., Vn;
10396      Too match with original group vars used to generate these header names, please check the sas dataset wide_ids_lookup!*/
10397      PutGrpVarsAtEndOfTable=0,/*When the ShortenColnames is 1, it is possible to put the grp_vars at the beginning or the end
10397    ! of the final table*/
10398      tot_wide_ids_cutoff=2000,/*If more than the number of combined grp_vars*num_of_SameTypeVars, short colnames,such as V1,
10398    ! V2,..., Vn, will be used in the final table*/
10399      AllowedWideIDLength=20,/*If the length of wide_ids (combined grp_vars and SameTypeVars) longer than 20, the above numeric
10399    !  colnames will be used*/
10400      debug=0, /*print the first 2 records for the final wide format dsd*/
10401      rm_rows_with_all_missing=0,/*Remove rows with all missing values*/
10402      missing_rows_type=_numeric_,	/*target row type, such as _numeric_ or _character_, subjected to remove with all missing
10402    ! value*/
10403      rm_cols_with_all_missing=0,/*Remove columns with all missing values*/
10404      missing_columns_type=_numeric_	/*target column type, such as _numeric_ or _character_, subjected to remove with all
10404    ! missing value*/
10405      /*Note: the removal of rows or columns with all missing only tested for _numeric_ matrix, and for _character_ matrix, it
10405    ! might have some issue!*/
10406      );
10407      %let ngvars=%sysfunc(countc(&grp_vars,%str( )));
10408      %let ngvars=%eval(&ngvars+1);
10409      
10410      %if "&SameTypeVars"="_numeric_" %then %do;
10411      %get_num_or_char_vars4dsd(indsd=&long_dsd,outdsd=info,numeric=1);
10412      proc sql noprint;
10413      select name into: SameTypeVars separated by ' '
10414      from info
10415      where name not in (%quotelst(&grp_vars));
10416      %put All numeric vars not overlapped with your grp vars are:;
10417      %put &SameTypeVars;
10418      %end;
10419      
10420      %else %if "&SameTypeVars"="_character_" %then %do;
10421      %get_num_or_char_vars4dsd(indsd=&long_dsd,outdsd=info,numeric=0);
10422      proc sql noprint;
10423      select name into: SameTypeVars separated by ' '
10424      from info
10425      where name not in (%quotelst(&grp_vars));
10426      %put All character vars not overlapped with your grp vars are:;
10427      %put &SameTypeVars;
10428      %end;
10429      
10430      
10431      *first, sort the input long dsd by grp vars;
10432      *Only unique combinations of grp vars and subgrpvar4wideheader will be keep in the input dsd;
10433      proc sort data=&long_dsd out=&long_dsd._uniq nodupkeys;by &grp_vars &subgrpvar4wideheader;
10434      *Note: the where condition will exclude records with any missing values across the grp vars;
10435      
10436      proc transpose data=&long_dsd._uniq
10437      /*This filter only works for missing character vars
10438      as prxmatch requires to have character input at the 2nd parameter;
10439      */
10440      /* ( */
10441      /* where=( */
10442      /* %do i=1 %to &ngvars; */
10443      /*    %if &i<&ngvars %then %do; */
10444      /*       (not prxmatch('/^(\s*|\.)$/',%scan(&grp_vars,&i,%str( ))) ) and  */
10445      /*    %end; */
10446      /*    %else %do; */
10447      /*       (not prxmatch('/^(\s*|\.)$/',%scan(&grp_vars,&i,%str( ))) ) */
10448      /*    %end; */
10449      /* %end; */
10450      /*  ) */
10451      /* )  */
10452      
10453      out=&long_dsd._1st_trans(rename=(_name_=vars col1=values));
10454      variable &SameTypeVars;
10455      by &grp_vars &subgrpvar4wideheader;
10456      run;
10457      *Now link vars and subgrpvar4wideheader as a single var, which will be subjected to transpose again;
10458      data &long_dsd._1st_trans (drop=&subgrpvar4wideheader vars);
10459      retain max_wideids_len 0;
10460      *Note: _wide_ids_ is the original wide_ids that is not modified by prxchange and keeps the non-words within it;
10461      length _wide_ids_ wide_ids :$500.;
10462      set &long_dsd._1st_trans end=eof;
10463      *When the delemiter is not right, the following codes can be used to debug;
10464      /*_tmp_0=&subgrpvar4wideheader;*/
10465      /*_tmp_0=scan(&subgrpvar4wideheader,&ithelement4subgrpvar,"&dlm4subgrpvar");*/
10466      /*_tmp_=trim(left(scan(&subgrpvar4wideheader,&ithelement4subgrpvar,"&dlm4subgrpvar")));*/
10467      _wide_ids_=trim(left(vars))||"_"||trim(left(scan(&subgrpvar4wideheader,&ithelement4subgrpvar,"&dlm4subgrpvar")));
10468      *As the wide_ids will be used by SAS as colnames in the transposed table, SAS will automatically replace space and other
10468    ! none word, such as *, +, -, into _;
10469      *It is necessary to ensure these wide_ids do not have duplicates by groups, otherwise, the transpose procedure will faile
10469    ! ;
10470      wide_ids=prxchange('s/[\W ]+/_/',-1,trim(left(_wide_ids_)));
10471      max_wideids_len=max(max_wideids_len,length(wide_ids));
10472      if eof then call symputx('Max_wideids_len',max_wideids_len);
10473      run;
10474      /*%abort 255;*/
10475      *Determine how many unique wide_ids;
10476      *If too many wide_ids, it is necessary to replace these ids by combination of "V" and group numbers;
10477      proc sql noprint;
10478      create table wide_ids_lookup as
10479      select 	 monotonic() as num_ord,
10480      catx('','V',put(monotonic(),best32.)) as numgrp,
10481      wide_ids,
10482      _wide_ids_
10483      from (
10484      	select distinct wide_ids,_wide_ids_
10485        from  &long_dsd._1st_trans
10486      );
10487      select count(*) into: tot_wide_ids
10488      from wide_ids_lookup;
10489      
10490      %put The maximum length for your wide_ids is &Max_wideids_len;
10491      %if &Max_wideids_len>&AllowedWideIDLength %then %do;
10492         %put Warning: lease consider to modify the input group variables that used to make the wide_ids;
10493         %put Warning: and ensure that no duplicate wise_ids will be generated for the combination of different group vars;
10494      %end;
10495      
10496      %if &ShortenColnames=1 or (&tot_wide_ids>&tot_wide_ids_cutoff and &Max_wideids_len>&AllowedWideIDLength) %then %do;
10497      
10498          %put There are %left(&tot_wide_ids) wide_ids and the maximum length for it is &Max_wideids_len;
10499          %put To prevent the final table with too long headers, we will arbitrarily use short wide_ids with numbers, such as
10499    ! V1, V2, ..., Vn!;
10500          %put Please use the dataset wide_ids_lookup to lookup the original headers in later analysis;
10501      
10502           proc  sql;
10503           create table &long_dsd._1st_trans  as
10504           select *
10505           from &long_dsd._1st_trans
10506           natural join
10507           wide_ids_lookup;
10508      
10509           data &long_dsd._1st_trans;
10510           set &long_dsd._1st_trans(drop=wide_ids _wide_ids_ num_ord);
10511           rename numgrp=wide_ids;
10512           run;
10513      
10514      %end;
10515      
10516      
10517      *Check duplicate wide_ids before transposing the tabel;
10518      data &long_dsd._1st_trans;
10519      set &long_dsd._1st_trans;
10520      *Ensure the longest id of wide_ids not exceeding the limit of variable length defined by SAS in proc tranpose;
10521      *This is probamatic, as some different elements may have the same strings for the first 32 chars;
10522      *The same issue will occur when extracting the last 32 chars;
10523      *if length(wide_ids)>32 then wide_ids=substr(wide_ids,1,32);
10524      %if &ShortenColnames=0 %then %do;
10525      if  length(wide_ids)>32 then wide_ids=substr(wide_ids,1,32);
10526      %end;
10527      run;
10528      
10529      
10530      proc sort data=&long_dsd._1st_trans out=&long_dsd._1st_trans nodupkeys dupout=dups;
10531      by &grp_vars wide_ids;
10532      run;
10533      
10534      %if %totobsindsd(work.dups)>0 %then %do;
10535      *Get these original duplicate wide ids, including _wide_ids_1 and _wide_ids_2;
10536      proc sql;
10537      create table dups(drop=values rename=(_wide_ids_=_wide_ids_1)) as
10538      select *
10539      from &long_dsd._1st_trans
10540      natural join
10541      dups(keep=&grp_vars wide_ids _wide_ids_ rename=(_wide_ids_=_wide_ids_2))
10542      ;
10543      %end;
10544      %else %do;
10545       %put No duplicates in the data set &long_dsd._1st_trans;
10546      %end;
10547      
10548      %if %rows_in_sas_dsd(test_dsd=work.dups) > 0 %then %do;
10549                  title "First 10 obs of duplicate wide ids in the sas dataset dups";
10550      			proc print data=dups(obs=10);run;
10551                 %put Error: there are duplicate records for the two group variables, &grp_vars and wide_ids, that are used for
10551    !  proc transpose;
10552                  %put Please check the dataset dups to evaluate these wide_ids, and further modification for the input group
10552    ! variables are needed to have the above two unique groups for proc transpose!;
10553                  %put To address the issue, just change the value the macro var ShortenColnames from 0 to 1!;
10554                 %abort 255;
10555      %end;
10556      
10557      *Now transpose the new dsd into wide dsd;
10558      proc sort data=&long_dsd._1st_trans;by &grp_vars wide_ids;
10559      proc transpose data=&long_dsd._1st_trans out=&outwide_dsd;
10560      var values;
10561      id wide_ids;
10562      by &grp_vars;
10563      run;
10564      
10565      
10566      data &outwide_dsd;
10567      set &outwide_dsd;
10568      drop _name_;
10569      run;
10570      proc sql noprint;
10571      drop table &long_dsd._1st_trans;
10572      drop table &long_dsd._uniq;
10573      quit;
10574      
10575      *Reorder the colnames, such as V1, V2, ..., Vn;
10576      %if &ShortenColnames=1 or (&tot_wide_ids>&tot_wide_ids_cutoff and &Max_wideids_len>&AllowedWideIDLength) %then %do;
10577         %put The macro will re-order the column names for these vars, such as V1, V2, ..., Vn;
10578      		proc sql noprint;
10579          select numgrp into: ordered_colnames separated by ' '
10580          from wide_ids_lookup
10581          order by num_ord;
10582      
10583          data &outwide_dsd;
10584          %if &PutGrpVarsAtEndOfTable=1 %then %do;
10585          retain &ordered_colnames &grp_vars;
10586          %end;
10587          %else %do;
10588          retain &grp_vars &ordered_colnames;
10589           %end;
10590          set  &outwide_dsd;
10591          run;
10592      
10593      %end;
10594      
10595      **************************************Remove missing rows and columns in the matrix**************************;
10596      %if &rm_rows_with_all_missing=1 %then %do;
10597      %rm_rows_gt_nmissing(
10598      dsd=&outwide_dsd,
10599      nmissing_cutoff=1, /*Remove rows with more than or equal to 1 missing records*/
10600      reverse=1,/*Default is 0 for removal of rows with total number missing vars >= nmissing_cutoff;
10601      Assign value 1 to revease the search to obtain rows with at least the specific number of non-missing values defined by
10601    ! the macro var nmissing_cutoff*/
10602      tgt_var_type=&missing_rows_type,/*Evaluate the total number of missing across the same type of  numeric or character
10602    ! variables*/
10603      dsdout=&outwide_dsd,/*Filtered dsd*/
10604      missing_summ_dsd=missing_rate_dsd /*Output a dsd containing the missing rate for each row*/
10605      );
10606      %end;
10607      %if &rm_cols_with_all_missing=1 %then %do;
10608      %rm_cols_gt_nmissing(
10609      dsd=&outwide_dsd,/*Input data set; it can be subsetted if not all numeric or character vars
10610      are targetted before supplying to the macro*/
10611      var_type=&missing_columns_type,	/*_numeric_ or _character_;
10612      if only specific numeric or character vars are targeted, please subset the input dsd
10613      based on specific variable names*/
10614      missing_summary=missing_summ_dsd, /*Output a dataset containg the NMissing and missing % for all targetted vars*/
10615      missing_N_cutoff=1, /*When reverse=0, remove the var with missing n >= the cutoff;
10616      when reverse=1, keep the var with at least the cutoff of number of non-missing value*/
10617      reverse=1,/*Remove or keep var based on the missing_N_cutoff*/
10618      filtered_dsdout=&outwide_dsd, /*The sas dataset after filtering with the above criteria*/
10619      print_missing_summary=0 /*Print out the missing summary dataset*/
10620      );
10621      %end;
10622      
10623      
10624      %if &debug=1 %then %do;
10625      title "First 2 records for the final transposed data set &outwide_dsd";
10626      proc print data=&outwide_dsd(obs=2);
10627      run;
10628      %end;
10629      title;
10630      
10631      %mend;
