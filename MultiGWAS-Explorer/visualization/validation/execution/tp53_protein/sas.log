3687       data &dsdin;
3688       set &dsdin;
3689       frq=1;
3690       run;
3691       %if &Keep_order_of_target_SNPs=1 %then %do;
3692       /*For ordered local Manhattan panels, assign a stable numeric group id directly
3693         instead of depending on a generated format catalog entry.*/
3694       %let ordered_target_label_var=&chr_var;
3695       data _chr_map_;
3696         length &chr_var $32767;
3697         if 0 then set &dsdin(keep=&chr_var);
3698         declare hash seen();
3699         seen.defineKey("&chr_var");
3700         seen.defineData("&chr_var","_chr_");
3701         seen.defineDone();
3702         do until (eof);
3703           set &dsdin(keep=&chr_var) end=eof;
3704           if seen.check() ne 0 then do;
3705             _chr_+1;
3706             seen.add();
3707             output;
3708           end;
3709         end;
3710         stop;
