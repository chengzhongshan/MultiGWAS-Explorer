6971       %macro Beta2OR_forest_plot(
6972       dsdin=,
6973       beta_var=,
6974       se_var=,
6975       sig_p_var=,/*adjust the threshold of p in the extra_condition4updatedsd*/
6976       marker_var=,
6977       marker_label=,
6978       svgoutname=,
6979       plot_title=OR Forest Plot,
6980       figfmt=png,
6981       figwidth=600,
6982       figheight=800,
6983       dotsize=10,
6984       autolegend=0,
6985       xaxis_value_range=%str(0.4 to 1.6 by 0.2),
6986       sort_var4y=,/*Provide a variable in the input dsdin to sort the y axis tickets in the final figure;
6987       1. If left empty, it will use the default data order of marker_var to label y-axis from lower to upper;
6988       The default order of data can be modified by using proc sort procedure as follows:
6989       proc sort data=tops;by type gwas2_beta rsid;run;
6990       This is powerful because multiple variables can be used to sort the final y-axis tickets;
6991       2. Alternatively, it is fine to use a new variable, as sometimes it is better to create
6992       a new variable for sorting the input dsdin before applying the current macro
6993       */
6994       y2axis_ticket_var=,/*Default is emptyp to not to draw the 2nd yaxis;
6995       Provide a variable name to use its values to draw the 2nd yaxis*/
6996       both_y_font_size=12, /*Font size for any of the two y-axis*/
6997       sig_datalabel_pos=,
6998       sig_datalabel_size=,
6999       min_axis=0,
7000       max_axis=2,
7001       yoffsetmax=0.03, /*offset for the upper y axis maximum value*/
7002       yoffsetmin=0.03, /*offset for the lower y axis minimum value*/
7003       y_refline_values=,
7004       y_refline_lineattrs=%str(pattern=shortdash color=gray thickness=1),
7005       randomize_output_suffix=1,
7006       output_suffix=,
7007       /*Note: the macro need to have a input variable grp to color dots representing OR;
7008       So in the following extra condition for input dataset, a new variable grp is created.*/
7009       outdsd=dsd4OR,/*Output calcuated ORs for further evaluation*/
7010       extra_condition4updatedsd=%nrstr(
7011       length sigtag $10.;
7012       if &marker_var="rs16831827" then do;
7013        grp=0;sigtag='';
7014       end;
7015       else if &sig_p_var<5e-8 then do;
7016        grp=1;sigtag='*';
7017       end;
7018       else do;
7019        grp=1;sigtag="";
7020       end;
7021       if &marker_var="12:113357193:G:A" then &marker_var="rs10774671";
7022       if &marker_var="17:44219831:T:A" then &marker_var="rs1819040";
7023       if &marker_var="19:10427721:T:A" then &marker_var="rs74956615";
7024       
7025       if &marker_var in ('rs2271616','rs11919389','rs912805253','rs4801778') then grp=0;
7026       else if &marker_var='rs16831827' then grp=1;
7027       else grp=2;
7028        )
7029       );
7030       
7031       %local _forest_output_suffix _forest_output_stub _forest_output_stub_norm _forest_image_name _forest_output_dir
7031     ! _forest_printer_device;
7032       %if %length(&sig_datalabel_size)=0 %then %let sig_datalabel_size=&both_y_font_size;
7033       %if %length(&output_suffix)>0 %then %do;
7034         %let _forest_output_suffix=&output_suffix;
7035       %end;
7036       %else %if %sysevalf(&randomize_output_suffix ne 0) %then %do;
7037         %let _forest_output_suffix=%RandBetween(1,100);
7038       %end;
7039       %else %do;
7040         %let _forest_output_suffix=;
7041       %end;
7042       %let _forest_output_stub=&svgoutname;
7043       %if %length(&_forest_output_suffix)>0 %then %let _forest_output_stub=&svgoutname.&_forest_output_suffix;
7044       %let _forest_output_stub_norm=%sysfunc(tranwrd(%superq(_forest_output_stub),%str(\),/));
7045       %let _forest_image_name=%sysfunc(scan(%superq(_forest_output_stub_norm),-1,%str(/)));
7046       %let _forest_output_dir=%sysfunc(prxchange(s/\/[^\/]+$//,1,%superq(_forest_output_stub_norm)));
7047       %if %superq(_forest_output_dir)=%superq(_forest_output_stub_norm) %then %let _forest_output_dir=.;
7048       %let _forest_printer_device=%lowcase(&figfmt);
7049       %if %length(&_forest_printer_device)=0 %then %let _forest_printer_device=png;
7050       
7051       data tmp;
7052       set &dsdin;
7053       effect=exp(&beta_var);
7054       uppercl=exp(&beta_var+1.96*&se_var);
7055       lowercl=exp(&beta_var-1.96*&se_var);
7056       %unquote(&extra_condition4updatedsd);
7057       run;
7058       
7059       ods listing close;
7060       ods listing gpath="&_forest_output_dir";
7061       
7062       %if %length(&plot_title)>0 %then %do;
7063       title "&plot_title";
7064       %end;
7065       %else %do;
7066       title;
7067       %end;
7068       ods graphics on/reset=all noborder outputfmt=&figfmt
7069                                   width=&figwidth height=&figheight
7070                                   imagename="&_forest_image_name";
7071       data _tmp_;
7072       set tmp;
7073       keep by_n &marker_var;
7074       %if %length(&sort_var4y)=0 %then %do;
7075          by_n=_n_;
7076       %end;
7077       %else %do;
7078         by_n=&sort_var4y;
7079       %end;
7080       run;
7081       
7082       %mkfmt4grps_by_var(
7083       grpdsd=_tmp_,
7084       grp_var=&marker_var,
7085       by_var=by_n,
7086       outfmt4numgrps=x2y,
7087       outfmt4chargrps=y2x
7088       );
7089       
7090       data tmp;
7091       set tmp;
7092       *format char grps to numeric grps;
7093       new_grp_var=input(&marker_var,x2y.);
7094       run;
7095       
7096       ***********Import attrmap to assign the same color schemes to different grp*****************************;
7097       /*https://blogs.sas.com/content/iml/2017/01/30/auto-discrete-attr-map.html*/
7098       %let VarName = grp;           /* specify name of grouping variable */
7099       proc freq data=tmp ORDER=FORMATTED noprint;   /* or ORDER=DATA|FREQ  */
7100          tables &VarName / out=Attrs(rename=(&VarName=Value));
7101       run;
7102       data DAttrs;
7103       ID = "&VarName";                 /* or "ID_&VarName" */
7104       set Attrs(keep=Value);
7105       length MarkerStyleElement $11.;
7106       MarkerStyleElement = cats("GraphData", 1+mod(_N_-1, 12)); /* GraphData1, GraphData2, etc */
7107       run;
7108       /*proc print; run;*/
7109       ***********The above codes are important to assign the same color schemes to different grp*********;
7110       
7111       
7112       proc sgplot data=tmp dattrmap=DAttrs %if &autolegend=0 %then noautolegend;;
7113       /* scatter x=effect y=&marker_var / datalabel=sigtag */
7114       scatter x=effect y=new_grp_var / datalabel=sigtag
7115       datalabelattrs=(size=&sig_datalabel_size weight=bold)
7116       %if %length(&sig_datalabel_pos)>0 %then %do;
7117       datalabelpos=&sig_datalabel_pos
7118       %end;
7119       group=grp xerrorlower=lowercl  grouporder=ASCENDING attrid=grp
7120       xerrorupper=uppercl	 name="dotsc"
7121       markerattrs=(symbol=circleFilled size=&dotsize);
7122       *https://documentation.sas.com/doc/en/pgmsascdc/9.4_3.5/grstatproc/p0er4dg9tojp05n1sf7maeqdz1d8.htm;
7123       refline 1 / axis=x lineattrs=(pattern=solid color=darkgray thickness=1) ;
7124       xaxis label="OR and 95% CI " labelattrs=(size=&both_y_font_size) min=&min_axis valueattrs=(size=&both_y_font_size)
7124     ! max=&max_axis values=(&xaxis_value_range);
7125       *It is necessary to add the type=discrete to fix the yaxis using the newly created new_grp_var with its numeric format;
7126       yaxis label="&marker_label" labelattrs=(size=&both_y_font_size) valueattrs=(size=&both_y_font_size style=normal)
7126     ! type=discrete display=(nolabel)
7127                 offsetmax=&yoffsetmax offsetmin=&yoffsetmin;
7128       %if %length(&y_refline_values)>0 %then %do;
7129       refline &y_refline_values / axis=y lineattrs=(&y_refline_lineattrs);
7130       %end;
7131       
7132       *Align labels to SNP rows so repeated genes or NA values cannot collapse categories;
7133       %if %length(&y2axis_ticket_var)>0 %then %do;
7134       yaxistable &y2axis_ticket_var / y=new_grp_var position=right location=outside
7135         nolabel valueattrs=(size=&both_y_font_size style=italic);
7136       %end;
7137       
7138       %if &autolegend=1 %then %do;
7139       keylegend "dotsc"/ title="";
7140       %end;
7141       
7142       format new_grp_var y2x.;
7143       run;
7144       ods listing;
7145       title;
7146       
7147       data &outdsd;
7148       set tmp;
7149       run;
7150       
7151       %mend;
