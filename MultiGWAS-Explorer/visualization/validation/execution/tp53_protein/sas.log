6791       %macro bed_region_plot_by_grp(
6792       bed_dsd,
6793       chr_var,
6794       st_var,
6795       end_var,
6796       grp_var,
6797       yval_var,
6798       linethickness=20,
6799       track_width=800,
6800       track_height=400,
6801       dist2st_and_end=0
6802       );
6803       %number_rows_by_grp(dsdin=&bed_dsd,grp_var=&grp_var,num_var4sort=&st_var,descending_or_not=0,dsdout=x1);
6804       data x1(keep=&chr_var pos &yval_var &grp_var ord st end);
6805       set x1;
6806       array X{2} &st_var &end_var;
6807       do i=1 to 2;
6808        pos=X{i};
6809        output;
6810       end;
6811       run;
6812       /*Get max grp number for split data into different dsd*/;
6813       proc sql noprint;
6814       select max(ord),floor(min(&yval_var)),ceil(max(&yval_var)),min(&st_var)-&dist2st_and_end,max(&end_var)+&dist2st_and_end
6815              into: max_ord,: min_y,: max_y,: min_x,: max_x
6816       from x1;
6817       %if %eval(&min_x<0) %then %do;
6818           %let min_x=0;
6819       %end;
6820       /*
6821       data tmp;
6822       set x1(keep=&grp_var &yval_var);
6823       proc sort data=tmp nodupkeys;by &yval_var &grp_var;
6824       run;
6825       proc sql noprint;
6826       select quote(&grp_var) into: y_grp_values separated by " "
6827       from tmp
6828       order by &yval_var;
6829       drop table tmp;
6830       */
6831       
6832       data tmp;
6833       do i=&min_y to &max_y;
6834       output;
6835       end;
6836       run;
6837       proc sql noprint;
6838       select i into: y_axis_values separated by " "
6839       from tmp;
6840       drop table tmp;
6841       
6842       /***********************No need this, as it generates missing group that will be put into the legend
6843       in in the final figure*/
6844       /*data x1;*/
6845       /*set x1;*/
6846       /*%do i=1 %to &max_ord;*/
6847       /*if ord=&i then do;*/
6848       /*  &grp_var.&i=&grp_var;*/
6849       /*  pos&i=pos;*/
6850       /*  &yval_var.&i=&yval_var;*/
6851       /*  output;*/
6852       /*end;*/
6853       /*%end;*/
6854       /*run;*/
6855       /************************************************************************************************/
6856       
6857       
6858       /*Need to fill these missing values with pair of non-missing values,
6859       otherwise, the missing values will be a group that will be included
6860       in the legend in the final figure*/
6861       %do gi=1 %to &max_ord;
6862       data y&gi(keep=ord &grp_var&gi pos&gi &yval_var&gi);
6863       set x1;
6864       if ord=&gi then do;
6865         &grp_var&gi=&grp_var;
6866         pos&gi=pos;
6867         &yval_var&gi=&yval_var;
6868         output;
6869       end;
6870       else do;
6871         /*grp_var may be numeric or char,
6872          just use its original value here,
6873          will remove it later*/
6874         &grp_var&gi=&grp_var;
6875         pos&gi=.;
6876       		label pos&gi="Relative position (bp)";
6877         &yval_var&gi=.;
6878       		label &yval_var&gi="Group";
6879         output;
6880       end;
6881       run;
6882       
6883       /*proc sort data=y&gi;by &grp_var&gi ord pos&gi;*/
6884       /*run;*/
6885       
6886       /*get the 1st two records without missing values,
6887       which will be used for fill these missing values later*/
6888       data y&gi._ y&gi._missing;
6889       set y&gi;
6890       if pos&gi^=. then output y&gi._;
6891       else output y&gi._missing;
6892       /*create the common var n with values of 1 or 2
6893       for matching with non-missing values from y1_*/
6894       data y&gi._missing;
6895       set y&gi._missing;
6896       if mod(_n_,2)=0 then n=2;
6897       else n=1;
6898       /*Also get the 1st two non-missing values and
6899       label them with 1 and 2 for matching*/
6900       data y&gi._1;
6901       set y&gi._;
6902       n=_n_;
6903       if _n_<=2;
6904       run;
6905       proc sql;
6906       create table y&gi._filled as
6907       select a.n as n&gi, b.*
6908       from y&gi._missing as a,
6909            y&gi._1 as b
6910       where a.n=b.n;
6911       /*merge y1_filled with y1_*/
6912       data y&gi._final(drop=ord n);
6913       set y&gi._filled(drop=n&gi) y&gi._;
6914       run;
6915       %end;
6916       
6917       data final;
6918       %do i=1 %to &max_ord;
6919       set y&i._final;
6920       %end;
6921       run;
6922       *documentation for adjusting axis for layout overlay;
6923       *https://documentation.sas.com/doc/en/pgmsascdc/9.4_3.5/grstatug/p1pqfzgbuzbpkzn1mrbzhgggvhkz.htm;
6924       proc template;
6925       define statgraph Bedgraph;
6926       dynamic _chr _pos _value _G;
6927       begingraph / designwidth=&track_width designheight=&track_height;
6928          layout lattice / rowdatarange=data columndatarange=data rowgutter=10 columngutter=10;
6929                layout overlay/yaxisopts=(
6930                               type=linear offsetmin=0.1 offsetmax=0.1
6931                               linearopts=(minorticks=false tickvaluelist=(&y_axis_values))
6932                               )
6933                               xaxisopts=(linearopts=(viewmin=&min_x viewmax=&max_x));
6934                               /* Need to add this into linearopts later: tickdisplaylist=(&y_grp_values)*/
6935       		 %do i=1 %to &max_ord;
6936       	       %if &i=1 %then %do;
6937       		     referenceline y=0 /lineattrs=(color=black pattern=1 thickness=2);
6938       						%if &min_y<0 %then %do;
6939       						  %do _yi_=&min_y %to -1;
6940       		       referenceline y=&_yi_ /lineattrs=(color=black pattern=2 thickness=0.5);
6941       								%end;
6942       						%end;
6943       						%else %do;
6944       						  %do yi=1 %to &max_y;
6945       		        referenceline y=&yi /lineattrs=(color=black pattern=2 thickness=0.5);
6946       								%end;
6947       						%end;
6948       		   %end;
6949       
6950                      seriesplot x=pos&i y=&yval_var.&i / group=&grp_var.&i name='series' connectorder=xaxis
6951                                             lineattrs=(pattern=SOLID thickness=&linethickness)
6952                                             name="series&i"
6953                                             ;
6954                %end;	
6955             endlayout;
6956       	  sidebar /align=bottom;
6957       	  discretelegend "series1";
6958       	  endsidebar;
6959          endlayout;
6960       endgraph;
6961       end;
6962       run;
6963       
6964       proc sgrender data=WORK.final template=BedGraph;
6965       dynamic _chr="&chr_var";
6966       run;
6967       
6968       %mend;
