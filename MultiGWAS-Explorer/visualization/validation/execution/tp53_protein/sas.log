3839       data manhattan;
3840       set manhattan;
3841       /* Keep a SNP when any displayed GWAS track has a P value. In merged-wide
3842          tables, meta and differential values can occupy distinct allele rows;
3843          filtering on the primary track alone silently empties the other track. */
3844       if n(of &P_var &Other_P_vars)=0 then delete;
3845       %if (&logP=1) %then %do;
3846       logp=-log10(&P_var);
3847       %end;
3848       %else %do;
3849       logp=&P_var;
3850       %end;
3851       run;
3852       
3853       *Sorting the gwas will slow down the macro;
3854       /*
3855       proc sort data=manhattan;
3856       by &chr_var Fake_position;
3857       run;
3858       */
3859       
3860       %if &gwas_sortedby_numchrpos=0 %then %do;
3861       proc sort data=manhattan;
3862       by &chr_var Fake_position;
3863       run;
3864       %end;
