2594     ! _recommended_yaxis_offset4max=%sysfunc(max(&_recommended_yaxis_offset4max,0.08));
2595          %if (&text_rotate_angle=0 and %sysevalf(&n_marker_labels>=1)) %then %let
2595     ! _recommended_yaxis_offset4max=%sysfunc(max(&_recommended_yaxis_offset4max,0.09));
2596          %if %sysevalf(&n_marker_labels>=2) %then %let
2596     ! _recommended_yaxis_offset4max=%sysfunc(max(&_recommended_yaxis_offset4max,0.1));
2597       
2598       /*    %if %sysevalf(&totsc>3) %then %let _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.03); */
2599       /*    %if %sysevalf(&totsc>5) %then %let _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.04); */
2600       /*    %if %sysevalf(&totsc>8) %then %let _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.05); */
2601       
2602       /*    %if %sysevalf(&track_height<700) %then %let
2602     ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.03); */
2603       /*    %if %sysevalf(&track_height<550) %then %let
2603     ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.05); */
2604       /*    %if %sysevalf(&track_height<420) %then %let
2604     ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.07); */
2605       
2606       /*    %if %sysevalf(&track_width<900) %then %let
2606     ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.02); */
2607       /*    %if %sysevalf(&track_width<700) %then %let
2607     ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.03); */
2608       /*    %if %sysevalf(&track_width<500) %then %let
2608     ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.04); */
2609       
2610          %if %sysevalf(&_recommended_yaxis_offset4max>0.95) %then %let _recommended_yaxis_offset4max=0.95;
