7154       %macro char_grp_to_num_grp(
7155       dsdin=,
7156       grp_vars4sort=,
7157       descending_or_not=,
7158       dsdout=,
7159       num_grp_output_name=,
7160       keep_uniq_rows_by_grp=0
7161       );
7162       /*Note: if keep_uniq_rows_by_grp=1, then only unique grps will be remained in the final dataset*/
7163       %let nvars=%numargs(&grp_vars4sort);
7164       *Use key instead of by in the proc sort, as unknown error occurred when using by with descending function;
7165       *Note: if &dsdin and &dsdout are the same, the final &dsdout will only contain unique rows by keys;
7166       *This would be wrong if wanting to keep all rows!;
7167       *So only use the temporary table dsdout here;
7168       %if &descending_or_not %then %do;
7169       proc sort data=&dsdin nodupkeys out=dsdout;
7170       key &grp_vars4sort /descending;
7171       run;
7172       %end;
7173       %else %do;
7174       proc sort data=&dsdin nodupkeys out=dsdout;
7175       key &grp_vars4sort;
7176       run;
7177       %end;
7178       
7179       data dsdout;
7180       set dsdout;
7181       &num_grp_output_name=_n_;
7182       %if &nvars>=1 %then %do;
7183       grps_output_key=catx(':', of &grp_vars4sort);
7184       %end;
7185       run;
7186       /*Only unique grp keys are kept in the above output dsd!*/
7187       
7188       %if %eval(&keep_uniq_rows_by_grp=0) %then %do;
7189       *Now add the num_grp_output_name back to the original table;
7190       data tmp;
7191       set &dsdin;
7192       _grps_output_key_=catx(':', of &grp_vars4sort);
7193       run;
7194       proc sql;
7195       create table &dsdout(drop=_grps_output_key_) as
7196       select b.*,a.&num_grp_output_name,a.grps_output_key
7197       from dsdout as a
7198       right join
7199       tmp as b
7200       on a.grps_output_key=b._grps_output_key_;
7201       %end;
7202       %else %do;
7203       data &dsdout;
7204       set dsdout;
7205       run;
7206       %end;
7207       %mend;
7208       
7209       
7210       %macro check_var_type(dsdin,var_rgx);
7211       proc contents data=&dsdin out=&dsdin._fmt noprint;
7212       run;
7213       proc sql noprint;
7214       /*select distinct(TYPE) into: var_type separated by '|'*/
7215       select TYPE into: var_type separated by '|'
7216       from &dsdin._fmt
7217       where prxmatch("/&var_rgx/i",NAME);
7218       
7219       %put The types of variables matched with regular expression &var_rgx in dsd &dsdin are:;
7220       %put &var_type;
7221       %if %index(&var_type,|) %then %put Your regular expression matchs with >1 variables, please restrict your regular
7221     ! expression to only match with a unique variable name;
7222       
7223       %mend;
7224       
7225       
7226       %macro delete_empty_dsd(dsd_in);
7227       %if (%sysfunc(count(&dsd_in,%str(.)))>0) %then %do;
7228       %let lib=%scan(&dsd_in,1,'.');
7229       %let dsd_in=%scan(&dsd_in,2,'.');
7230       %end;
7231       %else %do;
7232       %let lib=work;
7233       %end;
7234       proc sql noprint;
7235       select count(*)
7236       into: obs_num
7237       from &lib..&dsd_in;
7238       %if (&obs_num=0) %then %do;
7239       proc datasets lib=&lib nolist;
7240       delete &dsd_in;
7241       run;
7242       %put "The dataset &dsd_in in the library &lib is empty!";
7243       %put "The above dataset is deleted!";
7244       %end;
7245       %mend;
