8609       %macro map_grp_assoc2gene4covidsexgwas(
8610       /*Note: this macro uses a internal macro Multgscatter_with_gene_exons
8611       Also, the macro will only focus on protein coding genes and its exons as demonstrated
8612       at lines 125 in the macro as follows:
8613       type in ("gene" "exon") and protein_coding=1
8614       It is possible to focus on transcript and its exons by updating the above code;
8615       */
8616       focus_on_transcript=1,/*This will generate a subset exon GTF data set by
8617       replacing gene variable with ensembl transcript variable and removing rows
8618       with the type of "gene" and update transcript as "gene" to enable the macro
8619       to work on these transcripts instead of genes*/
8620       gwas_dsd=FM.f_vs_m_mixedpop,/*Requires to have the arbitary var
8621       chr in the input gwas dsd*/
8622       gtf_dsd=FM.GTF_HG19,/*Need to use sas macro import gtf to save GTF_HG19;
8623       these vars are arbitrary, such as chr, st, end, protein_coding (1 or 0)
8624       and type of bed region (gene or exon);*/
8625       chr=,
8626       min_st=,
8627       max_end=,
8628       dist2genes=100000,
8629       AssocPVars=pval gwas1_p gwas2_p,
8630       ZscoreVars=diff_zscore gwas1_z gwas2_z,
8631       design_width=800,/*Width*height=800*800 would be the best for publication*/
8632       design_height=800,
8633       image_dpi=300,
8634       barthickness=8,
8635       dotsize=6,
8636       grp_font_size=8,/*font size for gene labels in the bottom gene track*/
8637       /*Important parameters for drawing SNVs and CNVs together*/
8638       scattermarker_symbol=circlefilled,/*Assign specific marker symbol, such as ibeam, circlefilled, circle, dot,
8638     ! squarefilled, or square, for scatter plot;
8639       Note the size of the designated marker symbol will be defined by the macro variable dotsize; when creating heatmap, you
8639     ! can assign
8640       squarefilled to the scattermarker_symbol, which would be more compatable with the highlow line style in for CNV or bed
8640     ! regions!*/
8641       highlow_line_cmd=%str(thickness=6 color=darkorange pattern=solid),/*For CNV bed regions, customize the following
8641     ! parameters using dot, dash, or solid line pattern
8642       with custome thickness and color for the line; please increase the thickness to match with that of
8643       dotsize=10 when scattermarker_symbol=squarefilled for the scatter plot, which will enable the square and the line
8644       in the same size and color*/
8645       dist2sep_genes=0.3, /*
8646       this will ensure these genes close to each other to
8647       be separated in the final gene track;
8648       (1) give 0 to plot ALL genes in the same line;
8649       (2) give value between 0 and 1 to separate genes based on the pct distance to the whole region;
8650       (3) give value > 1 to use absolute distance to separate genes into different groups;
8651       Customize this for different gene exon track!
8652       */
8653       where_cndtn_for_gwasdsd=%str() /*add filters to the input gwas_dsd; such as pval < 0.05 or gwas1_p < 0.05 or gwas2_p <
8653     ! 0.05*/,
8654       
8655       shift_text_yval=-0.2, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
8656                             to liftup or lower text labels on the y axis; the default value is -0.2 to put gene lable under
8656     ! gene tracks;
8657                             Change it with the macro var pct4neg_y!*/
8658       fig_fmt=svg, /*output figure formats: svg, png, jpg, and others*/
8659       pct4neg_y=2, /*the most often used value is 1;
8660                     compacting the bed track y values by increasing the scatterplot scale,
8661                     which can reduce the bed trace spaces; It seems that two-fold increasement
8662                     leads to better ticks for different tracks!
8663                     Use value >1 will increase the gene tract, while value < 1 will reduce it!
8664                     Note: when there are only 1 or 2 scatterplots, it is better to provide value = 0.5;
8665                     Modify this parameter with the parameter shift_text_yval to adjust gene label!
8666                     Typically, when there are more scatterplots, it is necessary to increase the value of pct4neg_y accordingly
8666     ! ;
8667                     If there are only <4 scatterplots, the value would be usually set as 1 or 2;
8668                     */
8669       adjval4header=-0.5, /*In terms of header of each subscatterplot, provide postive value to move up scatter group header by
8669     !  the input value*/
8670       
8671       gwas_pos_var=pos,
8672       Variant_Length_Var=,/*this variable if not empty, its value will be used to extend the value of Pos_Var for making
8673       the start and end position for SNP_Var, i.e., st=&Pos_Var-0.5*&Variant_Length_Var and
8673     ! end=&Pos_Var-0.5*&Variant_Length_Var;
8674       This would be especially helpful for mixing CNV and SNV data for making scatter plots, as it is only necessary
8675       to provide middle position for CNVs and its lengths for ploting CNVs and SNVs together!
8676       */
8677       gwas_labels_in_order=gwas1_vs_gwas2 gwas1 gwas2, /*Provide gwas names matched with the numeric scatter_grp_var
8678       Use _ to represent blank space in each name, and these _ will be changed back into blank space!*/
8679       makedotheatmap=0,/*use colormap to draw dots in scatterplot instead of the discretemap;
8680       Note: if makedotheatmap=1, the scatterplot will not use the discretemap mode based on
8681       the negative and postive values of lattice_subgrp_var to color dots in scatterplot*/
8682       
8683       /*Main color scheme for coloring dots in scatter plot with your quantitative color response variable
8684       Note: it is necessary to have makedotheatmap=1 and use the default heatmap_var or other quantitative
8685       variable with both negative and positive values to color the scatter plot; when the quantitative response
8686       variable is postive or negative, please change the heatmap_min_neg_val as 0 for postive values, meanwhile,
8687       for all negative values, please assign value 0 to heatmap_max_pos_val*/
8688       heatmap_var=%nrbquote(&lattice_subgrp_var),/*Assign lattice_subgrp_var to this macro var to draw scatter plot in heatmap
8689       using lattice_subgrp_var with rangeattrmap instead of drawing dots using binary mode, such as 0 and 1 representing Pos
8690       and negative directions of latticen_subgrp_var!*/
8691       heatmap_Neg_rangealtcolormodel=darkgreen lightgreen deepskyblue,/*Range alt color model for negative values,
8691     ! heatmap_var<=0,  in heatmap*/
8692       heatmap_Pos_rangealtcolormodel=gold mediumred vipk,/*Range alt color model for positve values, heatmap_var>=0, in
8692     ! heatmap*/
8693       heatmap_min_neg_val=-8,/*Minimum negative value for the heatmap_var when it is not empty;
8694       change this to customize the minimum value for colorbar in heatmap*/
8695       heatmap_max_pos_val=8,/*Maximum postive value for the heatmap_var when it is not empty;
8696       change this to customize the max value for colorbar in heatmap*/
8697       
8698       /*Alternative color scheme for categorical color response variable! Please keep it in default
8699       value if you don't want to use it for your quantitative color response variable*/
8700       
8701       color_resp_var=,/*Use the variable to draw colormap of dots in scatterplots with colors
8702       supplied by a later macro variable dataContrastCols that are specifically designated for
8703       scatterplot dots but not other tracks under the scatter plots, such as gene tracks;.
8704       previously if the macro var is empty, the default var would be the same as that of yval_var;
8705       Later it is updated to enable the macro to use lattice_subgrp_var but not yval_var when
8706       this color_resp_var is empty! A later macro variable dataContrastCols will be used
8707       to supply colors for different groups of the variable solely for coloring scatterplot dots!*/
8708       fixedcols4tracksunderscatter=cyan blue, /*when color_resp_var is not empty, all tracks under scatterplots will be fixed
8708     ! with
8709       two different colors, including cyan and blue, represented by the macro var fixedcols4tracksunderscatter!*/
8710       color_resp_grpdsd=,/*this dataset contains two columns, including &color_resp_var and the fixed
8711       variable numgrp4color_resp,which are corresponding to the unique char color_resp_var and
8712       its associated numeric var that would be sorted to order these char color_resp_var in the final figure legend!
8713       Note: for color_resp_var not included in the dataset, they will be asigned as Others;
8714       Custom colors with the same number of unique color_resp_var for these groups can be provided to
8715       a latter macro variable dataContrastCols*/
8716       dataContrastCols=%str(darkblue darkgreen darkred darkyellow
8717       CXFFF000 CXFF7F00 CXFF00FF CXFF0000 CXEAADEA CXE6E8FA CXDB9370 CXDB70DB CXD9D919 CXD8D8BF
8718       CXCD7F32 CXC0C0C0 CXBC8F8F CXB87333 CXB5A642 CXADEAEA CXA67D3D CXA62A2A CX9F9F5F CX9F5F9F
8719       CX97694F CX8E236B CX8E2323 CX8C7853 CX8C1717 CX871F78 CX856363 CX855E42 CX70DB93 CX5F9F9F
8720       CX5C4033 CX545454 CX4F2F4F CX4E2F2F CX32CD32 CX2F4F2F CX238E23 CX236B8E CX23238E CX00FFFF
8721       CX00FF00 CX0000FF CX000000
8722       ),
8723       /*Note: these colors will be used for the scatterplot and gene track together when color_resp_var is a char var, so it is
8723     !  difficult control*/
8724       
8725       makeheatmapdotintooneline=0,/*This will make all dots have the same yaxis value but have different colors
8726       based on its real value in the heatmap plot; To keep the original dot y axis value, assign 0 to the macro var
8727       This would be handy when there are multiple subgrps represented by different y-axis values! By modifying
8728       the y-axis values for these subgrps, the macro can plot them separately in each subtrack!
8729       */
8730       var4label_scatterplot_dots=, /*Make sure the variable name is not grp, which is a fixed var used by the macro for other
8730     ! purpose;
8731       Whenever  makeheatmapdotintooneline=1 or 0, it is possible to use values of the var4label_scatterplot_dots to
8732       label specific scatterplot dots based on the customization of the variable predifined by users for the input data set;
8733       default is empty; provide a variable that include non-empty strings for specific dots in the
8734       scatterplots;*/
8735       var4mark_ld_scatterplot_dots=, /*Optional character variable containing '*' for LD-linked variants.*/
8736       ld_marker_color=black,
8737       ld_marker_legend_symbol=*,
8738       ld_heatmap_var=,
8739       ld_heatmap_colormodel=CXF7FBFF CX6BAED6 CX54278F,
8740       ld_heatmap_legend_title=%str(LD r2),
8741       text_rotate_angle=90, /*Angle to rotate text labels for these selected dots by users*/
8742       label_position_overrides=,
8743       font_size4textlabels=10,
8744       label_headroom_frac=,
8745       label_center_offset=,
8746       auto_rotate2zero=0, /*supply value 1 when less than 3 text labels, it is good to automatically set the
8746     ! text_rotate_angel=0*/
8747       pct2adj4dencluster=0.15,/*For SNP labels on the top, please try to use this parameter, which only works when
8748       there are less than or equal to 3 top SNPs if track_width <= 500, or 5 top SNPs if track_width between 500 and 800, or 6
8748     ! top SNPs if
8749       track_width >=800, otherwise, this parameter will be excluded and even step will be used to separate them on the top!
8750       and SNPs within a cluster are overlapped with each other or overlapped with elements from other SNP cluster, so it is
8750     ! feasible to
8751       avoid this issue by increasing the pct or reducing it, respectively*/
8752       yoffset4max_drawmarkersontop=0.25, /*If draw scatterplot marker labels on the top of track,
8753        this fixed value will be used instead of yaxis_offset4max!*/
8754       Yoffset4textlabels=3.5, /*Move up the text labels for target SNPs in specific fold;
8755       the default value 2.5 fold works for most cases*/
8756       scatter_yaxis_label=%str(-log10%(P%)),/*Visible y-axis title for the stacked association tracks*/
8757       heatmap_legend_title=%str(Z score),/*Visible title for the continuous colorbar when heatmap coloring is enabled*/
8758       plot_title=,/*Optional visible title naming the color metric.*/
8759       adj_spaces_among_top_snps=1 /*Provide value 1 to adjust spaces among top SNP labels; otherwise, give value 0 to not
8760       adjust top SNPs labels if these labels are rotated 90 degree, which is helpful when the space adjusted labels are not
8760     ! pretty*/
8761       );
8762       %if %ntokens(&gwas_labels_in_order)^=%ntokens(&AssocPVars) %then %do;
8763         %put Please ensure the gwas_labels_in_order has the same number of elements as that of AssocPVars;
8764         %put gwas_labels_in_order=;
8765         %put AssocPVars=;
8766         %abort 255;
8767       %end;
8768       
8769       %let orig_minst=&min_st;
8770       %let orig_maxend=&max_end;
8771       
8772       %let min_st=%sysevalf(&min_st-&dist2genes);
8773       %let max_end=%sysevalf(&max_end+&dist2genes);
8774       
8775       *if the dist between min_st and max_end, the range may not be;
8776       *able to cover the gene body, resulting in failure of drawing gene body and exons;
8777       %if %sysevalf(&max_end - &min_st)<1e8 %then %do;
8778        %put Extend to the st and end position to cover gene bodies and exons;
8779        %let min_st=%sysevalf(&min_st - 50000000);
8780        %let max_end=%sysevalf(&max_end + 50000000);
8781       %end;
8782       
8783       
8784       %let totP=%sysfunc(countw(&AssocPVars));
8785       %if &totP ne %sysfunc(countw(&ZscoreVars)) %then %do;
8786           %put Please make sure the two macro vars have the same number of parameters:;
8787           %put Your AssocPVars: &AssocPVars;
8788           %put Your ZscoreVars: &ZscoreVars;
8789           %abort 255;
8790       %end;
8791       
8792       %if &focus_on_transcript=0 %then %do;
8793       *Need to first select these genes and get their min_pos and max_pos;
8794       *then use these regions to lookup with associaiton signals;
8795       data exons(keep=_chr_ st end grp pi type &Variant_Length_Var);
8796       length _chr_ $5.;
8797       *Enlarge the length of grp, which may be truncated if too short!;
8798       length grp $30.;
8799       set &gtf_dsd;
8800       pi=0;
8801       grp=genesymbol;
8802       _chr_=cats("chr",put(chr,2.));
8803       where chr=&chr and
8804       ( (st between &min_st and &max_end) or (end between &min_st and &max_end) )
8805       and
8806       /* type="gene" and protein_coding=1; */
8807       /*This does not work as expected, as some exons belonging to the same gene are colored differently*/
8808       /*It is also very time-consuming*/
8809       /* type in ("exon" "gene") and protein_coding=1; */
8810       type in ("gene" "exon") and protein_coding=1 and genesymbol not contains '.';
8811       /*and genesymbol not contains 'ENSG';*/
8812       run;
8813       /* %abort 255; */
8814       %end;
8815       %else %do;
8816       *Need to first select these transcripts of genes and get their min_pos and max_pos;
8817       *then use these regions to lookup with associaiton signals;
8818       data exons(keep=_chr_ st end grp pi type &Variant_Length_Var);
8819       length _chr_ $5.;
8820       *Enlarge the length of grp, which may be truncated if too short!;
8821       length grp $50.;
8822       set &gtf_dsd;
8823       pi=0;
8824       *Note that transcript variable ensembl_transcript is used to replace gene variable;
8825       grp=ensembl_transcript;
8826       _chr_=cats("chr",put(chr,2.));
8827       where chr=&chr and
8828       ( (st between &min_st and &max_end) or (end between &min_st and &max_end) )
8829       and
8830       /* type="gene" and protein_coding=1; */
8831       /*This does not work as expected, as some exons belonging to the same gene are colored differently*/
8832       /*It is also very time-consuming*/
8833       /* type in ("exon" "gene") and protein_coding=1; */
8834       type in ("transcript" "exon") and protein_coding=1 and genesymbol not contains '.';
8835       /*and genesymbol not contains 'ENSG';*/
8836       run;
8837       
8838       *Need to update the type of transcript as gene to draw each transcript as that of a gene in the final track of scatter
8838     ! plots;
8839       data exons;
8840       set exons;
8841       if type="transcript" then type="gene";
8842       run;
8843       /* %abort 255; */
8844       %end;
8845       
8846       
8847       *Important to remove dup exons;
8848       proc sort data=exons nodupkeys;by _all_;run;
8849       
8850       *Count how many exons in the exons dsd;
8851       *If there are more than 1000, keep only gene and exclude all exons;
8852       proc sql noprint;
8853       select count(type) into: tot_exons
8854       from exons
8855       where type="exon";
8856       %put There are &tot_exons unique exons!;
8857       %if &tot_exons > 20000 %then %do;
8858       %put There are too many exons in the input dataset, with n=%left(&tot_exons)!;
8859       %put The macro will exclude these exons;
8860       /*%abort 255;*/
8861       data exons;
8862       set exons;
8863       where type^="exon";
8864       run;
8865       %end;
8866       
8867       
8868       *Need to drop the var type;
8869       data exons;
8870       set exons(drop=type);
8871       run;
8872       proc sql noprint;
8873       select count(*) into: tot_bed_regs
8874       from exons;
8875       %if &tot_bed_regs > 20000 %then %do;
8876         %put Too many bed regions in your exon dsd;
8877       		%put Only < 20000 bed regions can be fastly draw by the macro;
8878       		%abort 255;
8879       %end;
8880       
8881       *Need to extend the min_st and max_end for better visualization in the final figure;
8882       proc sql noprint;
8883       select min(st)-1000-&dist2genes, max(end)+1000+&dist2genes
8884       into :min_gpos,:max_gpos
8885       from exons;
8886       *Need to compare it with original input min_st and max_end;
8887       /* Large positions can be formatted as 6.601E7 or 1.1708E8.  A plain
8888          macro %IF may compare those strings lexically and clip away the lead SNP. */
8889       %if %sysevalf(&max_end>&max_gpos,boolean) %then %let max_gpos=&max_end;
8890       %if %sysevalf(&min_st<&min_gpos,boolean) %then %let min_gpos=&min_st;
8891       %if %sysevalf(&min_gpos<0,boolean) %then %let min_gpos=0;
8892       %put The final chromosomal range for your query region is from &min_gpos to &max_gpos;
8893       %put However, we will restrict the x-axis to the original min and max genomic position in the final figure;
8894       *Need to enlarge the grp length by asigning longer comman label for it;
8895       *Filter input gwas_dsd with where condition to reduce the total number of markers;
8896       *Assign enough length for the variable grp, which will be further combined with gene names later;
8897       *Larger length will avoid of truncating of gene names;
8898       proc sql;
8899       create table signal_dsd as
8900       select
8901            %if %length(&color_resp_var)>0 %then %do;
8902              &color_resp_var,
8903            %end;
8904            %if %length(&var4label_scatterplot_dots)>0 %then %do;
8905              &var4label_scatterplot_dots,
8906            %end;
8907            %if %length(&var4mark_ld_scatterplot_dots)>0 %then %do;
8908              &var4mark_ld_scatterplot_dots,
8909            %end;
8910            %if %length(&Variant_Length_Var)>0 %then %do;
8911              &Variant_Length_Var,
8912            %end;
8913       
8914            %do i=1 %to &totP;
8915       	    %if &makedotheatmap=1 %then %do;
8916       		%*Use original ZscoreVars for making heatmap later;
8917       		%scan(&ZscoreVars,&i) as AssocGrp&i,
8918       		%end;
8919       		%else %do;
8920       		%*use binary variable to color scatter plot dots when not in heatmap style;
8921       		%*Pos=1 and Neg=0;
8922               %scan(&ZscoreVars,&i) > 0 as AssocGrp&i,
8923       		%end;
8924              -log10(%scan(&AssocPVars,&i)) as var4log10P&i,
8925            %end;
8926              &gwas_pos_var as st,&gwas_pos_var+1 as end,"GWAS_Assoc_Signal" as grp length=50,
8927              cats("chr",put(chr,2.)) as _chr_
8928       from &gwas_dsd	
8929       %if %length(&where_cndtn_for_gwasdsd)^=0 %then %do;
8930       (where=(&where_cndtn_for_gwasdsd))
8931       %end;
8932       where chr=&chr and
8933       (&gwas_pos_var between &min_gpos and &max_gpos);
8934       /*%abort 255;*/
8935       
8936       /* The region will be different from the (pos between &minst and &maxend); */
8937       
8938       *For debug only;
8939       /*data a;*/
8940       /*set &gwas_dsd;*/
8941       /*run;*/
8942       /*%abort 255;*/
8943       
8944       data signal_dsd(where=(var4log10P>0));
8945       *The final output would be necessary with p<0.05;
8946       set signal_dsd;
8947       array X{*} var4log10P1-var4log10P&totP;
8948       array Z{*} AssocGrp1-AssocGrp&totP;
8949       *array W{*} _AssocGrp1-_AssocGrp&totP; *No need anymore;
8950       do pi=1 to dim(X);
8951          var4log10P=X{pi};
8952          AssocGrp=Z{pi};
8953          *_AssocGrp=W{pi};*No need anymore;
8954          output;
8955       end;
8956       run;
8957       /*%abort 255;*/
8958       
8959       data signal_dsd(rename=(_chr_=chr));
8960       set signal_dsd;
8961       if _chr_="chr23" then _chr_="chrX";
8962       data exons(rename=(_chr_=chr));
8963       set exons;
8964       if _chr_="chr23" then _chr_="chrX";
8965       run;
8966       /*%abort 255;*/
8967       *Make sure the two datasets have 4 comman vars, including chr, st, end, and grp;
8968       *Need to ensure the dist2st_and_end as 0 to make the final scatterplot and gene track matching perfectly.;
8969       %Multgscatter_with_gene_exons(
8970       bed_dsd=signal_dsd,
8971       Variant_Length_Var=&Variant_Length_Var,/*this variable if not empty, its value will be used to extend the value of
8971     ! Pos_Var for making
8972       the start and end position for SNP_Var, i.e., st=&Pos_Var-0.5*&Variant_Length_Var and
8972     ! end=&Pos_Var-0.5*&Variant_Length_Var;
8973       This would be especially helpful for mixing CNV and SNV data for making scatter plots, as it is only necessary
8974       to provide middle position for CNVs and its lengths for ploting CNVs and SNVs together!
8975       */
8976       yval_var=var4log10P,
8977       scatter_grp_var=pi,
8978       lattice_subgrp_var=AssocGrp,  /*When &makedotheatmap=0, use AssocGrp to color scatterplot by its direction, i.e.,
8978     ! negative and position,
8979       when &makedotheatmap=1, also use AssocGrp to make heatmap for the scatter plot in quantitative way, as the input variable
8979     !  AssocGrp is
8980       also modified based on the input parameter &makedotheatmap!*/
8981       gene_exon_bed_dsd=exons,/*Too many exons will slow down the macro dramatically*/
8982       dist2st_and_end=0,
8983       design_width=&design_width,
8984       design_height=&design_height,
8985       image_dpi=&image_dpi,
8986       barthickness=&barthickness,
8987       dotsize=&dotsize,
8988       grp_font_size=&grp_font_size,
8989       /*Important parameters for drawing SNVs and CNVs together*/
8990       scattermarker_symbol=&scattermarker_symbol,/*Assign specific marker symbol, such as ibeam, circlefilled, circle, dot,
8990     ! squarefilled, or square, for scatter plot;
8991       Note the size of the designated marker symbol will be defined by the macro variable dotsize; when creating heatmap, you
8991     ! can assign
8992       squarefilled to the scattermarker_symbol, which would be more compatable with the highlow line style in for CNV or bed
8992     ! regions!*/
8993       highlow_line_cmd=&highlow_line_cmd,/*For CNV bed regions, customize the following parameters using dot, dash, or solid
8993     ! line pattern
8994       with custome thickness and color for the line; please increase the thickness to match with that of
8995       dotsize=10 when scattermarker_symbol=squarefilled for the scatter plot, which will enable the square and the line
8996       in the same size and color*/
8997       min_dist4genes_in_same_grps=&dist2sep_genes, /*
8998       this will ensure these genes close to each other to
8999       be separated in the final gene track;
9000       (1) give 0 to plot ALL genes in the same line;
9001       (2) give value between 0 and 1 to separate genes based on the pct distance to the whole region;
9002       (3) give value > 1 to use absolute distance to separate genes into different groups;
9003       Customize this for different gene exon track!*/
9004       sc_labels_in_order=&gwas_labels_in_order, /*Provide scatter names matched with the numeric scatter_grp_var*/
9005       min_xaxis=&orig_minst,
9006       max_xaxis=&orig_maxend,
9007       yoffset4max_drawmarkersontop=&yoffset4max_drawmarkersontop,/*If draw scatterplot marker labels on the top of track,
9008       this fixed value will be used instead of yaxis_offset4max!*/
9009       Yoffset4textlabels=&Yoffset4textlabels, /*Move up the text labels for target SNPs in specific fold;
9010       the default value 2.5 fold works for most cases*/
9011       scatter_yaxis_label=&scatter_yaxis_label, /*Visible y-axis title for the stacked association tracks*/
9012       heatmap_legend_title=&heatmap_legend_title, /*Visible title for the continuous colorbar when heatmap coloring is
9012     ! enabled*/
9013       plot_title=&plot_title,
9014       shift_text_yval=&shift_text_yval, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
9015                             to liftup or lower text labels on the y axis; the default value is -0.2 to put gene lable under
9015     ! gene tracks;
9016                             Change it with the macro var pct4neg_y!*/
9017       fig_fmt=&fig_fmt, /*output figure formats: svg, png, jpg, and others*/
9018       pct4neg_y=&pct4neg_y, /*the most often used value is 1;
9019                     compacting the bed track y values by increasing the scatterplot scale,
9020                     which can reduce the bed trace spaces; It seems that two-fold increasement
9021                     leads to better ticks for different tracks!
9022                     Use value >1 will increase the gene tract, while value < 1 will reduce it!
9023                     Note: when there are only 1 or 2 scatterplots, it is better to provide value = 0.5;
9024                     Modify this parameter with the parameter shift_text_yval to adjust gene label!
9025                     Typically, when there are more scatterplots, it is necessary to increase the value of pct4neg_y accordingly
9025     ! ;
9026                     If there are only <4 scatterplots, the value would be usually set as 1 or 2;
9027                     */
9028       adjval4header=&adjval4header, /*In terms of header of each subscatterplot, provide postive value to move up scatter group
9028     !  header by the input value*/
9029       
9030       makedotheatmap=&makedotheatmap,/*Use the default value 0 of &makedotheatmap to draw scatter plot in two color modes;
9031       Assign value 1 to it to use colormap to draw dots in scatterplot instead of the discretemap;
9032       Note: if makedotheatmap=1, the scatterplot will not use the discretemap mode based on
9033       the negative and postive values of lattice_subgrp_var to color dots in scatterplot*/
9034       
9035       /*Main color scheme for coloring dots in scatter plot with your quantitative color response variable
9036       Note: it is necessary to have makedotheatmap=1 and use the default heatmap_var or other quantitative
9037       variable with both negative and positive values to color the scatter plot; when the quantitative response
9038       variable is postive or negative, please change the heatmap_min_neg_val as 0 for postive values, meanwhile,
9039       for all negative values, please assign value 0 to heatmap_max_pos_val*/
9040       heatmap_var=&heatmap_var,/*Assign lattice_subgrp_var to this macro var to draw scatter plot in heatmap
9041       using lattice_subgrp_var with rangeattrmap instead of drawing dots using binary mode, such as 0 and 1 representing Pos
9042       and negative directions of latticen_subgrp_var!*/
9043       heatmap_Neg_rangealtcolormodel=&heatmap_Neg_rangealtcolormodel,/*Range alt color model for negative values,
9043     ! heatmap_var<=0,  in heatmap*/
9044       heatmap_Pos_rangealtcolormodel=&heatmap_Pos_rangealtcolormodel,/*Range alt color model for positve values,
9044     ! heatmap_var>=0, in heatmap*/
9045       heatmap_min_neg_val=&heatmap_min_neg_val,/*Minimum negative value for the heatmap_var when it is not empty;
9046       change this to customize the minimum value for colorbar in heatmap*/
9047       heatmap_max_pos_val=&heatmap_max_pos_val,/*Maximum postive value for the heatmap_var when it is not empty;
9048       change this to customize the max value for colorbar in heatmap*/
9049       
9050       /*Alternative color scheme for categorical color response variable! Please keep it in default
9051       value if you don't want to use it for your quantitative color response variable*/
9052       color_resp_var=&color_resp_var,/*Use the variable to draw colormap of dots in scatterplots with colors
9053       supplied by a later macro variable dataContrastCols that are specifically designated for
9054       scatterplot dots but not other tracks under the scatter plots, such as gene tracks;.
9055       previously if the macro var is empty, the default var would be the same as that of yval_var;
9056       Later it is updated to enable the macro to use lattice_subgrp_var but not yval_var when
9057       this color_resp_var is empty! A later macro variable dataContrastCols will be used
9058       to supply colors for different groups of the variable solely for coloring scatterplot dots!*/
9059       fixedcols4tracksunderscatter=&fixedcols4tracksunderscatter, /*when color_resp_var is not empty, all tracks under
9059     ! scatterplots will be fixed with
9060       two different colors, including cyan and blue, represented by the macro var fixedcols4tracksunderscatter!*/
9061       color_resp_grpdsd=&color_resp_grpdsd,/*this dataset contains two columns, including &color_resp_var and the fixed
9062       variable numgrp4color_resp,which are corresponding to the unique char color_resp_var and
9063       its associated numeric var that would be sorted to order these char color_resp_var in the final figure legend!
9064       Note: for color_resp_var not included in the dataset, they will be asigned as Others;
9065       Custom colors with the same number of unique color_resp_var for these groups can be provided to
9066       a latter macro variable dataContrastCols*/
9067       dataContrastCols=&dataContrastCols,
9068       /*Note: these colors will be used for the scatterplot and gene track together when color_resp_var is a char var, so it is
9068     !  difficult control*/
9069       makeheatmapdotintooneline=&makeheatmapdotintooneline, /*This will make all dots have the same yaxis value but have
9069     ! different colors
9070       based on its real value in the heatmap plot; To keep the original dot y axis value, assign 0 to the macro var
9071       This would be handy when there are multiple subgrps represented by different y-axis values! By modifying
9072       the y-axis values for these subgrps, the macro can plot them separately in each subtrack!
9073       */
9074       text_rotate_angle=&text_rotate_angle, /*Angle to rotate text labels for these selected dots by users*/
9075       label_position_overrides=&label_position_overrides,
9076       font_size4textlabels=&font_size4textlabels,
9077       label_headroom_frac=&label_headroom_frac,
9078       label_center_offset=&label_center_offset,
9079       auto_rotate2zero=&auto_rotate2zero, /*supply value 1 when less than 3 text labels, it is good to automatically set the
9079     ! text_rotate_angel=0*/
9080       pct2adj4dencluster=&pct2adj4dencluster,
9081       var4label_scatterplot_dots=&var4label_scatterplot_dots, /*Make sure the variable name is not grp, which is a fixed var
9081     ! used by the macro for other purpose;
9082       Whenever  makeheatmapdotintooneline=1 or 0, it is possible to use values of the var4label_scatterplot_dots to
9083       label specific scatterplot dots based on the customization of the variable predifined by users for the input data set;
9084       default is empty; provide a variable that include non-empty strings for specific dots in the
9085       scatterplots;*/
9086       var4mark_ld_scatterplot_dots=&var4mark_ld_scatterplot_dots,
9087       ld_marker_color=&ld_marker_color,
9088       ld_marker_legend_symbol=&ld_marker_legend_symbol,
9089       ld_heatmap_var=&ld_heatmap_var,
9090       ld_heatmap_colormodel=&ld_heatmap_colormodel,
9091       ld_heatmap_legend_title=&ld_heatmap_legend_title,
9092       adj_spaces_among_top_snps=&adj_spaces_among_top_snps /*Provide value 1 to adjust spaces among top SNP labels; otherwise,
9092     ! give value 0 to not
9093       adjust top SNPs labels if these labels are rotated 90 degree, which is helpful when the space adjusted labels are not
9093     ! pretty*/
9094       );
9095       %mend;
