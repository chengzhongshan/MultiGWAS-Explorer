2309       *Get min and max postive old y value for heatmap;
2310       proc sql noprint;
2311       select floor(min(old_y)),ceil(max(old_y)) into: min_old_y,: max_old_y
2312       from final;
2313       quit;
2314       *To exclude negative old_y in the range of min and max, use the following code;
2315       /*(where=(old_y>=0));*/
2316       
2317       *Adjust avgpos for scatter track labels if the xaxis_viewmin and xaxis_viewmax are provided with values;
2318       %let _avg_pos=%sysevalf(0.5*(&max_x+&min_x));
2319       %if (%length(&xaxis_viewmin)>0 and %length(&xaxis_viewmax)>0) %then %do;
2320         %let _avg_pos=%sysevalf(0.5*(&xaxis_viewmin+&xaxis_viewmax));
2321         %let xaxis_offset4min=%sysfunc(min(&xaxis_offset4min,0.01));
2322         %let xaxis_offset4max=%sysfunc(min(&xaxis_offset4max,0.005));
2323       %end;
2324       %if (%length(&xaxis_viewmin)=0 and %length(&xaxis_viewmax)>0) %then %do;
2325         %let _avg_pos=%sysevalf(0.5*(&min_x+&xaxis_viewmax));
2326         %let xaxis_offset4min=%sysfunc(min(&xaxis_offset4min,0.01));
2327         %let xaxis_offset4max=%sysfunc(min(&xaxis_offset4max,0.005));
2328       %end;
2329       %if (%length(&xaxis_viewmin)>0 and %length(&xaxis_viewmax)=0) %then %do;
2330         %let _avg_pos=%sysevalf(0.5*(&xaxis_viewmin+&max_x));
2331         %let xaxis_offset4min=%sysfunc(min(&xaxis_offset4min,0.01));
2332         %let xaxis_offset4max=%sysfunc(min(&xaxis_offset4max,0.005));
2333       %end;
