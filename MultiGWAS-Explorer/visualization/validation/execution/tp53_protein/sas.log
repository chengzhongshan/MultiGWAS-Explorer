5470       %macro SNP_Local_Manhattan_With_GTF(
5471       /*Note: this macro can draw CNVs and SNVs together. Please ensure the macro variable
5472       Variant_Length_Var is not empty, which contains distance of these CNVs (>1), with non-CNVs
5473       assigned with missing value, and the middle positions of these CNVs is required to be
5474       combined with that of SNVs and gene tracks!
5475       
5476       Tip 1: when there gene labels are cluttered within the gene track, it is feasible to
5477       resolve the issue by increasing the values for either variable pct4neg_y or dist2sep_genes or both!
5478       such as pct4neg_y and dist2sep_genes=1000000; alternatively, it also possible to address the problem
5479       by increase the width of figure, such as assigning larger value to the macro variable track_width=800.
5480       
5481         Tip 2: the figure width and height should ideally set around 500 and no less then 300 or greater than
5482       1000, as large figures are not good for publication purpose!
5483       
5484         Tip 3: For SNP labels on the top, please try to use this parameter, which only works when
5485       there are less than or equal to 3 top SNPs if track_width <= 500, or 4 top SNPs if track_width between 500 and 800, or 5
5485     ! top SNPs if
5486       track_width >=800, otherwise, this parameter will be excluded and even step will be used to separate them on the top!
5487       
5488        Tip 4: dist_pct_to_cluster_pos and pct2adj4dencluste (0.0001 to ~) can affect the top SNP labels positions when there
5488     ! are <= 3 or 4, or 5 SNP labels, as the its value
5489       dist_pct_to_cluster_pos will be internally replaced as 0.5/total number of top SNPs, and pct2adj4dencluste will be
5489     ! changed differently
5490       when make_even_pos=1, the macro will multiple the amplification_fc with 10*pct2adj4dencluster to further enlarge the even
5490     !  distance among positions;
5491       while if make_even_pos=0, it is useful when elements within a cluster is overlapped with each other or overlapped with
5491     ! elements from other cluster,
5492       so it is also feasible to avoid this issue by increasing or reducing the pct.
5493       
5494        Tip 5: In default, the scatterplot will use the transformed values of all variables inclued in the macro variable
5495       ZscoreVars into a variable for the lattice_subgrp_var to color dots differently across different scatter groups; User can
5495     !  supply
5496       an independent variable represented by the macro variable color_resp_var to color scatter plot dots but different
5496     ! scattergroups
5497       will be applied in a union style!
5498       */
5499       
5500       /*
5501       As this macro use other sub-macros, it is not uncommon that some global macro
5502       vars would be in the same name, such as macro vars chr and i, thus, to avoid of crash,
5503       chr_var is used instead of macro var chr in this macro;*/
5504       /*
5505       Important: there are many other parameters of the sub-macro Lattice_gscatter_over_bed_track,
5506       which can be modified by changing the default values for them to improve the quality of final produced figure!
5507       */
5508       
5509       focus_on_transcript=0,/*This will generate a subset exon GTF data set by
5510       replacing gene variable with ensembl transcript variable and removing rows
5511       with the type of "gene" and update transcript as "gene" to enable the macro
5512       to work on these transcripts instead of genes*/
5513       gwas_dsd=,
5514       chr_var=chr,
5515       AssocPVars=pval1 pval2,
5516       SNP_IDs=rs370604612 rs2070788 9:5114773,
5517       /*if providing chr:pos or chr:st:end, it will query by pos;
5518       Please also enlarge the dist2snp to extract the whole gene body and its exons,
5519       although the final plots will be only restricted by the input start and end positions!*/
5520       dist2snp=2000000,
5521       chromosome_lengths=,/*Comma-separated lengths for chromosomes 1-22, X, Y in the GWAS build.*/
5522       /*assign value in bp, and the final figure will be add extend this distance for both start and end positions*/
5523       SNP_Var=snp,
5524       Pos_Var=pos,
5525       Variant_Length_Var=,/*this variable if not empty, its value will be used to extend the value of Pos_Var for making
5526       the start and end position for SNP_Var, i.e., st=&Pos_Var-0.5*&Variant_Length_Var and
5526     ! end=&Pos_Var-0.5*&Variant_Length_Var;
5527       This would be especially helpful for mixing CNV and SNV data for making scatter plots, as it is only necessary
5528       to provide middle position for CNVs and its lengths for ploting CNVs and SNVs together!
5529       */
5530       gtf_dsd=FM.GTF_HG19,
5531       ZscoreVars=zscore1 zscore2,/*Can be beta1 beat2 or other numberic vars indicating assoc or other +/- directions,
5532       the values of which can be used to color scatter plots of association signals specifically for its corresponding scatter
5533       plot group membership for the following gwas labels. Please ensure makedotheatmap=1 and the input zscoreVars
5534       are in the same type of variable that can be used properly along with the heatmap feature*/
5535       gwas_labels_in_order=gwas1 gwas2,/*If providing _ for labeling each GWAS,
5536       the _ will be replaced with empty string, which is useful when wanting to remove gwas label
5537       if only one scatterplot or the label for a gwas containing spaces;
5538       The list will be used to label scatterplots
5539       by the sub-macro map_grp_assoc2gene4covidsexgwas*/
5540       design_width=500,/*Best width for publication, and usually used width rangs from 400 to 800*/
5541       design_height=500,/*Best height for publication, and usally used height rangs from 400 to 800*/
5542       image_dpi=300,/*Raster output DPI; the SAS ODA wrapper uses 150 to limit Java memory.*/
5543       barthickness=10, /*gene track bar thinkness*/
5544       dotsize=6,/*scatter data point size for the following macro variable scattermarker_symbol*/
5545       grp_font_size=8,/*font size for gene labels in the bottom gene track*/
5546       
5547       /*Important parameters for drawing SNVs and CNVs together*/
5548       scattermarker_symbol=circlefilled,/*Assign specific marker symbol, such as ibeam, circlefilled, circle, dot,
5548     ! squarefilled, or square, for scatter plot;
5549       Note the size of the designated marker symbol will be defined by the macro variable dotsize; when creating heatmap, you
5549     ! can assign
5550       squarefilled to the scattermarker_symbol, which would be more compatable with the highlow line style in for CNV or bed
5550     ! regions!*/
5551       highlow_line_cmd=%str(thickness=6 color=darkorange pattern=solid),/*For CNV bed regions, customize the following
5551     ! parameters using dot, dash, or solid line pattern
5552       with custome thickness and color for the line; please increase the thickness to match with that of
5553       dotsize=10 when scattermarker_symbol=squarefilled for the scatter plot, which will enable the square and the line
5554       in the same size and color*/
5555       
5556       dist2sep_genes=100000,/*Distance to separate close genes into different rows in the gene track; provide negative value or
5556     !  0
5557       to have all genes in a single row in the final gene track
5558       this will ensure these genes close to each other to
5559       be separated in the final gene track;
5560       (1) give 0 or negative value to plot ALL genes in the same line;
5561       (2) give value >0 and <1 to separate genes based on the pct distance to the whole region;
5562       (3) give value > 1 to use absolute distance to separate genes into different groups;
5563       Customize this for different gene exon track!*/
5564       where_cndtn_for_gwasdsd=%str(), /*where condition to filter input gwas_dsd*/
5565       
5566       shift_text_yval=0.1, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
5567                             to liftup or lower text labels on the y axis; the default value is -0.2 to put gene lable under
5567     ! gene tracks;
5568                             Change it with the macro var pct4neg_y!*/
5569       fig_fmt=png, /*output figure formats: svg, png, jpg, and others*/
5570       pct4neg_y=2, /*the most often used value is 1;
5571                     compacting the bed track y values by increasing the scatterplot scale,
5572                     which can reduce the bed trace spaces; It seems that two-fold increasement
5573                     leads to better ticks for different tracks!
5574                     Use value >1 will increase the gene tract, while value < 1 will reduce it!
5575                     Note: when there are only 1 or 2 scatterplots, it is better to provide value = 0.5;
5576                     Modify this parameter with the parameter shift_text_yval to adjust gene label!
5577                     Typically, when there are more scatterplots, it is necessary to increase the value of pct4neg_y accordingly
5577     ! ;
5578                     If there are only <4 scatterplots, the value would be usually set as 1 or 2;
5579                     */
5580       adjval4header=-0.2, /*In terms of header of each subscatterplot, provide postive value to move up scatter group header by
5580     !  the input value*/
5581       makedotheatmap=1,/*use colormap to draw dots in scatterplot instead of the discretemap;
5582       Note: if makedotheatmap=1, the scatterplot will not use the discretemap mode based on
5583       the negative and postive values of lattice_subgrp_var to color dots in scatterplot
5584       Note: the macro is updated to use heatmap to illustrate positve and negative values
5585       of scatter plot represented by the variable ZscoreVars in the sub macros
5586       map_grp_assoc2gene4covidsexgwas=>Multgscatter_with_gene_exons (HERE inside the 1st submacro)
5587       =>Lattice_gscatter_over_bed_track, and you can see the details by reading the
5588       parameters for  the 2nd sub macro used by the 1st sub mcro;
5589       Set it as 0 to use binary mode to color the negative and postive values in scatter plot*/
5590       
5591       /*Main color scheme for coloring dots in scatter plot with your quantitative color response variable
5592       Note: it is necessary to have makedotheatmap=1 and use the default heatmap_var or other quantitative
5593       variable with both negative and positive values to color the scatter plot; when the quantitative response
5594       variable is postive or negative, please change the heatmap_min_neg_val as 0 for postive values, meanwhile,
5595       for all negative values, please assign value 0 to heatmap_max_pos_val*/
5596       heatmap_var=AssocGrp,/*This variable is generated by transposing all ZscoreVars into a long format internally by the
5596     ! macro,
5597       thus, do not change this macro variable, just update ZscoreVars accordingly; the macro uses this var to draw scatter plot
5597     !  in heatmap
5598       with rangeattrmap instead of drawing dots using binary mode, such as 0 and 1 representing Pos
5599       and negative directions of latticen_subgrp_var!*/
5600       heatmap_Neg_rangealtcolormodel=darkgreen lightgreen deepskyblue,/*Range alt color model for negative values,
5600     ! heatmap_var<=0,  in heatmap*/
5601       heatmap_Pos_rangealtcolormodel=gold mediumred vipk,/*Range alt color model for positve values, heatmap_var>=0, in
5601     ! heatmap*/
5602       heatmap_min_neg_val=-8,/*Minimum negative value for the heatmap_var when it is not empty;
5603       change this to customize the minimum value for colorbar in heatmap*/
5604       heatmap_max_pos_val=8,/*Maximum postive value for the heatmap_var when it is not empty;
5605       change this to customize the max value for colorbar in heatmap*/
5606       
5607       /*Alternative color scheme for categorical color response variable! Please keep it in default
5608       value if you don't want to use it for your quantitative color response variable*/
5609       
5610       color_resp_var=,/*Use the variable to draw colormap of dots in scatterplots with colors
5611       supplied by a later macro variable dataContrastCols that are specifically designated for
5612       scatterplot dots but not other tracks under the scatter plots, such as gene tracks;.
5613       previously if the macro var is empty, the default var would be the same as that of yval_var;
5614       Later it is updated to enable the macro to use lattice_subgrp_var but not yval_var when
5615       this color_resp_var is empty! A later macro variable dataContrastCols will be used
5616       to supply colors for different groups of the variable solely for coloring scatterplot dots!*/
5617       fixedcols4tracksunderscatter=cyan blue, /*when color_resp_var is not empty, all tracks under scatterplots will be fixed
5617     ! with
5618       two different colors, including cyan and blue, represented by the macro var fixedcols4tracksunderscatter!*/
5619       color_resp_grpdsd=,/*this dataset contains two columns, including &color_resp_var and the fixed
5620       variable numgrp4color_resp,which are corresponding to the unique char color_resp_var and
5621       its associated numeric var that would be sorted to order these char color_resp_var in the final figure legend!
5622       Note: for color_resp_var not included in the dataset, they will be asigned as Others;
5623       Custom colors with the same number of unique color_resp_var for these groups can be provided to
5624       a latter macro variable dataContrastCols*/
5625       dataContrastCols=%str(darkblue darkgreen darkred darkyellow
5626       CXFFF000 CXFF7F00 CXFF00FF CXFF0000 CXEAADEA CXE6E8FA CXDB9370 CXDB70DB CXD9D919 CXD8D8BF
5627       CXCD7F32 CXC0C0C0 CXBC8F8F CXB87333 CXB5A642 CXADEAEA CXA67D3D CXA62A2A CX9F9F5F CX9F5F9F
5628       CX97694F CX8E236B CX8E2323 CX8C7853 CX8C1717 CX871F78 CX856363 CX855E42 CX70DB93 CX5F9F9F
5629       CX5C4033 CX545454 CX4F2F4F CX4E2F2F CX32CD32 CX2F4F2F CX238E23 CX236B8E CX23238E CX00FFFF
5630       CX00FF00 CX0000FF CX000000
5631       ),
5632       /*Note: these colors will be used for the scatterplot and gene track together when color_resp_var is a char var, so it is
5632     !  difficult control*/
5633       
5634       makeheatmapdotintooneline=0,/*This will make all dots have the same yaxis value but have different colors
5635       based on its real value in the heatmap plot; To keep the original dot y axis value, assign 0 to the macro var
5636       This would be handy when there are multiple subgrps represented by different y-axis values! By modifying
5637       the y-axis values for these subgrps, the macro can plot them separately in each subtrack!
5638       */
5639       var4label_scatterplot_dots= ,/*Make sure the variable name is not grp, which is a fixed var used by the macro for other
5639     ! purpose;
5640       the variable should contain values of target SNPs and other non-targets are asigned with empty values;
5641       Whenever  makeheatmapdotintooneline=1 or 0, it is possible to use values of the var4label_scatterplot_dots to
5642       label specific scatterplot dots based on the customization of the variable predifined by users for the input data set;
5643       default is empty; provide a variable that include non-empty strings for specific dots in the
5644       scatterplots;*/
5645       SNPs2label_scatterplot_dots=, /*Add multiple SNP rsids to label dots within or at the top of scatterplot
5646       Note: if this parameter is provided, it will replace the parameter var4label_scatterplot_dots!
5647       If there are too much space on the top for these SNP labels, please manually change default value of
5648       the macro variable yoffset4max_drawmarkersontop included in the macro Lattice_gscatter_over_bed_track
5649        from 0.2 to a smaller value, such as 0.1;
5650       */
5651       LD_SNPs2mark_scatterplot_dots=, /*Optional space-delimited LD-linked SNPs overlaid with the selected marker on every
5651     ! association track.*/
5652       LD_marker_symbol=*, /*Marker text for LD-linked SNPs: *, +, x, o, s, ^, or d.*/
5653       LD_marker_color=black, /*SAS color name or CXrrggbb value for LD-linked SNP markers.*/
5654       LD_r2_values=, /*Space-delimited SNP:r2 pairs used by the optional LD heatmap overlay.*/
5655       LD_r2_var=LD_R2, /*Numeric LD column uploaded with the GWAS plotting dataset.*/
5656       LD_reference_snp=, /*Explicit LD reference SNP; falls back to the first labeled SNP when omitted.*/
5657       LD_display_mode=none, /*none, markers, heatmap, or both. LD display is opt-in.*/
5658       LD_heatmap_colormodel=CXF7FBFF CX6BAED6 CX54278F, /*Retained for legacy marker-overlay mode.*/
5659       LD_heatmap_legend_title=%str(LD r2),
5660       text_rotate_angle=90, /*Angle to rotate text labels for these selected dots by users*/
5661       label_position_overrides=, /*Optional SNP=BP list computed before SAS to avoid label collisions.*/
5662       font_size4textlabels=10, /*Actual text size used by the Perl label planner and SAS renderer.*/
5663       label_headroom_frac=,
5664       label_center_offset=,
5665       auto_rotate2zero=1, /*supply value 1 when there are <=3 text labels and you want them kept horizontal in the top
5665     ! headroom*/
5666       pct2adj4dencluster=2,/*Input value can be ranging from 0.0001 to 10 or even higher value!
5667       For SNP labels on the top, please try to use this parameter, which only works when
5668       there are less than or equal to 3 top SNPs if track_width <= 500, or 4 top SNPs if track_width between 500 and 800, or 5
5668     ! top SNPs if
5669       track_width >=800, otherwise, this parameter will be excluded and even step will be used to separate them on the top!
5670       and SNPs within a cluster are overlapped with each other or overlapped with elements from other SNP cluster, so it is
5670     ! feasible to
5671       avoid this issue by increasing the pct or reducing it, respectively*/
5672       yoffset4max_drawmarkersontop=0.25, /*If draw scatterplot marker labels on the top of track,
5673        this fixed value will be used instead of yaxis_offset4max!*/
5674       Yoffset4textlabels=3.5, /*Move up the text labels for target SNPs in specific fold;
5675       the default value 2.5 fold works for most cases*/
5676       scatter_yaxis_label=%str(-log10%(P%)),/*Visible y-axis title for the stacked association tracks*/
5677       heatmap_legend_title=%str(Z score),/*Visible title for the continuous colorbar when heatmap coloring is enabled*/
5678       adj_spaces_among_top_snps=1,/*Provide value 1 to adjust spaces among top SNP labels; otherwise, give value 0 to not
5679       adjust top SNPs labels if these labels are rotated 90 degree, which is helpful when the space adjusted labels are not
5679     ! pretty*/
5680       verbose=0 /*Not print any notes in SAS log*/
5681       );
5682       
5683       %local effective_ld_marker_var effective_ld_heatmap_var effective_heatmap_legend_title effective_plot_title
5683     ! _chrom_end_for_window;
5684       %let effective_ld_marker_var=;
5685       %let effective_ld_heatmap_var=;
5686       %let effective_heatmap_legend_title=&heatmap_legend_title;
5687       
5688       %*It is better to output these notes into the log for AI;
5689       %*However, too large number of notes will slow down the pipeline dramatically;
5690       %*Thus, we will only print these notes when verbose=1;
5691       %if &verbose=0 %then %do;
5692       %put To prevent too many notes printed in the SAS log, we will enable options nonotes;
5693       options nonotes;
5694       %end;
5695       
5696       
5697       *Note: the macro map_grp_assoc2gene4covidsexgwas requires the input dsd contain the var chr;
5698       %if "&chr_var"^="chr" %then %do;
5699       data &gwas_dsd;
5700       set &gwas_dsd;
5701       chr=&chr_var;
5702       run;
5703       %end;
5704       
5705       *Add a compact star-overlay variable for LD-linked SNPs.;
5706       %if %length(&LD_SNPs2mark_scatterplot_dots)>0 and
5707           (%upcase(&LD_display_mode)=MARKERS or %upcase(&LD_display_mode)=BOTH) %then %do;
5708        %let effective_ld_marker_var=_LD_SNP_MARK_;
5709        data &gwas_dsd;
5710        set &gwas_dsd;
5711        length _LD_SNP_MARK_ $8.;
5712        _LD_SNP_MARK_="";
5713        %do _li_=1 %to %ntokens(&LD_SNPs2mark_scatterplot_dots);
5714          if &SNP_Var="%scan(&LD_SNPs2mark_scatterplot_dots,&_li_,%str( ))" then _LD_SNP_MARK_="&LD_marker_symbol";
5715        %end;
5716        run;
5717       %end;
5718       
5719       *Add a numeric r2 overlay variable from the uploaded LD_R2 column.;
5720       %if (%upcase(&LD_display_mode)=HEATMAP or %upcase(&LD_display_mode)=BOTH) %then %do;
5721        %let effective_ld_heatmap_var=_LD_R2_;
5722        data &gwas_dsd;
5723        set &gwas_dsd;
5724        _LD_R2_=&LD_r2_var;
5725        %let _ld_reference_snp_=&LD_reference_snp;
5726        %if %length(&_ld_reference_snp_)=0 %then %let _ld_reference_snp_=%scan(&SNPs2label_scatterplot_dots,1,%str( ));
5727        %if %length(&_ld_reference_snp_)=0 %then %let _ld_reference_snp_=%scan(&SNP_IDs,1,%str( ));
5728        if missing(_LD_R2_) and upcase(&SNP_Var)=upcase("&_ld_reference_snp_") then _LD_R2_=1;
5729        %if %length(%superq(LD_r2_values))>0 %then %do;
5730          %do _li_=1 %to %ntokens(&LD_r2_values);
5731            %let _ld_pair_=%scan(&LD_r2_values,&_li_,%str( ));
5732            if upcase(&SNP_Var)=upcase("%scan(&_ld_pair_,1,%str(:))") then
5733              if missing(_LD_R2_) then _LD_R2_=input("%scan(&_ld_pair_,2,%str(:))",best32.);
5734          %end;
5735        %end;
5736        run;
5737        %let effective_signed_r2=1;
5738        %let effective_ld_heatmap_var=;
5739       %end;
5740       %else %let effective_signed_r2=0;
5741       %let effective_zscore_vars=&ZscoreVars;
5742       %let effective_heatmap_min_neg_val=&heatmap_min_neg_val;
5743       %let effective_heatmap_max_pos_val=&heatmap_max_pos_val;
5744       %if &effective_signed_r2=1 %then %do;
5745         %let effective_zscore_vars=;
5746         data &gwas_dsd;
5747         set &gwas_dsd;
5748         %do _zi_=1 %to %sysfunc(countw(&ZscoreVars));
5749           _SIGNED_R2_&_zi_=0;
5750           if not missing(_LD_R2_) then do;
5751             if %scan(&ZscoreVars,&_zi_) < 0 then _SIGNED_R2_&_zi_=-_LD_R2_;
5752             else if %scan(&ZscoreVars,&_zi_) > 0 then _SIGNED_R2_&_zi_=_LD_R2_;
5753           end;
5754         %end;
5755         run;
5756         %do _zi_=1 %to %sysfunc(countw(&ZscoreVars));
5757           %let effective_zscore_vars=&effective_zscore_vars _SIGNED_R2_&_zi_;
5758         %end;
5759         %let effective_heatmap_min_neg_val=-1;
5760         %let effective_heatmap_max_pos_val=1;
5761         %let effective_heatmap_legend_title=&LD_heatmap_legend_title;
5762       %end;
5763       
5764       *Add labels for target SNPs if they exist;
5765       %if %length(&SNPs2label_scatterplot_dots)>0 %then %do;
5766        %let var4label_scatterplot_dots=_Target_SNP_;
5767       data &gwas_dsd;
5768       set &gwas_dsd;
5769       length _Target_SNP_ $25.;
5770        _Target_SNP_="";
5771        %do _si_=1 %to %ntokens(&SNPs2label_scatterplot_dots);
5772           if &SNP_Var="%scan(&SNPs2label_scatterplot_dots,&_si_,%str( ))" then _Target_SNP_=&SNP_Var;
5773        %end;
5774       run;
5775       %end;
5776       
5777       %do snpi=1 %to %ntokens(&SNP_IDs);
5778         *query SNP using the index snpi (do not use i that may interupt with other macro var i used other sub-macros!);
5779         %let qsnp=%scan(&SNP_IDs,&snpi,%str( ));
5780          %if %sysfunc(countc(&qsnp,%str(:)))=1 %then %do;
5781             *Manually add the start position as end position when the input is in the format of chrNum:Pos!;
5782             %let qsnp=%sysfunc(prxchange(s/^([^:]+):(\d+)/$1:$2:$2/,-1,&qsnp));
5783          %end;
5784         *determine whether input snp is a chrpos based markder;
5785         %if %sysfunc(prxmatch(/:/,&qsnp)) %then %do;
5786           %let qsnp=%sysfunc(prxchange(s/chr//i,-1,&qsnp));
5787           %let chrposquery=1;
5788           %let num_chr=%scan(&qsnp,1,%str(:));
5789           %let tgt_pos=%scan(&qsnp,2,%str(:));
5790       
5791           %let st_pos=%sysevalf(&tgt_pos-&dist2snp);
5792           %let end_pos=%sysevalf(&tgt_pos+&dist2snp);
5793       
5794           %if %sysfunc(countc(&qsnp,%str(:)))>1 %then %do;
5795            /*To keep the proc sql codes consistant for creating macros vars of minst and maxend;
5796            The position range need to be adjusted by dist2snp, because the proc sql command
5797            will substract and add the dist2snp to the st and end positions; By adding and substracting
5798            the dist2snp from st and end position, respectively, the final minst and maxend will
5799            be the same as the input st and end positions!*/
5800            %if &dist2snp<50000000 %then %do;
5801             %let st_pos=%sysevalf(%scan(&qsnp,2,%str(:)) - 50000000);
5802             %let end_pos=%sysevalf(%scan(&qsnp,3,%str(:)) + 50000000);
5803            %end;
5804            %else %do;
5805             %let st_pos=%sysevalf(%scan(&qsnp,2,%str(:)) - &dist2snp);
5806             %let end_pos=%sysevalf(%scan(&qsnp,3,%str(:)) + &dsdt2snp);
5807            %end;
5808           %end;
5809       
5810         %end;
5811         %else %do;
5812           %let chrposquery=0;
5813           %if %sysfunc(prxmatch(/^rs/i,&qsnp)) and &dist2snp<10000 %then %do;
5814             %put Please be noted that your query SNP is rsid (&qsnp);
5815             %put It is necessary to expand the searching region > +/-10kb to get genes that cover the variant and specific
5815     ! genes!;
5816             %abort 255;
5817           %end;
5818         %end;
5819       
5820         title "Query SNP is &qsnp";
5821         proc sql noprint;
5822         select &chr_var,&SNP_Var,minst,maxend
5823         into: chr,:snp,:minst,:maxend
5824         from (
5825         select &chr_var,&SNP_Var,&Pos_Var-&dist2snp as minst,&Pos_Var+&dist2snp as maxend
5826         from &gwas_dsd
5827         %if &chrposquery=0 %then %do;
5828           where &SNP_Var="&qsnp"
5829         %end;
5830         %else %do;
5831           where &chr_var=&num_chr and
5832           (&Pos_Var between
5833             &st_pos and &end_pos
5834           )
5835         %end;
5836         );
5837         %if %sysfunc(countc(&qsnp,%str(:)))=2 %then %do;
5838            /*To keep the proc sql codes consistant for creating macros vars of minst and maxend;
5839            The position range need to be adjusted by dist2snp, because the proc sql command
5840            will substract and add the dist2snp to the st and end positions; By adding and substracting
5841            the dist2snp from st and end position, respectively, the final minst and maxend will
5842            be the same as the input st and end positions!*/
5843            %let chr=%scan(&qsnp,1,%str(:));
5844            %let minst=%sysevalf(%scan(&qsnp,2,%str(:))-&dist2snp);
5845            %let maxend=%sysevalf(%scan(&qsnp,3,%str(:))+&dist2snp);
5846         %end;
5847       
5848         %if %symexist(chr)=0 %then %do;
5849          %put no record for your query SNP &qsnp;
5850          %abort 255;
5851         %end;
5852         %if %length(%superq(chromosome_lengths))>0 %then %do;
5853           /* PROC SQL can pad numeric chromosome values in macro variables. Strip
5854              that padding before checking the chromosome and looking up its length. */
5855           %let _chrom_for_window=%sysfunc(strip(%superq(chr)));
5856           %if %sysfunc(prxmatch(/^(?:[1-9]|1[0-9]|2[0-4])$/,%superq(_chrom_for_window))) %then %do;
5857             %let _chrom_end_for_window=%scan(%superq(chromosome_lengths),&_chrom_for_window,%str(,));
5858             %if %sysevalf(&maxend>&_chrom_end_for_window) %then %do;
5859               %put NOTE: Clipping the local GTF x-axis for chromosome &_chrom_for_window from &maxend to its reference end
5859     ! &_chrom_end_for_window.;
5860               %let maxend=&_chrom_end_for_window;
5861             %end;
5862           %end;
5863         %end;
5864         %let force_lattice_xaxis_viewmin=&minst;
5865         %let force_lattice_xaxis_viewmax=&maxend;
5866         %if %sysevalf(&force_lattice_xaxis_viewmin<1) %then %let force_lattice_xaxis_viewmin=1;
5867         %put Your input three parameters for the SNP &qsnp are: chr=&chr minst=&minst maxend=&maxend;
5868         %put NOTE: The displayed x-axis for &qsnp will use the requested SNP-centered window [&force_lattice_xaxis_viewmin,
5868     ! &force_lattice_xaxis_viewmax].;
5869       
5870         /* SAS ODA already has the HTML5 plot destination open. The extra printer
5871            destination renders a second 300-DPI bitmap and can exhaust Java memory. */
5872         %if not %symexist(local_gtf_ods_html5) %then %do;
5873           %OpenSVG_Printer(
5874            filename=Local_SNP_Manhattanplot,
5875            svgfileref=out,
5876            other_paras4ods_graphics=%str(noborder)
5877            );
5878         %end;
5879       /*  %abort 255;*/
5880         %if &effective_signed_r2=1 %then
5881           %let effective_plot_title=Signed LD r2 x sign(Z score): &qsnp;
5882         %else
5883           %let effective_plot_title=Z-score-colored local Manhattan: &qsnp;
5884         title "&effective_plot_title";
