7247       
7248       %macro format_xaxis_with_numeric_order(
7249       dsdin,
7250       Xaxis_vars,
7251       new_Xaxis_var,
7252       Var4sorting_Xaxis,
7253       function4sorting,
7254       descending_or_not,
7255       dsdout,
7256       createdfmtname,
7257       KeyVar4Xaxis_vars=KeyVar4dsdout
7258       );
7259       
7260       *If AlsoAppFun4Cols=1, will apply specific function on each row or ALL Rows (if row_keys is missing) for ALL these
7260     ! matched columns;
7261       *For AlsoAppFun4Cols=1, we can not use avg but mean, because avg is going to calculate mean based on group and mean is to
7261     !  calculate mean of different columns;
7262       *Should be careful to use this function to calculate mean of ALL data points.;
7263       *Note: KeyVar4dsdout will try to catx all row_keys with ':';
7264       %ApplyFunc_rowwide(dsdin=&dsdin
7265                         ,row_keys=&Xaxis_vars
7266                         ,KeyVar4dsdout=KeyVar4dsdout
7267                         ,Regex4col_vars2apply=&Var4sorting_Xaxis
7268       				  ,SQL_Fun4apply=&function4sorting
7269                         ,dsdout=Sorted_dsd
7270                         ,AlsoAppFun4Cols=1);
7271       %put Xaxis_vars are &Xaxis_vars;
7272       
7273       *Add numeric grp id to each grp with the order in accordace with the summary of &var4sorting after applied for the
7273     ! function &function4sorting by grp;
7274       *New variable &function4sorting will be created, which can be used to sort the new variable dataset;
7275       *If supplying ONE or multiple vars into grp_vars4sort, a default new var combining all these vars with ':' will be
7275     ! created;
7276       *which is grps_output_key;
7277       %char_grp_to_num_grp(dsdin=Sorted_dsd,grp_vars4sort=&function4sorting
7277     ! KeyVar4dsdout,descending_or_not=&descending_or_not,dsdout=Sorted_dsd1,num_grp_output_name=&new_Xaxis_var);
7278       
7279       /*catx Xaxis_vars*/
7280       data var_labels;
7281       set Sorted_dsd1;
7282       *remove leading grp generated by supplied function;
7283       grps_output_key=prxchange('s/^[^:]+://',-1,grps_output_key);
7284       keep grps_output_key &new_Xaxis_var KeyVar4dsdout;
7285       run;
7286       
7287       proc sql noprint;
7288       select count(grps_output_key), catx('','grp',count(grps_output_key)) into: vtot, : grp_v
7289       from var_labels;
7290       select grps_output_key into: vvgrp1 - : vv&grp_v
7291       from var_labels;
7292       
7293       *Print it for debugging;
7294       %do xi=1 %to &vtot;
7295          %put Apply format for &xi="&&vvgrp&xi";
7296       %end;
7297       
7298       *Delete previous format, otherwise the new format will not be applied;
7299       /*
7300       proc format lib=work fmtlib;
7301       run;
7302       */
7303       
7304       proc catalog cat=work.formats;
7305       delete &createdfmtname..format;
7306       run;
7307       
7308       proc format;
7309       value &createdfmtname
7310       %do i=1 %to &vtot;
7311               &i="&&vvgrp&i"
7312       %end;
7313       ;
7314       data &dsdin;
7315       set &dsdin;
7316       KeyVar4dsdout=catx(':',of &Xaxis_vars);
7317       run;
7318       
7319       proc sql;
7320       create table &dsdin._tmp as
7321       select a.*,
7322              b.&new_Xaxis_var,
7323              b.grps_output_key
7324       from &dsdin as a
7325       left join
7326       var_labels as b
7327       on strip(left(a.KeyVar4dsdout))=strip(left(b.KeyVar4dsdout))
7328       ;
7329       
7330       *This actually not helpful;
7331       data &dsdout;
7332       set &dsdin._tmp;
7333       num_grp=&new_Xaxis_var;
7334       /*Will change it manually outside the macro later*/
7335       attrib &new_Xaxis_var format=&createdfmtname..;
7336       run;
7337       
7338       *Note: new evaluation revealed that the above format is not useful;
7339       *The variable KeyVar4Xacis_vars can not used to draw plot with numeric order directly.;
7340       proc sort data=&dsdout;by num_grp;run;
7341       data &dsdout;
7342       set &dsdout;
7343       rename KeyVar4Xaxis_vars=&KeyVar4Xaxis_vars;
7344       run;
7345       
7346       %mend;
