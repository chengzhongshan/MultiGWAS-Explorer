9422       %macro spaceAdjust(
9423       /*
9424        This macro can generate new numbers by adjusting its distance space
9425        in the sorted numbers, so please ensure the input dataset containing
9426       numbers that are sorted in ascending order; if the input is a list, the macro
9427       will generate a sorted dataset and generate adjust numbers automatically.
9428       */
9429       data=, /*Input dsd with long format with vars like col1-coln
9430       or a list containing blank space separated elements*/
9431       out=, /*out dsd in long format but only contains one column AdjPos*/
9432       goal=COL:,/*Target column vars in the input data set, such as col1-coln*/
9433       sep=, /*Minimum distance to separate numbers in the input data set and
9434       adjust the number by ensuring its distances to left and right numbers
9435       at least greater than the minimum distance*/
9436       newvar4adjnum=AdjPos /*Create a new variable to contain these
9437       position adjusted numers*/);
9438       
9439       %if %ntokens(&data)>=1 and %sysfunc(prxmatch(/^\d[\.E\d\s]+/,&data/)) %then %do;
9440          %put The macro will transform the input list: &data;
9441          %put into a sas dataset in wide-format that all vars col1-coln containing these input elements;
9442          %rank4grps(
9443           grps=&data,
9444           dsdout=&out);
9445           data &out;
9446           set &out;
9447           value=grps+0;
9448           *Need to sort these numeric values;
9449           proc sort data=&out;by value;run;
9450           proc transpose data=&out(keep=value) out=&out(drop=_name_);
9451           var value;
9452           run;
9453           %let goal=col:;
9454           %let data=&out;
9455       %end;
9456       
9457         *First save a copy of input dataset for later merging with adjust positions;
9458         data _old_;
9459         set &data;
9460         run;
9461       /*proc print;run;*/
9462       /*%abort 255;*/
9463       
9464       %let nvars=%TotVarsInDsd(&data,var_type=_numeric_);
9465       /*  %abort 255;*/
9466         *Now generate adjust positions for these input numbers;
9467       /*
9468       https://www.lexjansen.com/pharmasug/2010/CC/CC05.pdf
9469       It is important to add options nosyntaxcheck here before the data step that is prone to error;
9470       otherwise, other procedures followed the failed data step will be under the environment of
9471       options obs=0; adding this is the only solution when running sas codes in batch mode!
9472       */
9473       OPTIONS NOSYNTAXCHECK;
9474       data &out.new;
9475               set &data.;
9476       		*Need to make a copy for these input numbers;
9477               array u(*) u1-u&nvars;
9478       		*The input numbers will be changed during evaluation in the array w;
9479               array w(*) &goal.;
9480               eps1000 = 1000*1E-12; /* SAS equivalent for precision */
9481               n = dim(w);
9482               v = &sep.;
9483       
9484               /* Initialize output */
9485       		*Ensure these _i_ and _ii_ will not interupt other similar loop vars;
9486       		do _i_=1 to n;
9487                 u[_i_] = w[_i_];
9488       		end;
9489               do _ii_ = 2 to n;
9490                   w[_ii_] = max(w[_ii_-1] + v, u[_ii_]);
9491               end;
9492       
9493               moving = 1;
9494       		*Only try 500 times optimization, which would prevent the macro run forever;
9495       		nmoving=1;
9496               do while (moving and nmoving<=500);
9497                   moving = 0;
9498       			nmoving+1;
9499       
9500                   i = 1;
9501       			*It is important to restrict the i < n;
9502       			*when i=n, the loop will fail;
9503                   do while (i <n);
9504                       /* Find next block */
9505                       b = 0;
9506                       do j = i to n-1;
9507                           b+1;*It is necessary to put b+1 here before the leave command!;
9508                           if abs(w[j+1] - w[j] - v) > eps1000 then leave;
9509                           /*b + 1;*/
9510                       end;
9511       
9512       				*Get the last block;
9513       				*Important: assign b=n-1 if b=0;
9514       				if b=0 then b=n-1;
9515       
9516                       sum_u=0;
9517                       sum_w=0;
9518                       do jj=i to i+b;
9519                         sum_u+u[jj];
9520                         sum_w+w[jj];
9521                       end;
9522       
9523                       sh = sum_u/(1+b) - sum_w/(1+b);
9524                       if abs(sh) > eps1000 then do;
9525       				   if i=1 then leftLim=-1E12;
9526       				   else leftLim=w[i-1]+v;
9527       				   if i+b=n then rightLim=1E12;
9528       				   else rightLim=w[i+b+1]-v;
9529       /*				   The following will fail, as ifn will evaluate w[i-1] even when i=1;*/
9530       /*                    leftLim  = ifn(i=1, -1E12, w[i-1] + v);*/
9531       /*                    rightLim = ifn(i+b=n, 1E12, w[i+b+1] - v);*/
9532                           if w[i] + sh < leftLim then sh = leftLim - w[i];
9533                           if w[i+b] + sh > rightLim then sh = rightLim - w[i+b];
9534       
9535                           do jjj = i to i+b;
9536                               w[jjj] = w[jjj] + sh;
9537                           end;
9538                           moving = 1;
9539                       end;
9540                       i = i + b + 1;
9541                   end;
9542       
9543                   /* Move singles */
9544       			/*Use xi but not i*/
9545       
9546       /*Matlab original codes for debugging;
9547       	nloop=0;
9548           while ~isempty(i) && nloop<500
9549               k0 = abs(diff(w)-v)>eps1000;
9550               nloop=nloop+1;
9551               for i = find(([1 k0] & w>u) | ([k0 1] & w<u))
9552                   if i==1; leftLim  =-inf; else leftLim  = w(i-1)+v; end
9553                   if i==n; rightLim = inf; else rightLim = w(i+1)-v; end
9554                   w(i) = max(min(u(i),rightLim),leftLim);
9555                   moving = true;
9556               end
9557           end
9558       end % moving
9559       *The following implements the above matlab codes in SAS;
9560       */
9561       
9562       		k0=1;
9563       		niters=0;
9564       		 do while (k0 and niters<=500);
9565                   do xi = 1 to n;
9566       			 if xi=1 and w[xi]>u[xi] then k0=1;
9567                    if xi=n and w[xi]<u[xi] then k0=1;
9568                    if xi>1 and xi<n then k0 = abs(w[xi] - w[xi-1] - v) > eps1000;
9569                       if k0 then do;
9570       				   if xi=1 then leftLim=-1E12;
9571                          else leftLim  = w[xi-1] + v;
9572                          if xi=n then rightLim=1E12;
9573                          else rightLim = w[xi+1] - v;
9574                          w[xi] = max(min(u[xi], rightLim), leftLim);
9575                           moving = 1;
9576       					*Note: when xi=n, the 1st while loop relying on moving=1 might break;
9577       					*For debugging, comment out the following code to test the scenario;
9578       					*if xi=n then moving=0;
9579       					niters+1;
9580                       end;
9581                   end;
9582       		 end;
9583               end;
9584           run;
9585       /*proc print data=_old_;run;*/
9586       /* %abort 255;*/
9587       %if %totobsindsd(&out.new)=0 %then %do;
9588          %put failed to generate adjusted dataset &out.new;
9589          %put try to use the original input dataset &data without adjustment;
9590          OPTIONS NOSYNTAXCHECK;
9591          data &out;
9592          set _old_;
9593          run;
9594       %end;
9595       %else %do;
9596         data &out;
9597         set &out.new;
9598         run;
9599       %end;
9600       /*
9601       proc print data=&out;run;
9602       %abort 255;
9603       */
9604       
9605       data &out;
9606       set &out;
9607       keep Col:;
9608       proc transpose data=&out out=&out(rename=(col1=&newvar4adjnum) drop=_name_);
9609       var Col:;
9610       run;
9611       
9612       *Now combine the adjust and original numbers;
9613       proc transpose data=_old_ out=_old_(drop=_name_ rename=(col1=orig_num));
9614       var _numeric_;
9615       run;
9616       data &out;
9617       merge _old_ &out;
9618       run;
9619       proc datasets nolist;
9620       delete _old_;
9621       run;
9622       %mend spaceAdjust;
