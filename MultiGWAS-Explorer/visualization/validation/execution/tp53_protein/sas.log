9166       start = _N_ + &numstarter - 1;
9167       rename &grp_var=label;
9168       fmtname = "&outfmt4chargrps";
9169       type = "n";
9170       run;
9171       proc format cntlin=fmt4chargrps&rnd;
9172       run;
