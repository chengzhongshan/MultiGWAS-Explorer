10820      %long2wide4multigrpsSameTypeVars(
10821      long_dsd=&SNP_long_dsd,
10822      outwide_dsd=&subset_gwas_dsd,
10823      grp_vars=&gwas_snp_var &gwas_chr_var &gwas_pos_var &var4label_scatterplot_dots,/*If grp_vars and SameTypeVars are
10823    ! overlapped,
10824      the macro will automatically only keep it in the grp_vars;
10825      grp_vars can be multi vars separated by space, which
10826      can be numeric and character*/
10827      subgrpvar4wideheader=&gwas_dsd_var,/*This subgrpvar will be used to tag all transposed SameTypeVars
10828      in the wide table, and the max length of this var can not be >32!*/
10829      dlm4subgrpvar=.,/*string used to split the subgrpvar if it is too long*/
10830      ithelement4subgrpvar=1,/*Keep the nth splitted element of subgrpvar and use it for tag
10831      in the final wide table*/
10832      SameTypeVars=_numeric_, /*These same type of vars will be added with subgrp tag in the
10833      final wide table; Make sure they are either numberic or character vars and not
10834      overlapped with grp_vars and subgrpvar!*/
10835      debug=0 /*print the first 2 records for the final wide format dsd*/
10836      );
10837      /*%abort 255;*/
10838      %BookGDCDropCoordinates(data=&subset_gwas_dsd,chr=&gwas_chr_var,pos=&gwas_pos_var);
10839      
