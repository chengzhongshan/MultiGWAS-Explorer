13201         *******************************************************************************************************;
13202           proc sort data=_xtag_;
13203           by &var4label_scatterplot_dots pos;
13204           run;
13205      
13206           data _xtag_;
13207           set _xtag_;
13208           by &var4label_scatterplot_dots;
13209           if first.&var4label_scatterplot_dots;
13210           run;
13211      
13212           /*
13213             _xtag_ contains only the requested label rows.  Update their adjusted
13214             x positions directly in FINAL with a hash lookup.  The former
13215             CREATE TABLE FINAL AS SELECT ... FROM FINAL required a second complete
13216             438-column table plus SQL utility space and could disconnect SAS ODA
13217             when WORK filled.
13218           */
13219           data final;
13220             if _n_=1 then do;
13221               declare hash _label_positions(
13222                 dataset:"_xtag_(keep=&var4label_scatterplot_dots pos newpos)",
13223                 duplicate:"r"
13224               );
13225               _label_positions.defineKey("&var4label_scatterplot_dots", "pos");
13226               _label_positions.defineData("newpos");
13227               _label_positions.defineDone();
13228             end;
13229             modify final;
13230             if &var4label_scatterplot_dots^="" and pos^=. then do;
13231               if _label_positions.find()=0 then &lattice_subgrp_var=0;
13232             end;
13233             label top_y4label="&yaxis_label";
13234             replace;
13235           run;
13236         *Need to enlarge the macro var yaxis_offset4max to be 0.1;
13237         %let yaxis_offset4max=&yoffset4max_drawmarkersontop;
13238         *Get the positions of these selected markers for making vertical reflines later;
13239         *Note: it is important to use put to change larger number into str frist;
13240         *otherwise, sas will automatically round the large number to nearest number;
13241         *resulting into the wrong number for the newly created macro var markers_pos;
13242         %let markers_pos=;
13243         %let new_markers_pos=;
13244         proc sql noprint;
13245         select put(pos,best32.),put(newpos,best32.) into: markers_pos separated by ' ',:new_markers_pos separated by ' '
13246         from _xtag_;
13247         select count(*) into: n_marker_labels trimmed
13248         from _xtag_;
13249         select max(lengthn(strip(&var4label_scatterplot_dots)))
13250           into: _max_marker_label_chars trimmed
13251         from _xtag_;
13252      
13253         %put Your marker positions are as follows:;
13254         %put &markers_pos;
13255         %put Total marker labels requested on the top are: &n_marker_labels;
13256      
13257      %if %sysevalf(%superq(n_marker_labels)=,boolean) %then %let n_marker_labels=0;
13258      %if %sysevalf(%superq(_max_marker_label_chars)=,boolean) %then %let _max_marker_label_chars=0;
13259         %let _scatter_track_count=&totsc;
13260         %if %sysevalf(%superq(_scatter_track_count)=,boolean) %then %let _scatter_track_count=1;
13261         %if %sysevalf(&_scatter_track_count<1) %then %let _scatter_track_count=1;
13262         %let _scatter_y_span=%sysevalf(&max_y-&min_y+0.2);
13263         %if %sysevalf(&_scatter_y_span<=0) %then %let _scatter_y_span=%sysevalf(&max_y+0.2);
13264         %if %sysevalf(&_scatter_y_span<=0) %then %let _scatter_y_span=1;
13265         %let _avg_signal_span_per_track=%sysevalf(&_scatter_y_span/&_scatter_track_count);
13266         %let _yoffset_scale_fc=1;
13267         %if %sysevalf(&_avg_signal_span_per_track>4.5) %then %let
13267    ! _yoffset_scale_fc=%sysevalf(1+(&_avg_signal_span_per_track-4.5)*0.08);
13268         %else %if %sysevalf(&_avg_signal_span_per_track<3.0) %then %let
13268    ! _yoffset_scale_fc=%sysevalf(1-(3.0-&_avg_signal_span_per_track)*0.06);
13269         %if %sysevalf(&_yoffset_scale_fc<0.85) %then %let _yoffset_scale_fc=0.85;
13270         %if %sysevalf(&_yoffset_scale_fc>1.35) %then %let _yoffset_scale_fc=1.35;
13271         %let _recommended_yaxis_offset4max=&yaxis_offset4max;
13272      
13273         %if %sysevalf(&n_marker_labels>=1) %then %let
13273    ! _recommended_yaxis_offset4max=%sysfunc(max(&_recommended_yaxis_offset4max,0.08));
13274         %if (&text_rotate_angle=0 and %sysevalf(&n_marker_labels>=1)) %then %let
13274    ! _recommended_yaxis_offset4max=%sysfunc(max(&_recommended_yaxis_offset4max,0.09));
13275         %if %sysevalf(&n_marker_labels>=2) %then %let
13275    ! _recommended_yaxis_offset4max=%sysfunc(max(&_recommended_yaxis_offset4max,0.1));
13276      
13277      /*    %if %sysevalf(&totsc>3) %then %let _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.03); */
13278      /*    %if %sysevalf(&totsc>5) %then %let _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.04); */
13279      /*    %if %sysevalf(&totsc>8) %then %let _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.05); */
13280      
13281      /*    %if %sysevalf(&track_height<700) %then %let
13281    ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.03); */
13282      /*    %if %sysevalf(&track_height<550) %then %let
13282    ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.05); */
13283      /*    %if %sysevalf(&track_height<420) %then %let
13283    ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.07); */
13284      
13285      /*    %if %sysevalf(&track_width<900) %then %let
13285    ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.02); */
13286      /*    %if %sysevalf(&track_width<700) %then %let
13286    ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.03); */
13287      /*    %if %sysevalf(&track_width<500) %then %let
13287    ! _recommended_yaxis_offset4max=%sysevalf(&_recommended_yaxis_offset4max+0.04); */
13288      
13289         %if %sysevalf(&_recommended_yaxis_offset4max>0.95) %then %let _recommended_yaxis_offset4max=0.95;
13290         %if %sysevalf(&_recommended_yaxis_offset4max>&yaxis_offset4max) %then %do;
13291            %put NOTE: Auto-increasing yaxis_offset4max from &yaxis_offset4max to &_recommended_yaxis_offset4max to reserve
13291    ! more top space for SNP labels.;
13292            %let yaxis_offset4max=&_recommended_yaxis_offset4max;
13293         %end;
13294      
13295         %if (&text_rotate_angle=0 and &n_marker_labels>=4) %then %let
13295    ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,4.0));
13296         %if (&text_rotate_angle=0 and &n_marker_labels>=5) %then %let
13296    ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,4.6));
13297         %if (&text_rotate_angle>=60 and &n_marker_labels>=5) %then %let
13297    ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,2.2));
13298      
13299         *Make the top SNP label offset less sensitive to the absolute y-axis range by
13300         *scaling it with the observed signal span per scatter track. This keeps the
13301         *visual gap more stable when tracks get taller or the max -log10(P) changes.;
13302         %if %sysevalf(&n_marker_labels<=3) %then %do;
13303            %let effective_yoffset4textlabels=%sysevalf(&effective_yoffset4textlabels*&_yoffset_scale_fc);
13304            %if (&text_rotate_angle=0) %then %do;
13305               %if %sysevalf(&effective_yoffset4textlabels<0.18) %then %let effective_yoffset4textlabels=0.18;
13306               %if %sysevalf(&effective_yoffset4textlabels>0.90) %then %let effective_yoffset4textlabels=0.90;
13307            %end;
13308            %else %do;
13309               %if %sysevalf(&effective_yoffset4textlabels<0.80) %then %let effective_yoffset4textlabels=0.80;
13310               %if %sysevalf(&effective_yoffset4textlabels>2.80) %then %let effective_yoffset4textlabels=2.80;
13311            %end;
13312         %end;
13313      
13314         *Convert the needed label headroom into the raw yaxis_offset4max scale used
13315         *later by GTL so the reserved top region stays close to the label height.;
13316         *this is the key part to make the top label headroom more adaptive to the signal span and track height, thus more
13316    ! robust to different y-axis ranges and figure sizes.;
13317         *For running the code with AI, AI should be able to understand the logic of the following code;
13318         *and adjust the parameters and formula as needed to achieve the desired visible fraction of top labels, which is
13318    ! determined by the effective font size of text labels and the track height, as well as other factors such as text rotation
13318    !  angle, number of marker labels, average signal span per track, and figure size. The goal is to make the top label
13318    ! headroom more adaptive and robust to different scenarios.;
13319         %let _desired_visible_top_frac=%sysevalf((&effective_font_size4textlabels+1)/&track_height);
13320         %if (&text_rotate_angle=0) %then %let _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac*1.15);
13321         %else %let _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac*0.95);
13322         %if %sysevalf(&n_marker_labels>1) %then %let
13322    ! _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac+0.0025*(&n_marker_labels-1));
13323         %if %sysevalf(&_avg_signal_span_per_track>5.5) %then %let
13323    ! _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac+0.002);
13324         %if %sysevalf(&_avg_signal_span_per_track<3.0) %then %let
13324    ! _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac-0.0015);
13325         %if %sysevalf(&track_height<500) %then %let _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac+0.002);
13326         %if %sysevalf(&n_marker_labels=1) %then %do;
13327            %if %sysevalf(&_desired_visible_top_frac<0.02) %then %let _desired_visible_top_frac=0.02;
13328            %if %sysevalf(&_desired_visible_top_frac>0.02) %then %let _desired_visible_top_frac=0.02;
13329         %end;
13330         %else %do;
13331            %if %sysevalf(&_desired_visible_top_frac<0.02) %then %let _desired_visible_top_frac=0.02;
13332            %if %sysevalf(&_desired_visible_top_frac>0.040) %then %let _desired_visible_top_frac=0.040;
13333         %end;
13334      
13335         %let _auto_yaxis_offset4max=&_desired_visible_top_frac;
13336         %if %sysevalf(&_scatter_track_count>5) %then %let
13336    ! _auto_yaxis_offset4max=%sysevalf(&_desired_visible_top_frac*&_scatter_track_count/5);
13337         %if %sysevalf(&_auto_yaxis_offset4max<0.02) %then %let _auto_yaxis_offset4max=0.02;
13338         %if %sysevalf(&_auto_yaxis_offset4max>0.25) %then %let _auto_yaxis_offset4max=0.25;
13339         %if %sysevalf(&n_marker_labels<=2) %then %do;
13340            %if %sysevalf(&_auto_yaxis_offset4max^=&yaxis_offset4max) %then %do;
13341               %put NOTE: Replacing yaxis_offset4max=&yaxis_offset4max with scale-aware top-label offset
13341    ! &_auto_yaxis_offset4max (visible frac=&_desired_visible_top_frac, tracks=&_scatter_track_count,
13341    ! avg_signal_span=&_avg_signal_span_per_track).;
13342               %let yaxis_offset4max=&_auto_yaxis_offset4max;
13343            %end;
13344         %end;
13345         %else %if %sysevalf(&_auto_yaxis_offset4max>&yaxis_offset4max) %then %do;
13346            %put NOTE: Auto-increasing yaxis_offset4max from &yaxis_offset4max to &_auto_yaxis_offset4max with scale-aware
13346    ! top-label headroom (visible frac=&_desired_visible_top_frac).;
13347            %let yaxis_offset4max=&_auto_yaxis_offset4max;
13348         %end;
13349      
13350         /* Fit vertical labels to the longest requested marker. Font size is in
13351            points while track_height is a layout dimension; raster DPI must not
13352            change the fraction of the plot reserved for a label. */
13353         %if (&text_rotate_angle>=60 and &n_marker_labels>=1) %then %do;
13354            %let
13354    ! _vertical_label_frac=%sysevalf(((&_max_marker_label_chars*0.62+1)*&effective_font_size4textlabels*96/72+2*&effective_yoff
13354    ! set4textlabels+8)/(&track_height*0.75));
13355            %if %sysevalf(&_vertical_label_frac<0.04) %then %let _vertical_label_frac=0.04;
13356            %if %sysevalf(&_vertical_label_frac>0.45) %then %let _vertical_label_frac=0.45;
13357            %let yaxis_offset4max=&_vertical_label_frac;
13358            %put NOTE: Vertical SNP-label headroom fitted to &_max_marker_label_chars characters: offsetmax=&yaxis_offset4max.;
13359         %end;
13360      
13361         %put NOTE: Effective top-label settings: rotate=&text_rotate_angle font_size=&effective_font_size4textlabels
13361    ! yoffset=&effective_yoffset4textlabels yaxis_offset4max=&yaxis_offset4max
13361    ! avg_signal_span_per_track=&_avg_signal_span_per_track fc2distant_close_labels=&fc2distant_close_labels
13361    ! pct2adj4dencluster=&pct2adj4dencluster make_even_pos=&make_even_pos.;
13362      
13363      %end;
13364      %put NOTE: LATTICE_STAGE top_label_transform_complete;
13365      
13366      *For debug;
13367      /*data a;*/
13368      /*set _xtag_;*/
13369      /*run;*/
13370      /*%abort 255;*/
13371      
13372      
13373      *Select line pattern for highlighting markers labeled on the the top of scatterplots;
13374      *Solid, ShortDash, MediumDash, LongDash,MediumDashShortDash, DashDashDot;
13375      *DashDotDot, Dash, LongDashShortDash, Dot, ThinDot, ShortDashDot, MediumDashDotDot;
13376      *or numbers from 1 (solid) to 46 which are many combinations of dashes,;
13377      *dots, lengths and numbers of dashes, numbers and sizes of dots.;
13378      %let reflinepattern=Dot;
13379      
13380      *Also add the marker ids into the output figure name;
13381      %let  vars4figurename=;
13382      %if %length(&var4label_scatterplot_dots)>0 %then %do;
13383      proc sql noprint;
13384      select distinct trim(left(&var4label_scatterplot_dots)) into: vars4figurename separated by '_'
13385      from final
13386      where &var4label_scatterplot_dots^="";
13387      
13388      %if %length(&vars4figurename)>100 %then %do;
13389         %put You var4figurename is too long:;
13390         %put &var4figurename;
13391         %put The macro will arbitrarily assign the value of macro var var4label_scatterplot for the macro var;
13392         %let  vars4figurename=&var4label_scatterplot_dots;
13393      %end;
13394      
13395      *When there are three or fewer SNPs for labeling at the top, keep those labels horizontal in the top headroom;
13396      *Also reduce the top cell space represented by the macro var yoffset4max_drawmarkersontop from the default value 0.15 to
13396    ! 0.05;
13397      *Other parameters restrict the upper and lower offset are also resetted;
13398      %if %sysevalf(&n_marker_labels>=1) and %sysevalf(&n_marker_labels<=3) and &auto_rotate2zero=1 %then %do;
13399          %let text_rotate_angle=0;
13400      
13401      /*	%let yoffset4max_drawmarkersontop=0.01;*/
13402      	/*Setting this as 0 does not change the figure, so this parameter is not needed to be reset!*/
13403      	/*Use the simpler horizontal-label scaling for small label sets so <=3 SNPs
13404            stay readable on one line within the reserved headroom. */
13405      	%let effective_yoffset4textlabels=%sysevalf(0.55*1000/&track_height);
13406      	%if &track_height<400 %then %let effective_yoffset4textlabels=0.55;
13407      	%let yaxis_offset4max=%sysevalf(0.04*500/&track_height);
13408      	%let yaxis_offset4min=%sysevalf(0.02*500/&track_height);/*This will reduce the lower offset of y-axis*/
13409          %put NOTE: Small top-label horizontal tuning: n_marker_labels=&n_marker_labels yaxis_offset4max=&yaxis_offset4max
13409    ! yaxis_offset4min=&yaxis_offset4min effective_yoffset4textlabels=&effective_yoffset4textlabels track_height=&track_height.
13409    ! ;
13410      %end;
13411      %if %length(%superq(label_headroom_frac))>0 and %length(%superq(label_center_offset))>0 %then %do;
13412          %let yaxis_offset4max=&label_headroom_frac;
13413          %let effective_yoffset4textlabels=&label_center_offset;
13414          %put NOTE: Planned top-label headroom=&yaxis_offset4max center_offset=&effective_yoffset4textlabels.;
13415      %end;
13416      %end;
13417      
13418       *In terms of gene labels in the gene track, if a gene is too close to the right most position in the figure;
13419      *It is necessary to move the gene label position to left to prevent the gene label is truncated in the figure;
13420      %if (%length(&xaxis_viewmax)>0 and %length(&xaxis_viewmin)>0) %then %do;
13421           %let window_dist=%sysevalf(&xaxis_viewmax - &xaxis_viewmin + 1);
13422      	 %let _maxpos_=&xaxis_viewmax;
13423      %end;
13424      %else %do;
13425           %let window_dist=%sysevalf(&max_x - &min_x + 1);
13426      	 %let _maxpos_=&max_x;
13427      %end;
13428      
13429      *********************************************SAS codes to adjust gene label positions, preventing them too close to each
13429    ! other*********************;
13430      /*proc sql noprint;*/
13431      /*select max(pos1), min(pos1)into: max_pos1, :min_pos1*/
13432      /*from final;*/
13433      %if &track_width>=500 %then %let extra_reduce_pct=0.8;
13434      %else %let extra_reduce_pct=1;
13435      *This means for figure with width < 500, it will increase the 1 fold for the amplification facto;
13436      *but for figure with width > 500 and < 750, it will keep around 0.8 fold for the amplification facto;
13437      *in terms of figure with width >750, it will keep around 0.8*0.5 fold for the amplification factor;
13438      data final ;
13439      set final;
13440      pfactor=IFC(length(grp_label)<3,0,length(grp_label))/4;
13441      if pfactor>5 then pfactor=5;
13442      *Further adjust it by figure track_width by comparing it to the optimized figure with width 450;
13443      pfactor=pfactor*500/&track_width;
13444      *If track_width>600, it is necessary to reduce the factor 2 folder;
13445      if &track_width>750 then pfactor=0.5*pfactor;
13446      if grp_label^="" and (&_maxpos_ - pos1+1)/&window_dist<((1+pfactor)*&move_right_genetxt_pct) then do;
13447            *Also move the gene label by its length;
13448      	   _pos1_=pos1-&extra_reduce_pct*&window_dist*&move_right_genetxt_pct*pfactor;
13449      end;
13450      else do;
13451      	  _pos1_=pos1;
13452      end;
13453      run;
13454      /*%abort 255;*/
13455      
13456      *This only works for making gene bed scatter plots with the yval_var, which is log10P;
13457      %Check_VarnamesInDsd(indsd=final,Rgx=&yval_var.1,exist_tag=Hasvar4y);
13458      %if %length(&Hasvar4y)>0 %then %do;
13459      *Further adjust the gene lable x-axis positions if two gene labels are in the same row and have distance less than
13459    ! designated pct of the whole window;
13460      %put NOTE: LATTICE_STAGE gene_label_adjust_begin;
13461      *Further adjust the gene lable x-axis positions if two gene labels are in the same row and have distance less than
13461    ! designated pct of the whole window;
13462      data final_gene;
13463      set final(keep=grp_label grp1 &yval_var.1 _pos1_ pfactor);
13464      where grp_label^="";
13465      run;
13466      proc sort;by &yval_var.1 _pos1_;run;
13467      
13468      data final_gene;
13469      set final_gene;
13470      lag_pos1=lag(_pos1_);
13471      if first.&yval_var.1 then do;
13472       lag_pos1=.;
13473      end;
13474      else do;
13475         if  (_pos1_ - lag_pos1+1)/&window_dist<(pfactor*&move_right_genetxt_pct)  then
13475    ! lag_pos1_adj=lag_pos1-&extra_reduce_pct*&window_dist*&move_right_genetxt_pct*pfactor;
13476      end;
13477      by &yval_var.1;
13478      run;
13479      *Update only affected gene-label positions in place.  This avoids recreating
13480       the full FINAL table through a self-referential PROC SQL join.;
13481      data final_gene_lookup;
13482        set final_gene(keep=&yval_var.1 lag_pos1 lag_pos1_adj);
13483        where lag_pos1^=. and lag_pos1_adj^=.;
13484        _pos1_=lag_pos1;
13485        *Reuse PFActor, which already exists in FINAL, as the hash return slot.  A
13486         MODIFY step cannot enlarge an existing observation with a new variable.;
13487        pfactor=lag_pos1_adj;
13488        keep &yval_var.1 _pos1_ pfactor;
13489      run;
13490      
13491      data final;
13492        if _n_=1 then do;
13493          declare hash _gene_positions(dataset:"final_gene_lookup", duplicate:"r");
13494          _gene_positions.defineKey("&yval_var.1", "_pos1_");
13495          _gene_positions.defineData("pfactor");
13496          _gene_positions.defineDone();
13497        end;
13498        modify final;
13499        pfactor=.;
13500        if _gene_positions.find()=0 and pfactor^=. then _pos1_=pfactor;
13501        replace;
13502      run;
13503      
13504      proc datasets library=work nolist;
13505        delete final_gene final_gene_lookup;
13506      quit;
13507      %end;
13508      %put NOTE: LATTICE_STAGE gene_label_adjust_complete;
13509      
13510      *Need to obtain the minimum and maximum values to decide whether all of values of heatmap_var are postive or negative;
13511      %let min_heatmap_var=-999;
13512      %let max_heatmap_var=999;
13513      %if &makedotheatmap=1 and %length(&heatmap_var)>0 %then %do;
13514        %put NOTE: LATTICE_STAGE heatmap_normalize_begin;
13515        proc sql noprint;
13516        select min(%unquote(&heatmap_var)) into: min_heatmap_var
13517        from final;
13518        select max(%unquote(&heatmap_var)) into: max_heatmap_var
13519        from final;
13520      
13521        data final;
13522        set final;
13523        *Reset all values <heatmap_min_neg_val or >heatmap_max_pos_val to be heatmap_min_neg_val or heatmap_max_pos_val,
13523    ! specifically;
13524       %if %sysevalf(&heatmap_min_neg_val>&min_heatmap_var) and %sysevalf(&min_heatmap_var<0) %then %do;
13525          %let min_heatmap_var=&heatmap_min_neg_val;
13526      	if &heatmap_var<&heatmap_min_neg_val then &heatmap_var=&heatmap_min_neg_val;
13527       %end;
13528        %if %sysevalf(&heatmap_max_pos_val<&max_heatmap_var) and %sysevalf(&max_heatmap_var>0) %then %do;
13529            %let max_heatmap_var=&heatmap_max_pos_val;
13530      	if &heatmap_var>&heatmap_max_pos_val then &heatmap_var=&heatmap_max_pos_val;
13531       %end;
13532        run;
13533      %end;
13534      %put NOTE: LATTICE_STAGE heatmap_normalize_complete;
13535      
13536      
13537      /* This relabels the variable newpos as Position in the final figure. */
13538      data final;
13539      set final;
13540      *Update the x-axis label, which might be revised if the macro is not used for drawing GWAS local Manhattan plot;
13541      /* label newpos="%trim(%left(%sysfunc(prxchange(s/^chr/Chromosome /,1,&chr_name)))) (hg19)"; */
13542      label newpos="%trim(%left(%sysfunc(prxchange(s/^chr/Chromosome /,1,&chr_name))))";
13543      *This will remove the legend in the figure for dots that are with missing value of old_y;
13544      *The value 1 would be used as group number to match with its corresponding char label in the figure legend;
13545      /*if old_y=. then old_y=&Other_num_grpval;*/
13546      *The above fails to exclude groups with missing numeric group value;
13547      *keeping these old_y as missing would exclude them in the final figure legend;
13548      *The following code is just for reminding of the above fact;
13549      %if %length(&Other_num_grpval)>0 %then %do;
13550      if old_y=. then old_y=&Other_num_grpval;
13551      *it is necessary to re-assign missing value to these old_y when the &yval_var is missing;
13552      if &yval_var=. then old_y=.;
13553      %end;
13554      run;
13555      
13556      *Only draw CNVs in highlow plots based on their length>1;
13557      data final;
13558      set final;
13559      if not (&Variant_Length_Var>1) then do;
13560       &st_var=.;&end_var=.;
13561      end;
13562      run;
13563      *If end_var are all missing, it means there are no CNVs for running the highlow plot;
13564      %iscolallmissing(dsd=final,colvar=&end_var,outmacrovar=NoCNVs);
13565      
13566      ****************************************End of SAS codes to adjust gene label positions, preventing them too close to
13566    ! each other***************;
