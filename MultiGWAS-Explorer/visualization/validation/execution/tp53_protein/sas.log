10092      %long2wide4multigrpsSameTypeVars(
10093      long_dsd=&SNP_long_dsd,
10094      outwide_dsd=&subset_gwas_dsd,
10095      grp_vars=&gwas_snp_var &gwas_chr_var &gwas_pos_var &var4label_scatterplot_dots,/*If grp_vars and SameTypeVars are
10095    ! overlapped,
10096      the macro will automatically only keep it in the grp_vars;
10097      grp_vars can be multi vars separated by space, which
