14285      data _null_;
14286       infile "&in" lrecl=32767 truncover;file "&template" lrecl=32767;
14287       length line token $32767;retain rx;
14288       if _n_=1 then rx=prxparse('/viewmin=(-[0-9.]+)/i');
14289       input;line=_infile_;
14290       /* Compress the negative annotation coordinates only, on the same x axis. */
14291       if prxmatch(rx,line) then do;
14292        call prxposn(rx,1,book_start,book_length);
14293        token=substr(line,book_start,book_length);
14294        line=tranwrd(line,cats('viewmin=',token),cats('viewmin=',put(input(token,best32.)*&factor,best32.)));
14295       end;
14296       if index(lowcase(line),'seriesplot x=') then do;
14297        %do i=1 %to &nann;
14298        line=tranwrd(line,"y=%upcase(%scan(&annvars,&i)) /","y=BOOK_ANN&i /");
14299        %end;
14300        line=prxchange("s/thickness=[0-9.]+(?:px|pt|in|cm|mm)?/thickness=&body.px/",1,line);
14301       end;
14302       line=tranwrd(line,'y=_Y_ /','y=BOOK_GENE_Y /');
14303       %if &single_marker %then %do;
14304       line=tranwrd(line,'scatterplot x=POS y=VAR4LOG10P /','scatterplot x=BOOK_MARKER_POS y=VAR4LOG10P /');
14305       %end;
14306       %if %length(&label_center_pct) %then %do;
14307       if index(lowcase(line),'textplot x=newpos') then do;
14308        /* Center the complete rotated string inside the reserved wall band. */
14309        do book_label_i=1 to book_nlabels;
14310         set work.book_labels point=book_label_i nobs=book_nlabels;
14311         put 'drawtext textattrs=(size=8) "' _target_snp_ +(-1)
14312          '" / x=' newpos best32. " y=&label_center_pct xspace=datavalue yspace=wallpercent anchor=center rotate=90;";
14313        end;
14314        delete;
14315       end;
14316       %end;
14317       put line;
