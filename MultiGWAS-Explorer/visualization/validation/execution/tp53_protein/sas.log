12924      
12925      %if %length(&ordered_sc_grpnames)>0 and &NotDrawScatterPlot=0 %then %do;
12926          *Add a dataset containing scatterplot headers;
12927          *Note: scatter_grp_var should be in numeric;
12928          *Also adjust the x-axis position for the group headers;
12929          proc sql;
12930          create table header_dsd as
12931          select distinct
12932          &scatter_grp_var as sc_grp,
12933          &yval_var+(&adjval4header) as header_yval,avgpos
12934          from (select *,
12935                0.5*(&max_x+&min_x) as avgpos
12936                from x1)
12937          where &scatter_grp_var >0
12938          group by &scatter_grp_var
12939          having &yval_var=max(&yval_var);
12940          *Now get the scatter plot group names;
12941          %rank4grps(
12942          grps=&ordered_sc_grpnames,
12943          dsdout=scgrpnames
12944          );
12945          *Note: here all _ included in the name of scatter plot are changed into blank space;
12946          %local _book_gdc_header;
12947          %let _book_gdc_header=_bh%substr(%sysfunc(compress(%sysfunc(uuidgen()),-)),1,24);
12948          proc sql;
12949          create table work.&_book_gdc_header as
12950          select a.*,prxchange('s/_/ /',-1,b.grps) as header_grp
12951          from header_dsd as a,
12952               scgrpnames as b
12953          where a.sc_grp=b.num_grps;
12954          quit;
12955          data header_dsd;set work.&_book_gdc_header;run;
12956          proc datasets library=work nolist;delete &_book_gdc_header;quit;
12957      
12958          *Add the header dsd into the final dsd;
12959          *No need to adjust the avgpos by header length for each header grp;
12960          *SAS will adjust it automatically with the markercharacterposition=top in proc template;
12961          *But the code may be useful in adjusting gene labels;
12962      /*     data header_dsd; */
12963      /*     set header_dsd; */
12964      /*     avgpos=avgpos*(1-0.005*(countc(header_grp))); */
12965      /*     run; */
12966          data final;
12967          merge final header_dsd;
12968          run;
12969          *Get the minimum value of header_yval and the avgpos to fill these missing value after merge with final dsd;
12970          proc sql noprint;
12971          select header_yval, avgpos, header_grp
12972           into: hd_min,:mid_pos,:hgrp
12973          from header_dsd
12974          group by sc_grp
12975          having sc_grp=min(sc_grp);
12976          quit;
12977          data final;
12978          set final;
12979          if sc_grp=. then do;
12980           avgpos=&mid_pos;
12981           header_yval=&hd_min;
12982           header_grp="";
12983          end;
12984          run;
12985          /* proc print;run; */
12986      %end;
12987      
12988      *Get min and max postive old y value for heatmap;
12989      proc sql noprint;
12990      select floor(min(old_y)),ceil(max(old_y)) into: min_old_y,: max_old_y
12991      from final;
12992      quit;
12993      *To exclude negative old_y in the range of min and max, use the following code;
12994      /*(where=(old_y>=0));*/
12995      
12996      *Adjust avgpos for scatter track labels if the xaxis_viewmin and xaxis_viewmax are provided with values;
12997      %let _avg_pos=%sysevalf(0.5*(&max_x+&min_x));
12998      %if (%length(&xaxis_viewmin)>0 and %length(&xaxis_viewmax)>0) %then %do;
12999        %let _avg_pos=%sysevalf(0.5*(&xaxis_viewmin+&xaxis_viewmax));
13000        %let xaxis_offset4min=%sysfunc(min(&xaxis_offset4min,0.01));
13001        %let xaxis_offset4max=%sysfunc(min(&xaxis_offset4max,0.005));
13002      %end;
13003      %if (%length(&xaxis_viewmin)=0 and %length(&xaxis_viewmax)>0) %then %do;
13004        %let _avg_pos=%sysevalf(0.5*(&min_x+&xaxis_viewmax));
13005        %let xaxis_offset4min=%sysfunc(min(&xaxis_offset4min,0.01));
13006        %let xaxis_offset4max=%sysfunc(min(&xaxis_offset4max,0.005));
13007      %end;
13008      %if (%length(&xaxis_viewmin)>0 and %length(&xaxis_viewmax)=0) %then %do;
13009        %let _avg_pos=%sysevalf(0.5*(&xaxis_viewmin+&max_x));
13010        %let xaxis_offset4min=%sysfunc(min(&xaxis_offset4min,0.01));
13011        %let xaxis_offset4max=%sysfunc(min(&xaxis_offset4max,0.005));
13012      %end;
13013      data final;
13014      set final;
13015      avg_pos=&_avg_pos + 0;
13016      *Preallocate label plotting columns during an existing rewrite so the later
13017       hash update can modify only matching target rows in place.;
13018      newpos=pos;
13019      top_y4label=&max_y;
13020      
13021      run;
13022      
13023      *De-duplicate repeated labels without dropping a singleton label by row parity.;
13024      *Key only by label text: x1 expands each variant to start/end plotting positions,;
13025      *so a label+position key incorrectly retains the same rsID twice.;
13026      %if %length(&var4label_scatterplot_dots)>0 %then %do;
13027      data final;
13028        if _n_=1 then do;
13029          declare hash _seen_target_labels();
13030          _seen_target_labels.defineKey("&var4label_scatterplot_dots");
13031          _seen_target_labels.defineData("&var4label_scatterplot_dots");
13032          _seen_target_labels.defineDone();
13033        end;
13034        modify final;
13035        if &var4label_scatterplot_dots^="" and pos^=. then do;
13036          if _seen_target_labels.check()=0 then &var4label_scatterplot_dots="";
13037          else _seen_target_labels.add();
13038        end;
13039        replace;
13040      run;
13041      %end;
13042      
13043      
13044      *Transform data to label selected dots only once if multiple satterplots containing the same label;
13045      %if (%length(&var4label_scatterplot_dots)>0 and &label_dots_once_on_top=1 and &NotDrawScatterPlot=0) %then %do;
13046          %put NOTE: LATTICE_STAGE top_label_transform_begin;
13047          data _xtag_;
13048          set final;
13049          xtag=_n_;
13050          _tmp_=_n_;
13051          where &var4label_scatterplot_dots^="" and pos^=.;
13052          keep &var4label_scatterplot_dots xtag _tmp_ pos;
13053          run;
13054      
13055          *Collapse repeated label rows before any spacing adjustment so a SNP that;
13056          *appears in multiple tracks is treated as one top label with one position.;
13057          proc sort data=_xtag_;
13058          by &var4label_scatterplot_dots pos _tmp_;
13059          run;
13060      
13061          data _xtag_;
13062          set _xtag_;
13063          by &var4label_scatterplot_dots;
13064          if first.&var4label_scatterplot_dots;
13065          run;
13066          proc sql noprint;
13067      	select count(*) into: total_target_labels
13068      	from (
13069      	select distinct &var4label_scatterplot_dots
13070          from _xtag_
13071          );
13072        %let effective_font_size4textlabels=&font_size4textlabels;
13073        %let effective_yoffset4textlabels=&Yoffset4textlabels;
13074      
13075        *When there is less then 4 SNPs for labeling at the top of the local Manhattan plot, reset the following rotation angle
13075    !  macro var to 0;
13076        *and increase 4 fold for the the dist_pct_to_cluster_pos;
13077        *First decide the cutoff of total_target_labels based on the width of figure;
13078       %if &track_width <= 500 %then %do;
13079           %let label_n_cutoff=3;
13080      %end;
13081      %else %if (&track_width>500 and  &track_width<800) %then %do;
13082           %let label_n_cutoff=4;
13083      %end;
13084      %else %if (&track_width>=800) %then %do;
13085          %let label_n_cutoff=5;
13086      %end;
13087      %else %do;
13088          %let label_n_cutoff=0;
13089      %end;
13090      
13091        %if &total_target_labels=0 %then %do;
13092            %put WARNING: No requested SNP labels remain in the local GWAS plot data.;
13093            %let make_even_pos=0;
13094        %end;
13095        %else %if &total_target_labels<=&label_n_cutoff %then %do;
13096      /*	   %let dist_pct_to_cluster_pos=%sysevalf(4*&dist_pct_to_cluster_pos);*/
13097      /*       %let dist_pct_to_cluster_pos=%sysevalf(1/&total_target_labels);*/
13098               %let dist_pct_to_cluster_pos=%sysevalf(0.5/&total_target_labels);
13099      /*	   %let  fc2distant_close_labels=%sysevalf(4*&fc2distant_close_labels);*/
13100      	   %let make_even_pos=0;
13101        %end;
13102        %else %do;
13103      	  %let make_even_pos=1;
13104      	  *No need to make even positions when rotation angle is set as 90;
13105      	  %if &text_rotate_angle=90 %then %let make_even_pos=0;
13106        %end;
13107      
13108        *Horizontal top labels need more aggressive spacing control than vertical labels.;
13109        %if (&text_rotate_angle=0) %then %do;
13110            %if &total_target_labels>=3 %then %let make_even_pos=1;
13111            %if &total_target_labels>=3 %then %let
13111    ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,3.0));
13112            %if &total_target_labels>=4 %then %do;
13113                %let fc2distant_close_labels=%sysfunc(max(&fc2distant_close_labels,5));
13114                %let pct2adj4dencluster=%sysfunc(max(&pct2adj4dencluster,3));
13115                %let effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,9));
13116                %let effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,3.6));
13117            %end;
13118            %if &total_target_labels>=5 %then %do;
13119                %let fc2distant_close_labels=%sysfunc(max(&fc2distant_close_labels,6));
13120                %let pct2adj4dencluster=%sysfunc(max(&pct2adj4dencluster,4));
13121                %let effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,8));
13122                %let effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,4.2));
13123            %end;
13124            %if &track_width<700 and &total_target_labels>=4 %then %let
13124    ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,8));
13125            %if &track_width<500 and &total_target_labels>=3 %then %let
13125    ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,7));
13126        %end;
13127        %else %if (&text_rotate_angle>=60) %then %do;
13128            %if &total_target_labels>=5 %then %let
13128    ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,9));
13129            %if &total_target_labels>=7 %then %let
13129    ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,8));
13130            %if &total_target_labels>=5 %then %let
13130    ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,2.0));
13131        %end;
13132      
13133         *Also need to adjust labels with too close positions;
13134        %if &track_width<700 %then %let Pct4OnlyTwoPos=0.25;
13135        %else %let Pct4OnlyTwoPos=0.1;
13136      
13137        %if (&adj_spaces_among_top_snps=1 and &total_target_labels>=2) %then %do;
13138         %adjust_close_positions(
13139         indsd=_xtag_,
13140         outdsd=_xtag_,
13141         pos_var=pos,
13142         new_pos_var=newpos,
13143         dist_pct_to_cluster_pos=&dist_pct_to_cluster_pos,
13144         amplification_fc=&fc2distant_close_labels,
13145         make_even_pos=&make_even_pos,
13146         Pct4OnlyTwoPos=&Pct4OnlyTwoPos,/*In case of only two positions, it is necessary to use arbitrary proportion of
13146    ! dist_step to separate them,
13147         i.e., minus and add Pct4OnlyTwoPos*dist_step and for the first and second positions, respectively*/
13148         pct2adj4dencluster=&pct2adj4dencluster,
13149         fixed_min_pos=&min_x,
13150         fixed_max_pos=&max_x
13151         );
13152         %end;
13153         %else %do;
13154      	 data _xtag_;
13155      	 set _xtag_;
13156      	 newpos=pos;
13157      	 run;
13158         %end;
13159         *The above macro is not good in separating these positions into distinguishable positions;
13160         *However, due to historical compatability, the above codes will be kept;
13161         *******************************************************************************************************;
13162         *Use the other macro to improve it, and it can be canceled if it is still not optimum;
13163         *Only run it when requiring the text to be rotated;
13164         %if (&text_rotate_angle>0 and &adj_spaces_among_top_snps=1 and &total_target_labels>=2) %then %do;
13165         %put We will further optimize the space between each SNP label on the top of the gene track;
13166         proc sql noprint;
13167         select pos into: _tgt_pos_ separated by ' '
13168         from _xtag_
13169         order by pos;
13170         select &fc2distant_close_labels*0.1*(&max_x-&min_x+1)/count(*) into: sep4tgt_pos
13171         from _xtag_;
13172         %spaceAdjust(data=&_tgt_pos_, out=_xtag1_, goal=COL:, sep=&sep4tgt_pos, newvar4adjnum=newpos);
13173         /* _xtag1_ follows genomic-position order, so align rows before merging. */
13174         proc sort data=_xtag_;
13175         by pos;
13176         run;
13177         data _xtag_;
13178         merge _xtag_(drop=newpos) _xtag1_(keep=newpos);
13179         run;
13180         %end;
13181         /* Preserve the planner's label centers after the legacy SAS spacing pass.
13182            Only label coordinates change; GWAS marker and LD positions stay intact. */
13183         %if %length(%superq(label_position_overrides))>0 %then %do;
13184         data _xtag_;
13185         set _xtag_;
13186         length _planned_token $256 _planned_snp $128;
13187         do _planned_i=1 to countw(symget('label_position_overrides'), ' ');
13188            _planned_token=scan(symget('label_position_overrides'), _planned_i, ' ');
13189            _planned_snp=scan(_planned_token, 1, '=');
13190            if upcase(strip(&var4label_scatterplot_dots))=upcase(_planned_snp) then do;
13191               _planned_bp=input(scan(_planned_token, 2, '='), best32.);
13192               if not missing(_planned_bp) then newpos=_planned_bp;
13193               leave;
13194            end;
13195         end;
13196         drop _planned_token _planned_snp _planned_i _planned_bp;
13197         run;
13198         %end;
13199      /*   %abort 255;*/
