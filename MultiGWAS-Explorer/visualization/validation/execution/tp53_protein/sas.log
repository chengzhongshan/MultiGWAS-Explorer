10229      adj_spaces_among_top_snps=1 /*Provide value 1 to adjust spaces among top SNP labels; otherwise, give value 0 to not
10230      adjust top SNPs labels if these labels are rotated 90 degree, which is helpful when the space adjusted labels are not
10230    ! pretty*/
10231      );
10232      
10233      %end;
10234      %else %do;
10235      
