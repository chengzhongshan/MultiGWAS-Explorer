9097       
9098       %macro mkfmt4grps_by_var(
9099       grpdsd,
9100       grp_var,
9101       by_var,/*Empty value is possible for this var, which is handy
9102       when there would be duplciates of grp_var after sorting by
9103       grp_var and by_var for the by_var to make a new format*/
9104       outfmt4numgrps,
9105       outfmt4chargrps,
9106       dsd4fmt=dsd4fmt, /*This dataset can be used to get fmt info*/
9107       numstarter=1 /*This will restrict the starter as 1 or other supplied number;
9108       such as 0, which would be helpful when it is necessary to use different range
9109       for making the format*/
9110       );
9111       %local rnd;
9112       
9113       proc sort data=&grpdsd(keep=&grp_var &by_var) nodupkeys out=grpdsd;
9114       *Make sure to sort it first by &by_var, and then by &grp_var;
9115       *This was wrong, as some grps will be excluded by nodupkeys sorting with &by_var first;
9116       by &grp_var &by_var;
9117       run;
9118       
9119       proc sql noprint;
9120       select max(ndup_grps) into: maxdups
9121       from
9122       (select count(*) as ndup_grps
9123       from grpdsd
9124       group by &grp_var)
9125       ;
9126       
9127       %if &maxdups >1 %then %do;
9128       		   %put Please evaluate the data set grpdsd for the combination between two vars, including &grp_var and &by_var;
9129       		   %put It is necessary to have no duplicates in the first grp_var: &grp_var;
9130       		   %put Currently there are duplicates for grp_var &grp_var after running proc sort nodupkeys by the two vars;
9131       		   %put You may try to replace the two vars by using grp_var and grp_var, which means to use grp_var to replace the
9131     ! by_var;
9132       		   %abort 255;
9133       %end;
9134       
9135       *The above dataset may still contains duplicates of &grp_var;
9136       *Need to keep all unique &by_var and &grp_var;
9137       /* proc sort data=grpdsd nodupkeys;by &grp_var; */
9138       /* proc sort data=grpdsd;by &by_var &grp_var; */
9139       /* run; */
9140       
9141       *Need to sort grps by the by_var for making formats;
9142       *Only when the by_var is not empty, run this codes;
9143       %if %length(&by_var)>0 %then %do;
9144       proc sort data=grpdsd;by &by_var;run;
9145       %end;
9146       
9147       /* Use a timestamp-derived suffix so this helper does not depend on
9148          a separately compiled random-number macro. */
9149       %let rnd=%sysfunc(floor(%sysfunc(datetime())));
9150       %let rnd=&rnd._;
9151       data fmt4numgrps&rnd;
