4982           scattermarker_symbol=&scattermarker_symbol,/*Assign specific marker symbol, such as ibeam, circlefilled, circle, dot,
4982     !  squarefilled, or square, for scatter plot;
4983       Note the size of the designated marker symbol will be defined by the macro variable dotsize; when creating heatmap, you
4983     ! can assign
4984       squarefilled to the scattermarker_symbol, which would be more compatable with the highlow line style in for CNV or bed
4984     ! regions!*/
4985          highlow_line_cmd=&highlow_line_cmd,/*For CNV bed regions, customize the following parameters using dot, dash, or solid
4985     !  line pattern
4986       with custome thickness and color for the line; please increase the thickness to match with that of
4987       dotsize=10 when scattermarker_symbol=squarefilled for the scatter plot, which will enable the square and the line
4988       in the same size and color*/
4989           ordered_sc_grpnames=&sc_labels_in_order,
4990           NotDrawScatterplot=&missingscatterdsd,
4991           xaxis_viewmin=&min_xaxis,/*arbitrary xaxis min value to show the figure, and it requires to work with
4991     ! thresholdmin=0*/
4992           xaxis_viewmax=&max_xaxis,/*arbitrary xaxis max vale to show the figure, and it requires to go along with
4992     ! thresholdmax=0*/
4993           yaxis_offset4min=&yaxis_offset4min, /*provide 0-1 value or auto to offset the min of the yaxis*/
4994           yaxis_offset4max=&yaxis_offset4max, /*provide 0-1 value or auto or to offset the max of the yaxis*/
4995           yoffset4max_drawmarkersontop=&yoffset4max_drawmarkersontop,/*If draw scatterplot marker labels on the top of track,
4996           this fixed value will be used instead of yaxis_offset4max!*/
4997             Yoffset4textlabels=&Yoffset4textlabels, /*Move up the text labels for target SNPs in specific fold;
4998       the default value 2.5 fold works for most cases*/
4999             heatmap_legend_title=&heatmap_legend_title, /*Visible title for the continuous colorbar when heatmap coloring is
4999     ! enabled*/
5000             plot_title=&plot_title,
5001             xaxis_offset4min=&xaxis_offset4min, /*provide 0-1 value or auto  to offset the min of the xaxis*/
5002           xaxis_offset4max=&xaxis_offset4max, /*provide 0-1 value or auto to offset the max of the xaxis*/
5003       
5004         shift_text_yval=&shift_text_yval, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
5005                             to liftup or lower text labels on the y axis; the default value is -0.2 to put gene lable under
5005     ! gene tracks;
5006                             Change it with the macro var pct4neg_y!*/
5007         fig_fmt=&fig_fmt, /*output figure formats: svg, png, jpg, and others*/
5008         pct4neg_y=&_effective_pct4neg_y, /*the most often used value is 1;
5009                     compacting the bed track y values by increasing the scatterplot scale,
5010                     which can reduce the bed trace spaces; It seems that two-fold increasement
5011                     leads to better ticks for different tracks!
5012                     Use value >1 will increase the gene tract, while value < 1 will reduce it!
5013                     Note: when there are only 1 or 2 scatterplots, it is better to provide value = 0.5;
5014                     Modify this parameter with the parameter shift_text_yval to adjust gene label!
5015                     Typically, when there are more scatterplots, it is necessary to increase the value of pct4neg_y accordingly
5015     ! ;
5016                     If there are only <4 scatterplots, the value would be usually set as 1 or 2;
5017                     */
5018         adjval4header=&adjval4header, /*In terms of header of each subscatterplot, provide postive value to move up scatter
5018     ! group header by the input value*/
5019       
5020        makedotheatmap=&makedotheatmap,/*use colormap to draw dots in scatterplot instead of the discretemap;
5021       Note: if makedotheatmap=1, the scatterplot will not use the discretemap mode based on
5022       the negative and postive values of lattice_subgrp_var to color dots in scatterplot*/
5023       /*Main color scheme for coloring dots in scatter plot with your quantitative color response variable
5024       Note: it is necessary to have makedotheatmap=1 and use the default heatmap_var or other quantitative
5025       variable with both negative and positive values to color the scatter plot; when the quantitative response
5026       variable is postive or negative, please change the heatmap_min_neg_val as 0 for postive values, meanwhile,
5027       for all negative values, please assign value 0 to heatmap_max_pos_val*/
5028       heatmap_var=&heatmap_var,/*Assign lattice_subgrp_var to this macro var to draw scatter plot in heatmap
5029       using lattice_subgrp_var with rangeattrmap instead of drawing dots using binary mode, such as 0 and 1 representing Pos
5030       and negative directions of latticen_subgrp_var!*/
5031       heatmap_Neg_rangealtcolormodel=&heatmap_Neg_rangealtcolormodel,/*Range alt color model for negative values,
5031     ! heatmap_var<=0,  in heatmap*/
5032       heatmap_Pos_rangealtcolormodel=&heatmap_Pos_rangealtcolormodel,/*Range alt color model for positve values,
5032     ! heatmap_var>=0, in heatmap*/
5033       heatmap_min_neg_val=&heatmap_min_neg_val,/*Minimum negative value for the heatmap_var when it is not empty;
5034       change this to customize the minimum value for colorbar in heatmap*/
5035       heatmap_max_pos_val=&heatmap_max_pos_val,/*Maximum postive value for the heatmap_var when it is not empty;
5036       change this to customize the max value for colorbar in heatmap*/
5037       
5038       /*Alternative color scheme for categorical color response variable! Please keep it in default
5039       value if you don't want to use it for your quantitative color response variable*/
5040       color_resp_var=&color_resp_var,/*Use the variable to draw colormap of dots in scatterplots with colors
5041       supplied by a later macro variable dataContrastCols that are specifically designated for
5042       scatterplot dots but not other tracks under the scatter plots, such as gene tracks;.
5043       previously if the macro var is empty, the default var would be the same as that of yval_var;
5044       Later it is updated to enable the macro to use lattice_subgrp_var but not yval_var when
5045       this color_resp_var is empty! A later macro variable dataContrastCols will be used
5046       to supply colors for different groups of the variable solely for coloring scatterplot dots!*/
5047       fixedcols4tracksunderscatter=&fixedcols4tracksunderscatter, /*when color_resp_var is not empty, all tracks under
5047     ! scatterplots will be fixed with
5048       two different colors, including cyan and blue, represented by the macro var fixedcols4tracksunderscatter!*/
5049       color_resp_grpdsd=&color_resp_grpdsd,/*this dataset contains two columns, including &color_resp_var and the fixed
5050       variable numgrp4color_resp,which are corresponding to the unique char color_resp_var and
5051       its associated numeric var that would be sorted to order these char color_resp_var in the final figure legend!
5052       Note: for color_resp_var not included in the dataset, they will be asigned as Others;
5053       Custom colors with the same number of unique color_resp_var for these groups can be provided to
5054       a latter macro variable dataContrastCols*/
5055       dataContrastCols=&dataContrastCols,
5056       /*Note: these colors will be used for the scatterplot and gene track together when color_resp_var is a char var, so it is
5056     !  difficult control*/
5057       
5058        makeheatmapdotintooneline=&makeheatmapdotintooneline, /*This will make all dots have the same yaxis value but have
5058     ! different colors
5059       based on its real value in the heatmap plot; To keep the original dot y axis value, assign 0 to the macro var
5060       This would be handy when there are multiple subgrps represented by different y-axis values! By modifying
5061       the y-axis values for these subgrps, the macro can plot them separately in each subtrack!
5062       */
5063        var4label_scatterplot_dots=&var4label_scatterplot_dots, /*Make sure the variable name is not grp, which is a fixed var
5063     ! used by the macro for other purpose;
5064       Whenever  makeheatmapdotintooneline=1 or 0, it is possible to use values of the var4label_scatterplot_dots to
5065       label specific scatterplot dots based on the customization of the variable predifined by users for the input data set;
5066       default is empty; provide a variable that include non-empty strings for specific dots in the
5067       scatterplots;*/
5068        var4mark_ld_scatterplot_dots=&var4mark_ld_scatterplot_dots,
5069        ld_marker_color=&ld_marker_color,
5070        ld_marker_legend_symbol=&ld_marker_legend_symbol,
5071        ld_heatmap_var=&ld_heatmap_var,
5072        ld_heatmap_colormodel=&ld_heatmap_colormodel,
5073        ld_heatmap_legend_title=&ld_heatmap_legend_title,
5074       text_rotate_angle=&text_rotate_angle, /*Angle to rotate text labels for these selected dots by users*/
5075       label_position_overrides=&label_position_overrides,
5076       font_size4textlabels=&font_size4textlabels,
5077       label_headroom_frac=&label_headroom_frac,
5078       label_center_offset=&label_center_offset,
5079       auto_rotate2zero=&auto_rotate2zero, /*supply value 1 when less than 3 text labels, it is good to automatically set the
5079     ! text_rotate_angel=0*/
5080       pct2adj4dencluster=&pct2adj4dencluster,
5081       adj_spaces_among_top_snps=&adj_spaces_among_top_snps /*Provide value 1 to adjust spaces among top SNP labels; otherwise,
5081     ! give value 0 to not
5082       adjust top SNPs labels if these labels are rotated 90 degree, which is helpful when the space adjusted labels are not
5082     ! pretty*/
5083           );
5084       
5085          *options notes;
5086       %let ci=%eval(&ci+1);
5087       %end;
5088       
5089       %mend;
