3633                     chr_var=&chr_var,
3634                    pos_var=&pos_var,
3635                    p_var=%scan(&P_var &Other_P_vars,&_mh_,%str( )),
3636                    dsdout=_tophits_&_mh_,
3637                    p_thrsd=&top_hit_thresd,
3638                   dist4get_uniq_top_hit=&dist4get_smallest_top_hit
3639                    );
3640       /*             *Note: the above macro will create new variable tag_snp and a global macro var _top_snps_ that will be
3640     ! used to capture these top SNPs;*/
3641       /*             %let top_snps=&top_snps &_top_snps_;*/
3642       			%end;
3643       			%else %if (&_mh_=&only_get_top_hit4n_th_gwas) %then %do;
3644       
3645                    %get_top_hits4Manhattan(
3646                     dsdin=&dsdin,
3647                     snp_var=&snp_var,
3648                     chr_var=&chr_var,
3649                    pos_var=&pos_var,
3650                    p_var=%scan(&P_var &Other_P_vars,&_mh_,%str( )),
3651                    dsdout=_tophits_&_mh_,
3652                    p_thrsd=&top_hit_thresd,
3653                   dist4get_uniq_top_hit=&dist4get_smallest_top_hit
3654                    );
3655       
3656       			%end;
3657                  %end;
3658       					 %put We will extract associaiton signals around these top SNPs within a genomic window of
3658     ! &dist4get_smallest_top_hit bp that pass the p value threshold of &top_hit_thresd;
3659                  %put These top SNPs are &top_snps;
3660                   data tophits_all;
3661                   set _tophits_:;
3662                   run;
