4488       %macro Multgscatter_with_gene_exons(
4489       bed_dsd=,/*This input dsd should contain association signals, but not
4490       for gene bed regions; the name of the var should not be misunderstood!
4491       It should contain the arbitrary vars: chr, st, and end
4492       If the bed_dsd is missing, the macro will use the min and max position from
4493       the gene_exon_bed_dsd as a fake data set to draw track without the scatterplot;
4494       The typical input format of bed_dsd would be:
4495       chr st end grp num_scattergrp num_lattice_scattergrp
4496       the var grp should be character;
4497       */
4498       Variant_Length_Var=,/*this variable if not empty, its value will be used to extend the value of Pos_Var for making
4499       the start and end position for SNP_Var, i.e., st=st-0.5*&Variant_Length_Var and end=st-0.5*&Variant_Length_Var;
4500       This would be especially helpful for mixing CNV and SNV data for making scatter plots, as it is only necessary
4501       to provide middle position for CNVs and its lengths for ploting CNVs and SNVs together!
4502       For SNVs, please assign missing value . to them;
4503       */
4504       yval_var=,
4505       scatter_grp_var=,
4506       lattice_subgrp_var=,
4507       gene_exon_bed_dsd=,
4508       /*
4509       This input dsd is for exonic bed regions, which should contains the following vars:
4510       chr, st, end, and grp, and these varnames are fixed and used by the internal macro!
4511       Make sure there is only one unique chr included in the gene_exon_bed_dsd when the 1st data set bed_dsd is missing!
4512       The typical input format of gene_exon_bed_dsd would be:
4513       chr st end grp num_scattergrp
4514       grp would be character, such as gene or exon
4515       char_scattergrp would be y-axis values for these genes and it corresponding exons;
4516       */
4517       dist2st_and_end=50000,
4518       design_width=1000,
4519       design_height=200,
4520       image_dpi=300,
4521       barthickness=20,
4522       dotsize=6,
4523       grp_font_size=8,
4524       /*Important parameters for drawing SNVs and CNVs together*/
4525       scattermarker_symbol=circlefilled,/*Assign specific marker symbol, such as ibeam, circlefilled, circle, dot,
4525     ! squarefilled, or square, for scatter plot;
4526       Note the size of the designated marker symbol will be defined by the macro variable dotsize; when creating heatmap, you
4526     ! can assign
4527       squarefilled to the scattermarker_symbol, which would be more compatable with the highlow line style in for CNV or bed
4527     ! regions!*/
4528       highlow_line_cmd=%str(thickness=6 color=darkorange pattern=solid),/*For CNV bed regions, customize the following
4528     ! parameters using dot, dash, or solid line pattern
4529       with custome thickness and color for the line; please increase the thickness to match with that of
4530       dotsize=10 when scattermarker_symbol=squarefilled for the scatter plot, which will enable the square and the line
4531       in the same size and color*/
4532       min_dist4genes_in_same_grps=0.3,
4533       /*this will ensure these genes close to each other to
4534       be separated in the final gene track;
4535       (1) give 0 to plot ALL genes in the same line;
4536       (2) give value between 0 and 1 to separate genes based on the pct distance to the whole region;
4537       (3) give value > 1 to use absolute distance to separate genes into different groups;
4538       Customize this for different gene exon track!*/
4539       sc_labels_in_order= ,/*Provide scatter names matched with the numeric scatter_grp_var
4540       Use _ to represent blank space in each name, and these _ will be changed back into blank space!*/
4541       
4542       /*Note: More parameters included in the sub-macro Lattice_gscatter_over_bed_track
4543       can be modified to obtain better figures; please just find the sub-macro and
4544       update the default setting for specific parameters to improve the final figure
4545       */
4546       min_xaxis=,/*These two parameters will restrict the min and max position for xaxis*/
4547       max_xaxis=,
4548       yaxis_offset4min=0.05, /*provide 0-1 value or auto to offset the min of the yaxis*/
4549       yaxis_offset4max=0.05, /*provide 0-1 value or auto or to offset the max of the yaxis*/
4550       yoffset4max_drawmarkersontop=0.15,/*If draw scatterplot marker labels on the top of track,
4551       this fixed value will be used instead of yaxis_offset4max!*/
4552       Yoffset4textlabels=3.5, /*Move up the text labels for target SNPs in specific fold;
4553       the default value 2.5 fold works for most cases*/
4554       scatter_yaxis_label=%str(-log10%(P%)),/*Visible y-axis title for the stacked association tracks*/
4555       heatmap_legend_title=%str(Z score),/*Visible title for the continuous colorbar when heatmap coloring is enabled*/
4556       plot_title=,/*Optional visible title naming the plotted color metric.*/
4557       xaxis_offset4min=0.02, /*provide 0-1 value or auto  to offset the min of the xaxis*/
4558       xaxis_offset4max=0.02, /*provide 0-1 value or auto to offset the max of the xaxis*/
4559       shift_text_yval=-0.2, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
4560                             to liftup or lower text labels on the y axis; the default value is -0.2 to put gene lable under
4560     ! gene tracks;
4561                             Change it with the macro var pct4neg_y!*/
4562       fig_fmt=svg, /*output figure formats: svg, png, jpg, and others*/
4563       pct4neg_y=2, /*the most often used value is 1;
4564                     compacting the bed track y values by increasing the scatterplot scale,
4565                     which can reduce the bed trace spaces; It seems that two-fold increasement
4566                     leads to better ticks for different tracks!
4567                     Use value >1 will increase the gene tract, while value < 1 will reduce it!
4568                     Note: when there are only 1 or 2 scatterplots, it is better to provide value = 0.5;
4569                     Modify this parameter with the parameter shift_text_yval to adjust gene label!
4570                     Typically, when there are more scatterplots, it is necessary to increase the value of pct4neg_y accordingly
4570     ! ;
4571                     If there are only <4 scatterplots, the value would be usually set as 1 or 2;
4572                     */
4573       adjval4header=-0.5, /*In terms of header of each subscatterplot, provide postive value to move up scatter group header by
4573     !  the input value*/
4574       
4575       
