12401         %if &crowded_scatter_yaxis_compat=1 %then %do;
12402         %put NOTE: Crowded-axis compatibility mode will keep the custom y-axis labels despite their length, matching the older
12402    !  local-GTF macro behavior.;
12403         %end;
12404         %else %do;
