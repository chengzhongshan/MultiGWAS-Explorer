10218      */
10219      text_rotate_angle=&text_rotate_angle, /*Angle to rotate text labels for these selected dots by users*/
10220      auto_rotate2zero=&auto_rotate2zero, /*supply value 1 when less than 3 text labels, it is good to automatically set the
10220    ! text_rotate_angel=0*/
10221      pct2adj4dencluster=&pct2adj4dencluster,/*For SNP labels on the top, please try to use this parameter, which only works
