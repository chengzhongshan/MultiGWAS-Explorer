12730      %put NOTE: LATTICE_STAGE gene_track_final_merge_begin;
12731      data final;
12732      set
12733      %do ti=1 %to %sysfunc(countw(&genegrp_ords));
12734      %let i=%scan(&genegrp_ords,&ti);
12735       %if %sysfunc(exist(work._y&i._final)) %then %do;
12736          _y&i._final
12737       %end;
12738      %end;
12739      ;
12740      %put NOTE: LATTICE_STAGE final_gene_track_merge_complete;
12741      
12742      /*
12743      *change the Y6 as other group for debugging;
12744      proc print data=WORK._Y6_FINAL;
