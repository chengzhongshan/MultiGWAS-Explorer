4330       proc transpose data=manhattan out=manhattan(rename=(col1=logP) drop=_name_);
4331       var logp:;
4332       by &chr_var Fake_position;
4333       run;
4334       
4335       *Get the max position for each chr;
4336       proc sql noprint;
4337       select distinct Fake_position into: min_fk_pos separated by ' '
4338       from manhattan
4339       group by &chr_var
4340       having fake_position=min(fake_position);
4341       *Remove the first element in the list;
4342       %select_element_range_from_list(
4343       list=&min_fk_pos,
4344       st=2,
4345       end=%ntokens(&min_fk_pos),
4346       sublist=new_min_fk_pos,
4347       sep=%str( )
4348       );
4349       
4350       
4351       %if "&var_type"="2" or &Keep_order_of_target_SNPs=1 %then %do;
4352       
4353       /*Note: the offset setting will make the legend move left when value is negative!*/
4354       *https://documentation.sas.com/doc/en/pgmsascdc/9.4_3.5/graphref/p0anvu6ux4d0ijn1mt06fn9yl0wx.htm#p18f31f18e6elan1ge5bb2p
4354     ! jiv34;
4355       *Note: asign empty string for the label of the legend;
4356       legend1 across=10 down=2 repeat=1 label=(height=4 position=top justify=center ' ')
4357               value=(height=2) shape=symbol(2,2) offset=(1pct)
4358               position=(bottom center outside);
4359       *The offset=(0,0)cm or offset=(2pct) will affect the left position of the legend;
4360       *See how to customize legend:;
4361       *https://support.sas.com/resources/papers/proceedings/proceedings/forum2007/163-2007.pdf;
4362       
4363       %if &sep_chr_grp=1 %then %do;
4364       %let maxbp=&maxbp &new_min_fk_pos;
4365       %end;
4366       
4367       proc gplot data=manhattan;
4368       plot logp*Fake_position=&chr_var
4369        /
4370                        haxis = axis1
4371                        vaxis = axis2
4372                        href  = &maxbp
4373                        annotate = anno
4374                       nolegend
4375       		            noframe
4376       /*		         legend=legend1*/
4377       ;
4378       %if &Keep_order_of_target_SNPs^=1 %then %do;
4379       format &chr_var Xaxis_var_label.;
4380       %end;
4381       label Fake_position="Groups"
4382             &chr_var="Legends of groups";
4383       run;
4384       
4385       *Also keep a copy of the dataset for further plotting with the macro;
4386       /*
4387       data _tgthits_;
4388       set _tgthits_;
4389       drop tag_snp;
4390       run;
4391       */
4392       
4393       %end;
4394       
4395       %else %do;
4396       proc gplot data=manhattan;
4397       plot1 logp*Fake_position=&chr_var
4398        /
4399                        haxis = axis1
4400                        vaxis = axis2
4401                        href  = &maxbp
4402                        annotate = anno
4403                        nolegend
4404       		         noframe
4405       ;
4406       run;
4407       %end;
4408       
4409       *This will enable the macro generate one figure by proc gplot in SAS OnDemand for Academics;
4410       *Otherwise, there would be two duplicated Manhattan plots;
4411       /* %return; */
4412       *return does not work, and only quit dose!;
4413       %put After successfully generate manhattan plot, the macro will quit to prevent from two duplicated Manhattan plots
4413     ! printed!;
4414       quit;
4415       
4416       %mend;
4417       %macro twocolors(c1,c2);
4418       %do j=1 %to 23 %by 2;
4419       symbol&j v=dot c=&c1;
4420       symbol%eval(&j+1) v=dot c=&c2;
4421       %end;
4422       %mend;
