847        %macro ApplyFunc_rowwide(
848        /*The macro is a handy tool to calculate common summary statistics, such as mean, median, sum, n, std, and others that
848      ! allowed
849        in proc sql when conducting analysis on groups on ROW-WIDE. Additionally, the macro can generate summary statistics by
850        including data from both rows and columns, with special case to generate summary statistics on all columns without
850      ! providing row_keys or
851        on all data in a table from all columns and rows!*/
852        dsdin,
853        row_keys,
854        KeyVar4dsdout,
855        Regex4col_vars2apply,
856        SQL_Fun4apply,
857        dsdout,
858        KeyVar4dsdout_length=200,
859        AlsoAppFun4Cols=0
860        );
861        %let n=%numargs(&row_keys);
862        %put macro var row_keys are &row_keys;
863        
864        %if %eval(&n=0) %then %do;
865        data &dsdout;
866        set &dsdin;
867        &KeyVar4dsdout="AllRows";
868        run;
869        %end;
870        %else %do;
871        data &dsdout;
872        length &KeyVar4dsdout $ &KeyVar4dsdout_length;
873        set &dsdin;
874        &KeyVar4dsdout=catx(":",
875        %let i=1;
876        %do %while (&i<&n);
877           %scan(&row_keys,&i,%str( )),
878           %let i=%eval(&i+1);
879        %end;
880           %scan(&row_keys,&n,%str( ))
881        );
882        run;
883        %end;
