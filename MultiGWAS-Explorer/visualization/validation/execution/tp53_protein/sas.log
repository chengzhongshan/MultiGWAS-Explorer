2857       
2858       /* This relabels the variable newpos as Position in the final figure. */
2859       data final;
2860       set final;
2861       *Update the x-axis label, which might be revised if the macro is not used for drawing GWAS local Manhattan plot;
2862       /* label newpos="%trim(%left(%sysfunc(prxchange(s/^chr/Chromosome /,1,&chr_name)))) (hg19)"; */
2863       label newpos="%trim(%left(%sysfunc(prxchange(s/^chr/Chromosome /,1,&chr_name))))";
2864       *This will remove the legend in the figure for dots that are with missing value of old_y;
2865       *The value 1 would be used as group number to match with its corresponding char label in the figure legend;
2866       /*if old_y=. then old_y=&Other_num_grpval;*/
2867       *The above fails to exclude groups with missing numeric group value;
2868       *keeping these old_y as missing would exclude them in the final figure legend;
2869       *The following code is just for reminding of the above fact;
2870       %if %length(&Other_num_grpval)>0 %then %do;
2871       if old_y=. then old_y=&Other_num_grpval;
2872       *it is necessary to re-assign missing value to these old_y when the &yval_var is missing;
2873       if &yval_var=. then old_y=.;
2874       %end;
2875       run;
2876       
2877       *Only draw CNVs in highlow plots based on their length>1;
2878       data final;
2879       set final;
2880       if not (&Variant_Length_Var>1) then do;
2881        &st_var=.;&end_var=.;
2882       end;
2883       run;
2884       *If end_var are all missing, it means there are no CNVs for running the highlow plot;
2885       %iscolallmissing(dsd=final,colvar=&end_var,outmacrovar=NoCNVs);
2886       
