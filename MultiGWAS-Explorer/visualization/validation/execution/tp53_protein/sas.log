14182      %macro book_pub_gtl(in=,out=,chr=,start=,stop=,step=,decimals=1);
14183      %local tick ticks;
14184      %let ticks=;
14185      %if %length(&chr) %then %do;
14186       proc format;
14187       value bookmb
14188       %do tick=&start %to &stop %by &step;
14189        &tick="%sysfunc(strip(%sysfunc(putn(%sysevalf(&tick/1000000),12.&decimals))))"
14190        %let ticks=&ticks &tick;
14191       %end;
14192       ;
14193       run;
14194      %end;
14195      data _null_;
14196       infile "&in" lrecl=32767 truncover;
14197       file "&out" lrecl=32767;
14198       length line $32767;
14199       input;line=_infile_;
14200       /* Captions identify the panel; avoid repeating a long headline in the image. */
14201       if index(lowcase(line),'entrytitle') then delete;
14202       line=tranwrd(line,'color=lightgray pattern=1 thickness=5',
14203                         'color=CXCCCCCC pattern=1 thickness=0.5');
14204       %if %length(&chr) %then %do;
14205       if index(lowcase(line),'xaxisopts=(') then do;
14206        line=prxchange('s/xaxisopts=\(label="[^"]*"/xaxisopts=(/',1,line);
14207        line=tranwrd(line,'xaxisopts=(',
14208          'xaxisopts=(label="Chromosome &chr position (Mb)" ');
14209       end;
14210       line=tranwrd(line,'tickvalueformat=best32.',
14211         'tickvalueformat=bookmb. tickvaluelist=(&ticks)');
14212       %end;
14213       put line;
14214      run;
14215      proc template;%include "&out";run;
14216      %mend;
