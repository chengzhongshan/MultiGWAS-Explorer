14219      /* Book-owned display pass: preserve every original macro-generated column. */
14220      %macro book_track_display(data=,out=work.track_display,in=,template=,
14221       factor=0.5,body=16,single_marker=0,label_center_pct=,label_gap=0);
14222      %local annvars allvars nann i compare_status;
14223      /* SOURCE materializes the compiled template, including resolved local macro
14224         variables from book_pub_gtl (chromosome and tick list). */
14225      proc template;source BedGraph / file="&BOOK_OUT/track_resolved_template.sas";run;
14226      %let in=&BOOK_OUT/track_resolved_template.sas;
14227      proc contents data=&data out=work.book_columns noprint;run;
14228      proc sql noprint;
14229       select name into :annvars separated by ' ' from work.book_columns
14230       where prxmatch('/^VAR4LOG10P\d+$/i',strip(name)) order by varnum;
14231       select name into :allvars separated by ' ' from work.book_columns order by varnum;
14232      quit;
14233      %let nann=%sysfunc(countw(&annvars));
14234      %if &single_marker %then %do;
14235       proc sql;
14236        create table work.book_group_order as select name from dictionary.columns
14237         where libname='WORK' and memname='MUTATION_WIDE' and upcase(substr(name,1,2))='P_'
14238         order by varnum;
14239       quit;
14240       data work.book_group_order;set work.book_group_order;pi=_n_;run;
14241       proc sql;
14242        create table work.book_occurrence_key as select distinct a.pos,b.pi
14243         from work.mutation_long a inner join work.book_group_order b
14244         on lowcase(a.panel)=lowcase(substr(b.name,3));
14245       quit;
14246      %end;
14247      data &out;
14248       %if &single_marker %then %do;
14249       if _n_=1 then do;
14250        declare hash occurrence(dataset:'work.book_occurrence_key');
14251        occurrence.defineKey('pi','pos');occurrence.defineDone();
14252       end;
14253       %end;
14254       set &data;
14255       array original_ann {*} &annvars;
14256       array display_ann {*} book_ann1-book_ann&nann;
14257       do book_i=1 to dim(original_ann);
14258        display_ann[book_i]=original_ann[book_i];
14259        if not missing(original_ann[book_i]) and original_ann[book_i]<0 then
14260         display_ann[book_i]=&factor*original_ann[book_i];
14261       end;
14262       book_gene_y=_y_;
14263       if not missing(_y_) and _y_<0 then book_gene_y=&factor*_y_;
14264       if not missing(book_gene_y) and book_gene_y<0 and grp_label ne ''
14265          and not missing(display_ann[1]) and display_ann[1]<0 then
14266        book_gene_y=max(book_gene_y,display_ann[1]+&label_gap);
14267       %if &single_marker %then %do;
14268       book_marker_pos=.;
14269       if grp='GWAS_Assoc_Signal' and not missing(old_y) and occurrence.check()=0 then book_marker_pos=pos;
14270       %end;
14271       drop book_i;
