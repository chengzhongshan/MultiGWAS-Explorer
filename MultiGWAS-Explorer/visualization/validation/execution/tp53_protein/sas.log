7492       );
7493       *Note: these global macro vars will be used to draw Manhattan plot later;
7494       %global _chr_colors_ _top_snps_;
7495       %let _chr_colors_=;
7496       %let _top_snps_=;
7497       
7498       %let _grp_cols_=
7499       cx0072bd
7500       cxd95319
7501       cxedb120
7502       cx7e2f8e
