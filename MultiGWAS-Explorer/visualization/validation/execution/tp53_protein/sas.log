9638       %macro varexist
9639       /*----------------------------------------------------------------------
9640       Check for the existence of a specified variable.
9641       ----------------------------------------------------------------------*/
9642       (ds=        /* Data set name */
9643       ,var=       /* Variable name */);
9644       
9645       /*----------------------------------------------------------------------
9646       Usage Notes:
9647       
9648       %if %varexist(&data,NAME)
9649         %then %put input data set contains variable NAME;
9650       
9651       The macro calls resolves to 0 when either the data set does not exist
9652       or the variable is not in the specified data set.
9653       ----------------------------------------------------------------------*/
9654       
9655       %local dsid rc ;
9656       
9657       /*----------------------------------------------------------------------
9658       Use SYSFUNC to execute OPEN, VARNUM, and CLOSE functions.
9659       -----------------------------------------------------------------------*/
9660       
9661       %let dsid = %sysfunc(open(&ds));
9662       
9663       %if (&dsid) %then %do;
9664         %if %sysfunc(varnum(&dsid,&var)) %then 1;
9665         %else 0 ;
9666         %let rc = %sysfunc(close(&dsid));
9667       %end;
9668       %else 0;
9669       
9670       %mend varexist;
