12383      yaxis_macro_labels=ylabelsmacro_var,
12384      fc2scale_pos_vals=&yscale,
12385      /*Use this fc to enlarge the proportion of positive values in the plots
12386      It seems that fc=2 is the best for the final ticks of different tracks;*/
12387      mod_num2keep=&mod_num2keep /*For the final yaxis_macro_labels, default value for the current var  is empty for not
12387    ! filtering these elements by mod; when values,
12388      such as 2 or 3 are provided, only keep numbers that fulfil the mod(element,num)=0;
12389      Note that this will only be applied on numbers that are positve!*/
12390      );
12391      %if %length(&ylabelsmacro_var)=0 %then %do;
12392      	 %put WARNING: The y-axis label macro variable is empty after fake-axis generation.;
12393         %put WARNING: Falling back to automatic y-axis ticks for this panel.;
12394         %let use_custom_y_ticks=0;
12395         %let yaxis_auto_ticks=1;
