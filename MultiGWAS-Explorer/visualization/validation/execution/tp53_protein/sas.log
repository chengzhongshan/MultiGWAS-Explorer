12015      *To avoid of the crash, let create a temporary variable for color_resp_var;
12016      data &bed_dsd;
12017      set &bed_dsd;
12018      _color_resp_var_=&var4label_scatterplot_dots;
12019      run;
12020      %let color_resp_var=_color_resp_var_;
12021      %end;
