5431       %macro Rename_Del_Rgx4All_Vars(indsd,Rgx);
5432       %let dsd_name=%scan(&indsd,-1,'.');
5433       %let dsd_lib=%scan(&indsd,-2,'.');
5434       proc sql noprint;
5435       create table temp as
5436       select name,label,format
5437         from dictionary.columns
5438         where libname=upper("&dsd_lib") and
5439               memname=upper("&dsd_name") and
5440       		memtype="DATA";
5441       data temp;
5442       set temp;
5443       newname=prxchange("s/&Rgx//",-1,name);
5444       run;
5445       
5446       proc sql noprint;
5447          select count(*) into :n from temp
5448          where prxmatch("/&Rgx/",name);
5449       
5450       %if &n>0 %then %do;
5451       proc sql noprint;
5452          select cat('rename ',strip(name),
5453                     '= ',strip(newname),';')
5454             into :l1 - %sysfunc(compress(:l&n))
5455             from temp
5456          where prxmatch("/&Rgx/",name);
5457       quit;
5458       
5459       proc datasets lib=&dsd_lib nolist;
5460       modify &dsd_name;
5461          %do i = 1 %to &n;
5462            &&l&i
5463          %end;
5464       run;
5465       %end;
5466       
5467       %mend;
