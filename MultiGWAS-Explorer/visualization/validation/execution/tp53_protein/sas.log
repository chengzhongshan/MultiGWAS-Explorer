14349      /* Scoped display pass. Original macros, data coordinates and palettes remain intact. */
14350      %macro BookChapter17Layout(data=,out=work.chapter17_display,height=400,dots=6,
14351       bottom_pad=12,body=14);
14352      %local annvars allvars lower_seen compare_status;
14353      proc template;source BedGraph / file="&BOOK_OUT/ch17_before_template.sas";run;
14354      proc contents data=&data out=work.ch17_columns noprint;run;
14355      proc sql noprint;
14356       select name into :annvars separated by ' ' from work.ch17_columns
14357       where prxmatch('/^BOOK_ANN[0-9]+$/i',strip(name)) order by varnum;
14358       select name into :allvars separated by ' ' from work.ch17_columns order by varnum;
14359      quit;
14360      data &out;set &data;run;
14361      proc compare base=&data compare=&out(keep=&allvars) criterion=0 noprint;run;
14362      %let compare_status=&sysinfo;
14363      data work.chapter17_compare;compare_sysinfo=&compare_status;run;
14364      %if &compare_status ne 0 %then %do;
14365       %put ERROR: Chapter 17 display copy changed original values.;
14366       %return;
14367      %end;
14368      /* Find the lowest annotation center, not a generic negative-axis fraction. */
14369      data _null_;
14370       set &data end=last;
14371       array a {*} &annvars;
14372       retain lowest 0;
14373       do i=1 to dim(a);if not missing(a[i]) then lowest=min(lowest,a[i]);end;
14374       if last then call symputx('lower_seen',lowest,'L');
14375      run;
14376      /* Preserve the positive scale. Reserve a small clearance below thick body bars. */
14377      data work.chapter17_layout_parameters;
14378       infile "&BOOK_OUT/ch17_before_template.sas" lrecl=32767 truncover end=last;
14379       length line $32767;retain upper offset_top;
14380       input;line=lowcase(_infile_);
14381       rx=prxparse('/viewmax=([-0-9.]+) viewmin=(-[0-9.]+)/');
14382       if prxmatch(rx,line) then do;
14383        call prxposn(rx,1,s,n);upper=input(substr(line,s,n),best32.);
14384       end;
14385       rx2=prxparse('/offsetmin=[0-9.]+ offsetmax=([0-9.]+)/');
14386       if prxmatch(rx2,line) then do;
14387        call prxposn(rx2,1,s,n);offset_top=input(substr(line,s,n),best32.);
14388       end;
14389       if last then do;
14390        lowest=&lower_seen;height=&height;marker_size=&dots;bottom_padding=&bottom_pad;
14391        usable=(height-70)*(1-offset_top-0.01);
14392        pad=max(bottom_padding,&body/2+4);
14393        lower=lowest-pad*(upper-lowest)/(usable-pad);
14394        if nmiss(upper,offset_top,lower) or usable<=pad then do;
14395         put 'ERROR: Unsupported chapter 17 GTL axis layout.';stop;
14396        end;
14397        call symputx('ch17_lower',lower,'L');output;
14398       end;
14399       keep upper lower lowest height marker_size bottom_padding;
14400      run;
14401      data _null_;
14402       infile "&BOOK_OUT/ch17_before_template.sas" lrecl=32767 truncover;
14403       file "&BOOK_OUT/ch17_template.sas" lrecl=32767;
14404       length line $32767;input;line=_infile_;
14405       line=prxchange("s/designheight=[0-9.]+/designheight=&height/i",1,line);
14406       if index(lowcase(line),'yaxisopts=') then do;
14407        line=prxchange("s/viewmin=-[0-9.]+/viewmin=&ch17_lower/i",1,line);
14408        line=prxchange('s/offsetmin=[0-9.]+/offsetmin=0.01/i',1,line);
14409       end;
14410       /* Only the actual association/occurrence point layer gets larger markers. */
14411       if prxmatch('/scatterplot x=(POS|BOOK_SCATTER_POS|BOOK_MARKER_POS) y=VAR4LOG10P /i',line)
14412        then line=prxchange("s/size=[0-9.]+(?:px|pt)?/size=&dots.px/i",1,line);
14413       put line;
14414      run;
14415      proc template;%include "&BOOK_OUT/ch17_template.sas";run;
14416      %mend;
