10701      %macro BookGDCMutationProteinTrack(
10702      /*See the demo code at the end of this macro for how to generate fake gtf and inptu data set based on ncbi gpff file;
10703      Note: several important parameters can adjust the label on the top:
10704      yoffset4max_drawmarkersontop and Yoffset4textlabels can be used to enlarge the top regions covering the labels;
10705      pct2adj4dencluster is able to increase the distance among these labels.
10706      text_rotate_angle and  pct2adj4dencluster control the rotation of these labels.
10707      */
10708      longformat_muts=,/*Long format HGI GWAS with association signals in a union by same columns and different gwas dsd names;
10709      Note: the input GWAS data should be in hg38 build if querying by genesymbol!*/
10710      gwas_dsd_var=gwas,/*The gwas variable in the longformat_muts*/
10711      filter4gwas_dsd=,/*Add full sas conditional filter for filtering snps by GWAS dsd, such as the following without adding ;
10711    ! :
10712      %nrbquote(if prxmatch('/DF/',&gwas_dsd_var)); note: superq can not be used here!*/
10713      query_rsid_or_genesymbol=1:1:1000 ,/*Subset the long format GWAS by rsid or genesymbol, rsid should be in the format of
10713    ! chr:st:end*/
10714      dist2snp_or_gene=1,/*in bp; left or right size distant to each target Gene for the Manhattan plot*/
10715      subset_gwas_dsd=subset_gwas_dsd,/*Output subset gwas dataset for further visualization with other sas macro if
10715    ! necessary*/
10716      gwas_chr_var=chr,/*GTF uses numeric chr notation; ensure the type of chr is consistent with input gwas dsd*/
10717      gwas_p_var=p,
10718      gwas_beta_var=beta,
10719      gwas_se_var=se,
10720      gwas_snp_var=rsid,
10721      gwas_pos_var=pos,
10722      GenerateGeneManhattanPlot=1,/*To not generate gene Manhattan plot, provide value 0 here*/
10723      SNPs2label_scatterplot_dots=,/*Add mut ids to label scatter dots at the top of figure; ensure
10724      gwas_snp_var contain these mut ids, otherwise, these muts will not be */
10725      var4label_scatterplot_dots=,/*Use either this var or input SNPs IDs to label vars*/
10726      yoffset4max_drawmarkersontop=0.5,/*Increase the top offset region for snp labels if the snp labels were truncated;
10727      This parameter is also useful for reducing the spaces among gene tracks by increasing its value and also reducing
10728      the figure height at the same time!*/
10729      Yoffset4textlabels=3.5, /*Move up the text labels for target SNPs in specific fold;
10730      the default value 2.5 fold works for most cases*/
10731      text_rotate_angle=90, /*Angle to rotate text labels for these selected dots by users*/
10732      auto_rotate2zero=0, /*supply value 1 when less than 3 text labels, it is good to automatically set the
10732    ! text_rotate_angel=0*/
10733      pct2adj4dencluster=20,/*For SNP labels on the top, please try to use this parameter, which only works when
10734      there are less than or equal to 3 top SNPs if track_width <= 500, or 5 top SNPs if track_width between 500 and 800, or 6
10734    ! top SNPs if
10735      track_width >=800, otherwise, this parameter will be excluded and even step will be used to separate them on the top!
10736      and SNPs within a cluster are overlapped with each other or overlapped with elements from other SNP cluster, so it is
10736    ! feasible to
10737      avoid this issue by increasing the pct or reducing it, respectively*/
10738      adj_spaces_among_top_snps=1, /*Provide value 1 to adjust spaces among top SNP labels; otherwise, give value 0 to not
10739      adjust top SNPs labels if these labels are rotated 90 degree, which is helpful when the space adjusted labels are not
10739    ! pretty*/
10740      gtf_dsd=LG.GTF_HG38,
10741      Gene_Var_GTF=Genesymbol,
10742      GTF_Chr_Var=chr,
10743      GTF_ST_Var=st,
10744      GTF_End_Var=end,
10745      design_width=1000,
10746      design_height=5000, /*If gene tracks are sparated with too much space vertically, please try to reudce the height and
10747      increase the yoffset4max_drawmarkersontop*/
10748      barthickness=20, /*gene track bar thinkness*/
10749      dotsize=8,
10750      dist2sep_genes=10,/*Distance to separate close genes into different rows in the gene track; provide negative value
10751      to have all genes in a single row in the final gene track*/
10752      where_cndtn_for_gwasdsd=%str(), /*where condition to filter input gwas_dsd*/
10753      gwas_labels_in_order=,
10754      /*The order will be from down to up in the final tracks*/
10755      outfigfmt=png
10756      );
10757      
10758      %let SNP_long_dsd=tgt;
10759      
10760      %if %sysfunc(prxmatch(/^(rs\d+|\d+:\d+)/,&query_rsid_or_genesymbol)) %then %do;
10761        %put We are going to get the genomic position and chromosome for the input query SNP &query_rsid_or_genesymbol;
10762      
10763        %if %sysfunc(prxmatch(/^(rs\d+)/,&query_rsid_or_genesymbol)) %then %do;
10764        proc sql noprint;
10765        select &gwas_chr_var,&gwas_pos_var into: tgt_chr, : tgt_pos
10766        from
10767        &longformat_muts
10768        where &gwas_snp_var="&query_rsid_or_genesymbol";
10769        quit;
10770        %let tgt_pos1=&tgt_pos;
10771        %let tgt_pos2=&tgt_pos;
10772        %end;
10773      
10774        %else %do;
10775      
10776        %let tgt_chr=%scan(&query_rsid_or_genesymbol,1,:);
10777        %let tgt_pos1=%scan(&query_rsid_or_genesymbol,2,:);
10778        %let tgt_pos2=%scan(&query_rsid_or_genesymbol,3,:);
10779      
10780        %end;
10781      
10782        data tgt;
10783        set &longformat_muts;
10784        keep &gwas_snp_var &gwas_pos_var &gwas_chr_var &gwas_dsd_var
10785                 &gwas_beta_var &gwas_se_var &gwas_p_var &var4label_scatterplot_dots;
10786        where &gwas_snp_var^="" and &gwas_chr_var=&tgt_chr and
10787        (&gwas_pos_var between &tgt_pos1-&dist2snp_or_gene and &tgt_pos2+&dist2snp_or_gene);
10788        run;
10789      
10790      	%if %length(&tgt_chr)=0 %then %do;
10791      	   %put No records related to the query SNP &query_rsid_or_genesymbol in the input GWAS &longformat_muts;
10792      		 %abort 255;
10793      	 %end;
10794        %put Target chromosome &tgt_chr and interval &tgt_pos1 to &tgt_pos2;
10795      
10796      
10797      %end;
10798      %else %do;
10799         %put The macro stopped due to the input data set not containing information for the query var;
10800         %abort 255;
10801      %end;
10802      
10803      %if %length(&query_rsid_or_genesymbol)>0 %then %do;
10804      data &SNP_long_dsd;
10805      set &SNP_long_dsd;
10806      %if %length(&filter4gwas_dsd)>0 %then %do;
10807       *filter GWAS dsd;
10808       /*if prxmatch('/DF/',dsd);*/
10809        %unquote(&filter4gwas_dsd);
10810      %end;
10811      run;
10812      %end;
10813      
10814      
10815      %if %sysfunc(exist(&SNP_long_dsd))=0 %then %do;
10816      		%put You filtered &SNP_long_dsd dataset does not exist;
10817      		%abort 255;
10818      %end;
