10321      %macro get_num_or_char_vars4dsd(indsd,outdsd,numeric);
10322      %if &numeric=0 %then %do;
10323        %let var_type=char;
10324      %end;
10325      %else %do;
10326        %let var_type=num;
10327      %end;
10328      
10329      %let dsd_name=%scan(&indsd,-1,'.');
10330      %let dsd_lib=%scan(&indsd,-2,'.');
10331      /*In case of no libname was provided*/
10332      %if %eval(&dsd_lib=) %then %let dsd_lib=work;
10333      proc sql;
10334      create table &outdsd as
10335      select name,label,format,type
10336        from dictionary.columns
10337        where libname=upper("&dsd_lib") and
10338              memname=upper("&dsd_name") and
10339      		memtype="DATA" and
10340              type="&var_type";
10341      quit;
10342      %mend;
10343      
10344      %macro idx4list_in_alphabet_ord(
10345      /*This macro is very useful for obtaining numeric index in an alphabetic sorted list for a query list;
10346      The output idx can be used in a macro loop or in a array at data step!*/
10347      list= ,/*Blank space separated elements*/
10348      outdsd=list_order, /*A sas dataset will be created to contain the index
10349      for these elements sorted in alphabet mode*/
10350      index_list_var=idx4list, /*a global macro var will be created to contain these index
10351      Make sure the value for index_list_var is not index_list_var, as it will lead conflict between
10352      the global macro var and the local macro var with the same name*/
10353      sep=%nrbquote(,) /*separator for the newly created index*/
10354      );
10355      %global &index_list_var;
10356      %let &index_list_var=;
10357      %rank4grps(
10358      grps=&list,
10359      dsdout=&outdsd
10360      );
10361      
10362      proc sql noprint;
10363      select char_ord into: &index_list_var separated by "&sep"
10364      from &outdsd;
10365      
10366      %mend;
