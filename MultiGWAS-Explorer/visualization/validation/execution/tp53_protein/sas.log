2250       %if %length(&ordered_sc_grpnames)>0 and &NotDrawScatterPlot=0 %then %do;
2251           *Add a dataset containing scatterplot headers;
2252           *Note: scatter_grp_var should be in numeric;
2253           *Also adjust the x-axis position for the group headers;
2254           proc sql;
2255           create table header_dsd as
2256           select distinct
2257           &scatter_grp_var as sc_grp,
2258           &yval_var+(&adjval4header) as header_yval,avgpos
2259           from (select *,
2260                 0.5*(&max_x+&min_x) as avgpos
2261                 from x1)
2262           where &scatter_grp_var >0
2263           group by &scatter_grp_var
2264           having &yval_var=max(&yval_var);
2265           *Now get the scatter plot group names;
2266           %rank4grps(
2267           grps=&ordered_sc_grpnames,
2268           dsdout=scgrpnames
2269           );
2270           *Note: here all _ included in the name of scatter plot are changed into blank space;
2271           proc sql;
2272           create table header_dsd as
2273           select a.*,prxchange('s/_/ /',-1,b.grps) as header_grp
2274           from header_dsd as a,
2275                scgrpnames as b
2276           where a.sc_grp=b.num_grps;
2277           quit;
2278       
2279           *Add the header dsd into the final dsd;
2280           *No need to adjust the avgpos by header length for each header grp;
2281           *SAS will adjust it automatically with the markercharacterposition=top in proc template;
2282           *But the code may be useful in adjusting gene labels;
2283       /*     data header_dsd; */
2284       /*     set header_dsd; */
2285       /*     avgpos=avgpos*(1-0.005*(countc(header_grp))); */
2286       /*     run; */
2287           data final;
2288           merge final header_dsd;
2289           run;
2290           *Get the minimum value of header_yval and the avgpos to fill these missing value after merge with final dsd;
2291           proc sql noprint;
2292           select header_yval, avgpos, header_grp
2293            into: hd_min,:mid_pos,:hgrp
2294           from header_dsd
2295           group by sc_grp
2296           having sc_grp=min(sc_grp);
2297           quit;
2298           data final;
2299           set final;
2300           if sc_grp=. then do;
2301            avgpos=&mid_pos;
2302            header_yval=&hd_min;
2303            header_grp="";
2304           end;
2305           run;
2306           /* proc print;run; */
