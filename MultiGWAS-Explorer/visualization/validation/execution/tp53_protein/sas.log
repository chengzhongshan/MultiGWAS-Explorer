12753      
12754      *Need to keep var4label_scatterplot_dots when  makeheatmapdotintooneline=1;
12755      
12756      data final;
12757      *Keep &st_var &end_var for CNV highlowplot if necessary;
12758      merge final x1(where=(&yval_var>=0) keep=old_y &Variant_Length_Var &st_var &end_var pos &yval_var &grp_var
12758    ! &scatter_grp_var &lattice_subgrp_var &var4label_scatterplot_dots &var4mark_ld_scatterplot_dots &ld_heatmap_var);
12759      *Add back these excluded data;
12760      run;
