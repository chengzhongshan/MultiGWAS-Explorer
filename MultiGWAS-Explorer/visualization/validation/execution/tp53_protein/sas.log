10099      subgrpvar4wideheader=&gwas_dsd_var,/*This subgrpvar will be used to tag all transposed SameTypeVars
10100      in the wide table, and the max length of this var can not be >32!*/
10101      dlm4subgrpvar=.,/*string used to split the subgrpvar if it is too long*/
