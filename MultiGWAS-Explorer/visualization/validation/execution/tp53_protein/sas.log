12768      %put NOTE: LATTICE_STAGE positive_signal_merge_complete;
12769      *Asign a specific values for gene with missing value;
12770      proc sql noprint;
12771      select grp1 into: genenames separated by " "
12772      from
12773      (select unique(grp1)
12774      from final
12775      where grp1^="" and &yval_var.1<0);
12776      %let onegenename=%scan(&genenames,1,%str( ));
12777      %put selected genename for missing value is &onegenename;
12778      
12779      *Asign a specific values for non-gene grp with missing value;
12780      proc sql noprint;
12781      select &grp_var into: grpnames separated by " "
12782      from
12783      (select unique(&grp_var)
12784      from x1
12785      where &yval_var>=0);
12786      %let onegrpname=%scan(&grpnames,1,%str( ));
12787      %put selected grpname for missing value of non-gene group is &onegrpname;
12788      /* %abort 255; */
12789      data final;
12790      set final;
12791      array C{*} _character_;
12792      *The above array may include the var &var4label_scatterplot_dots for labeling users selected dots in scatterplot;
12793      *We need to exclude the var &var4label_scatterplot_dots;
12794      *Need to pay attention to other variables that were character but not included in the gene group variables!;
12795      do ci=1 to dim(C);
12796         grpname=vname(C{ci});
12797      /*    if grpname^="&var4label_scatterplot_dots" then do; */
12798      /*    The following is better; */
12799            if prxmatch('/^grp\d+$/',grpname) then do;
12800      			*The &grp_var.1 to &grp_var.&tot_genegrps are for genes, thus they are only needed to be replaced for missing values
12800    ! with genename!;
12801      		       if ci<=&tot_genegrps then do;
12802                       if C{ci}="" then C{ci}="&onegenename";
12803      				end;
12804      				*For non-gene grps, use non-gene grp name to fill missing grp value;
12805      				*This is not right, need to use gene name to fill all missing subgrps;
12806      				*Because all sub grps &grp_var&i only contain gene or exon bed regions;
12807      				else do;
12808      /* 					if C{ci}="" then C{ci}="&onegrpname"; */
12809      					if C{ci}="" then C{ci}="&onegenename";
12810      				end;
12811      	 end;
12812      end;
12813      /*array N{*} _numeric_;*/
12814      /*Can not asign values to numeric variable with missing values;*/
12815      /* do ni=1 to dim(N); */
12816      /*    if N{ni}=. then N{ni}=.; */
12817      /* end; */
12818      drop ci;
12819      run;
12820      /* %abort 255; */
12821      *prevent missing data draw in the final scatterplot legend;
12822      *Here would be a potential bug if the var lattice_subgrp_var is character;
12823      *Address it by checking var type;
12824      %check_var_type(
12825      dsdin=final,
12826      var_rgx=&lattice_subgrp_var
12827      );
12828      %put lattice_subgrp_var &lattice_subgrp_var variable type is &var_type;
12829      %put NOTE: LATTICE_STAGE lattice_subgrp_type_checked;
12830      
12831      %if %length(&lattice_subgrp_var)=0 %then %do;
12832        %put WARNING: The lattice_subgrp_var is empty. Falling back to scatter_grp_var=&scatter_grp_var.;
12833        %let lattice_subgrp_var=&scatter_grp_var;
12834        %check_var_type(
12835        dsdin=final,
12836        var_rgx=&lattice_subgrp_var
12837        );
12838        %put lattice_subgrp_var fallback variable type is &var_type;
12839      %end;
12840      
12841      *For numeric lattice_subgrp_var;
12842      %if %eval(&var_type=1) %then %do;
12843      data _null_;
12844      set final(keep=&lattice_subgrp_var where=(&lattice_subgrp_var^=.));
12845      if _n_=1 then do;
12846        call symputx('lattice_grp1',&lattice_subgrp_var);
12847      end;
12848      else do;
12849      		stop;
12850      end;
12851      run;
12852      
12853      *To rescue the above when not drawing scatterplot, the macro var lattice_grp1 would be missing;
12854      %if (&NotDrawScatterPlot=1) %then %let lattice_grp1=0;
12855      
12856      data final;
12857      set final;
12858      if &lattice_subgrp_var=. then &lattice_subgrp_var=&lattice_grp1;
12859      run;
12860      %end;
12861      %else %do;
12862      *For character lattice_subgrp_var;
12863      data _null_;
12864      set final(keep=&lattice_subgrp_var where=(&lattice_subgrp_var^=""));
12865      if _n_=1 then do;
12866        call symputx('lattice_grp1',&lattice_subgrp_var);
12867      end;
12868      else do;
12869      		stop;
12870      end;
12871      run;
12872      data final;
12873      set final;
12874      if &lattice_subgrp_var="" then &lattice_subgrp_var=&lattice_grp1;
12875      run;
12876      
12877      %end;
12878      /*%abort 255;*/
12879      
12880      /*
12881      proc print data=final(obs=50);run;
12882      %abort 255;
12883      */
12884      
12885      %if &add_grp_anno=1 %then %do;
12886      
12887      ***********************************Add grp label for making text identification*******************************;
12888      /*proc print data=final;run;*/
12889      
12890      data final(drop=A);
12891      *Ensure the lower gene track name have enough length;
12892      length grp_label $50.;
12893      set final;
12894      *Also need to add grp labels for the first grp, which usually represent genes for all grps;
12895      *It is important to get the lag value of &grp_var.1 here;
12896      *if use the lag function within the if else condition,;
12897      *du to the _n_=1 was passed without of determine the 1st lag value,;
12898      *the output is not as expected.;
12899      A=lag(&grp_var.1);
12900      if _n_=1 then do;
12901        grp_label=&grp_var.1;
12902      end;
12903      else do;
12904        if trim(&grp_var.1)^=trim(A) then grp_label=&grp_var.1;
12905        if pos1=. then grp_label="";
12906      end;
12907      *Adjust the y value to make the label about the left a little bit in the gene track;
12908      *shift_text_yval can be negative or positve value;
12909      if &yval_var.1^=. then _y_=&yval_var.1 + (&shift_text_yval*&pct4neg_y);
12910      
12911      *adjust pos1 value if the xaxi_viewmin is set up;
12912      %if %length(&xaxis_viewmin)>0 %then %do;
12913        if pos1<&xaxis_viewmin then pos1=&xaxis_viewmin;
12914      %end;
12915      run;
12916      
12917      /*
12918      proc print data=final(obs=50);run;
12919      %abort 255;
12920      */
12921      
12922      %end;
