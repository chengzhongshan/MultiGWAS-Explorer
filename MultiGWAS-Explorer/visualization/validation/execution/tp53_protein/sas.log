12568      *Get the grp ord of gene grps;
12569      %put NOTE: LATTICE_STAGE gene_group_ord_query_begin;
12570      proc sql noprint;
12571      select unique(ord) into: genegrp_ords separated by " "
12572      from X2;
12573      select count(unique(&grp_var)) into:tot_genegrps
12574      from X2;
12575      %put NOTE: LATTICE_STAGE gene_group_ord_query_complete genegrp_ords=&genegrp_ords tot_genegrps=&tot_genegrps
12575    ! max_ord=&max_ord;
12576      
12577      /*
12578      proc print data=x2;
12579      run;
12580      %abort 255;
12581      */
12582      
12583      ******************************************Prepare data for making series and scatter
12583    ! plots************************************************************;
12584      /*Need to fill these missing values with pair of non-missing values,
12585      otherwise, the missing values will be a group that will be included
12586      in the legend in the final figure*/
12587      *Can not simplify the above process by using &tot_genegrps!;
12588      *Do not use the following loop;
12589      /* %do gi=1 %to &tot_genegrps; */
12590      /* %do gi=1 %to &max_ord; */
12591      
12592      %do gi=1 %to %ntokens(&genegrp_ords);
12593      %let _gi_=%scan(&genegrp_ords,&gi,%str( ));
12594      %put NOTE: LATTICE_STAGE gene_track_subset_begin gi=&gi ord=&_gi_;
12595      data _y&gi(keep=ord &grp_var&_gi_ pos&_gi_ &yval_var&_gi_);
12596      *Only keep these y values <0 and the max y value for drawing bed track;
12597      *Excluded data will be plotted via scatter plot;
12598      set x2;
12599      *Important to asign enough length for these grps, which are typical for gene names;
12600      length  &grp_var&_gi_ $30.;
12601      if ord=&_gi_ then do;
12602        &grp_var&_gi_=&grp_var;
12603        pos&_gi_=pos;
12604      		label pos&_gi_="%unquote(&xaxis_label)";
12605        &yval_var&_gi_=&yval_var;
12606      		label &yval_var&_gi_="&yaxis_label";
12607        output;
12608      end;
12609      *No need this, which only add missing values and makes the dataset too big;
12610      /*else do;*/
12611         *Missing values will be generated for ord not equal to &_gi_;
12612        /*grp_var may be numeric or char,
12613         just use its original value here,
12614         will remove it later*/
12615      /*  &grp_var&_gi_=&grp_var;*/
12616      /*  pos&_gi_=.;*/
12617      /*		label pos&_gi_="Position (bp) on chromosome &chr_name";*/
12618      /*  &yval_var&_gi_=.;*/
12619      /*		label &yval_var&_gi_="&yaxis_label";*/
12620      /*  output;*/
12621      /*end;*/
12622      run;
12623      %put NOTE: LATTICE_STAGE gene_track_subset_built gi=&gi ord=&_gi_ ds=_y&gi;
12624      
12625      
12626      /*proc sort data=_y&_gi_;by &grp_var&_gi_ ord pos&_gi_;*/
12627      /*run;*/
12628      
12629      /*get the 1st two records without missing values,
12630      which will be used for fill these missing values later*/
12631      %if %sas_dsd_exist(_y&gi)=0 %then %do;
12632           %put WARNING: The temporary gene-track dataset _y&gi does not exist, so this subgroup will be skipped.;
12633      %end;
12634      %else %do;
12635      data _y&_gi_._ _y&_gi_._missing;
12636      /*set _y&_gi_;*/
12637      set _y&gi;
12638      if pos&_gi_^=. then output _y&_gi_._;
12639      else output _y&_gi_._missing;
12640      /*create the common var n with values of 1 or 2
12641      for matching with non-missing values from y1_*/
12642      run;
12643      /*%if &_gi_=4 %then %abort 255;*/
12644      
12645      *Directly count whether the temporary subgroup keeps any non-missing positions;
12646      *instead of relying on helper macros that may abort on empty inputs.;
12647      %let _ygi_nonmissing=0;
12648      proc sql noprint;
12649      select count(*) into: _ygi_nonmissing trimmed
12650      from _y&_gi_._
12651      where pos&_gi_^=.
12652      ;
12653      quit;
12654      %if %sysevalf(%superq(_ygi_nonmissing)=,boolean) %then %let _ygi_nonmissing=0;
12655      %put NOTE: LATTICE_STAGE gene_track_subset_nonmissing_count gi=&gi ord=&_gi_ count=&_ygi_nonmissing;
12656      %let tot_missing=1;
12657      %if %sysevalf(&_ygi_nonmissing>0) %then %do;
12658      %let tot_missing=0;
12659      %end;
12660      %else %do;
12661      %put WARNING: The temporary gene-track dataset _y&_gi_._ has no non-missing positions, so it will be skipped.;
12662      proc datasets lib=work nolist;
12663      delete _y&_gi_._;
12664      quit;
12665      %end;
12666      /*%put &tot_missing;*/
12667      /* %if %sysfunc(exist(work._y&_gi_._)) %then %do; */
12668      %if "&tot_missing" eq "0" and %sysfunc(exist(work._y&_gi_._)) %then %do;
12669      data _y&_gi_._missing;
12670      set _y&_gi_._missing;
12671      if mod(_n_,2)=0 then n=2;
12672      else n=1;
12673      /*Also get the 1st two non-missing values and
12674      label them with 1 and 2 for matching*/
12675      data _y&_gi_._1;
12676      set _y&_gi_._;
12677      n=_n_;
12678      if _n_<=2;
12679      run;
12680      proc sql;
12681      create table _y&_gi_._filled as
12682      select a.n as n&_gi_, b.*
12683      from _y&_gi_._missing as a,
12684           _y&_gi_._1 as b
12685      where a.n=b.n;
12686      /*merge y1_filled with y1_*/
12687      data _y&_gi_._final(drop=ord n);
12688      set _y&_gi_._filled(drop=n&_gi_) _y&_gi_._;
12689      run;
12690      %put NOTE: LATTICE_STAGE gene_track_subset_finalized gi=&gi ord=&_gi_;
12691      
12692      *better to add the &grp_var1 into other subset dsd, as these subset dsd may missing some genes;
12693      %if 	%eval(&gi>1) %then %do;
12694      proc sql;
12695      create table y1fory&gi as
12696       select * from _y1_final
12697        where &grp_var.1 NOT in (select &grp_var.&_gi_ from _y&_gi_._final);
12698      
12699      *Manually make all pos1 as _n_ (out of the xaix range);
12700      *leading to no drawing of the y1 region but inclusion of y1 legend in the final series plot;
12701      data y1fory&gi;
12702      set y1fory&gi;
12703      pos1=_n_;
12704      run;
12705      
12706      proc sql;
12707      create table _y&_gi_._final_ as
12708      select * from _y&_gi_._final
12709      union all
12710      select * from y1fory&gi;
12711      
12712      *Rename _y&gi._final_ back as _y&gi._final_;
12713      *This is because the _y&gi._final is used by union and can not be replace within the same proc sql;
12714      data _y&_gi_._final;
12715      set _y&_gi_._final_;
12716      *Make values < &min_x as .;
12717      if pos&_gi_ < &min_x then pos&_gi_=.;
