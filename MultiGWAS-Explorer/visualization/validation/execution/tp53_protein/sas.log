11277      where_cndtn_for_gwasdsd=&where_cndtn_for_gwasdsd, /*where condition to filter input gwas_dsd*/
11278      gwas_labels_in_order=&gwas_labels_in_order,
11279      /*The order will be from down to up in the final tracks*/
11280      fig_fmt=&outfigfmt,
11281      shift_text_yval=-0.2, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
11282                            to liftup or lower text labels on the y axis; the default value is -0.2 to put gene lable under
11282    ! gene tracks;
11283                            Change it with the macro var pct4neg_y!*/
11284      pct4neg_y=4, /*the most often used value is 1;
11285                    compacting the bed track y values by increasing the scatterplot scale,
11286                    which can reduce the bed trace spaces; It seems that two-fold increasement
11287                    leads to better ticks for different tracks!
11288                    Use value >1 will increase the gene tract, while value < 1 will reduce it!
11289                    Note: when there are only 1 or 2 scatterplots, it is better to provide value = 0.5;
11290                    Modify this parameter with the parameter shift_text_yval to adjust gene label!
11291                    Typically, when there are more scatterplots, it is necessary to increase the value of pct4neg_y accordingly
11291    ! ;
11292                    If there are only <4 scatterplots, the value would be usually set as 1 or 2;
11293                    */
11294      adjval4header=-2, /*In terms of header of each subscatterplot, provide postive value to move up scatter group header by
11294    ! the input value*/
11295      
11296      makedotheatmap=1,/*use colormap to draw dots in scatterplot instead of the discretemap;
11297      Note: if makedotheatmap=1, the scatterplot will not use the discretemap mode based on
11298      the negative and postive values of lattice_subgrp_var to color dots in scatterplot*/
11299      
11300      color_resp_var=,/*Use value of the var to draw colormap of dots in scatterplot
11301      if empty, the default var would be the same as that of yval_var;*/
11302      
11303      makeheatmapdotintooneline=1,/*This will make all dots have the same yaxis value but have different colors
11304      based on its real value in the heatmap plot; To keep the original dot y axis value, assign 0 to the macro var
11305      This would be handy when there are multiple subgrps represented by different y-axis values! By modifying
11306      the y-axis values for these subgrps, the macro can plot them separately in each subtrack!
11307      */
11308      var4label_scatterplot_dots=&var4label_scatterplot_dots ,/*Make sure the variable name is not grp, which is a fixed var
11308    ! used by the macro for other purpose;
11309      the variable should contain values of target SNPs and other non-targets are asigned with empty values;
11310      Whenever  makeheatmapdotintooneline=1 or 0, it is possible to use values of the var4label_scatterplot_dots to
11311      label specific scatterplot dots based on the customization of the variable predifined by users for the input data set;
11312      default is empty; provide a variable that include non-empty strings for specific dots in the
11313      scatterplots;*/
11314      SNPs2label_scatterplot_dots= &SNPs2label_scatterplot_dots, /*Add multiple SNP rsids to label dots within or at the top of
11314    !  scatterplot
11315      Note: if this parameter is provided, it will replace the parameter var4label_scatterplot_dots!
11316      */
11317      text_rotate_angle=&text_rotate_angle, /*Angle to rotate text labels for these selected dots by users*/
11318      auto_rotate2zero=&auto_rotate2zero, /*supply value 1 when less than 3 text labels, it is good to automatically set the
11318    ! text_rotate_angel=0*/
11319      pct2adj4dencluster=&pct2adj4dencluster,/*For SNP labels on the top, please try to use this parameter, which only works
11319    ! when
11320      there are less than or equal to 3 top SNPs if track_width <= 500, or 5 top SNPs if track_width between 500 and 800, or 6
11320    ! top SNPs if
11321      track_width >=800, otherwise, this parameter will be excluded and even step will be used to separate them on the top!
11322      and SNPs within a cluster are overlapped with each other or overlapped with elements from other SNP cluster, so it is
11322    ! feasible to
11323      avoid this issue by increasing the pct or reducing it, respectively*/
11324      yoffset4max_drawmarkersontop=&yoffset4max_drawmarkersontop,
11325      Yoffset4textlabels=&Yoffset4textlabels, /*Move up the text labels for target SNPs in specific fold;
11326      the default value 2.5 fold works for most cases*/
11327      adj_spaces_among_top_snps=&adj_spaces_among_top_snps /*Provide value 1 to adjust spaces among top SNP labels; otherwise,
11327    ! give value 0 to not
11328      adjust top SNPs labels if these labels are rotated 90 degree, which is helpful when the space adjusted labels are not
11328    ! pretty*/
11329      );
11330      
11331       %end;
11332      
11333      %end;
11334      
11335      %mend;
