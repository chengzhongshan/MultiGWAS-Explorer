2342       run;
2343       
2344       *De-duplicate repeated labels without dropping a singleton label by row parity.;
2345       *Key only by label text: x1 expands each variant to start/end plotting positions,;
2346       *so a label+position key incorrectly retains the same rsID twice.;
2347       %if %length(&var4label_scatterplot_dots)>0 %then %do;
2348       data final;
2349         if _n_=1 then do;
2350           declare hash _seen_target_labels();
2351           _seen_target_labels.defineKey("&var4label_scatterplot_dots");
2352           _seen_target_labels.defineData("&var4label_scatterplot_dots");
2353           _seen_target_labels.defineDone();
2354         end;
2355         modify final;
2356         if &var4label_scatterplot_dots^="" and pos^=. then do;
2357           if _seen_target_labels.check()=0 then &var4label_scatterplot_dots="";
2358           else _seen_target_labels.add();
2359         end;
2360         replace;
2361       run;
2362       %end;
2363       
2364       
2365       *Transform data to label selected dots only once if multiple satterplots containing the same label;
2366       %if (%length(&var4label_scatterplot_dots)>0 and &label_dots_once_on_top=1 and &NotDrawScatterPlot=0) %then %do;
2367           %put NOTE: LATTICE_STAGE top_label_transform_begin;
2368           data _xtag_;
2369           set final;
2370           xtag=_n_;
2371           _tmp_=_n_;
2372           where &var4label_scatterplot_dots^="" and pos^=.;
2373           keep &var4label_scatterplot_dots xtag _tmp_ pos;
2374           run;
2375       
2376           *Collapse repeated label rows before any spacing adjustment so a SNP that;
2377           *appears in multiple tracks is treated as one top label with one position.;
2378           proc sort data=_xtag_;
2379           by &var4label_scatterplot_dots pos _tmp_;
2380           run;
2381       
2382           data _xtag_;
2383           set _xtag_;
2384           by &var4label_scatterplot_dots;
2385           if first.&var4label_scatterplot_dots;
2386           run;
2387           proc sql noprint;
2388       	select count(*) into: total_target_labels
2389       	from (
2390       	select distinct &var4label_scatterplot_dots
2391           from _xtag_
2392           );
2393         %let effective_font_size4textlabels=&font_size4textlabels;
2394         %let effective_yoffset4textlabels=&Yoffset4textlabels;
2395       
2396         *When there is less then 4 SNPs for labeling at the top of the local Manhattan plot, reset the following rotation angle
2396     !  macro var to 0;
2397         *and increase 4 fold for the the dist_pct_to_cluster_pos;
2398         *First decide the cutoff of total_target_labels based on the width of figure;
2399        %if &track_width <= 500 %then %do;
2400            %let label_n_cutoff=3;
2401       %end;
2402       %else %if (&track_width>500 and  &track_width<800) %then %do;
2403            %let label_n_cutoff=4;
2404       %end;
2405       %else %if (&track_width>=800) %then %do;
2406           %let label_n_cutoff=5;
2407       %end;
2408       %else %do;
2409           %let label_n_cutoff=0;
2410       %end;
2411       
2412         %if &total_target_labels=0 %then %do;
2413             %put WARNING: No requested SNP labels remain in the local GWAS plot data.;
2414             %let make_even_pos=0;
2415         %end;
2416         %else %if &total_target_labels<=&label_n_cutoff %then %do;
2417       /*	   %let dist_pct_to_cluster_pos=%sysevalf(4*&dist_pct_to_cluster_pos);*/
2418       /*       %let dist_pct_to_cluster_pos=%sysevalf(1/&total_target_labels);*/
2419                %let dist_pct_to_cluster_pos=%sysevalf(0.5/&total_target_labels);
2420       /*	   %let  fc2distant_close_labels=%sysevalf(4*&fc2distant_close_labels);*/
2421       	   %let make_even_pos=0;
2422         %end;
2423         %else %do;
2424       	  %let make_even_pos=1;
2425       	  *No need to make even positions when rotation angle is set as 90;
2426       	  %if &text_rotate_angle=90 %then %let make_even_pos=0;
2427         %end;
2428       
2429         *Horizontal top labels need more aggressive spacing control than vertical labels.;
2430         %if (&text_rotate_angle=0) %then %do;
2431             %if &total_target_labels>=3 %then %let make_even_pos=1;
2432             %if &total_target_labels>=3 %then %let
2432     ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,3.0));
2433             %if &total_target_labels>=4 %then %do;
2434                 %let fc2distant_close_labels=%sysfunc(max(&fc2distant_close_labels,5));
2435                 %let pct2adj4dencluster=%sysfunc(max(&pct2adj4dencluster,3));
2436                 %let effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,9));
2437                 %let effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,3.6));
2438             %end;
2439             %if &total_target_labels>=5 %then %do;
2440                 %let fc2distant_close_labels=%sysfunc(max(&fc2distant_close_labels,6));
2441                 %let pct2adj4dencluster=%sysfunc(max(&pct2adj4dencluster,4));
2442                 %let effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,8));
2443                 %let effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,4.2));
2444             %end;
2445             %if &track_width<700 and &total_target_labels>=4 %then %let
2445     ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,8));
2446             %if &track_width<500 and &total_target_labels>=3 %then %let
2446     ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,7));
2447         %end;
2448         %else %if (&text_rotate_angle>=60) %then %do;
2449             %if &total_target_labels>=5 %then %let
2449     ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,9));
2450             %if &total_target_labels>=7 %then %let
2450     ! effective_font_size4textlabels=%sysfunc(min(&effective_font_size4textlabels,8));
2451             %if &total_target_labels>=5 %then %let
2451     ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,2.0));
2452         %end;
2453       
2454          *Also need to adjust labels with too close positions;
2455         %if &track_width<700 %then %let Pct4OnlyTwoPos=0.25;
2456         %else %let Pct4OnlyTwoPos=0.1;
2457       
2458         %if (&adj_spaces_among_top_snps=1 and &total_target_labels>=2) %then %do;
2459          %adjust_close_positions(
2460          indsd=_xtag_,
2461          outdsd=_xtag_,
2462          pos_var=pos,
2463          new_pos_var=newpos,
2464          dist_pct_to_cluster_pos=&dist_pct_to_cluster_pos,
2465          amplification_fc=&fc2distant_close_labels,
2466          make_even_pos=&make_even_pos,
2467          Pct4OnlyTwoPos=&Pct4OnlyTwoPos,/*In case of only two positions, it is necessary to use arbitrary proportion of
2467     ! dist_step to separate them,
2468          i.e., minus and add Pct4OnlyTwoPos*dist_step and for the first and second positions, respectively*/
2469          pct2adj4dencluster=&pct2adj4dencluster,
2470          fixed_min_pos=&min_x,
2471          fixed_max_pos=&max_x
2472          );
2473          %end;
2474          %else %do;
2475       	 data _xtag_;
2476       	 set _xtag_;
2477       	 newpos=pos;
2478       	 run;
2479          %end;
2480          *The above macro is not good in separating these positions into distinguishable positions;
2481          *However, due to historical compatability, the above codes will be kept;
2482          *******************************************************************************************************;
2483          *Use the other macro to improve it, and it can be canceled if it is still not optimum;
2484          *Only run it when requiring the text to be rotated;
2485          %if (&text_rotate_angle>0 and &adj_spaces_among_top_snps=1 and &total_target_labels>=2) %then %do;
2486          %put We will further optimize the space between each SNP label on the top of the gene track;
2487          proc sql noprint;
2488          select pos into: _tgt_pos_ separated by ' '
2489          from _xtag_
2490          order by pos;
2491          select &fc2distant_close_labels*0.1*(&max_x-&min_x+1)/count(*) into: sep4tgt_pos
2492          from _xtag_;
2493          %spaceAdjust(data=&_tgt_pos_, out=_xtag1_, goal=COL:, sep=&sep4tgt_pos, newvar4adjnum=newpos);
2494          /* _xtag1_ follows genomic-position order, so align rows before merging. */
2495          proc sort data=_xtag_;
2496          by pos;
2497          run;
2498          data _xtag_;
2499          merge _xtag_(drop=newpos) _xtag1_(keep=newpos);
2500          run;
2501          %end;
2502          /* Preserve the planner's label centers after the legacy SAS spacing pass.
2503             Only label coordinates change; GWAS marker and LD positions stay intact. */
2504          %if %length(%superq(label_position_overrides))>0 %then %do;
2505          data _xtag_;
2506          set _xtag_;
2507          length _planned_token $256 _planned_snp $128;
2508          do _planned_i=1 to countw(symget('label_position_overrides'), ' ');
2509             _planned_token=scan(symget('label_position_overrides'), _planned_i, ' ');
2510             _planned_snp=scan(_planned_token, 1, '=');
2511             if upcase(strip(&var4label_scatterplot_dots))=upcase(_planned_snp) then do;
2512                _planned_bp=input(scan(_planned_token, 2, '='), best32.);
2513                if not missing(_planned_bp) then newpos=_planned_bp;
2514                leave;
2515             end;
2516          end;
2517          drop _planned_token _planned_snp _planned_i _planned_bp;
2518          run;
2519          %end;
