6068       %macro TotVarsInDsd(/*This macro is able to count all, numeric, or character vars in a sas dataset*/
6069       ds, /*This macro return total number of variables in a dsd*/
6070       var_type=_all_ /*optional values including _all_, _numeric_, or _character_
6071       for counting total number of all, numeric, or character vars*/
6072       );
6073       
6074          %local dset dsid;
6075          %let dset=&ds;
6076          %let dsid = %sysfunc(open(&dset(keep=&var_type)));
6077          %if &dsid %then
6078             %do;
6079       /*         %let nobs =%sysfunc(attrn(&dsid,NOBS));*/
6080                %let nvars=%sysfunc(attrn(&dsid,NVARS));
6081                %let rc = %sysfunc(close(&dsid));
6082                 &nvars
6083             %end;
6084       
6085       %mend;
