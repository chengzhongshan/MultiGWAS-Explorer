1052       %macro Lattice_gscatter_over_bed_track(
1053       /*
1054       Note: when makedotheatmap=1, in default, the scatterplot will use lattice_subgrp_var to color dots
1055       across different scatter groups; User can supply an independent variable represented by the macro variable
1056       color_resp_var to color scatter plot dots but different scattergroups will be applied in a union style!
1057       This macro can also draw mixed CNV and scatter plots upper the gene tracks;
1058       */
1059       bed_dsd,/*at least contains 7 variables, including chr_var, st_var, end_var, grp_var, and yval_var;
1060       Too many bed regions (>1000) for the gene track will slow down the macro dramatically;
1061       Note: the macro will change the input bed_dsd when supplying xaxis_viewmin and xaxis_viewmax*/
1062       chr_var,/*chromosome name for bed regions*/
1063       st_var,	/*start positions for bed regions*/
1064       end_var,/*end positions for bed regions*/
1065       Variant_Length_Var,/*this variable if not empty, its value will be used to extend the value of Pos_Var for making
1066       the start and end position for SNP_Var, i.e., st=st-0.5*&Variant_Length_Var and end=st-0.5*&Variant_Length_Var;
1067       This would be especially helpful for mixing CNV and SNV data for making scatter plots, as it is only necessary
1068       to provide middle position for CNVs and its lengths for ploting CNVs and SNVs together!*/
1069       grp_var,/*it is specifically designed for genes used by the lower gene track, such as genesymbols for all its bed
1069     ! regions,
1070       and the upper scatterplot tracks do not use it, thus values for data points in the scatterplots can be missing*/
1071       scatter_grp_var,/*it is used to separate scatterplot data points into different scatter groups, and its values for
1072       scatterplot data points and gene bed regions in lower gene track should be positve and negative, respectively;
1073       when only draw gene tracks, ensure the the negative value, such as -1, provided for all bed regions, and
1074       the macro will automatically separate these genes if they are too close to each other!*/
1075       lattice_subgrp_var,/*specifically designed for scatterplots, its values are used to separate dots in scatterplots
1076       into different groups and color them based on its yval_var value; when only draw gene tracks, just assign the same
1077       value for all bed regions, which can be 0 or any other numeric or character values, as it will be only enable the
1078       macro to run successful but will not be used for drawing the final figure!*/
1079       yval_var, /*this variable is used to draw y-axis for dots of scatterplots and bed regions of genes*/
1080       yaxis_label=Group,/*The value will be used to label the y-axis*/
1081       linethickness=20, /*line thinkness for gene bed regions*/
1082       track_width=800, /*Final figure width*/
1083       track_height=400,/*Final figure height*/
1084       image_dpi=300,/*Raster output DPI. Lower values reduce SAS ODA Java memory use without changing the layout.*/
1085       dist2st_and_end=0,/*Extend the start and end position for the x-axis*/
1086       dotsize=10,/*Scatter plot marker symbol size, and the default marker is circlefilled dot; when making heatmap, it is
1087       possible to restrict the dotsize as the same for the highlow line size, such as 10pt, which would be different from the
1088       default value 10 without the pt unit!*/
1089       scattermarker_symbol=circlefilled,/*Assign specific marker symbol, such as ibeam, circlefilled, circle, dot,
1089     ! squarefilled, or square, for scatter plot;
1090       Note the size of the designated marker symbol will be defined by the macro variable dotsize; when creating heatmap, you
1090     ! can assign
1091       squarefilled to the scattermarker_symbol, which would be more compatable with the highlow line style in for CNV or bed
1091     ! regions!*/
1092       debug=0,/*keep intermediate data sets for debugging if its value is 1*/
1093       add_grp_anno=1, /*This will add group names, such as gene labels, to each member of grp_var*/
1094       grp_font_size=8, /*font size for gene labels in the lower gene track*/
1095       grp_anno_font_type=italic, /*other type: normal; specifically designed for the gene label font type*/
1096       shift_text_yval=-0.25, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
1097       to liftup or lower text labels on the y axis; the default value is -0.25 to put gene lable under gene tracks;
1098       Change it with the macro var pct4neg_y! Provide very large or small values, such as 9999 or -9999 to remove test labels
1098     ! for genes!*/
1099       amplify_scatterheader_pos=1, /*Provide value 1 to the macro var when the max value for each scatter plot is too large,
1100       the header position for it should be amplified automatically by the macro*/
1101       yaxis_offset4min=0.05, /*provide 0-1 value or auto to offset the min of the yaxis*/
