3805       Fake_position=1;
3806       Fake_position + _n_ ;/*This part will affect the Xaxis dramatically*/;
3807       /*where &chr_var between 1 and 24;*/
3808       /*where &chr_var >=1;*/
3809       run;
3810       %end;
3811       /*For GWAS*/
3812       %else %do;
