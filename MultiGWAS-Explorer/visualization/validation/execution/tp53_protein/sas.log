10841      %Get_All_Var_Info(indsd=&subset_gwas_dsd,outdsd=tgt_vars);
10842      proc sql noprint;
10843      select name into: pvar_list separated by ' '
10844      from tgt_vars
10845      where prxmatch( "/^&gwas_p_var._/i",name);
10846      select name into: betavar_list separated by ' '
