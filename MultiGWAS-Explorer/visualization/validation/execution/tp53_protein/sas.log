12722      proc sort data=_y&_gi_._final;
12723      by grp&_gi_;
12724      run;
12725      %put NOTE: LATTICE_STAGE gene_track_subset_sorted gi=&gi ord=&_gi_;
12726      %end;
12727      %end;
