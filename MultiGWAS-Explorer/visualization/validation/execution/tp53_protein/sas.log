6088       %macro add_fake_pos_by_grp4nonnegvars(
6089       dsdin,
6090       axis_var,/*No negative values are allowed for the target axis var*/
6091       axis_grp,
6092       new_fake_axis_var,
6093       dsdout, /*Two new variables, tag var and tpos, can be used to draw a ref line to separe each group*/
6094       axis_step=1, /*Add extra step to separate each group for the end value of axis_var*/
6095       concise_output=0, /*Provide value 1 to only keep 3 vars and other vars included in the original input dsdin,
6096       including axis_var, axis_grp, and new_fake_axis_var, and others in the output dsdout*/
6097       reset_1st_value_as_one=0 /*Default is not to reset the 1st value of each group as one;
6098       Provide the value 1 to reset the 1st value of each group as 1 and other values to minus the 1st value in the input dsdin;
6099       this would be helpful if the 1st position value of each group is too large to draw plot by group!*/
6100       );
6101       
6102       /*
6103       %let dsdin=a;
6104       %let axis_grp=g;
6105       %let axis_var=y;
6106       %let dsdout=b;
6107       %let axis_step=1;
6108       %let new_fake_axis_var=fy;
6109       */
6110       
6111       *Test whether there are negative values in the &dsdin;
6112       *the macro only works for values >= 0;
6113       proc sql noprint;
6114       select count(&axis_var) into: neg_var_tot
6115       from &dsdin
6116       where &axis_var<0;
6117       
6118       
6119       %if &neg_var_tot>0 %then %do;
6120        %put the macro only works for positve values, and you dsd &dsdin contains &neg_var_tot number of negative values;
6121        %abort 255;
6122       %end;
6123       
6124       
6125       *Fix a bug when only one record in a group;
6126       *make an extra copy for the records to make it has >1 records;
6127       *This is because the script will not be able to update corrected;
6128       *y axis labels if there is only one record for a group;
6129       
6130       proc sql;
6131       create table _single_ as
6132       select *
6133       from &dsdin
6134       group by &axis_grp
6135       having count(&axis_grp)=1;
6136       
6137       data &dsdin;
6138       set &dsdin _single_;
6139       
6140       proc sort data=&dsdin;
6141       by &axis_grp &axis_var;
6142       run;
6143       
6144       data _dsdin_;
6145       set &dsdin;
6146       *Scale position value and make it larger by fold change;
6147       *if &axis_var>0 then &axis_var=&fc2scale_pos_vals*&axis_var;
6148       run;
6149       
6150       *Reset the 1st axis_var as 1;
6151       %if &reset_1st_value_as_one=1 %then %do;
6152       %put Going to reset the 1st value of each group as one and other values will adjusted accordingly;
6153        proc sql;
6154       create table _dsdin_ (drop=&axis_var) as
6155       select a.*,
6156                  a.&axis_var-min(a.&axis_var)+1 as _new_
6157       from _dsdin_ as a
6158       group by &axis_grp
6159       order by &axis_grp,_new_;
6160       data _dsdin_;
6161       set _dsdin_;
6162       rename _new_=&axis_var;
6163       run;
6164       %end;
6165       
6166       data &dsdout;
6167       retain tpos 0 step &axis_step grp_n 0 grpnum 0;
6168       set _dsdin_;
6169       
6170       n=_n_;
6171       *add the var grp_n for sorting the values inside each group;
6172       *which would be handy to handle all negative values by using the macro;
6173       *the method is simply to change all negative values into positve, ane then;
6174       *use this macro. Finally, flip the order of fake axis values by this var grp_n later;
6175       *grp_n need to be put in the retain command;
6176       
6177       if first.&axis_grp then do;
6178        fst_tag=1;
6179        grpnum=grpnum+1;
6180        grp_n=1;
6181        if n=1 then do;
6182          *important to make tpos as 0 when n=1;
6183          tpos=tpos;
6184          &new_fake_axis_var=&axis_var;
6185        end;
6186        else do;
6187          &new_fake_axis_var=&axis_var + tpos;
6188        end;
6189       end;
6190       
6191       if last.&axis_grp then do;
6192          grp_n=grp_n+1;
6193          tag=1;
6194          &new_fake_axis_var=tpos + &axis_var;
6195          if not first.&axis_grp then do;
6196             *only floor but not ceil can be used here;
6197             tpos=ceil(&axis_var) + tpos + step;
6198          end;
6199       end;
6200       
6201       if (not first.&axis_grp) and (not last.&axis_grp) then do;
6202        grp_n=grp_n+1;
6203        &new_fake_axis_var=&axis_var + tpos;
6204       end;
6205       
6206       by &axis_grp;
6207       
6208       run;
6209       
6210       *Also add a new var to indicate the middle axis value for each group;
6211       data &dsdout;
6212       retain mid_val 0;
6213       set &dsdout;
6214       if tag=1 then mid_val=tpos-0.5*(tpos-mid_val);
6215       run;
6216       
6217       data &dsdout;
6218       set &dsdout;
6219       *reassign missing value for mid_val whoes tag is not 1;
6220       if tag=. then mid_val=.;
6221       run;
6222       
6223       *Make the last maximum value minus the step;
6224       data &dsdout;
6225       set &dsdout end=eoff;
6226       if eoff then tpos=tpos-step;
6227       run;
6228       %if &concise_output=1 %then %do;
6229       data &dsdout;
6230       set &dsdout;
6231       drop mid_val tpos step grp_n grpnum n fst_tag tag;
6232       run;
6233       %end;
6234       
6235       %mend;
6236       
6237       
6238       %macro adj_grpnum4close_gene_bed_regs(
6239       /*Note: the macro can only separate most of the bed regions
6240       for better labeling bed regions, and usually the 1st track will be
6241       good, with genes included in other tracks may not be well separated!*/
6242       gene_bed_dsd=a,
6243       st_var=st,
6244       end_var=end,
6245       reg_type=type,/*if empty, it will use the longest region as gene and
6246                      other shorter region from the same group as exons*/
6247       focused_reg_type4grouping=gene,
6248       gene_grp=grp,
6249       gene_dist_thrhd=0.1,/*(1) give 0 or negative value to incluce all genes into a single group;
6250                             (2) given value in bp > 1 to separate genes by absolute distance in bp;
6251                             (3) if given value ranging from 0 to 1, it will use the pct of the whole region
6252                                 to separate genes into different groups!
6253                                 This option would be most useful to enable enough space for adding text on each
6254                                 gene, as it will consider the length of gene as well as the distance between genes*/
6255       dsdout=_gene_regions_,/*dsdout can be the same as gene_bed_dsd*/
6256       outnumgrp=numgrp /*the var name for outnumgrp can not be same as other vars in gene_bed_dsd*/
6257       );
6258       
6259       %if "&gene_bed_dsd"="&dsdout" %then %do;
6260           %put Your input dsd name is the same as the output dsd name;
6261           %put we will temporarily change the &dsdout as: &dsdout._;
6262           %let old_dsdout=&dsdout;
6263           %let dsdout=&dsdout._;
6264       %end;
6265       %else %do;
6266           %let old_dsdout=&dsdout;
6267       %end;
6268       
6269       %if &reg_type ne %then %do;
6270         proc sort
6271         data=&gene_bed_dsd(where=(&reg_type="&focused_reg_type4grouping"))
6272         out=&dsdout
6273         nodupkeys;
6274         by &st_var &end_var &gene_grp;
6275         run;
6276       %end;
6277       %else %do;
6278        data &dsdout;
6279        set &gene_bed_dsd;
6280        dist=&end_var - &st_var;
6281        run;
6282        proc sql;
6283        create table &dsdout(drop=dist) as
6284        select &st_var,&end_var, &gene_grp, dist
6285        from &dsdout
6286        group by &gene_grp
6287        having dist=max(dist);
6288       %end;
6289       
6290       *It is important to sort the start position again!;
6291       *otherwise, the _grp_ number would not be the best!;
6292       proc sort data=&dsdout;by &st_var;run;
6293       
6294       proc sql noprint;
6295       select left(put(count(&gene_grp),3.)) into: ngenes
6296       from &dsdout;
6297       run;
6298       
6299       %if &gene_dist_thrhd > 0 %then %do;
6300       
6301        %if &gene_dist_thrhd<1 %then %do;
6302            proc sql noprint;
6303            select min(st),max(end) into: st_min,:end_max
6304            from &dsdout;
6305            %put Now we will use the relative distance based on the percent &gene_dist_thrhd of whole region;
6306            %put from &st_min to &end_max to separate genes into different groups!;
6307            %let gene_dist_thrhd=%sysevalf((&end_max-&st_min)*&gene_dist_thrhd);
6308        %end;
6309       /*  data &dsdout(drop=_lag_end:);*/
6310        data &dsdout;
6311         retain _grp_ 1;
6312         set &dsdout;
6313         _lag_end_1=(lag(end) ^=.) and (abs(st-lag(end))<&gene_dist_thrhd or st-lag(end)<0);
6314         _lag_end_1= _lag_end_1 >0 or ((lag(st) ^=.) and (abs(st-lag(st))<&gene_dist_thrhd or st-lag(st)<0))>0;
6315         /*
6316         lag_end1=lag(end);
6317         */
6318         %do ni=2 %to &ngenes;
6319           /*
6320           lag_end2=lag2(end);
6321           lag_end3=lag3(end);
6322           */
6323           _lag_end_&ni=(lag&ni.(end) ^=.) and ((abs(st-lag&ni.(end))<&gene_dist_thrhd) or st-lag&ni.(end)<0);
6324           _lag_end_&ni=_lag_end_&ni>0 or ((lag&ni.(st) ^=.) and (abs(st-lag&ni.(st))<&gene_dist_thrhd or st-lag&ni.(st)<0))>0;
6325         %end;
6326         %if &ngenes>1 %then %do;
6327          *Add one to make it start from 1 for the 1st group;
6328           _grp_=sum(of _lag_end_1-_lag_end_&ngenes)+1;
6329         %end;
6330         run;
6331        %end;
6332       
6333       %else %do;
6334        *Include all genes into one group;
6335        data &dsdout;
6336        set &dsdout;
6337        _grp_=1;
6338        run;
6339       %end;
6340       /*%abort 255;*/
6341       
6342       
6343       *exclude records with the same consecutive _grp_;
6344       data &dsdout(drop=_consect_grp_tag)
6345            &dsdout._bad(drop=_consect_grp_tag);
6346       set &dsdout;
6347       _consect_grp_tag=lag(_grp_);
6348       if (_consect_grp_tag=_grp_ and _grp_>1) then output &dsdout._bad;
6349       else output &dsdout;
6350       run;
6351       /*for debugging*/
6352       /* %abort 255; */
6353       
6354       *make consective numeric groups for _grp_;
6355       *The limitation of this part is that only element in the _grp_=1 can be separated well;
6356       proc sort data=&dsdout;by _grp_ st end;
6357       data &dsdout;
6358       retain _cgrp_ 0;
6359       set &dsdout;
6360       if first._grp_ then _cgrp_=_cgrp_+1;
6361       by _grp_;
6362       run;
6363       
6364       *Combine the grps, such as n+1 and n+3, with n=0,1,2,3;
6365       *An easy way to combine them would be as follows:;
6366       *Make these grps with reverse order;
6367       *Note: use _grp_ to get max;
