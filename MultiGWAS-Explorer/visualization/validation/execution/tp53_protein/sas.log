1698       %make_fake_axis4NegPosVal_by_grps(
1699       dsdin=x1,
1700       axis_var=&yval_var,
1701       /*Both negative and positive values of axis var are allowed to use this macro,
1702       but in each group, only positve (>0) or negative (<0) values are allowed,
1703       and all 0 axis var values will be excluded from the dsdin,
1704       the above of which are the limitations of the macro!*/
1705       axis_grp=&scatter_grp_var, /*although using the same input, this para is different from make_fake_axis_values4grps*/
1706       new_fake_axis_var=&yval_var._new,
1707       dsdout=x1,
1708       yaxis_macro_labels=ylabelsmacro_var,
1709       fc2scale_pos_vals=&yscale,
1710       /*Use this fc to enlarge the proportion of positive values in the plots
1711       It seems that fc=2 is the best for the final ticks of different tracks;*/
1712       mod_num2keep=&mod_num2keep /*For the final yaxis_macro_labels, default value for the current var  is empty for not
1712     ! filtering these elements by mod; when values,
1713       such as 2 or 3 are provided, only keep numbers that fulfil the mod(element,num)=0;
1714       Note that this will only be applied on numbers that are positve!*/
1715       );
1716       %if %length(&ylabelsmacro_var)=0 %then %do;
1717       	 %put WARNING: The y-axis label macro variable is empty after fake-axis generation.;
1718          %put WARNING: Falling back to automatic y-axis ticks for this panel.;
1719          %let use_custom_y_ticks=0;
1720          %let yaxis_auto_ticks=1;
1721       %end;
1722       
1723       %if %length(&ylabelsmacro_var)>256 %then %do;
1724           *Prevent SAS from crash due to the truncated macro var containing single quote;
1725       	 %put WARNING: The y-axis label macro variable is too long, and SAS might crash!;
1726          %if &crowded_scatter_yaxis_compat=1 %then %do;
1727          %put NOTE: Crowded-axis compatibility mode will keep the custom y-axis labels despite their length, matching the older
1727     !  local-GTF macro behavior.;
1728          %end;
1729          %else %do;
1730          %put WARNING: Falling back to automatic y-axis ticks for this panel to avoid unsafe macro expansion.;
1731          %let use_custom_y_ticks=0;
1732          %let yaxis_auto_ticks=1;
1733          %end;
1734       %end;
1735       
1736       %put Generated y-axis ticks are:;
1737       %if &use_custom_y_ticks=1 %then %do;
1738       %put &ylabelsmacro_var;
1739       %end;
1740       %else %do;
1741       %put [suppressed: ylabelsmacro_var exceeded safe length];
1742       %end;
1743       %end;
1744       %else %do;
1745       
1746       %let use_custom_y_ticks=1;
