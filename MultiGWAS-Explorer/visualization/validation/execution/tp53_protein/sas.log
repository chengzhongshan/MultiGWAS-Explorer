10872      %SNP_Local_Manhattan_With_GTF(/*As this macro use other sub-macros, it is not uncommon that some global macro
10873      vars would be in the same name, such as macro vars chr and i, thus, to avoid of crash, chr_var is used instead of macro
10874      var chr in this macro*/
10875      gwas_dsd=&subset_gwas_dsd,
10876      chr_var=&gwas_chr_var,
10877      AssocPVars=&_pvar_list_,
10878      SNP_IDs=&query_rsid_or_genesymbol,
10879      /*if providing chr:pos or chr:st:end, it will query by pos;
10880      Please also enlarge the dist2snp to extract the whole gene body and its exons,
10881      altought the final plots will be only restricted by the input st and end positions!*/
10882      dist2snp=&dist2snp_or_gene,
10883      /*in bp; left or right size distant to each target SNP for the Manhattan plot*/
10884      SNP_Var=&gwas_snp_var,
10885      Pos_Var=&gwas_pos_var,
10886      gtf_dsd=&gtf_dsd,
10887      ZscoreVars=&_betavar_list_,/*Can be beta1 beat2 or other numberic vars indicating assoc or other +/- directions*/
10888      gwas_labels_in_order=&gwas_labels_in_order,/*If providing _ for labeling each GWAS,
10889      the _ will be replaced with empty string, which is useful when wanting to remove gwas label
10890      if only one scatterplot or the label for a gwas containing spaces;
10891      The list will be used to label scatterplots
10892      by the sub-macro map_grp_assoc2gene4covidsexgwas*/
10893      design_width=&design_width,
10894      design_height=&design_height,
10895      barthickness=&barthickness, /*gene track bar thinkness*/
10896      dotsize=&dotsize,
10897      dist2sep_genes=&dist2sep_genes,/*Distance to separate close genes into different rows in the gene track; provide negative
10897    !  value
10898      to have all genes in a single row in the final gene track*/
10899      where_cndtn_for_gwasdsd=%str(), /*where condition to filter input gwas_dsd*/
10900      
10901      shift_text_yval=0.2, /*in terms of gene track labels, add positive or negative vale, ranging from 0 to 1,
10902                            to liftup or lower text labels on the y axis; the default value is -0.2 to put gene lable under
10902    ! gene tracks;
10903                            Change it with the macro var pct4neg_y!*/
10904      fig_fmt=&outfigfmt, /*output figure formats: svg, png, jpg, and others*/
10905      pct4neg_y=4, /*the most often used value is 1;
10906                    compacting the bed track y values by increasing the scatterplot scale,
10907                    which can reduce the bed trace spaces; It seems that two-fold increasement
10908                    leads to better ticks for different tracks!
10909                    Use value >1 will increase the gene tract, while value < 1 will reduce it!
10910                    Note: when there are only 1 or 2 scatterplots, it is better to provide value = 0.5;
