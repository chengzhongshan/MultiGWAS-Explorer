6431       proc sort data=&dsdout;by _grp_ st end;
6432       *Note that the macro var &old_dsdout is used here to avoid of potential errors when the gene_bed_dsd is the same as
6432     ! &dsdout;
6433       proc sql;
6434       create table &old_dsdout as
6435       select a.*,b._cgrp_ as &outnumgrp
6436       from &gene_bed_dsd as a
6437       left join
6438       &dsdout as b
6439       on a.&gene_grp=b.&gene_grp;
6440       
6441       data &dsdout;
6442       set &old_dsdout;
6443       run;
6444       *When the two vars &dsdout and &old_dsdout have the same name, the original dataset will be overwritten;
6445       *Need to keep a copy for it.;
6446       data &old_dsdout.0;
6447       set &old_dsdout;
6448       run;
6449       /*%abort 255;*/
6450       ***It is necessary to further optimize these regions by merging the largest group number with the smallest group numer;
6451       ***when any regions in the largest group number are not within the distance threshold;
6452       
6453         *This part might invite issues for separating a gene and its corresponding exons into different groups;
6454         *To resovle the issue, it is necessary use minmum st and max end for each gene_grp as input;
6455         *First keep a copy for the above &dsdout, and then later update the &outnumgrp with newly calculated group numbers;
6456         proc sql;
6457         create table &dsdout as
6458         select distinct &gene_grp,min(&st_var) as &st_var,max(&end_var) as &end_var,&outnumgrp
6459         from &dsdout
6460         group by &gene_grp;
6461       /*  %abort 255;*/
6462       
6463       %let nmgrp_0=0;
6464       %let nmgrp_1=1;
6465       *For debugging the loop;
6466       %let nloop=0;
6467       *Restrict the loop only run maximum of 300 iterations;
6468       %do %while (&nmgrp_0 ne &nmgrp_1 and &nloop<300);
6469          %let nloop=%eval(&nloop+1);
6470         *Need to create a new numgrp var and reorder the numgrp based on new &outdsd in the loop;
6471         proc sql;
6472         create table _tmp_ as
6473         select unique(&outnumgrp) as _tmpnumgrp_
6474         from &dsdout
6475         order by &outnumgrp;
6476       /*  %abort 255;*/
6477         data _tmp_;set _tmp_;&outnumgrp=_n_;
6478         proc sql;
6479         create table &dsdout as
6480         select a.*,b.&outnumgrp as new&outnumgrp
6481         from &dsdout as a
6482         left join
6483         _tmp_ as b
6484         on a.&outnumgrp=b._tmpnumgrp_;
6485       /*  %abort 255;*/
6486         *Put the newnumgrp into the macro var &nmgrps;
6487         *This will update the macro var nmgrps in each interation;
6488         proc sql noprint;
6489         select put(new&outnumgrp,best12.) into: nmgrps separated by ' '
6490         from (
6491           select distinct new&outnumgrp from &dsdout
6492         );
6493       /*  %abort 255;*/
6494         *Use the newnumgrp to replace older numgrp;
6495         data &dsdout(rename=(new&outnumgrp=&outnumgrp));
6496         set &dsdout(drop=&outnumgrp);
6497         run;
6498       
6499        %if %ntokens(&nmgrps)>=3 %then %do;
6500       
6501          proc sql noprint;
6502          select put(&outnumgrp,best12.) into: nmgrp_0 separated by ':'
6503          from &dsdout
6504          order by &gene_grp, &st_var, &end_var;
6505          *Important to only consider the comparision between regions from i and i+2 groups;
6506          *since the consecutive groups, i and i+1 do not have potential non-overlapped regions based on the distance threshold;
6507       
6508          %do nmg_i=%ntokens(&nmgrps) %to 3 %by -1;
6509                *%let start_num=%eval(1+%ntokens(&nmgrps)-&nmg_i);
6510                 %let start_num=1;
6511       		 *Note: only compare 3 pairs, and the following can not be uncommented as SAS will fail to parse the macro contents due
6511     !  to it is use of pcts;
6512       		 %let end_num=%sysfunc(ifc(%eval(&nmg_i-2)>%eval(&start_num+6),%eval(&start_num+6),%eval(&nmg_i-2)));
6513       /*		  %let end_num=%eval(&nmg_i-2);*/
6514       		 %put Your start and end number for the loop is &start_num and &end_num;
6515       	     %do nmg_ii= &start_num %to &end_num %by 2;
6516       /*		      %let nloop=%eval(&nloop+1);*/
6517       		       %put Running the n=&nloop loop: comparison for the group &nmg_i with group &nmg_ii;
6518       			 data p1;set &dsdout;where &outnumgrp=&nmg_ii;
6519       			 data p2;set &dsdout;where &outnumgrp=&nmg_i;
6520       			 run;
6521       /*			 %if %totobsindsd(work.p2)=0 %then %do;*/
6522       /*						%put No obs in the dataset p2 for the numgrp &nmg_i;*/
6523       /*						%abort 255;*/
6524       /*			 %end;*/
6525       			%if %totobsindsd(work.p2)>0 %then %do;
6526       
6527       			 %if %ntokens(&nmgrps)>=3 %then %do;
6528       				 data left;set &dsdout;where &outnumgrp^=&nmg_ii and &outnumgrp^=&nmg_i;
6529       			 %end;
6530       			  run;
6531       /*			  %abort 255;*/
6532       			  *It is important to use distinct to remove duplicate records due to the where condition leads to potential multiple
6532     ! matches;
6533       			  proc sql;
6534       			  create table p1_p2 as
6535       			  select distinct b.*
6536       			  from p1 as a,
6537       			           p2 as b
6538       			  where (b.&st_var between  (a.&st_var-&gene_dist_thrhd) and (a.&end_var+&gene_dist_thrhd)) or
6539                                (b.&end_var between  (a.&st_var-&gene_dist_thrhd) and (a.&end_var+&gene_dist_thrhd));
6540       /*			   proc print;run;*/
6541       			   %if %totobsindsd(work.p1_p2)>0 %then %do;;			
6542       					 proc sql;
6543       					 create table p1p2_except as
6544       					 select * from p2
6545       					 except
6546       					 select * from p1_p2;
6547       					   data p1p2_except;set p1p2_except;&outnumgrp=&nmg_ii;
6548       					   *Update data set p2, which have different outnumgrp for p1_p2 and p1p2_except;
6549       					   data p2;set p1_p2 p1p2_except;run;
6550       			   %end;
6551       			   %else %do;
6552       			   	  *Merge all records with the largest group &nmg_i as that of &nmg_ii;
6553       			      data p2;set p2;&outnumgrp=&nmg_ii;
6554       			   %end;
6555       			    data &dsdout;
6556       				set p1 p2
6557                       %if %ntokens(&nmgrps)>=3 %then %do;
6558       				  left
6559       				%end;
6560                       ;
6561       				run;
6562       
6563       				proc sql;
6564       				drop table left;
6565       				drop table p1;
6566       				drop table p2;
6567       				drop table p1_p2;
6568       				drop  table p1p2_except;
6569       /*				%abort 255;*/
6570       	      %end;
6571                %end;
6572          %end;
6573         *Capture these new group numbers and order them by positions;
6574         *The macro var will be used to compare with previous numbers &nmgrp_0;
6575          proc sql noprint;
6576          select put(&outnumgrp,best12.) into: nmgrp_1 separated by ':'
6577          from &dsdout
6578          order by &gene_grp, &st_var, &end_var;
6579       %end;
6580        %else %do;
6581       	 %let nmgrp_0=1;
6582            %let nmgrp_1=1;
6583        %end;
6584       
6585       %end;
6586       
6587         *It is necessary to rename the &dsdout as &old_dsdout;
6588       *&old_dsdout contains the target output data set name, in case that it is the same as input data set name;
6589       *Update the newly generated grp number to the &old_dsdout;
6590       /*%put old_dsdout is &old_dsdout and dsdout is &dsdout;*/
6591       proc sql;
6592       create table &old_dsdout as
6593       select a.*,b.&outnumgrp
6594       from &old_dsdout.0(drop=&outnumgrp) as a
6595       left join
6596       &dsdout as b
6597       on a.&gene_grp=b.&gene_grp;
6598       /*%abort 255;*/
6599       /* proc print;run; */
6600       %mend;
