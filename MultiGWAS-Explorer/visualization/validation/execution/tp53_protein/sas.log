2164       %end;
2165       
2166       *For numeric lattice_subgrp_var;
2167       %if %eval(&var_type=1) %then %do;
2168       data _null_;
2169       set final(keep=&lattice_subgrp_var where=(&lattice_subgrp_var^=.));
