8424       %macro make_fake_axis_values4grps(
8425       /*This macro has issue when axis_var containing positve and negative values among different grps*/
8426       dsdin,
8427       axis_var,
8428       axis_grp,
8429       new_fake_axis_var,
8430       dsdout,
8431       yaxis_macro_labels=ylabelsmacro_var,
8432       step4yaxis_macro_labels=1,/*Only keep ticks with mod(t,step)=0, which will prevent the y-axis ticks from too compacted
8432     ! with each other!*/
8433       fc2scale_pos_vals=2, /*Use this fc to enlarge the proportion of positive values in the plots
8434       It seems that fc=2 is the best for the final ticks of different tracks;
8435       */
8436       mod_num2keep= /*Default is empty for not filtering these elements by mod; when values,
8437       such as 2 or 3 are provided, only keep numbers that fulfil the mod(element,num)=0*/
8438       );
8439       
8440       *Fix a bug when only one record in a group;
8441       *make an extra copy for the records to make it has >1 records;
8442       *This is because the script will not be able to update corrected;
8443       *y axis labels if there is only one record for a group;
8444       proc sql;
8445       create table _single_ as
8446       select *
8447       from &dsdin
8448       group by &axis_grp
8449       having count(&axis_grp)=1;
8450       data &dsdin;
8451       set &dsdin _single_;
8452       data &dsdin;
8453       set &dsdin;
8454       *Scale position value and make it larger by fold change;
8455       if &axis_var>0 then &axis_var=&fc2scale_pos_vals*&axis_var;
8456       run;
8457       
8458       *add 2 to the max value to make grps separated better;
8459       proc sql;
8460       create table &dsdout as
8461       select a.*,&axis_var as &new_fake_axis_var,
8462              floor(min(&axis_var)) as min_val,
8463              ceil(max(&axis_var))+2 as max_val
8464       from &dsdin as a
8465       group by &axis_grp
8466       order by &axis_grp,&axis_var;
8467       
8468       data &dsdout;
8469       retain max grpnum mtag 0;
8470       set &dsdout;
8471       grp_end_tag=0;
8472       if first.&axis_grp then do;
8473       *important to set max^=0;
8474       *No other value can be used, as 0 is very special;
8475        if max^=0 then do;
8476       /*	 if min_val<0 then do;*/
8477       /*		 *The 1st one of each grp would be the min_val;*/
8478       /*   &new_fake_axis_var=max-min_val;*/
8479       /*		end;*/
8480       /*		else do;*/
8481       /*   &new_fake_axis_var=&axis_var+max;*/
8482       /*		end;*/
8483       	  *As max value is integer, the 1st y value if not integer, need to add back its decimal value;
8484       	  &new_fake_axis_var=max+(&axis_var-min_val);
8485          grpnum=grpnum+1;
8486        end;
8487        else do;
8488         &new_fake_axis_var=&axis_var;
8489       		mtag=1;
8490         grpnum=1;
8491        end;
8492       end;
8493       
8494       else if last.&axis_grp then do;
8495        grp_end_tag=1;
8496       	*important to set max^=0;
8497       	*also need to check mtag,which forces to run the following when passed the;
8498       	*the 1st element;
8499        if max^=0 then do;
8500          &new_fake_axis_var=(&axis_var-min_val)+max;
8501       /*		*for negative min_val, it is necessary to adjust max;*/
8502       /*		if min_val<0 then do;*/
8503       /*		  *when max is still equal to 0, keep it as 0;*/
8504       /*		  if max^=0 then do;*/
8505       /*     max=max+max_val-min_val;*/
8506       /*					*Important to make it as the close largest integer;*/
8507       /*					max=ceil(max);*/
8508       /*				end;*/
8509       /*		end;*/
8510       /*		else do;*/
8511       /*			 *max=max+max_val;*/
8512       /*		  *The above can not be used;*/
8513       /*		  *Not 100% sure why the following works!;*/
8514       /*		   max=&axis_var-min_val+2+max;*/
8515       /*					max=ceil(max);*/
8516       /*		end;*/
8517       			 *Use correct syntax;
8518       			 max=ceil(&new_fake_axis_var)+2;
8519        end;
8520        else do;
8521         &new_fake_axis_var=&axis_var;
8522       		*for negative min_val, it is necessary to adjust max;
8523       		*Only if max^=0, the value of max will be updated;
8524       		if min_val<0 and max^=0 then do;
8525          max=max+max_val-min_val;
8526       			max=ceil(max);
8527       		end;
8528       		else do;
8529       			max=max+max_val;
8530       			max=ceil(max);
8531       		end;
8532        end;
8533       	mtag=0;
8534       end;
8535       
8536       else do;
8537         if min_val<0 then do;
8538            &new_fake_axis_var=&axis_var-min_val+max;
8539       		end;
8540       		else do;
8541       		  *this is wrong;
8542       /*				&new_fake_axis_var=&axis_var+max;*/
8543       	  	&new_fake_axis_var=&axis_var-min_val+max;
8544       		end;																																																	
8545       		if max=0 and mtag=1 then &new_fake_axis_var=&axis_var;
8546       end;
8547       output;
8548       *drop min max min_val max_val;
8549       *Make sure to sort by two vars;
8550       by &axis_grp &axis_var;
8551       run;
8552       
8553       *Generate real y axis labels;
8554       %global &yaxis_macro_labels fake_max_y fake_min_y fake_refline_values;
8555       proc sql noprint;
8556       select max_val,min_val,max-1
8557       into: max_y4grps separated by " ",
8558           : min_y4grps separated by " ",
8559       				: fake_refline_values separated by " "
8560       from &dsdout
8561       where grp_end_tag=1
8562       order by grpnum,&axis_var;
8563       
8564       %put max_y4grps: &max_y4grps;
8565       %put min_y4grps: &min_y4grps;
8566       
8567       *Also get the min_val when grp_end_tag=1;
8568       *Get the macro var fake_max_y value;
8569       data _null_;
8570       set &dsdout end=eof;
8571       if eof then call symputx('fake_max_y',ceil(&new_fake_axis_var));
8572       run;
8573       
8574       %let fake_min_y=%scan(&min_y4grps,1,%str( ));
8575       %let fake_min_y=%sysfunc(floor(&fake_min_y));
8576       
8577       %let nums=;
8578       %do xi=1 %to %sysfunc(countw(&max_y4grps));
8579         *use %str( ) to prevent from lossing of negative nums;
8580       		%let _min_y=%scan(&min_y4grps,&xi,%str( ));
8581       		%put _min_y is &_min_y;
8582       		%if %eval(&xi=1) %then %do;
8583          /* %nums_in_range(st=&_min_y,end=%eval(%scan(&max_y4grps,&xi,%str( ))-1),by=1,outmacrovar=nums&xi,quote=1);*/
8584           %nums_in_range_adj_scale(st=&_min_y,end=%eval(%scan(&max_y4grps,&xi,%str( ))-1),by=1,outmacrovar=nums&xi,
8585                          filter4scaledvals=%str(>0),scale=&fc2scale_pos_vals,quote=1,mod_num2keep=&mod_num2keep);
8586       				%let nums=&&nums&xi;
8587       				*Need to replace the last value as empty;
8588          %let nums=%sysfunc(prxchange(s/\S+$/" "/,-1,&nums));
8589       		%end;
8590       		%else %do;
8591       /*		  %nums_in_range(st=&_min_y,end=%eval(%scan(&max_y4grps,&xi,%str( ))-1),by=1,outmacrovar=nums&xi,quote=1); */
8592       		  %nums_in_range_adj_scale(st=&_min_y,end=%eval(%scan(&max_y4grps,&xi,%str( ))-1),by=1,outmacrovar=nums&xi,
8593                                        filter4scaledvals=%str(>0),scale=&fc2scale_pos_vals,quote=1,mod_num2keep=&mod_num2keep);
8594       				*Need to replace the last value as empty;
8595       				%let new_nums=%sysfunc(prxchange(s/\S+$/" "/,-1,&&nums&xi));
8596       				%put modified new_nums are: &new_nums;
8597       				%let nums=&nums &new_nums;
8598       		%end;
8599       	%end;
8600       	%let &yaxis_macro_labels=&nums;
8601       	%put generated the global macro var &&yaxis_macro_labels for labeling y axis, which are: &&&yaxis_macro_labels;
8602       		%put generated the global macro var fake_min_y, the value of which is &fake_min_y;
8603       	 %put generated the global macro var fake_max_y, the value of which is &fake_max_y;
8604       		%put generated the global macro var fake_refline_values, the value of which can be used to make reflines to separate
8604     ! grps:;
8605       		%put &fake_refline_values;
8606       %mend;
