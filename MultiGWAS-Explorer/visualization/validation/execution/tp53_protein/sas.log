7557       proc sql;
7558       create table _top_hits as
7559       select *
7560                from &dsdin
7561                where not missing(&p_var)
7562                  and &p_var > 0
7563                  and &p_var <= &p_thrsd;
7564       quit;
7565       
7566       %put NOTE: get_top_hits4Manhattan is selecting candidate hits with &p_var <= &p_thrsd.;
7567       
7568       %if %upcase(&selection_method)=LD %then %do;
7569         %get_top_signal_with_ld(
7570           dsdin=_top_hits,
7571           snp_var=&snp_var,
7572           grp_var=&chr_var,
7573           signal_var=&p_var,
7574           select_smallest_signal=1,
7575           pos_var=&pos_var,
7576           signal_thrshd=&p_thrsd,
7577           ld_pops=&ld_pops,
7578           ld_r2_threshold=&ld_r2_threshold,
7579           ld_population_rule=&ld_population_rule,
7580           query_failure_action=&ld_query_failure_action,
7581           fallback_dist_bp=&dist4get_uniq_top_hit,
7582           max_leads=&max_leads,
7583           dsdout=top_ind,
7584           audit_out=&ld_audit_out
7585         );
7586       %end;
7587       %else %do;
7588         %get_top_signal_within_dist(
7589           dsdin=_top_hits,
7590           grp_var=&chr_var,
7591           signal_var=&p_var,
7592           select_smallest_signal=1,
7593           pos_var=&pos_var,
7594           pos_dist_thrshd=&dist4get_uniq_top_hit,
7595           dsdout=top_ind,
7596           signal_thrshd=&p_thrsd
7597         );
7598       %end;
7599       proc sql noprint;
7600       select count(*) into: _top_snp_n trimmed
7601       from top_ind;
7602       quit;
7603       %put NOTE: get_top_hits4Manhattan retained &_top_snp_n lead SNPs after &selection_method selection.;
7604       
7605       proc sql outobs=200 noprint;
7606       select &snp_var into: _top_snps_ separated by ' '
7607       from top_ind
7608       order by &snp_var;
7609       %put Top snps are selected: &_top_snps_;
7610       %if %sysevalf(%superq(_top_snp_n) > 200) %then %do;
7611         %put NOTE: &_top_snp_n top SNPs passed the threshold, and _top_snps_ is truncated to the first 200 names to avoid
7611     ! macro-length overflow.;
7612       %end;
7613       %else %do;
7614         %put They are saved into a global macro variable, _top_snps_;
7615       %end;
7616       
7617       proc sql;
7618          create table &dsdout as
7619          select a.*,b.&snp_var as tag_snp
7620          from &dsdin as a,
7621                   top_ind as b
7622        where a.&chr_var=b.&chr_var and
7623       a.&pos_var between (b.&pos_var-0.5*&dist4get_uniq_top_hit) and
7624                                            (b.&pos_var+0.5*&dist4get_uniq_top_hit);
7625       
7626       
