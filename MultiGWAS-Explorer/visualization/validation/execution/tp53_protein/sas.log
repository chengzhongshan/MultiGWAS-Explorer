2614          %end;
2615       
2616          %if (&text_rotate_angle=0 and &n_marker_labels>=4) %then %let
2616     ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,4.0));
2617          %if (&text_rotate_angle=0 and &n_marker_labels>=5) %then %let
2617     ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,4.6));
2618          %if (&text_rotate_angle>=60 and &n_marker_labels>=5) %then %let
2618     ! effective_yoffset4textlabels=%sysfunc(max(&effective_yoffset4textlabels,2.2));
2619       
2620          *Make the top SNP label offset less sensitive to the absolute y-axis range by
2621          *scaling it with the observed signal span per scatter track. This keeps the
2622          *visual gap more stable when tracks get taller or the max -log10(P) changes.;
2623          %if %sysevalf(&n_marker_labels<=3) %then %do;
2624             %let effective_yoffset4textlabels=%sysevalf(&effective_yoffset4textlabels*&_yoffset_scale_fc);
2625             %if (&text_rotate_angle=0) %then %do;
2626                %if %sysevalf(&effective_yoffset4textlabels<0.18) %then %let effective_yoffset4textlabels=0.18;
2627                %if %sysevalf(&effective_yoffset4textlabels>0.90) %then %let effective_yoffset4textlabels=0.90;
2628             %end;
2629             %else %do;
2630                %if %sysevalf(&effective_yoffset4textlabels<0.80) %then %let effective_yoffset4textlabels=0.80;
2631                %if %sysevalf(&effective_yoffset4textlabels>2.80) %then %let effective_yoffset4textlabels=2.80;
2632             %end;
2633          %end;
2634       
2635          *Convert the needed label headroom into the raw yaxis_offset4max scale used
2636          *later by GTL so the reserved top region stays close to the label height.;
2637          *this is the key part to make the top label headroom more adaptive to the signal span and track height, thus more
2637     ! robust to different y-axis ranges and figure sizes.;
2638          *For running the code with AI, AI should be able to understand the logic of the following code;
2639          *and adjust the parameters and formula as needed to achieve the desired visible fraction of top labels, which is
2639     ! determined by the effective font size of text labels and the track height, as well as other factors such as text rotation
2639     !  angle, number of marker labels, average signal span per track, and figure size. The goal is to make the top label
2639     ! headroom more adaptive and robust to different scenarios.;
2640          %let _desired_visible_top_frac=%sysevalf((&effective_font_size4textlabels+1)/&track_height);
2641          %if (&text_rotate_angle=0) %then %let _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac*1.15);
2642          %else %let _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac*0.95);
2643          %if %sysevalf(&n_marker_labels>1) %then %let
2643     ! _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac+0.0025*(&n_marker_labels-1));
2644          %if %sysevalf(&_avg_signal_span_per_track>5.5) %then %let
2644     ! _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac+0.002);
2645          %if %sysevalf(&_avg_signal_span_per_track<3.0) %then %let
2645     ! _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac-0.0015);
2646          %if %sysevalf(&track_height<500) %then %let _desired_visible_top_frac=%sysevalf(&_desired_visible_top_frac+0.002);
2647          %if %sysevalf(&n_marker_labels=1) %then %do;
2648             %if %sysevalf(&_desired_visible_top_frac<0.02) %then %let _desired_visible_top_frac=0.02;
2649             %if %sysevalf(&_desired_visible_top_frac>0.02) %then %let _desired_visible_top_frac=0.02;
2650          %end;
2651          %else %do;
2652             %if %sysevalf(&_desired_visible_top_frac<0.02) %then %let _desired_visible_top_frac=0.02;
2653             %if %sysevalf(&_desired_visible_top_frac>0.040) %then %let _desired_visible_top_frac=0.040;
2654          %end;
2655       
2656          %let _auto_yaxis_offset4max=&_desired_visible_top_frac;
2657          %if %sysevalf(&_scatter_track_count>5) %then %let
2657     ! _auto_yaxis_offset4max=%sysevalf(&_desired_visible_top_frac*&_scatter_track_count/5);
2658          %if %sysevalf(&_auto_yaxis_offset4max<0.02) %then %let _auto_yaxis_offset4max=0.02;
2659          %if %sysevalf(&_auto_yaxis_offset4max>0.25) %then %let _auto_yaxis_offset4max=0.25;
2660          %if %sysevalf(&n_marker_labels<=2) %then %do;
2661             %if %sysevalf(&_auto_yaxis_offset4max^=&yaxis_offset4max) %then %do;
2662                %put NOTE: Replacing yaxis_offset4max=&yaxis_offset4max with scale-aware top-label offset
2662     ! &_auto_yaxis_offset4max (visible frac=&_desired_visible_top_frac, tracks=&_scatter_track_count,
2662     ! avg_signal_span=&_avg_signal_span_per_track).;
2663                %let yaxis_offset4max=&_auto_yaxis_offset4max;
2664             %end;
2665          %end;
2666          %else %if %sysevalf(&_auto_yaxis_offset4max>&yaxis_offset4max) %then %do;
2667             %put NOTE: Auto-increasing yaxis_offset4max from &yaxis_offset4max to &_auto_yaxis_offset4max with scale-aware
2667     ! top-label headroom (visible frac=&_desired_visible_top_frac).;
2668             %let yaxis_offset4max=&_auto_yaxis_offset4max;
2669          %end;
2670       
2671          /* Fit vertical labels to the longest requested marker. Font size is in
2672             points while track_height is a layout dimension; raster DPI must not
2673             change the fraction of the plot reserved for a label. */
2674          %if (&text_rotate_angle>=60 and &n_marker_labels>=1) %then %do;
2675             %let
2675     ! _vertical_label_frac=%sysevalf(((&_max_marker_label_chars*0.62+1)*&effective_font_size4textlabels*96/72+2*&effective_yoff
2675     ! set4textlabels+8)/(&track_height*0.75));
2676             %if %sysevalf(&_vertical_label_frac<0.04) %then %let _vertical_label_frac=0.04;
2677             %if %sysevalf(&_vertical_label_frac>0.45) %then %let _vertical_label_frac=0.45;
2678             %let yaxis_offset4max=&_vertical_label_frac;
2679             %put NOTE: Vertical SNP-label headroom fitted to &_max_marker_label_chars characters: offsetmax=&yaxis_offset4max.;
2680          %end;
2681       
2682          %put NOTE: Effective top-label settings: rotate=&text_rotate_angle font_size=&effective_font_size4textlabels
2682     ! yoffset=&effective_yoffset4textlabels yaxis_offset4max=&yaxis_offset4max
2682     ! avg_signal_span_per_track=&_avg_signal_span_per_track fc2distant_close_labels=&fc2distant_close_labels
2682     ! pct2adj4dencluster=&pct2adj4dencluster make_even_pos=&make_even_pos.;
2683       
2684       %end;
2685       %put NOTE: LATTICE_STAGE top_label_transform_complete;
2686       
2687       *For debug;
2688       /*data a;*/
2689       /*set _xtag_;*/
2690       /*run;*/
2691       /*%abort 255;*/
2692       
2693       
2694       *Select line pattern for highlighting markers labeled on the the top of scatterplots;
2695       *Solid, ShortDash, MediumDash, LongDash,MediumDashShortDash, DashDashDot;
2696       *DashDotDot, Dash, LongDashShortDash, Dot, ThinDot, ShortDashDot, MediumDashDotDot;
2697       *or numbers from 1 (solid) to 46 which are many combinations of dashes,;
2698       *dots, lengths and numbers of dashes, numbers and sizes of dots.;
2699       %let reflinepattern=Dot;
2700       
2701       *Also add the marker ids into the output figure name;
2702       %let  vars4figurename=;
2703       %if %length(&var4label_scatterplot_dots)>0 %then %do;
2704       proc sql noprint;
2705       select distinct trim(left(&var4label_scatterplot_dots)) into: vars4figurename separated by '_'
2706       from final
2707       where &var4label_scatterplot_dots^="";
2708       
2709       %if %length(&vars4figurename)>100 %then %do;
2710          %put You var4figurename is too long:;
2711          %put &var4figurename;
2712          %put The macro will arbitrarily assign the value of macro var var4label_scatterplot for the macro var;
2713          %let  vars4figurename=&var4label_scatterplot_dots;
2714       %end;
2715       
2716       *When there are three or fewer SNPs for labeling at the top, keep those labels horizontal in the top headroom;
2717       *Also reduce the top cell space represented by the macro var yoffset4max_drawmarkersontop from the default value 0.15 to
2717     ! 0.05;
2718       *Other parameters restrict the upper and lower offset are also resetted;
2719       %if %sysevalf(&n_marker_labels>=1) and %sysevalf(&n_marker_labels<=3) and &auto_rotate2zero=1 %then %do;
2720           %let text_rotate_angle=0;
2721       
2722       /*	%let yoffset4max_drawmarkersontop=0.01;*/
2723       	/*Setting this as 0 does not change the figure, so this parameter is not needed to be reset!*/
2724       	/*Use the simpler horizontal-label scaling for small label sets so <=3 SNPs
2725             stay readable on one line within the reserved headroom. */
2726       	%let effective_yoffset4textlabels=%sysevalf(0.55*1000/&track_height);
2727       	%if &track_height<400 %then %let effective_yoffset4textlabels=0.55;
2728       	%let yaxis_offset4max=%sysevalf(0.04*500/&track_height);
2729       	%let yaxis_offset4min=%sysevalf(0.02*500/&track_height);/*This will reduce the lower offset of y-axis*/
2730           %put NOTE: Small top-label horizontal tuning: n_marker_labels=&n_marker_labels yaxis_offset4max=&yaxis_offset4max
2730     ! yaxis_offset4min=&yaxis_offset4min effective_yoffset4textlabels=&effective_yoffset4textlabels track_height=&track_height.
2730     ! ;
2731       %end;
2732       %if %length(%superq(label_headroom_frac))>0 and %length(%superq(label_center_offset))>0 %then %do;
2733           %let yaxis_offset4max=&label_headroom_frac;
2734           %let effective_yoffset4textlabels=&label_center_offset;
2735           %put NOTE: Planned top-label headroom=&yaxis_offset4max center_offset=&effective_yoffset4textlabels.;
2736       %end;
2737       %end;
2738       
2739        *In terms of gene labels in the gene track, if a gene is too close to the right most position in the figure;
2740       *It is necessary to move the gene label position to left to prevent the gene label is truncated in the figure;
2741       %if (%length(&xaxis_viewmax)>0 and %length(&xaxis_viewmin)>0) %then %do;
2742            %let window_dist=%sysevalf(&xaxis_viewmax - &xaxis_viewmin + 1);
2743       	 %let _maxpos_=&xaxis_viewmax;
2744       %end;
2745       %else %do;
2746            %let window_dist=%sysevalf(&max_x - &min_x + 1);
2747       	 %let _maxpos_=&max_x;
2748       %end;
2749       
2750       *********************************************SAS codes to adjust gene label positions, preventing them too close to each
2750     ! other*********************;
2751       /*proc sql noprint;*/
2752       /*select max(pos1), min(pos1)into: max_pos1, :min_pos1*/
2753       /*from final;*/
2754       %if &track_width>=500 %then %let extra_reduce_pct=0.8;
2755       %else %let extra_reduce_pct=1;
2756       *This means for figure with width < 500, it will increase the 1 fold for the amplification facto;
2757       *but for figure with width > 500 and < 750, it will keep around 0.8 fold for the amplification facto;
2758       *in terms of figure with width >750, it will keep around 0.8*0.5 fold for the amplification factor;
2759       data final ;
2760       set final;
2761       pfactor=IFC(length(grp_label)<3,0,length(grp_label))/4;
2762       if pfactor>5 then pfactor=5;
2763       *Further adjust it by figure track_width by comparing it to the optimized figure with width 450;
2764       pfactor=pfactor*500/&track_width;
2765       *If track_width>600, it is necessary to reduce the factor 2 folder;
2766       if &track_width>750 then pfactor=0.5*pfactor;
2767       if grp_label^="" and (&_maxpos_ - pos1+1)/&window_dist<((1+pfactor)*&move_right_genetxt_pct) then do;
2768             *Also move the gene label by its length;
2769       	   _pos1_=pos1-&extra_reduce_pct*&window_dist*&move_right_genetxt_pct*pfactor;
2770       end;
2771       else do;
2772       	  _pos1_=pos1;
2773       end;
2774       run;
2775       /*%abort 255;*/
2776       
2777       *This only works for making gene bed scatter plots with the yval_var, which is log10P;
2778       %Check_VarnamesInDsd(indsd=final,Rgx=&yval_var.1,exist_tag=Hasvar4y);
2779       %if %length(&Hasvar4y)>0 %then %do;
2780       *Further adjust the gene lable x-axis positions if two gene labels are in the same row and have distance less than
2780     ! designated pct of the whole window;
2781       %put NOTE: LATTICE_STAGE gene_label_adjust_begin;
2782       *Further adjust the gene lable x-axis positions if two gene labels are in the same row and have distance less than
2782     ! designated pct of the whole window;
2783       data final_gene;
2784       set final(keep=grp_label grp1 &yval_var.1 _pos1_ pfactor);
2785       where grp_label^="";
2786       run;
2787       proc sort;by &yval_var.1 _pos1_;run;
2788       
2789       data final_gene;
2790       set final_gene;
2791       lag_pos1=lag(_pos1_);
2792       if first.&yval_var.1 then do;
2793        lag_pos1=.;
2794       end;
2795       else do;
2796          if  (_pos1_ - lag_pos1+1)/&window_dist<(pfactor*&move_right_genetxt_pct)  then
2796     ! lag_pos1_adj=lag_pos1-&extra_reduce_pct*&window_dist*&move_right_genetxt_pct*pfactor;
2797       end;
2798       by &yval_var.1;
2799       run;
2800       *Update only affected gene-label positions in place.  This avoids recreating
2801        the full FINAL table through a self-referential PROC SQL join.;
2802       data final_gene_lookup;
2803         set final_gene(keep=&yval_var.1 lag_pos1 lag_pos1_adj);
2804         where lag_pos1^=. and lag_pos1_adj^=.;
2805         _pos1_=lag_pos1;
2806         *Reuse PFActor, which already exists in FINAL, as the hash return slot.  A
2807          MODIFY step cannot enlarge an existing observation with a new variable.;
2808         pfactor=lag_pos1_adj;
2809         keep &yval_var.1 _pos1_ pfactor;
2810       run;
2811       
2812       data final;
2813         if _n_=1 then do;
2814           declare hash _gene_positions(dataset:"final_gene_lookup", duplicate:"r");
2815           _gene_positions.defineKey("&yval_var.1", "_pos1_");
2816           _gene_positions.defineData("pfactor");
2817           _gene_positions.defineDone();
2818         end;
2819         modify final;
2820         pfactor=.;
2821         if _gene_positions.find()=0 and pfactor^=. then _pos1_=pfactor;
2822         replace;
2823       run;
2824       
2825       proc datasets library=work nolist;
2826         delete final_gene final_gene_lookup;
2827       quit;
2828       %end;
2829       %put NOTE: LATTICE_STAGE gene_label_adjust_complete;
2830       
2831       *Need to obtain the minimum and maximum values to decide whether all of values of heatmap_var are postive or negative;
2832       %let min_heatmap_var=-999;
2833       %let max_heatmap_var=999;
2834       %if &makedotheatmap=1 and %length(&heatmap_var)>0 %then %do;
2835         %put NOTE: LATTICE_STAGE heatmap_normalize_begin;
2836         proc sql noprint;
2837         select min(%unquote(&heatmap_var)) into: min_heatmap_var
2838         from final;
2839         select max(%unquote(&heatmap_var)) into: max_heatmap_var
2840         from final;
2841       
2842         data final;
2843         set final;
2844         *Reset all values <heatmap_min_neg_val or >heatmap_max_pos_val to be heatmap_min_neg_val or heatmap_max_pos_val,
2844     ! specifically;
2845        %if %sysevalf(&heatmap_min_neg_val>&min_heatmap_var) and %sysevalf(&min_heatmap_var<0) %then %do;
2846           %let min_heatmap_var=&heatmap_min_neg_val;
2847       	if &heatmap_var<&heatmap_min_neg_val then &heatmap_var=&heatmap_min_neg_val;
2848        %end;
2849         %if %sysevalf(&heatmap_max_pos_val<&max_heatmap_var) and %sysevalf(&max_heatmap_var>0) %then %do;
2850             %let max_heatmap_var=&heatmap_max_pos_val;
2851       	if &heatmap_var>&heatmap_max_pos_val then &heatmap_var=&heatmap_max_pos_val;
2852        %end;
2853         run;
2854       %end;
2855       %put NOTE: LATTICE_STAGE heatmap_normalize_complete;
