12459      data x1(keep=old_y &Variant_Length_Var &chr_var pos &yval_var &grp_var ord &st_var &end_var &scatter_grp_var
12459    ! &lattice_subgrp_var &var4label_scatterplot_dots &var4mark_ld_scatterplot_dots &ld_heatmap_var);
12460      set x1;
