9254       %macro nums_in_range_adj_scale(
9255       /*Note: the scale can only be integer with value >=1, as the macro will only be able to scale down the numbers in
9255     ! range!*/
9256       st,/*start value that can be negative and position*/
9257       end,/*end value*/
9258       by,/*by value for each step; make sure it is matchable with st and end values*/
9259       outmacrovar,/*created a global macro var containing linked nums by space for later access*/
9260       filter4scaledvals=%str(>0),/*Only apply the scaling to specific numbers met the filter*/
9261       scale=2,/*integer num to scale down the nums, i.e., num/scale, that will be in the final macro var*/
9262       quote=1, /*quote the nums and separated by space in the final macro var*/
9263       mod_num2keep= /*Default is empty for not filtering these elements by mod; when values,
9264       such as 2 or 3 are provided, only keep numbers that fulfil the mod(element,num)=0*/
9265       );
9266       				%global &outmacrovar;
9267       				*This make the format include larger or negative numbers;
9268       				/**Note: sometimes the negative numbers may be out of range of the format;
9269       				%let numlength=%eval(%length(&end)+1);
9270                                       %if %eval(&numlength<3) %then %let numlength=3;
9271                                       */
9272                                       *Use 8 as the default, which is even better, as the above will missing numbers, such as
9272     ! 0.666;
9273                                       %let numlength=8;
9274       				
9275       				data range;
9276       				*Make sure not to use if condition within the do loop in datastep;
9277       				*otherwise, sas will run forever within the do loop!;
9278       				do i=&st to &end by &by;
9279                                         output;
9280                                       end;
9281                                       run;
9282       
9283                                       *Filter data and replace these selected values that can not be modded by scale value;
9284                                       data range;
9285                                       set range;
9286                                       ord=_n_;
9287       				 *scale the value i by scale;
9288                                        if i &filter4scaledvals then do;
9289                                           *Only keep these numbers can be modded by the &scale;
9290                                           *https://documentation.sas.com/doc/en/pgmsascdc/9.4_3.5/ds2ref/n0t9j8b09x4uphn1kl1i70
9290     ! x63z19.htm;
9291                                           *If &scale<1, such as 0.3, 10*i/3=>remain*0.1;
9292                                           if mod(i,&scale)=0 then i=i/&scale;
9293                                           else i=round(i/&scale,0.1);
9294                                        end;
9295       				run;
9296       
9297              %if %length(&mod_num2keep)>0 %then %do;
9298                       data range;
9299                       set range;
9300                       *Note: only focus on i passed the filter of i &filter4scaledvals;
9301                       if i &filter4scaledvals and mod(i,&mod_num2keep)^=0 then i=.;
9302                       run;
9303              %end;
9304       
9305       
9306       				proc sql noprint;
9307       				%if %eval(&quote=1) %then %do;
9308       				  select quote(prxchange("s/^\./ /",-1,trim(left(put(i,&numlength..1)))))
9309                                         into: &outmacrovar separated by " "
9310                                       %end;
9311       				%else %do;
9312       			          select prxchange("s/^\./ /",-1,trim(left(left(put(i,&numlength..1))))) into: &outmacrovar separated by " "
9313       				%end;
9314       				from range
9315       				order by ord;
9316       				drop table range;
9317       				quit;
9318       
9319       /*                              Can not replace these missing values as blank space, as later the global macro var seems
9319     ! be changed as local   */
9320       /*				%let &outmacrovar=%sysfunc(rgxchange(s/\./ /,-1,&&&outmacrovar));                                              */
9321       
9322       				%put generated numbers for the range from &st to &end by &by are: &&&outmacrovar;
9323       %mend;
