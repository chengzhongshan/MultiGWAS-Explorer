6369       select max(_grp_) into: mgrp
6370       from &dsdout;
6371       
6372       *Add back these bad groups and assign _cgrp_=&mgrp+_n_;
6373       data &dsdout._bad;
6374       retain init_num 1;
6375       set &dsdout._bad;
6376       _cgrp_=&mgrp+_n_;
6377       
6378       /*Assume it is better but it is not!;
6379       *Better to group regions with different _cgrp_ together;
6380       *which will aggregate these regions in a single track;
6381       if first._grp_ then do;
6382         _cgrp_=&mgrp+1;
6383         init_num=1;
6384       end;
6385       else do;
6386         init_num=init_num+1;
6387         _cgrp_=init_num+&mgrp;
6388       end;
6389       by _grp_;
6390       */
6391       run;
6392       
6393       
6394       data &dsdout;
6395       set &dsdout &dsdout._bad;
6396       run;
6397       
6398       *Note: use _cgrp_ but not _grp_ to get max;
6399       proc sql noprint;
6400       select max(_cgrp_) into: newmgrp
6401       from &dsdout;
6402       /*%abort 255;*/
6403       %if %superq(newmgrp)= %then %let newmgrp=0;
6404       
6405       data &dsdout;
6406       set &dsdout;
6407       *Important to adjust group number by not allowing the new _cgrp_ close to original _grp_;
6408       /* if &mgrp-_cgrp_+3 <= _grp_ then _cgrp_=&newmgrp-_cgrp_+1; */
6409       /* if &mgrp-_cgrp_+2 <= _grp_ then _cgrp_=&newmgrp-_cgrp_+1; */
6410       *Put half of these _cgrp_ with larger numbers started from 1;
6411       *This part is a bug if all grps are indeed not mergable, which means there are the same number of orginal and newly
6411     ! generated groups;
6412       %if %sysevalf(&newmgrp>=10) %then %do;
6413         %put WARNING: the macro adj_grpnum4close_gene_bed_regs will modify the newly created numeric group since it is the same
6413     !  number of groups as the original group;
6414         if _cgrp_>ceil(0.5*&newmgrp) then _cgrp_=_cgrp_-ceil(0.5*&newmgrp);
6415       %end;
6416       run;
6417       
6418       /*
6419       proc sql noprint;
6420       select max(_cgrp_) into: mgrp
6421       from &dsdout;
6422       *Add back these bad groups and assign _cgrp_=&mgrp+1;
6423       data &dsdout._bad;
6424       set &dsdout._bad;
6425       _cgrp_=&mgrp+1;
