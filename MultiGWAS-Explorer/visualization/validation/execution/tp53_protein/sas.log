11988      
11989      *Keep a copy of original data set &bed_dsd;
11990      data &bed_dsd._org;
11991      set &bed_dsd;
11992      run;
11993      *Adjust start and end positions based on &Variant_Length_Var if it is not empty;
11994      *This is specifically designed to handle CNVs;
11995      %if %length(&Variant_Length_Var)>0 %then %do;
11996      data &bed_dsd;
11997      set &bed_dsd;
11998      if &Variant_Length_Var>1 then do;
11999         &end_var=&st_var+0.5*&Variant_Length_Var;
12000         &st_var=&st_var-0.5*&Variant_Length_Var;
12001      end;
12002      run;
12003      %end;
12004      %else %do;
12005      %let Variant_Length_Var=var_length;
12006      data &bed_dsd;
12007      set &bed_dsd;
12008      Variant_Length_Var=&end_var-&st_var;
12009      run;
12010      %end;
12011      /*%abort 255;*/
