6602       
6603       %macro adjust_close_positions(
6604       /*Limitation: where there are only 2 closely related positions, a fixed distance with Pct4OnlyTwoPos*step will be used to
6604     !  separate them;
6605       Additonally, if there are positions too close to the start or end of position in the figure, it is possible to modify the
6605     !  internal macro
6606       var pct2adj4dencluster from 0.25 to larger value but less than 1 at line 90 in the sas macro!
6607       amplification_fc can be increased to separate closely related positions, too!*/
6608       indsd=,
6609       outdsd=,
6610       pos_var=pos,
6611       new_pos_var=newpos,
6612       dist_pct_to_cluster_pos=0.01,/*Use the pct of range of positions to cluster these positions
6613       Note: positions with distance less then ceil(&dist_pct_to_cluster_pos*(max(&pos_var)-min(&pos_var)+1)) will
6614       be asigned into a single cluster for further adjusting distance using amplification_fc!*/
6615       amplification_fc=1.5, /*Increase the distance fold change among these close records;
6616       Note: all positions within the same cluster will be amplified using the formula:
6616     ! pos+(&pos_var-median(&pos_var))*&amplification_fc by cluster*/
6617       make_even_pos=1, /*If provide value 1, which will ensure all position with the same distance between min and max pos;
6618       This will replace previous setting of dist_pct_to_cluster_pos and amplification_fc;
6619       Note: *Only when the total number of records is gt the number of distant cluster, the macro will generate even positions
6619     ! for all records
6620       */
6621       pct2adj4dencluster=0.05,/*This parameter is mainly designed when make_even_pos=0; it is useful when elements within a
6621     ! cluster is overlapped with each other
6622       or overlapped with elements from other cluster, so it is feasible to avoid this issue by increasing the pct or reducing
6622     ! it.
6623       However, when make_even_pos=1, the macro will multiple the amplification_fc with 10*pct2adj4dencluster to further enlarge
6623     !  the even distance among positions*/
6624       Pct4OnlyTwoPos=0.5,/*In case of only two positions, it is necessary to use arbitrary proportion of dist_step to separate
6624     ! them,
6625       i.e., minus and add Pct4OnlyTwoPos*dist_step and for the first and second positions, respectively*/
6626       fixed_min_pos=,/*Provide fixed minimum and maximum positions for generating even psotions;
6627       Default is empty to use the minimum and maximum positions from input dsd!*/
6628       fixed_max_pos=
6629       );
6630       
6631       proc sql noprint;
6632       select count(unique(&pos_var)) into: tot_rows
6633       from &indsd;
6634       
6635       select min(&pos_var),max(&pos_var),
6636       ceil(&dist_pct_to_cluster_pos*(max(&pos_var)-min(&pos_var)+1)),
6637       min(&pos_var), max(&pos_var),
6638       (max(&pos_var)-min(&pos_var)+1)/(1+&tot_rows)
6639       into: min_pos,:max_pos,
6640       :offset_dist,
6641       :min_pos,:max_pos,
6642       :dist_step
6643       from &indsd;
6644       quit;
6645       
6646       %if %length(&fixed_min_pos)>0 %then %let min_pos=&fixed_min_pos;
6647       %if %length(&fixed_max_pos)>0 %then %let  max_pos=&fixed_max_pos;
6648       %let dist_step=%sysevalf((&max_pos-&min_pos+1)/(1+&tot_rows));
6649       
6650       *Need to update the macro var offset_dist as min_pos and max_pos might be changed;
6651       %let offset_dist=%sysevalf(&dist_pct_to_cluster_pos*(&max_pos-&min_pos+1));
6652       
6653       proc sort data=&indsd out=&outdsd nodupkeys;by &pos_var;run;
6654       /* proc print;run; */
6655       
6656       
6657       data &outdsd(drop=_pre_pos_);
6658       retain _pre_pos_ dist_cluster 0;
6659       set &outdsd;
6660       ord=_n_;
6661       if _n_=1 then do;
6662          dist_cluster=1;
6663          _pre_pos_=&pos_var;
6664          output;
6665       end;
6666       *This means that two positions with distance less than the offset_dist will be assigned with the same cluster number;
6667       if _n_>1 and &pos_var-_pre_pos_<&offset_dist then do;
6668           _pre_pos_=&pos_var;
6669           dist_cluster=dist_cluster;
6670           output;
6671        end;
6672        else if _n_>1 then do;
6673           _pre_pos_=&pos_var;
6674           dist_cluster=dist_cluster+1;
6675           output;
6676        end;
6677       run;
6678       /* proc print;run; */
6679       
6680       
6681       /* %let amplification_fc=1.5; */
6682       *Note that if these positions within a cluster are too close, the adjusted position by only adding or minusing
6682     ! median(pos) would fail to separate positions;
6683       *So by including the ratio between distance between positions within a cluster to the average positions in the cluster to
6683     !  the offset_dist and further reduce it by 10 fold;
6684       *these positions will be separated from each other;
6685       
6686       *Note: that it is necessary to use median pos as a separator to add or substract offset distances among positions within
6686     ! a cluster;
6687       *the function avg fails to separate the most closest positions in each cluster, as these position tend to be not changed
6687     ! in scale in the final output;
6688       
6689       
6690       *Note that the extra amplification factor 0.1*&offset_dist/abs(&pos_var-median(&pos_var)) is not multiplied for _pos_;
6691       *Instead, we multiple it with the new factor: 10*pct2adj4dencluster;
6692       proc sql;
6693       create table &outdsd._with_close_records as
6694       select dist_cluster,&pos_var,ord,
6695       &pos_var+(&pos_var-median(&pos_var))*&amplification_fc*(10*&pct2adj4dencluster) as _pos_
6696       from &outdsd
6697       group by dist_cluster
6698       having count(dist_cluster)>1
6699       order by ord;
6700       /*proc print;run;*/
6701       /*%abort 255;*/
6702       
6703       *Now update the positions in the output data set;
6704       proc sql;
6705       create table &outdsd as
6706       select *
6707       from &outdsd
6708       natural full join
6709       &outdsd._with_close_records
6710       ;
6711       *This will keep duplicate records in the outdsd;
6712       proc sql;
6713       create table &outdsd as
6714       select *
6715       from &indsd
6716       natural full join
6717       &outdsd;
6718       
6719       
6720       proc sort data=&outdsd;by ord;
6721       proc sql noprint;
6722       select max(dist_cluster) into: max_cluster
6723       from &outdsd;
6724       
6725       data &outdsd(rename=(_pos_=&new_pos_var) );
6726       set &outdsd;
6727       if _pos_=. then _pos_=&pos_var;
6728       /*drop=dist_cluster ord;*/
6729       run;
6730       /*proc print;run;*/
6731       
6732       *Only when the total number of records is gt the number of distant cluster, the macro will generate even positions for
6732     ! all records;
6733       %if &make_even_pos=1 and  &max_cluster^=&tot_rows %then %do;
6734       data &outdsd;
6735       set &outdsd;
6736       &new_pos_var=&min_pos+ord*&dist_step;
6737       run;
6738       %end;
6739       
6740       
6741       proc sql;
6742       drop table &outdsd._with_close_records;
6743       quit;
6744       /* proc print;run; */
6745       
6746       *The above will failed to revise the positions of markers if the total number of which is 2;
6747       *The following code will update these positions specifically for the above scenario;
6748       proc sql noprint;
6749       select count(*) into: _tot_rescaled_pos_
6750       from &outdsd;
6751       %if &_tot_rescaled_pos_=2 %then %do;
6752       data &outdsd;
6753       set &outdsd;
6754       if _n_=1 then do;
6755       /*  &new_pos_var=&new_pos_var-0.1*&dist_step;*/
6756         &new_pos_var=&new_pos_var-&Pct4OnlyTwoPos*&dist_step;
6757       end;
6758       else do;
6759       /*  &new_pos_var=&new_pos_var+0.1*&dist_step;*/
6760         &new_pos_var=&new_pos_var+&Pct4OnlyTwoPos*&dist_step;
6761       end;
6762       run;
6763       %end;
6764       /*proc print;run;*/
6765       *Further correct the minimum and maximum value in the outpu data set;
6766       data &outdsd;
6767       set &outdsd;
6768       if &new_pos_var<&min_pos then &new_pos_var=&pos_var-(&max_pos-&min_pos)*0.05;
6769       if &new_pos_var>&max_pos then &new_pos_var=&pos_var+(&max_pos-&min_pos)*0.05;
6770       run;
6771       *Further separate positions that are too close based on the  cutoff 0.1*&dist_step;
6772       data &outdsd(drop=_new_pos_var_);
6773       set &outdsd;
6774         if &new_pos_var-lag(&new_pos_var)<0.5*&dist_step  then do;
6775          if first.dist_cluster then do;
6776            _new_pos_var_=lag(&new_pos_var)+0.5*&dist_step;
6777          end;
6778          else do;
6779       	 _new_pos_var_=lag(&new_pos_var)+0.25*&dist_step;
6780          end;
6781         end;
6782         if _new_pos_var_^=.  then &new_pos_var=_new_pos_var_;
6783         by dist_cluster;
6784       run;
6785       /*proc print;run;*/
6786       /*%abort 255;*/
6787       
6788       %mend;
