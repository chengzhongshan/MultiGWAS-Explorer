3564       /*   Fake_position + _n_ / 1e6 ;*/
3565       /*   logp = -log( ranuni(2)) ;*/
3566       /*   output ;*/
3567       /*end;*/
3568       /*end;*/
3569       /*run;*/
3570       
3571       %if %length(&Other_P_vars)=0 %then %do;
3572           %put NOTE: Other_P_vars is empty, so the macro will draw a single-GWAS Manhattan plot using only &P_var;
3573       %end;
3574       
3575       %if %varexist(ds=&dsdin,var=&chr_var) = 0 %then %do;
3576       					 %put Input chr var &chr_var does not exit!;
3577                  %abort 255;
3578       %end;
3579       
3580       %if %varexist(ds=&dsdin,var=&pos_var) = 0 %then %do;
3581       					 %put Input position var &pos_var does not exit!;
3582                  %abort 255;
3583       %end;
3584       
3585       %if %varexist(ds=&dsdin,var=&P_var) = 0 %then %do;
3586       					 %put Input P value var for the 1st GWAS does not exit!;
3587                  %abort 255;
3588       %end;
3589       
3590       
3591       
3592       *Subset GWAS data for target regions with top association signals passed specific p threshold;
3593       *or just draw the local Manhattan for these target SNPs with specific window size;
3594       %if &draw_local_Manhattan=1 %then %do;
3595              *Draw local Manhattan plot for target SNPs;
3596       			 %if 	(%length(&target_SNPs)>0 and %length(&top_hit_thresd)=0) %then %do;
3597       					%put We will extract association signals around these target snps and draw local Manhattan plot;
3598                  %put Your target SNPs are &target_SNPs;
3599                 *Get target SNPs;
3600                 %get_tgt_hits4Manhattan(
3601                  dsdin=&dsdin,
3602                  snp_var=&snp_var,
3603                  chr_var=&chr_var,
3604                  pos_var=&pos_var,
3605                  p_var=&P_var,
3606                  dsdout=_tgthits_,
3607                  target_snps=&target_snps,
3608                  keep_target_snps_order=&Keep_order_of_target_SNPs,
3609                  dist4get_uniq_top_hit=&dist4get_smallest_top_hit
3610                  );
3611                 *Note: the above macro will generate new variable tag_snp and a global macro variable _chr_colors_;
3612                 *which will be used to draw Manhattan plots by chr, and it is necessary to reset these macro var values for
3612     ! making local Manhattan plot;
