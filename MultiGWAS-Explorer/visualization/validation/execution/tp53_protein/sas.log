1783       *Note: if these added macro vars are empty, it will not affect the data step;
1784       data x1(keep=old_y &Variant_Length_Var &chr_var pos &yval_var &grp_var ord &st_var &end_var &scatter_grp_var
1784     ! &lattice_subgrp_var &var4label_scatterplot_dots &var4mark_ld_scatterplot_dots &ld_heatmap_var);
1785       set x1;
1786       array X{2} &st_var &end_var;
1787       do i=1 to 2;
1788          pos=X{i};
1789          *Exclude these CNVs with length >1 in the scatter plot;
1790          *CNVs will be drawn by highlow plot;
1791          *if &Variant_Length_Var>1 then pos=.;
1792       
1793          *Failed, as if excluding them, these CNVs can not be labeled on the top of the figure;
