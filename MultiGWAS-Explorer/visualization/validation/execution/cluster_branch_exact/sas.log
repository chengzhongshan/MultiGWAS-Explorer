544        /*        linestyle = 1 */
545        /*        contrastcolor = GraphColors('gaxis') */
546        /*        ; */
547        /*   end; */
548        /* run; */
549        /*  */
550        /* data _null_; */
551        /* rc=dlgcdir('<SAS_HOME>/data'); */
552        /* run; */
553        /* ods html file="sample.html" gpath="." style=styles.greyline; */
554        
555        *Note: the variable row and col will be used to draw Y-axis and X-axis labels!;
556        *This is a little confusing, but need to pay attention to it!;
557        *Decide whether to draw x-axis labels;
558        %if &nrows< &max_rows4labeling %then %do;
559          %let colaxis_label_setting=tickvalues;
560        %end;
561        %else %do;
562          %let colaxis_label_setting=line;
563        %end;
564        
565         *Decide whether to draw y-axis labels;
566        %if &ncols< &max_cols4labeling %then %do;
567          %let rowaxis_label_setting=tickvalues;
568        %end;
569        %else %do;
570          %let rowaxis_label_setting=line;
571        %end;
572        
573        /*Note: make sure to let rowdata and columndata with union range*/
574        %let rnd=%RandBetween(1,1000);
575        ods graphics /reset=all noborder outputfmt=&outputfmt imagename="Clustergram_random&rnd";
576        *The above failed sometimes due to unknown reasons;
577        *It is necessary to remove previous setting;
578        proc template;
579           define statgraph HeatDendrogram;
580        /*      begingraph / designheight=&height.cm designwidth=&width.cm;*/
581            begingraph / designheight=&height  designwidth=&width;
582                %if %length(&rangemap_setting)>0 %then %do;
583                      &rangemap_setting;
584                 %end;
585        		 *Note: borderattr=(color=white) will remove the frame lines for the whole figure;
586                 layout lattice    / rowdatarange=union columndatarange=union
587                                     rows=2 columns=2 	borderattrs=(color=white)
588                                     columnweights=(&columnweights) rowweights=(&rowweights);
589                    layout overlay; entry ' '; endlayout;
590                    layout overlay / xaxisopts=(display=none) yaxisopts=(display=none)
591                                     walldisplay=none;
592        														%if &cluster_type=1 or &cluster_type=3 %then %do;
593                       dendrogram nodeID=y_name_ parentID=y_parent_ clusterheight=y_height_;
594        														%end;
595        														%else %do;
596        															entry ' ';
597        														%end;
598                    endlayout;
599                    layout overlay / xaxisopts=(display=none reverse=true)
600                                     yaxisopts=(display=none reverse=true) walldisplay=none;
601        														%if &cluster_type=2 or &cluster_type=3 %then %do;
602                       dendrogram nodeID=x_name_ parentID=x_parent_ clusterheight=x_height_ /
603                                     orient=horizontal ;
604        														%end;
605        														%else %do;
606        															entry ' ';
607        														%end;
608                    endlayout;
609                    *To remove outline, add "walldisplay=none";
610                    layout overlay / walldisplay=none
611                                     yaxisopts=(display=none reverse=true
612                                                     displaysecondary=(&colaxis_label_setting)
612      ! TICKVALUEATTRS=(&colaxis_font_setting)
613                                                       )
614                                     xaxisopts=(
615                                                   display=(&rowaxis_label_setting) TICKVALUEATTRS=(&rowaxis_font_setting)
616        										%if %length(&rowaxis_rotation)>0 %then %do;
617                                                   discreteopts=(tickvaluefitpolicy=rotate TICKVALUEROTATION=&rowaxis_rotation)
618        						               %end;
619                                                   );
620                       heatmapparm y=col x=row
621                                       %if %length(&rangemap_setting)>0 %then %do;
622                                        colorresponse=RangeVar/
623                                        %end;
624                                        %else %do;
625                                        colorresponse=dist/colormodel=(&colormodel)
626                                         %end;
627                                        name="ht"
628                                        %if &show_heatmap_grid=1 %then %do;
629                                        outlineattrs=(color=gray  thickness=1) display=all
630                                        %end;
631                               ;
632                       *The above codes of outlineattrs=(color=gray  thickness=1) display=all customize grid colors and thickness
632      ! ;
633        
634                       *Customize the colorbar ticks;
635                       *Although the suggested tick counts is 50, sas will automatically decide how many integers will be used
635      ! for ticks;
636                       *default value: location=outside valign=bottom halign=center valuecounthint=50;
637                       continuouslegend "ht" / &continuouslegend_setting;
638                    endlayout;
639                 endlayout;
640             endgraph;
641           end;
642        run;
643        
644        *To achieve even spacing (monospaced font) in SAS, it is necessary to use a monospaced font by setting it with goptions
644      ! ftext;
645        *allocate the same amount of horizontal space for each character, regardless of its width. Examples include Courier,
645      ! Menlo, and Consolas.;
646        goptions ftext=Courier;
647        
648        *Need to exclude missing values;
649        proc sgrender data=&heatmap_dsd template=HeatDendrogram;
650        run;
651        
652        *The above colormodel can be updated by using %colormac;
653        *https://documentation.sas.com/doc/en/pgmsascdc/9.4_3.5/graphref/p0d4brn7o50u8ln1xxolln8t7tvc.htm;
654        *such as %RBG(100,100,0) for the yellow color;
655        
656        
657        /* ods html close; */
