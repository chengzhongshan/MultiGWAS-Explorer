79         %macro Rename_Add_Prefix(oldvarlist, prefix);
80           %let k=1;
81           %let old = %scan(&oldvarlist, &k);
82              %do %while("&old" NE "");
83               rename &old = &prefix.&old;
84         	  %let k = %eval(&k + 1);
85               %let old = %scan(&oldvarlist, &k);
86           %end;
