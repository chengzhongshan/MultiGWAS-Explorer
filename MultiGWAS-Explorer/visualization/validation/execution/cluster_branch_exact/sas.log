663        %macro review_tree_branches(
664        inputdsd=a,
665        y_name_var=child,
666        y_parent_var=parent,
667        y_height_var=hh,
668        outdsd=out,/*A output dataset would be further used to draw new tree with sgrender template HeatDendrogram1*/
669        branch_name_dsd=branch_name_dsd /*Ordered branche names for the end leaves in the final cluster from left to right*/
670        );
671        
672        data _tmpdsd_;
673        set &inputdsd;
674        b=&y_name_var;
675        all_parents=&y_parent_var;
676        if prxmatch("/^CL/",&y_parent_var);
677        run;
678        /*proc print;run;*/
679        
680        *Good hash SAS paper:;
681        *https://support.sas.com/resources/papers/proceedings16/10200-2016.pdf;
682        *The step tries to match up cluster CLnum with end leave names and save them into a long format dataset.;
683        data ab_res (keep=all_parents &y_parent_var &y_name_var &y_height_var);
684        length &y_name_var $200 &y_parent_var $200 v $200 b $200 ;
685        if _n_=1 then do;
686            /* build multidata hash on dataset A: key = c1, data = x */
687            declare hash h(dataset:"&inputdsd", multidata:'YES');
688            h.defineKey("&y_parent_var"); h.defineData("&y_name_var"); h.defineDone();
689            call missing(&y_parent_var,&y_name_var);
690        end;
691        
692        set _tmpdsd_; /* keep original b value in b */
693        
694        &y_parent_var = b;
695        
696        /* If there is no match for this key, just output the record (unmatched) */
697        rc = h.find();
698        if rc ne 0 then do;
699            /* no child entries in A for this key */
700            output;
701        end;
702        else do;
703            /* We'll collect CL keys to traverse in a queue, and produce outputs for non-CL leaves */
704            array queue[2000] $200 _temporary_;    /* queued CL keys to process */
705            array visited[2000] $200 _temporary_;  /* visited CL keys to avoid loops */
706            qcount = 0;
707            vcount = 0;
708            /* process all matches for the initial key (&y_parent_var = b) */
709            do while (rc = 0);
710                v = &y_name_var;
711                if prxmatch('/^CL/', v) then do;
712                    /* enqueue CL key if not already queued */
713                    dup = 0;
714                    do j = 1 to vcount;
715                        if queue[j] = v then do; dup = 1; leave; end;
716                    end;
717                    if dup = 0 then do; vcount + 1; queue[vcount] = v; end;
718                end;
719                else do;
720                    /* non-CL leaf: output */
721                    output;
722                end;
723                rc = h.find_next();
724            end;
725        
726            /* process queued CL keys iteratively (BFS/DFS style) */
727            i = 1;
728            do while (i <= vcount);
729                key = queue[i];
730        
731                /* skip if we've already fully processed this key (avoid cycles) */
732                already = 0;
733                do j = 1 to qcount;
734                    if visited[j] = key then do; already = 1; leave; end;
735                end;
736        
737                if already = 0 then do;
738                    qcount + 1; visited[qcount] = key;
739        
740                    /* set &y_parent_var to the queued CL key and find its matches */
741                    &y_parent_var = key;
742                    rc = h.find();
743                    if rc = 0 then do;
744                        do while (rc = 0);
745                            v = &y_name_var;
746                            if prxmatch('/^CL/', v) then do;
747                                /* enqueue deeper CL key if not already queued */
748                                dup = 0;
749                                do j = 1 to vcount;
750                                    if queue[j] = v then do; dup = 1; leave; end;
751                                end;
752                                if dup = 0 then do; vcount + 1; queue[vcount] = v; end;
753                            end;
754                            else do;
755                                /* non-CL leaf: output */
756                                output;
757                            end;
758                            rc = h.find_next();
759                        end;
760                    end;
761                end;
762        
763                i + 1;
764            end;
765        end;
766        run;
767        /*%abort 255;*/
768        
769        *Get the tree leave labels in order ranging from left to right in the final cluster and use them to get location of each
769      ! cluster CL for labeling them later;
770        *%treeorder(data=&inputdsd, child=&y_name_var, parent=&y_parent_var, hh=&y_height_var, root=CL1, order=ASC,
770      ! outds=&branch_name_dsd);
771        *Use a better macro to get branch names as well as relative positions for all parent branches;
772         %tree_CL_positions(data=&inputdsd, child=&y_name_var, parent=&y_parent_var, hh=&y_height_var, root=CL1, order=ASC,
772      ! outds=&branch_name_dsd);
773         *Need to remove parents or children not included in the &branch_name_dsd;
774         proc sql;
775         create table ab_res as
776         select a.*
777         from ab_res as a
778         where a.&y_name_var in (select name from &branch_name_dsd) or
779                    a.&y_parent_var in (select name from &branch_name_dsd);
780         proc sql;
781         create table &inputdsd.tmp as
782         select a.*
783         from &inputdsd as a
784         where a.&y_name_var in (select name from &branch_name_dsd) or
785                    a.&y_parent_var in (select name from &branch_name_dsd);
786        /*%abort 255;*/
787        data &branch_name_dsd;
788        /*(keep=&y_name_var left2right_ord);*/
789        set &branch_name_dsd;
790        rename order=left2right_ord name=&y_name_var;
791        run;
792        
793        /*%abort 255;*/
794        *Add the label order back into the table ab_res;
795        proc sql;
796        create table ab_res as
797        select a.*,b.left2right_ord
798        from ab_res as a
799        left join
800        &branch_name_dsd as b
801        on a.&y_name_var=b.&y_name_var
802        order by all_parents,left2right_ord;
803        *Also add the relative order for these parent branches;
804        proc sql;
805        create table ab_res as
806        select a.*,b.left2right_ord as parent_ord
807        from ab_res as a
808        left join
809        &branch_name_dsd as b
810        on a.all_parents=b.&y_name_var
811        order by all_parents,left2right_ord;
812        
813        data ab_res;
814        set ab_res;
815        end_child_label=&y_name_var;
816        if 	&y_height_var^=0 then  end_child_label="";
817        run;
818        proc sql noprint;
819        select count(*) into: tot_leaves
820        from &branch_name_dsd
821        where not prxmatch("/^CL\d+/",&y_name_var);
822        
823        *The trick part is to estimate the right x-axis % for each CLnum;
824        *it is necessary to increase the % of 5/(&tot_leaves-1)*(floor((count(left2right_ord)-1)/2)-1) by half of branches for
824      ! each CLnum;
825        proc sql;
826        create table ab_res1 as
827        select a.*,ceil(mean(left2right_ord)) as tgt_note,
828                 (99/(&tot_leaves-1)) * (
829                   (max(left2right_ord) - min(left2right_ord))/2+
830        		   min(left2right_ord)-1 + 5/(&tot_leaves-1)*(floor((max(left2right_ord)-1)/2)-1)
831        		   )  as right_xpos,
832                         case
833                         when left2right_ord=calculated tgt_note then  &y_name_var
834        				 else ""
835        				 end as all_parents_label
836        from ab_res as a
837        group by all_parents
838        order by all_parents,left2right_ord;
839        *Use better positions for these parent branches;
840        data ab_res1;
841        set ab_res1;
842        if end_child_label="" then do;
843        right_xpos=(100/(&tot_leaves-1))*(parent_ord-1);
844        end;
845        run;
846        /*%abort 255;*/
847        *Now only keep essential vars for labeling tree branches;
848        *Need to update the right height again, as previously matched height is not from y_name_var;
849        proc sql;
850        create table _right_height_dsd_ as
851        select a.&y_name_var as new_child, a.all_parents,a.right_xpos,b.&y_height_var as right_height, a.&y_height_var
852        from ab_res1 as a
853        left join
854        (select distinct &y_name_var, &y_height_var
855        from _tmpdsd_
856        ) as b
857        on a.all_parents=b.&y_name_var;
858        
859        proc sql noprint;
860        select &y_height_var into: topheight
861        from &inputdsd.tmp
862        where &y_name_var="CL1";
863        
864        data _right_height_dsd_ (drop=right_height rename=(&y_height_var=new_height));
865        set _right_height_dsd_ ;
866        if &y_height_var^=0 then &y_height_var=right_height;
867        *Manually put the CL1 in the middle of the top of the final dendrogram;
868        *if all_parents="CL1" then &y_height_var=&topheight;
869        run;
870        
871        data _right_height_dsd_ ;
872        set _right_height_dsd_ ;
873        if new_height>0 or all_parents="CL1";
874        run;
875        *Only keep unique parent CL and height;
876        proc sort data=_right_height_dsd_ nodupkeys;
877        by all_parents;
878        run;
879        /*%abort 255;*/
880        proc sql;
881        create table &outdsd as
882        select a.*,b.new_child,b.new_height,b.all_parents,b.right_xpos
883        from &inputdsd.tmp as a
884        left join
885        _right_height_dsd_ as b
886        on a.&y_name_var=b.all_parents;
887        /*%abort 255;*/
888        data &outdsd;
889        set &outdsd;
890        if new_child="" and not prxmatch("/^CL/",&y_name_var) then do;
891         new_child=&y_name_var;
892         all_parents=&y_parent_var;
893         new_height=0;
894        end;
895        _all_parents=all_parents;
896        if right_xpos^=. then do;
897           *enable to only draw end note branche names with textplot;
898           all_parents="";
899        end;
900        else do;
901           *These higher tree branches will be annotated using drawtext based on right_xpos;
902           _all_parents="";
903        end;
904        run;
905        /*%abort 255;*/
906        *Prepare macro vars for drawtext;
907        proc sql noprint;
908        select left(put(count(*),best12.)) into: tot_higher_branches
909        from &outdsd
910        where _all_parents^="";
911        select _all_parents  into:hblabel1-:hblabel&tot_higher_branches
912        from &outdsd
913        where _all_parents^="";
914        select right_xpos into: rx1-:rx&tot_higher_branches
915        from &outdsd
916        where _all_parents^="";
917        select new_height into: rh1-:rh&tot_higher_branches
918        from &outdsd
919        where _all_parents^="";
920        
921        /*proc print data=ab_res; run;*/
922        proc template;
923           define statgraph HeatDendrogram1;
924            begingraph;
925                    layout overlay / walldisplay=none;
926                       dendrogram nodeID=&y_name_var parentID=&y_parent_var clusterheight=&y_height_var;
927        /*This does not work well, and try to use drawtext statement;*/
928                       textplot x=new_child y=eval(new_height*1.02) text=all_parents/;
929        			   %do _di_=1 %to &tot_higher_branches;
930        			       /*%if &_di_=1 %then %let rx&_di_=43;*/
931        				   /*As CL1 will be always in the middle, substracting 5 pct offset on left and righ of the figure*/
932        				   drawtext "&&hblabel&_di_" / XSPACE=DATAPERCENT YSPACE=DATAVALUE
933                                          x=&&rx&_di_ y=&&rh&_di_;
934        			   %end;
935        			 endlayout;
936        	endgraph;
937        end;
938        run;
939        
940        /*proc print;run;*/
941        proc sgrender data=&outdsd template=HeatDendrogram1;
942        run;
943        
944        proc datasets nolist;
945        /*delete Ab_res Ab_res1 _tmpdsd_ _right_height_dsd_;*/
946        run;
947        
948        %mend;
949        
950        %macro subbranches(
951            data=,           /* input dataset, which should
952        	contain the following 3 input vars:*/
953        	y_name_var=y_name_,
954        	y_parent_var=y_parent_,
955        	y_height_var=y_height_,
956            out=work.sub,    /* output dataset */
957            height=,         /* numeric cutoff (use either height= or parent=), and only the
958        	the branche with the most closest height to the cutoff along with its sub-braches
959        	will be captured by the macro! So it is important to select the right cutoff
960        	for your target braches; it is possible to get the branche corresponding to
961        	the height cutoff by printing out the final output data to check the
962        	correponding branche matched with the hight cutoff;*/
963            parent=,         /* list of parent ids (space or comma separated), e.g. CL2 CL3 */
964            render=NO       /* YES/NO to call PROC SGRENDER with template */
965            );
966        
967            /* validate dataset exists */
968            %if %sysevalf(%superq(data)=,boolean) %then %do;
969                %put ERROR: data= is required.;
970                %return;
971            %end;
972            %if %sysfunc(exist(&data)) = 0 %then %do;
973                %put ERROR: Dataset &data does not exist.;
974                %return;
975            %end;
976        
977        	data _x_;
978        	length y_name_ y_parent_ $1000.;
979        	set &data;
980        	&y_name_var=&y_name_var;
981        	&y_parent_var=&y_parent_var;
982        	&y_height_var=&y_height_var;
983        	where &y_name_var^="";
984        	keep &y_name_var &y_parent_var &y_height_var;
985        	run;
986        
987            /* prepare initial seed set "keep0" (use robust existence checks) */
988            %if %length(%superq(height)) %then %do;
989               %let height_cutoff=&height;
990            %end;
991            %else %if %length(%superq(parent)) %then %do;
992               proc sql noprint;
993        	   select &y_height_var into: height_cutoff
994        	   from _x_
995        	   where &y_name_var="&parent";
996        	   *This method is prune to error when there are other clusters that have equal height to the target cluster;
997        	   *Make sure the filter is set as height < but not <= height_cutoff around line 59 in this script;
998        	   *However, these codes are necessary to get the right height for the target parent;
999        
1000       	   *Better method for get the right parents and leaves under the target parent  is implemented as follows:;
1001       	   %treeorder(
1002       data=_x_, 	/*A typical output generated by proc cluster*/
1003       child=&y_name_var,  /*Equivalent to y_name_ or x_name_ from proc cluster; ensure there is not spaces
1004       included in the elements of this variable!*/
1005       parent=&y_parent_var, /*Equivalent to y_parent_ or x_parent_ from proc cluster*/
1006       hh=&y_height_var, /*Equivalent to y_height_ or x_height_ from proc cluster*/
1007       root=&parent, /*the toppest root cluster name, and all braches under it will be searched for leaves*/
1008       order=ASC, /*Any non-string would be OK, as if provided with the string NAME, the input data
1009       will be sorted by parent and child names, however, SAS generted tree data set is used by
1010       proc tree or the statement of dendrogram in proc template to draw tree by sorting
1011       with the modified parent by using numers to represnet them,
1012       child and height, so please just use default string ASC for SAS generated input data*/
1013       outds=_leaf_order_, /*An output data set containing ordered leaf names from left to right in the dendrogram
1014       if running with SAS to generate tree using the input data*/
1015       parent_ds=_parent_list_ /*An output data set contain all parents and its childrens*/
1016            );
1017       /*	 %abort 255;*/
1018       	   proc sql noprint;
1019       	   create table _x_ as
1020       	   select a.*
1021       	   from _x_ as a,
1022       	           _parent_list_ as b
1023       	   where a.&y_parent_var=b.name;
1024       /*	   select max(&y_height_var) into: height_cutoff*/
1025       /*	   from _x_*/
1026       /*	   where &y_parent_var="&parent"*/
1027       /*       group by &y_parent_var; */
1028       *The above codes does not get the right height for the parent;
1029       	   data _x_;
1030       	   set _x_ end=eof;
1031       	   if eof then do;
1032       	        output;
1033       	       *Manually add a record for the target parent for the child column: &y_name_var;
1034       	       &y_name_var="&parent";&y_height_var=&height_cutoff; &y_parent_var="";
1035       		   output;
1036       	   end;
1037       	   else do;
1038       	      output;
1039       	   end;
1040       	   run;
1041       	   *Note the addition of 0.0001 to the max height will enable the use of < but not <= later to filter these parents;
1042       	   *It is not necessary but just for uniforming the codes with that for filtering the dataset soly by height when the;
1043       	   *macro parent is empty but the macro height is provided with a numeric value;
1044           %end;
1045           %else %do;
1046               %put ERROR: Either height= or parent= must be provided.;
1047               %return;
1048           %end;
1049       
1050       proc sql noprint;
1051       create table _x_1 as
1052       select a.*
1053       from _x_ as a
1054       where a.&y_height_var<=&height_cutoff;
1055       /*%abort 255;*/
1056       proc sql noprint;
1057       select max(&y_height_var)  into: max_height
1058       from _x_1;
1059       select &y_name_var into: parent
1060       from _x_1
1061       having &y_height_var=max(&y_height_var);
1062       create table _x_2 as
1063       select a.*
1064       from _x_1 as a
1065       where a.&y_parent_var in (
1066         select &y_name_var
1067         from _x_1
1068       );
1069       create table _x_tag as
1070       select &y_parent_var,input(prxchange("s/CL//",-1,&y_parent_var),best12.) as ord
1071       from _x_2
1072       order by ord;
1073       
1074       data _x_tag;
1075       retain n 0;
1076       set _x_tag;
1077       if first.ord then n=n+1;
1078       new_&y_parent_var=cat('CL',n);
1079       by ord;
1080       run;
1081       
1082       proc sql;
1083       create table _x_3 as
1084       select a.*,b.new_&y_parent_var as new_&y_parent_var.1
1085       from _x_2 as a
1086       left join
1087       _x_tag as b
1088       on a.&y_parent_var=b.&y_parent_var;
1089       create table _x_3 as
1090       select distinct a.*,b.new_&y_parent_var as new_&y_name_var.1
1091       from _x_3 as a
1092       left join
1093       _x_tag as b
1094       on a.&y_name_var=b.&y_parent_var;
1095       data _x_3;
1096       set _x_3;
1097       *Keep these original name for later looking up;
1098       old_&y_name_var=&y_name_var;
1099       old_&y_parent_var=&y_parent_var;
1100       run;
1101       data _x_3;
1102       set _x_3;
1103       if new_&y_name_var.1^="" then &y_name_var=new_&y_name_var.1;
1104       &y_parent_var=new_&y_parent_var.1;
1105       run;
1106       data _x_3_;
1107       &y_parent_var="";
1108       &y_name_var="CL1";
1109       &y_height_var=&max_height;
1110       run;
1111       data _x_3;
1112       set _x_3 _x_3_;
1113       drop new_y_:;
1114       run;
1115       
1116       proc sql;
1117       create table &out as
1118       select a.*
1119       from _x_3 as a
1120       where a.&y_parent_var in (
1121         select &y_name_var
1122         from _x_3
1123       ) or a.&y_parent_var="";
1124       data &out;
1125       set &out;
1126       if &y_name_var="CL1" and &y_parent_var="" then old_&y_name_var="&parent";
1127       /* optional render */
1128       %if %upcase(&render) = YES %then %do;
1129       proc template;
1130          define statgraph HeatDendrogram1;
1131       /*      begingraph / designheight=&height.cm designwidth=&width.cm;*/
1132           begingraph;
1133                   layout overlay /
1134       /*xaxisopts=(display=none) yaxisopts=(display=none)*/
1135                                    walldisplay=none;
1136                      dendrogram nodeID=&y_name_var parentID=&y_parent_var clusterheight=&y_height_var;
1137       			 endlayout;
1138       	endgraph;
1139       end;
1140       run;	
1141       *To recapture the original cluster, need to sort the data by numeric parent, child, and height;
1142       *the order of which is used by proc template to draw dendrogram;
1143       data &out;set &out;ord=prxchange("s/^CL//",-1,&y_parent_var)+0;
1144       proc sort data=&out;by descending ord &y_name_var &y_height_var;
1145       data &out;set &out;drop ord;run;
1146       proc sgrender data=&out template=HeatDendrogram1;
1147       run;
1148       %end;
1149       
1150       %mend subbranches;
