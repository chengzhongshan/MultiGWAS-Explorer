1208       %macro tree_CL_positions(
1209       data=, 	/*A typical output generated by proc cluster*/
1210       child=child,  /*Equivalent to y_name_ or x_name_ from proc cluster; ensure there is not spaces
1211       included in the elements of this variable!*/
1212       parent=parent, /*Equivalent to y_parent_ or x_parent_ from proc cluster*/
1213       hh=hh, /*Equivalent to y_height_ or x_height_ from proc cluster*/
1214       root=CL1, /*the toppest root cluster name CL1, and all braches under it will be searched for leaves;
1215       the macro only works when the root is CL1! Do not use other branch names, such as CL2, or others,
1216       as the macro will fail to obtain the right results!*/
1217       order=ASC, /*Any non-string would be OK, as if provided with the string NAME, the input data
1218       will be sorted by parent and child names, however, SAS generted tree data set is used by
1219       proc tree or the statement of dendrogram in proc template to draw tree by sorting
1220       with the modified parent by using numers to represnet them,
1221       child and height, so please just use default string ASC for SAS generated input data*/
1222       outds=CL_Positions, /*An output data set containing ordered leaf names from left to right in the dendrogram
1223       if running with SAS to generate tree using the input data, as well as these positions for the parent notes
1224       using the same order system*/
1225       );
1226       data _tmpdsd_;
1227       set &data;
1228       run;
1229        %treeorder(data=_tmpdsd_, child=&child, parent=&parent, hh=&hh, root=&root, order=&order, outds=&outds);
1230       *Now match up these leave names with it is input data set _tmpdsd_;
1231        proc sql;
1232        create table _tmpdsd_ as
1233        select *
1234        from _tmpdsd_
1235        natural left join
1236        &outds(rename=(name=&child))
1237        ;
1238       data _tmpdsd_(drop=order);
1239       set _tmpdsd_;
1240       if order^=. then &child=trim(left(put(order,best12.)));
1241       run;
1242       
1243       *Try to get cluster CL positions;
1244         %local tmp parents rc;
1245         data _tree_src;
1246         set _tmpdsd_;
1247         *Use numeric parent to order it;
1248         _parent_=prxchange("s/^CL//",-1,&parent)+0;
1249         run;
1250         /* 1) ensure sorted children by chosen order (HH or NAME) */
1251         %if %upcase(&order)=NAME %then %do;
1252            proc sort data=_tree_src ; by _parent_ &child; run;
1253         %end;
1254         %else %do;
1255            /* order by height (hh) then child name */
1256            proc sort data=_tree_src; by _parent_ &child &hh; run;
1257         %end;
1258       
1259         /* 2) create a parent -> space-separated children list */
1260         data _parent_list(keep=&parent children _parent_);
1261            length children $ 3000;
1262            retain children;
1263            set _tree_src;
1264            by _parent_;
1265            if first._parent_ then children = strip(&child);
1266            else children = catx(' ', children, strip(&child));
1267       
1268       	 if not prxmatch("/CL/",children) then do;
1269       		  *Get sum of these numeric children and change them back into char;
1270       	      xi=1;
1271       		  yi=0;
1272       	      do while (scan(children,xi,' ') ne '');
1273       			 yi=yi+scan(children,xi,' ');
1274       			 xi+1;
1275       		  end;
1276       		  yi=yi/(xi-1);/*Get the avg pos for all end leaves belonging to the same parent CLnum*/
1277       		  children=trim(left(put(yi,best12.)));
1278       	 end;
1279       
1280            if last._parent_ then output;
1281         run;
1282         *Remove these parents do not have any children;
1283         data _parent_list;
1284         set _parent_list;
1285         where children^=".";
1286         run;
1287         proc sql noprint;
1288         select &parent into: removed_parents separated by ' '
1289         from _parent_list
1290         where children=".";
1291         %if %length(&removed_parents)>0 %then %do;
1292         %put These parents do not have any children, which will be removed from the final data set;
1293         %put &removed_parents;
1294         %end;
1295       
1296         *Recursively calcuate the CL positions;
1297         %let change=1;
1298         %let tot_runs=1;
1299         %do %while (&change);
1300       	   proc sql;
1301       	   create table _parents as
1302       	   select children,&parent
1303       	   from _parent_list
1304       	   where children contains "CL" and &parent contains "CL";
1305       
1306       	   create table _children as
1307       	   select children as &child,&parent
1308       	   from _parent_list
1309       	   where (children not contains "CL" and &parent contains "CL" and children^=".");
1310       	   *Note: it is necessary to remove children with missing value ".";
1311       	   *These records are actually no-useful notes or leaves that are probably generated by subbranch macro;
1312       
1313       	   data _parents;
1314       	   length _child $100.;
1315       	   set _parents;
1316       	   ci=1;
1317       	   do while (scan(trim(left(children)),ci,' ') ^='');
1318       		  _child=scan(trim(left(children)),ci,' ');
1319       		  output;
1320       		  ci+1;
1321       	   end;
1322       	   drop ci;
1323       	   run;
1324       
1325       	   proc sql;
1326       	   create table _parent_tmp  as
1327       	   select a.*,input(b.&child,best12.) as &child
1328       	   from _parents as a
1329       	   left join
1330       	   _children as b
1331       	   on a._child=b.&parent;
1332       
1333       	   *Rescue the data set when the parent contains "\d+ CL\d+";
1334       	   *Otherwise, there will be no obs remain in the _resolved_children dataset;
1335       	   data _parent_tmp;
1336       	   set _parent_tmp;
1337       	   if &child=. and not prxmatch("/^CL\d+/",_child) then do;
1338       			 &child=_child+0;
1339       	   end;
1340       	   run;
1341       
1342       	   proc sql;
1343       	   create table _resolved_children as
1344       	   select distinct &parent,trim(left(put(mean(&child),best12.))) as &child,children
1345       	   from (
1346                    select * from _parent_tmp
1347                    where &child^=.
1348                   )
1349       	   group by &parent
1350       	   having count(&parent)=2 or (_child=children);
1351       	   *When _child and child is the same single branch and no other paired children for any group;
1352       	   *there will be no records in the final dataset _resolved_children and the macro will run forever;
1353       	   *to resolve the issue, add the extra condition _child=children for the single branch that still ca be further
1353     ! averaged;
1354       	   *for downstream analysis;
1355       
1356       	   data _children(rename=(&child=children));
1357       	   set _children _resolved_children(keep=&child &parent);
1358       	   run;
1359       	
1360       	   proc sql;
1361              create table _parent_left as
1362              select distinct children,&parent
1363              from _parent_tmp
1364              where children not in (
1365       		 select distinct children
1366       		 from _resolved_children
1367              );
1368       	   %let tot_runs=%eval(&&tot_runs+1);
1369       	   %if &sqlobs=0 %then %do;
1370       	      %let change=0;
1371       		%end;
1372       
1373       		data _parent_list;
1374       		set _children _parent_left;
1375       		run;
1376       	  %if &tot_runs>100 %then %do;
1377       		%put It ran 100 times but is still not converged;
1378       		%put Please check the following 4 data sets for debugging:;
1379       		%put _parents, _children, _parent_tmp, and _resolved_childre;
1380               %abort 255;
1381       	  %end;
1382         %end;
1383       
1384         *Add _parent_list into the leaf name data set;
1385         data 	_parent_list;
1386         set _parent_list;
1387         order=children+0;
1388         drop children;
1389         run;
1390         data &outds;
1391         set &outds _parent_list(rename=(&parent=name));
1392         run;
1393       
1394       %mend tree_CL_positions;
1395       
1396       %macro treeorder(
1397       data=, 	/*A typical output generated by proc cluster*/
1398       child=child,  /*Equivalent to y_name_ or x_name_ from proc cluster; ensure there is not spaces
1399       included in the elements of this variable!*/
1400       parent=parent, /*Equivalent to y_parent_ or x_parent_ from proc cluster*/
1401       hh=hh, /*Equivalent to y_height_ or x_height_ from proc cluster*/
1402       root=CL1, /*the toppest root cluster name, and all braches under it will be searched for leaves*/
1403       order=ASC, /*Any non-string would be OK, as if provided with the string NAME, the input data
1404       will be sorted by parent and child names, however, SAS generted tree data set is used by
1405       proc tree or the statement of dendrogram in proc template to draw tree by sorting
1406       with the modified parent by using numers to represnet them,
1407       child and height, so please just use default string ASC for SAS generated input data*/
1408       outds=leaf_order, /*An output data set containing ordered leaf names from left to right in the dendrogram
1409       if running with SAS to generate tree using the input data*/
1410       parent_ds=parent_list /*An output data set contain all parents and its childrens*/
1411       );
1412         %local tmp parents rc;
1413         data _tree_src;
1414         set &data;
1415         *Use numeric parent to order it;
1416         _parent_=prxchange("s/^CL//",-1,&parent)+0;
1417         run;
1418         /* 1) ensure sorted children by chosen order (HH or NAME) */
1419         %if %upcase(&order)=NAME %then %do;
1420            proc sort data=_tree_src ; by _parent_ &child; run;
1421         %end;
1422         %else %do;
1423            /* order by height (hh) then child name */
1424            proc sort data=_tree_src; by _parent_ &child &hh; run;
1425         %end;
1426       
1427         /* 2) create a parent -> space-separated children list */
1428         data _parent_list(keep=&parent children _parent_);
1429            length children $ 32767;
1430            retain children;
1431            set _tree_src;
1432            by _parent_;
1433            if first._parent_ then children = strip(&child);
1434            else children = catx(' ', children, strip(&child));
1435            if last._parent_ then output;
1436         run;
1437       
1438         /* 3) recursive traversal macro that builds a global macro variable &LEAFSEQ */
1439         %global LEAFSEQ;
1440         %let LEAFSEQ=;
1441          %global PARENTSEQ;
1442         %let PARENTSEQ=;
1443         %macro _traverse(node);
1444            %local children nxt i child sqlobs;
1445            proc sql noprint;
1446               select children into :children trimmed
1447               from _parent_list
1448               where strip(&parent) = "%bquote(&node)"
1449               order by children;
1450            quit;
1451       
1452            %if %eval(&sqlobs = 0) or %eval(%length(&children) = 0) %then %do;
1453               /* node is a leaf (no children entry) */
1454               %let LEAFSEQ=&LEAFSEQ %bquote(&node);
1455            %end;
1456            %else %do;
1457       	    %let PARENTSEQ=&PARENTSEQ %bquote(&node);
1458               %let i=1;
1459               %do %while(%scan(&children,&i,%str( )) ne );
1460                 %let child=%scan(&children,&i,%str( ));
1461                 %_traverse(&child);
1462                 %let i=%eval(&i+1);
1463               %end;
1464            %end;
1465         %mend _traverse;
1466       
1467         /* 4) invoke traversal starting at the root */
1468         %_traverse(&root);
1469       
1470         /* 5) create output dataset with order index and name */
1471         data &outds;
1472            length name $200;
1473            i=1;
1474            do while(scan("&LEAFSEQ",i,' ') ne '');
1475               name = scan("&LEAFSEQ",i,' ');
1476               order = i;
1477               output;
1478               i+1;
1479            end;
1480            drop i;
1481         run;
1482         proc sort data=&outds;by order name;
1483       
1484         /*
1485         data &parent_ds;
1486         set _parent_list;
1487         run;
1488         */
1489       
1490          data &outds.4parents;
1491            length name $200;
1492            i=1;
1493            do while(scan("&PARENTSEQ",i,' ') ne '');
1494               name = scan("&PARENTSEQ",i,' ');
1495               order = i;
1496               output;
1497               i+1;
1498            end;
1499            drop i;
1500         run;
1501         proc sort data=&outds.4parents nodupkeys;by order name;
1502         data &parent_ds;
1503         set &outds.4parents;
1504         run;
1505       
1506         /*
1507         proc print data=&outds noobs; title "Leaf order from root=&root"; run;
1508         */
1509       
1510         /* cleanup */
1511       /*  proc datasets library=work nolist;*/
1512       /*     delete _tree_src _parent_list;*/
1513       /*  quit;*/
1514       %mend treeorder;
